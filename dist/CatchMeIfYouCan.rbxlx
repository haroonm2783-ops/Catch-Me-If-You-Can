	-- The city-facing side is +Z, matching the arcade marquee below it.
	local citrus = CFrame.new(-101, 31.5, -104.9) * CFrame.Angles(0, math.pi, 0)
	disc(arcade, "CitrusMarqueeHalo", citrus, 13, 0.55, P.gold, Enum.Material.Metal)
