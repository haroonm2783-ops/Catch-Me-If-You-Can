      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Appearance</string>
          <string name="Source"><![CDATA[-- Original, asset-free costume geometry shared by live characters and viewport previews.
-- Apply only changes appearance: every attached part is massless and non-colliding.
local Appearance = {}

local C = Color3.fromRGB
local palettes = {
	skin_courier = {base=C(37,43,62), coat=C(245,187,57), trim=C(255,233,170), detail=C(76,187,202), skin=C(193,145,112)},
	skin_rooftop = {base=C(28,39,60), coat=C(53,97,156), trim=C(165,215,242), detail=C(235,117,79), skin=C(185,127,96)},
	skin_gardener = {base=C(57,76,61), coat=C(130,167,108), trim=C(239,221,164), detail=C(232,156,107), skin=C(155,103,76)},
	skin_shadow = {base=C(23,24,35), coat=C(38,37,55), trim=C(99,86,147), detail=C(191,139,255), skin=C(139,120,153)},
	skin_golden = {base=C(38,38,46), coat=C(239,227,188), trim=C(201,153,57), detail=C(255,224,116), skin=C(180,131,93)},
	skin_neon = {base=C(27,34,56), coat=C(109,51,137), trim=C(62,226,225), detail=C(248,107,212), skin=C(159,112,86)},
	skin_crimson = {base=C(43,30,40), coat=C(145,44,62), trim=C(192,191,201), detail=C(255,113,85), skin=C(150,113,95)},
}
local masks = {mask_phantom=true,mask_kitsune=true,mask_skull=true,mask_visor=true,mask_street=true}
local nominal = {
	Head=Vector3.new(1.15,1,1), UpperTorso=Vector3.new(2,1.6,1), LowerTorso=Vector3.new(1.8,0.7,0.9),
	LeftUpperArm=Vector3.new(0.7,1.1,0.8), RightUpperArm=Vector3.new(0.7,1.1,0.8),
	LeftLowerArm=Vector3.new(0.65,1,0.7), RightLowerArm=Vector3.new(0.65,1,0.7),
	LeftHand=Vector3.new(0.65,0.4,0.7), RightHand=Vector3.new(0.65,0.4,0.7),
	LeftUpperLeg=Vector3.new(0.85,1.1,0.85), RightUpperLeg=Vector3.new(0.85,1.1,0.85),
	LeftLowerLeg=Vector3.new(0.8,1.1,0.8), RightLowerLeg=Vector3.new(0.8,1.1,0.8),
	LeftFoot=Vector3.new(0.85,0.4,1.1), RightFoot=Vector3.new(0.85,0.4,1.1),
	HumanoidRootPart=Vector3.new(2,2,1),
}
local function mul(a,b) return Vector3.new(a.X*b.X,a.Y*b.Y,a.Z*b.Z) end
local function offset(x,y,z,rx,ry,rz)
	return CFrame.new(x,y,z) * CFrame.Angles(math.rad(rx or 0),math.rad(ry or 0),math.rad(rz or 0))
end
local function attach(folder, target, name, size, cf, color, material, shape)
	if not target then return nil end
	local base = nominal[target.Name] or target.Size
	local scale = Vector3.new(target.Size.X/base.X,target.Size.Y/base.Y,target.Size.Z/base.Z)
	local part = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	part.Name = name
	part.Size = mul(size,scale)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	if shape == "Ball" then part.Shape = Enum.PartType.Ball end
	if shape == "Cylinder" then part.Shape = Enum.PartType.Cylinder end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
	part.Massless = true
	-- Live roots are temporarily anchored by head starts and vaults. A welded
	-- cosmetic must never keep that avatar anchored after the move ends.
	part.Anchored = folder.Parent:GetAttribute("CatchPreview") == true and target.Anchored
	part.CFrame = target.CFrame * CFrame.new(mul(cf.Position,scale)) * (cf-cf.Position)
	part.Parent = folder
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1 = target, part
	weld.Parent = part
	return part
end

local function costume(folder, rig, skinId, maskId, p)
	local head, torso, hip = rig:FindFirstChild("Head"),rig:FindFirstChild("UpperTorso"),rig:FindFirstChild("LowerTorso")
	local function piece(target,name,size,cf,color,material,shape)
		return attach(folder,target,name,size,cf,color or p.coat,material,shape)
	end
	-- Structured clothing encloses limbs without replacing any motor or collision body.
	for _, name in ipairs({"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","LeftFoot","RightFoot"}) do
		local body = rig:FindFirstChild(name)
		if body then
			local isCoat = name == "UpperTorso" or string.find(name,"Arm") ~= nil
			piece(body,"Tailored_"..name,nominal[name]+Vector3.new(0.055,0.025,0.055),CFrame.new(),isCoat and p.coat or p.base)
		end
	end
	for _, side in ipairs({"Left","Right"}) do
		piece(rig:FindFirstChild(side.."LowerArm"),"Cuff",Vector3.new(0.71,0.15,0.77),offset(0,-0.41,0),p.trim)
		piece(rig:FindFirstChild(side.."Foot"),"BootToe",Vector3.new(0.91,0.21,0.48),offset(0,0.04,-0.36),p.base)
		piece(rig:FindFirstChild(side.."LowerLeg"),"BootStripe",Vector3.new(0.10,0.65,0.05),offset(side=="Left" and -0.28 or 0.28,-0.2,-0.43),p.trim)
	end
	piece(hip,"Belt",Vector3.new(1.87,0.18,0.97),offset(0,0.24,0),p.base)
	piece(hip,"Buckle",Vector3.new(0.28,0.24,0.09),offset(0,0.24,-0.55),p.trim,Enum.Material.Metal)
	if skinId == "skin_shadow" then
		piece(head,"HoodCrown",Vector3.new(1.46,0.34,1.31),offset(0,0.55,0.08,-8),p.base)
		piece(head,"HoodBack",Vector3.new(1.45,1.20,0.22),offset(0,-0.02,0.57),p.base)
		for _, side in ipairs({-1,1}) do
			piece(head,"HoodFold",Vector3.new(0.25,1.18,1.24),offset(side*0.65,0,0.07,0,0,side*-10),p.coat)
			piece(head,"HoodLip",Vector3.new(0.09,0.84,0.10),offset(side*0.53,0.12,-0.57,0,0,side*-10),p.trim)
			piece(torso,"LayeredShoulder",Vector3.new(0.73,0.31,1.12),offset(side*0.93,0.69,0,0,0,side*15),p.base,Enum.Material.Metal)
			piece(torso,"SplitCape",Vector3.new(1.10,2.8,0.16),offset(side*0.47,-0.75,0.81,12,0,side*-5),p.base)
			piece(torso,"CapeTip",Vector3.new(0.99,0.55,0.15),offset(side*0.59,-2.36,1.14,12,0,180),p.coat,nil,"Wedge")
		end
		piece(torso,"CrossedHarness",Vector3.new(0.22,1.73,0.10),offset(0,0,-0.59,0,0,32),p.trim)
		piece(torso,"AmethystClasp",Vector3.new(0.24,0.24,0.15),offset(0,0.51,-0.69,0,0,45),p.detail,Enum.Material.Neon)
		piece(rig:FindFirstChild("LeftLowerArm"),"ScoutBracer",Vector3.new(0.8,0.76,0.84),offset(0,0,0),p.base)
	elseif skinId == "skin_golden" then
		for _, side in ipairs({-1,1}) do
			piece(torso,"PhantomLapels",Vector3.new(0.36,1.40,0.13),offset(side*0.52,0.16,-0.60,0,0,side*-18),p.trim,Enum.Material.Metal)
			piece(torso,"CoatTail",Vector3.new(0.86,1.8,0.16),offset(side*0.57,-1.34,0.55,8,0,side*-8),p.coat)
			piece(torso,"TailGoldHem",Vector3.new(0.07,1.7,0.06),offset(side*0.90,-1.30,0.65,8,0,side*-8),p.trim,Enum.Material.Metal)
			piece(torso,"StandingCollar",Vector3.new(0.24,0.81,0.85),offset(side*0.62,0.89,0.22,-16,0,side*-14),p.trim,Enum.Material.Metal)
			for layer=1,3 do
				piece(torso,"DecoFan",Vector3.new(0.31,0.18,1.04-layer*0.12),offset(side*(0.98+layer*0.16),0.67+layer*0.12,0.06,0,0,side*22),p.trim,Enum.Material.Metal)
			end
		end
		piece(torso,"DarkWaistcoat",Vector3.new(0.65,1.43,0.08),offset(0,-0.03,-0.58),p.base)
		for y=-0.5,0.5,0.33 do piece(torso,"DecoButton",Vector3.new(0.10,0.10,0.08),offset(0,y,-0.66,0,0,45),p.detail,Enum.Material.Metal) end
		piece(head,"PhantomBrow",Vector3.new(1.03,0.13,0.14),offset(0,0.43,-0.53),p.trim,Enum.Material.Metal)
	elseif skinId == "skin_neon" then
		piece(torso,"PufferYoke",Vector3.new(2.19,0.45,1.2),offset(0,0.56,0),p.coat)
		piece(torso,"ZipGlow",Vector3.new(0.07,1.47,0.06),offset(0,-0.02,-0.58),p.trim,Enum.Material.Neon)
		for _, side in ipairs({-1,1}) do
			piece(torso,"NeonCollar",Vector3.new(0.44,0.53,0.88),offset(side*0.5,0.89,0.07,0,0,side*-15),p.base)
			piece(torso,"Piping",Vector3.new(0.07,0.39,1.24),offset(side*1.09,0.56,0),p.trim,Enum.Material.Neon)
			piece(rig:FindFirstChild(side==-1 and "LeftUpperArm" or "RightUpperArm"),"JacketPuff",Vector3.new(0.91,0.90,0.96),offset(0,0.07,0),p.coat)
			piece(rig:FindFirstChild(side==-1 and "LeftLowerArm" or "RightLowerArm"),"WristDisplay",Vector3.new(0.45,0.33,0.08),offset(0,-0.14,-0.43),p.trim,Enum.Material.Neon)
		end
		piece(torso,"TechPack",Vector3.new(1.10,1.15,0.47),offset(0,0.05,0.78),p.base)
		piece(torso,"PackBattery",Vector3.new(0.44,0.83,0.07),offset(0,0.05,1.05),p.detail,Enum.Material.Neon)
		piece(head,"Receiver",Vector3.new(0.22,0.48,0.48),offset(-0.68,0.12,0),p.base)
		piece(head,"Antenna",Vector3.new(0.06,0.45,0.06),offset(-0.69,0.55,0.1,0,0,-12),p.trim,Enum.Material.Neon)
		if maskId == "" or not maskId then
			piece(head,"IntegratedTechVisor",Vector3.new(1.24,0.25,0.13),offset(0,0.12,-0.57),p.base)
			piece(head,"IntegratedTechLens",Vector3.new(1.06,0.10,0.06),offset(0,0.13,-0.67),p.trim,Enum.Material.Neon)
		end
	elseif skinId == "skin_crimson" then
		piece(torso,"ArmoredChest",Vector3.new(1.74,1.07,0.24),offset(0,0.14,-0.66),p.coat,Enum.Material.Metal)
		piece(torso,"ChestRidge",Vector3.new(0.14,1.13,0.12),offset(0,0.13,-0.83),p.trim,Enum.Material.Metal)
		for _, side in ipairs({-1,1}) do
			piece(torso,"HunterPauldron",Vector3.new(0.94,0.51,1.19),offset(side*1.18,0.65,0,0,0,side*16),p.coat,Enum.Material.Metal)
			piece(torso,"PauldronRim",Vector3.new(0.13,0.53,1.23),offset(side*1.54,0.52,0,0,0,side*16),p.trim,Enum.Material.Metal)
			piece(torso,"ChestSlash",Vector3.new(0.67,0.10,0.07),offset(side*0.45,0.38,-0.82,0,0,side*-15),p.detail,Enum.Material.Neon)
			local sideName = side==-1 and "Left" or "Right"
			piece(rig:FindFirstChild(sideName.."LowerArm"),"HunterGauntlet",Vector3.new(0.86,0.80,0.91),offset(0,-0.02,0),p.coat,Enum.Material.Metal)
			piece(rig:FindFirstChild(sideName.."LowerLeg"),"KneeShield",Vector3.new(0.73,0.51,0.19),offset(0,0.42,-0.49),p.coat,Enum.Material.Metal)
			piece(head,"TempleArmor",Vector3.new(0.22,0.57,0.75),offset(side*0.63,0.15,0.05),p.coat,Enum.Material.Metal)
		end
		piece(head,"HunterBrow",Vector3.new(1.35,0.26,0.73),offset(0,0.45,-0.02),p.coat,Enum.Material.Metal)
		piece(head,"Crest",Vector3.new(0.22,0.31,0.93),offset(0,0.68,0.03),p.trim,Enum.Material.Metal)
	elseif skinId == "skin_rooftop" then
		piece(torso,"ScarfLoop",Vector3.new(1.40,0.29,1.13),offset(0,0.81,0),p.detail)
		piece(torso,"WindScarf",Vector3.new(0.48,1.87,0.15),offset(0.58,0.1,0.87,-20,0,-12),p.detail)
		piece(torso,"WindbreakerZip",Vector3.new(0.10,1.40,0.07),offset(0,0,-0.58),p.trim)
		piece(torso,"RouteChevron",Vector3.new(0.67,0.14,0.06),offset(-0.53,0.35,-0.59,0,0,20),p.trim)
		piece(head,"RaisedGogglesBand",Vector3.new(1.26,0.16,1.13),offset(0,0.36,0),p.base)
		for _, side in ipairs({-1,1}) do
			piece(head,"RaisedGoggleLens",Vector3.new(0.43,0.27,0.16),offset(side*0.30,0.42,-0.55),p.detail,Enum.Material.Glass)
			piece(rig:FindFirstChild(side==-1 and "LeftLowerArm" or "RightLowerArm"),"ClimberWrap",Vector3.new(0.73,0.53,0.79),offset(0,-0.12,0),p.base)
		end
	elseif skinId == "skin_gardener" then
		piece(torso,"UtilityApron",Vector3.new(1.48,1.93,0.11),offset(0,-0.27,-0.58),p.base)
		for _, side in ipairs({-1,1}) do
			piece(torso,"ApronStrap",Vector3.new(0.15,0.80,0.09),offset(side*0.54,0.48,-0.59),p.trim)
			piece(torso,"SeedPocket",Vector3.new(0.55,0.48,0.15),offset(side*0.38,-0.62,-0.69),p.coat)
		end
		piece(head,"StrawHatBrim",Vector3.new(0.14,2.04,2.04),offset(0,0.53,0,0,0,90),p.trim,nil,"Cylinder")
		piece(head,"StrawHatCrown",Vector3.new(0.49,1.25,1.25),offset(0,0.82,0,0,0,90),p.trim,nil,"Cylinder")
		piece(head,"HatRibbon",Vector3.new(0.13,1.29,1.29),offset(0,0.64,0,0,0,90),p.detail,nil,"Cylinder")
		piece(torso,"FlowerStem",Vector3.new(0.06,0.40,0.06),offset(-0.40,0.03,-0.69,0,0,14),p.coat)
		piece(torso,"PocketFlower",Vector3.new(0.23,0.23,0.10),offset(-0.45,0.22,-0.71),p.detail,nil,"Ball")
	else
		piece(torso,"MessengerStrap",Vector3.new(0.24,1.96,0.11),offset(0,0,-0.61,0,0,34),p.base)
		piece(hip,"DispatchSatchel",Vector3.new(0.75,0.77,0.51),offset(0.92,-0.02,-0.02),p.detail)
		piece(hip,"SatchelFlap",Vector3.new(0.79,0.29,0.10),offset(0.92,0.19,-0.32),p.trim)
		piece(torso,"CourierPatch",Vector3.new(0.40,0.28,0.07),offset(-0.56,0.35,-0.58),p.trim)
		piece(head,"CourierCap",Vector3.new(1.22,0.36,1.13),offset(0,0.45,0.04),p.base)
		piece(head,"CapBrim",Vector3.new(1.20,0.10,0.64),offset(0,0.31,-0.64,-8),p.coat)
		piece(head,"CapBadge",Vector3.new(0.22,0.14,0.06),offset(0,0.45,-0.56),p.detail)
	end
end

local function mask(folder, rig, maskId)
	local head = rig:FindFirstChild("Head")
	if not head or not maskId or maskId == "" then return end
	local function m(name,size,cf,color,material,shape) return attach(folder,head,name,size,cf,color,material,shape) end
	local white, ink, gold = C(240,235,228),C(28,29,42),C(222,176,73)
	if maskId == "mask_phantom" then
		m("PhantomCeramic",Vector3.new(0.96,0.76,0.17),offset(0,-0.01,-0.60),white)
		for _, side in ipairs({-1,1}) do
			m("PhantomCheek",Vector3.new(0.33,0.38,0.13),offset(side*0.35,-0.26,-0.66,0,0,side*20),white)
			m("PhantomEye",Vector3.new(0.27,0.10,0.06),offset(side*0.26,0.12,-0.72,0,0,side*10),ink)
			m("PhantomGoldBrow",Vector3.new(0.31,0.045,0.06),offset(side*0.26,0.23,-0.73,0,0,side*10),gold,Enum.Material.Metal)
		end
		m("PhantomNose",Vector3.new(0.12,0.24,0.17),offset(0,-0.05,-0.76,0,0,180),white,nil,"Wedge")
		m("PhantomMouth",Vector3.new(0.21,0.045,0.04),offset(0,-0.28,-0.75),ink)
	elseif maskId == "mask_kitsune" then
		m("FoxFace",Vector3.new(0.96,0.68,0.19),offset(0,-0.01,-0.62),white)
		for _, side in ipairs({-1,1}) do
			m("FoxEar",Vector3.new(0.32,0.63,0.17),offset(side*0.42,0.48,-0.58,0,0,side*-18),white,nil,"Wedge")
			m("FoxEarInner",Vector3.new(0.15,0.35,0.05),offset(side*0.43,0.47,-0.69,0,0,side*-18),C(195,65,82),nil,"Wedge")
			m("FoxEye",Vector3.new(0.28,0.075,0.06),offset(side*0.25,0.09,-0.75,0,0,side*20),C(174,37,60))
			m("FoxCheekMark",Vector3.new(0.24,0.07,0.06),offset(side*0.33,-0.13,-0.75,0,0,side*-25),C(195,65,82))
		end
		m("FoxMuzzle",Vector3.new(0.36,0.23,0.23),offset(0,-0.25,-0.76),white)
		m("FoxNose",Vector3.new(0.13,0.08,0.06),offset(0,-0.18,-0.91),ink)
	elseif maskId == "mask_skull" then
		m("SkullForehead",Vector3.new(1.01,0.47,0.22),offset(0,0.18,-0.61),gold,Enum.Material.Metal)
		for _, side in ipairs({-1,1}) do
			m("SkullCheek",Vector3.new(0.29,0.35,0.16),offset(side*0.38,-0.13,-0.65,0,0,side*18),gold,Enum.Material.Metal)
			m("SkullSocket",Vector3.new(0.30,0.23,0.07),offset(side*0.26,0.10,-0.77,0,0,side*9),ink)
		end
		m("SkullJaw",Vector3.new(0.62,0.24,0.19),offset(0,-0.33,-0.63),gold,Enum.Material.Metal)
		m("SkullNasal",Vector3.new(0.12,0.16,0.06),offset(0,-0.10,-0.79,0,0,180),ink,nil,"Wedge")
		for x=-0.24,0.24,0.12 do m("ToothGap",Vector3.new(0.025,0.14,0.04),offset(x,-0.33,-0.75),ink) end
	elseif maskId == "mask_visor" then
		m("VisorFrame",Vector3.new(1.34,0.42,0.22),offset(0,0.08,-0.61),ink,Enum.Material.Metal)
		m("VisorLens",Vector3.new(1.16,0.25,0.06),offset(0,0.09,-0.76),C(67,230,232),Enum.Material.Neon)
		m("VisorDivider",Vector3.new(0.05,0.26,0.07),offset(0.31,0.09,-0.80),white)
		for _, side in ipairs({-1,1}) do m("VisorEarpiece",Vector3.new(0.17,0.33,0.87),offset(side*0.67,0.06,-0.17),ink) end
	elseif maskId == "mask_street" then
		m("StreetRespirator",Vector3.new(0.87,0.43,0.21),offset(0,-0.24,-0.62),ink)
		for _, side in ipairs({-1,1}) do
			m("RespiratorFilter",Vector3.new(0.26,0.26,0.14),offset(side*0.35,-0.23,-0.77),C(105,115,133),Enum.Material.Metal,"Ball")
			m("StreetStrap",Vector3.new(0.07,0.10,0.93),offset(side*0.57,-0.13,-0.04),ink)
		end
		for y=-0.32,-0.16,0.08 do m("RespiratorVent",Vector3.new(0.30,0.025,0.04),offset(0,y,-0.75),C(244,184,70)) end
	end
end

local function addTrail(folder, rig, id)
	if id ~= "trail_cyan" and id ~= "trail_sunset" then return end
	local root = rig:FindFirstChild("HumanoidRootPart")
	local mount = attach(folder,root,"TrailMount",Vector3.new(0.05,0.05,0.05),offset(0,-0.55,0.6),Color3.new())
	if not mount then return end
	mount.Transparency = 1
	local a,b = Instance.new("Attachment"),Instance.new("Attachment")
	a.Position,b.Position = Vector3.new(-0.5,0,0),Vector3.new(0.5,0,0)
	a.Parent,b.Parent = mount,mount
	local trail = Instance.new("Trail")
	trail.Name = id
	trail.Enabled = rig:GetAttribute("CatchPreview") == true or rig:GetAttribute("Sprinting") == true
	trail.Attachment0,trail.Attachment1 = a,b
	trail.Color = id=="trail_cyan" and ColorSequence.new(C(59,236,228),C(85,123,239)) or ColorSequence.new(C(255,196,91),C(246,86,135))
	trail.Lifetime = 0.33
	trail.MinLength = 0.08
	trail.FaceCamera = true
	trail.LightEmission = 0.65
	trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.35),NumberSequenceKeypoint.new(1,1)})
	trail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0,0.72),NumberSequenceKeypoint.new(1,0)})
	trail.Parent = folder
end

function Appearance.Apply(rig, skinId, maskId, equipped)
	if not rig or not rig:IsA("Model") then return nil end
	local old = rig:FindFirstChild("CatchAppearance")
	if old then old:Destroy() end
	skinId = palettes[skinId] and skinId or "skin_courier"
	maskId = masks[maskId] and maskId or ""
	local p = palettes[skinId]
	for _, body in ipairs(rig:GetChildren()) do
		if body:IsA("BasePart") and nominal[body.Name] and body.Name ~= "HumanoidRootPart" then
			if body:GetAttribute("CatchOriginalColor") == nil then body:SetAttribute("CatchOriginalColor",body.Color) end
			body.Color = body:GetAttribute("CatchOriginalColor")
			if body.Name == "Head" or string.find(body.Name,"Hand") then body.Color = p.skin end
		elseif body:IsA("Accessory") then
			for _, part in ipairs(body:GetDescendants()) do
				if part:IsA("BasePart") then
					if part:GetAttribute("CatchOriginalTransparency") == nil then part:SetAttribute("CatchOriginalTransparency",part.Transparency) end
					part.Transparency = 1
				end
			end
		end
	end
	local folder = Instance.new("Folder")
	folder.Name = "CatchAppearance"
	folder.Parent = rig
	costume(folder,rig,skinId,maskId,p)
	mask(folder,rig,maskId)
	if equipped then addTrail(folder,rig,equipped.trails) end
	-- Keep the asset-free face through repeated outfit and mask changes in previews.
	if rig:GetAttribute("CatchPreview") and maskId == "" then
		local head = rig:FindFirstChild("Head")
		for _, side in ipairs({-1,1}) do attach(folder,head,"PreviewEye",Vector3.new(0.065,0.10,0.035),offset(side*0.20,0.07,-0.54),C(38,35,42)) end
		attach(folder,head,"PreviewSmile",Vector3.new(0.22,0.035,0.035),offset(0,-0.20,-0.54),C(89,55,48))
	end
	return folder
end

function Appearance.BuildPreview(skinId, maskId, extra)
	local rig = Instance.new("Model")
	rig.Name = "CatchPreview"
	rig:SetAttribute("CatchPreview",true)
	local positions = {
		HumanoidRootPart=Vector3.new(0,0,0),UpperTorso=Vector3.new(0,0.65,0),LowerTorso=Vector3.new(0,-0.50,0),Head=Vector3.new(0,2.02,0),
		LeftUpperArm=Vector3.new(-1.39,0.84,0),RightUpperArm=Vector3.new(1.39,0.84,0),
		LeftLowerArm=Vector3.new(-1.43,-0.21,0),RightLowerArm=Vector3.new(1.43,-0.21,0),
		LeftHand=Vector3.new(-1.43,-0.90,0),RightHand=Vector3.new(1.43,-0.90,0),
		LeftUpperLeg=Vector3.new(-0.46,-1.39,0),RightUpperLeg=Vector3.new(0.46,-1.39,0),
		LeftLowerLeg=Vector3.new(-0.46,-2.49,0),RightLowerLeg=Vector3.new(0.46,-2.49,0),
		LeftFoot=Vector3.new(-0.46,-3.23,-0.12),RightFoot=Vector3.new(0.46,-3.23,-0.12),
	}
	-- Root matches Roblox's standing height of about 3 studs; feet finish at -3.
	for name, position in pairs(positions) do
		if name ~= "HumanoidRootPart" then position += Vector3.new(0,0.43,0) end
		local part = Instance.new("Part")
		part.Name,part.Size = name,nominal[name]
		part.CFrame = CFrame.new(position)
		part.Anchored = true
		part.CanCollide,part.CanTouch,part.CanQuery = false,false,false
		part.Massless = true
		part.Color = C(190,146,112)
		part.TopSurface,part.BottomSurface = Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
		if name == "HumanoidRootPart" then part.Transparency = 1 end
		if name == "Head" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Scale = Vector3.new(1.12,1.05,1.08)
			mesh.Parent = part
		end
		part.Parent = rig
	end
	rig.PrimaryPart = rig:FindFirstChild("HumanoidRootPart")
	-- Preview joints make the model recognizable to avatar tools without live physics.
	local joints = {
		{"Root","HumanoidRootPart","LowerTorso"},{"Waist","LowerTorso","UpperTorso"},{"Neck","UpperTorso","Head"},
		{"LeftShoulder","UpperTorso","LeftUpperArm"},{"RightShoulder","UpperTorso","RightUpperArm"},
		{"LeftElbow","LeftUpperArm","LeftLowerArm"},{"RightElbow","RightUpperArm","RightLowerArm"},
		{"LeftWrist","LeftLowerArm","LeftHand"},{"RightWrist","RightLowerArm","RightHand"},
		{"LeftHip","LowerTorso","LeftUpperLeg"},{"RightHip","LowerTorso","RightUpperLeg"},
		{"LeftKnee","LeftUpperLeg","LeftLowerLeg"},{"RightKnee","RightUpperLeg","RightLowerLeg"},
		{"LeftAnkle","LeftLowerLeg","LeftFoot"},{"RightAnkle","RightLowerLeg","RightFoot"},
	}
	for _, spec in ipairs(joints) do
		local joint = Instance.new("Motor6D")
		joint.Name,joint.Part0,joint.Part1 = spec[1],rig:FindFirstChild(spec[2]),rig:FindFirstChild(spec[3])
		joint.C0 = joint.Part0.CFrame:ToObjectSpace(joint.Part1.CFrame)
		joint.Parent = joint.Part0
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.AutoRotate = false
	humanoid.Parent = rig
	Appearance.Apply(rig,skinId,maskId,extra)
	return rig
end

-- Anchored showroom models cannot rely on live Motor6D physics. Animate the arm
-- geometry and its clothing together, preserving the same pose after PivotTo.
-- The returned animator is intentionally unavailable for live character rigs.
function Appearance.CreatePreviewPose(rig, victoryId)
	if not rig or not rig:IsA("Model") or rig:GetAttribute("CatchPreview") ~= true then return nil end
	if victoryId ~= "victory_wave" and victoryId ~= "victory_spin" then return nil end
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local parts = {}
	local sides = {LeftUpperArm=-1,LeftLowerArm=-1,LeftHand=-1,RightUpperArm=1,RightLowerArm=1,RightHand=1}
	for _, part in ipairs(rig:GetDescendants()) do
		if part:IsA("BasePart") then
			if not part.Anchored then return nil end
			local weld = part:FindFirstChildOfClass("WeldConstraint")
			local targetName = weld and weld.Part0 and weld.Part0.Name or part.Name
			local side = sides[targetName]
			if side then table.insert(parts,{part=part,side=side,rest=root.CFrame:ToObjectSpace(part.CFrame)}) end
		end
	end
	return function(elapsed)
		if not rig.Parent or not root.Parent then return end
		elapsed = type(elapsed)=="number" and elapsed==elapsed and math.abs(elapsed)<math.huge and elapsed or 0
		local wave = math.sin(elapsed*5.5)
		for _, item in ipairs(parts) do
			if item.part.Parent then
				local angle = victoryId=="victory_spin" and item.side*72
					or (item.side==1 and 138+wave*11 or -8)
				local pivot = CFrame.new(item.side*1.05,1.78,0)
				local rotation = pivot*CFrame.Angles(0,0,math.rad(angle))*pivot:Inverse()
				item.part.CFrame = root.CFrame*rotation*item.rest
			end
		end
	end
end

return Appearance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[-- Original cosmetics, all cosmetic-only. Enter real experience pass IDs here.
-- The Robux price shown here is a design price: set the matching price in Creator
-- Dashboard. Roblox's purchase prompt remains the authority for charged prices.
local Catalog = {}
Catalog.Categories = {
	{id="skins",label="Skins"}, {id="masks",label="Masks"},
	{id="trails",label="Trails"}, {id="emotes",label="Emotes"},
	{id="tagEffects",label="Tag effects"}, {id="victories",label="Victories"},
	{id="nameplates",label="Nameplates"}, {id="bundles",label="Bundles"},
	{id="vip",label="VIP"},
}
local entries = {
	{id="skin_courier",category="skins",name="Midnight Courier",description="Asymmetric messenger straps, amber headphones and city-ready high tops.",currency="Free",price=0,rarity="Common",accent={255,190,95}},
	{id="skin_rooftop",category="skins",name="Rooftop Ace",description="An aqua parkour jacket, utility harness and bold runner fins. Reach level 5.",currency="Milestone",price=0,milestone={stat="level",value=5},rarity="Rare",accent={73,234,219}},
	{id="skin_gardener",category="skins",name="Skygarden Keeper",description="Botanical shoulder leaves, a canvas apron and a pocket of rooftop flowers.",currency="Coins",price=650,rarity="Rare",accent={152,219,151}},
	{id="skin_shadow",category="skins",name="Shadow Runner",description="A sculpted midnight hood, split cape and violet stealth harness.",currency="Robux",price=299,gamePassId=0,rarity="Epic",accent={164,129,255}},
	{id="skin_golden",category="skins",name="Golden Phantom",description="Art deco gilded armor, a floating halo and a royal black coat.",currency="Robux",price=599,gamePassId=0,rarity="Legendary",accent={255,204,91}},
	{id="skin_neon",category="skins",name="Neon Outlaw",description="An oversized tech collar, cyan light piping and a magenta back reactor.",currency="Robux",price=399,gamePassId=0,rarity="Epic",accent={62,233,255}},
	{id="skin_crimson",category="skins",name="Crimson Hunter",description="Angular red pauldrons, a high tactical collar and a split battle sash.",currency="Robux",price=499,gamePassId=0,rarity="Epic",accent={255,88,109}},
	{id="mask_street",category="masks",name="Street Signal",description="A clean teal respirator with bright side filters. Yours from the start.",currency="Free",price=0,rarity="Common",accent={88,228,206}},
	{id="mask_visor",category="masks",name="Prism Visor",description="A luminous wraparound lens with independent temple plates.",currency="Coins",price=180,rarity="Rare",accent={94,218,255}},
	{id="mask_phantom",category="masks",name="Phantom Mask",description="An ivory asymmetrical phantom face with a violet tear detail.",currency="Robux",price=149,gamePassId=0,rarity="Epic",accent={202,188,255}},
	{id="mask_kitsune",category="masks",name="Kitsune Mask",description="Sculpted fox ears, an ivory muzzle and vermilion markings.",currency="Robux",price=199,gamePassId=0,rarity="Epic",accent={255,119,104}},
	{id="mask_skull",category="masks",name="Gold Skull Mask",description="A gilded skull silhouette with dark orbital sockets and individual teeth.",currency="Robux",price=349,gamePassId=0,rarity="Legendary",accent={255,204,91}},
	{id="trail_cyan",category="trails",name="Afterglow",description="A restrained cyan ribbon that wakes up while you sprint.",currency="Coins",price=250,rarity="Rare",accent={87,238,237}},
	{id="trail_sunset",category="trails",name="Sunset Circuit",description="Warm coral light for runners who have earned 20 wins.",currency="Milestone",price=0,milestone={stat="wins",value=20},rarity="Epic",accent={255,140,117}},
	{id="tag_spark",category="tagEffects",name="Signal Burst",description="A crisp cyan pulse on every successful catch.",currency="Free",price=0,rarity="Common",accent={81,231,240}},
	{id="tag_bloom",category="tagEffects",name="Cherry Bloom",description="A coral burst of city petals. Unlock after 50 tags.",currency="Milestone",price=0,milestone={stat="tags",value=50},rarity="Epic",accent={255,128,174}},
	{id="victory_wave",category="victories",name="City Salute",description="Wave to the whole skyline from the winners' podium.",currency="Free",price=0,rarity="Common",accent={121,228,231}},
	{id="victory_spin",category="victories",name="Victory Lap",description="An animated podium turn with neon confetti.",currency="Coins",price=350,rarity="Rare",accent={255,190,95}},
	{id="emote_wave",category="emotes",name="Hey, Neighbor",description="A friendly wave in the lobby or after a round.",currency="Free",price=0,rarity="Common",accent={112,215,242}},
	{id="emote_dance",category="emotes",name="Rooftop Shuffle",description="A quick shoulder-and-step dance for your crew.",currency="Coins",price=220,rarity="Rare",accent={221,151,255}},
	{id="name_rookie",category="nameplates",name="CITY NEWCOMER",description="Every rooftop legend starts somewhere.",currency="Free",price=0,rarity="Common",accent={172,193,208}},
	{id="name_survivor",category="nameplates",name="UNTOUCHABLE",description="Earn 10 wins and let your name do the talking.",currency="Milestone",price=0,milestone={stat="wins",value=10},rarity="Rare",accent={87,238,237}},
	{id="name_legend",category="nameplates",name="SKYLINE LEGEND",description="Reach level 30. A badge of long-term city mastery.",currency="Milestone",price=0,milestone={stat="level",value=30},rarity="Legendary",accent={255,204,91}},
	{id="bundle_night",category="bundles",name="Nightfall Collection",description="Shadow Runner, Phantom Mask and Afterglow trail. Appearance only.",currency="Robux",price=649,gamePassId=0,grants={"skin_shadow","mask_phantom","trail_cyan"},rarity="Legendary",accent={164,129,255}},
	{id="vip_founder",category="vip",name="Neon Social Club",description="Neon Outlaw, Prism Visor and Rooftop Shuffle. No XP, speed or currency boosts.",currency="Robux",price=699,gamePassId=0,grants={"skin_neon","mask_visor","emote_dance"},rarity="Legendary",accent={255,204,91}},
}
Catalog.Items = {}
for order, item in ipairs(entries) do
	item.order = order
	Catalog.Items[item.id] = item
end
Catalog.DefaultEquipment = {
	skins="skin_courier", masks="", trails="", tagEffects="tag_spark",
	victories="victory_wave", emotes="emote_wave", nameplates="name_rookie",
}
function Catalog.Get(id) return Catalog.Items[id] end
function Catalog.ForCategory(category)
	local result = {}
	for _, item in ipairs(entries) do
		if item.category == category then table.insert(result, item) end
	end
	return result
end
function Catalog.IsEquippable(category)
	return Catalog.DefaultEquipment[category] ~= nil
end
function Catalog.DefaultOwned()
	local owned = {}
	for _, item in ipairs(entries) do
		if item.currency == "Free" then owned[item.id] = true end
	end
	return owned
end
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Shared tunables. Prices and pass IDs live in Catalog.lua.
local Config = {
	GameName = "CATCH ME IF YOU CAN",
	Version = "0.1.0",
	Round = {
		MaxPlayers = 12, MinimumPlayers = 2, Duration = 180, Intermission = 16,
		ResultsDuration = 10, HeadStart = 5, FinalSeconds = 30, RespawnDelay = 2,
		StudioSolo = true,
	},
	Movement = {
		WalkSpeed = 17, RunnerSprint = 26, HunterSprint = 27, Acceleration = 7,
		JumpPower = 48, SlideSpeed = 35, SlideDuration = 0.65, SlideCooldown = 3,
		VaultCooldown = 1.1, VaultDistance = 5, VaultHeight = 4.5,
		TagRange = 5.8, TagCooldown = 0.65,
	},
	Persistence = {
		StoreName = "CatchMeIfYouCan_v1", AutosaveSeconds = 60, Retries = 3,
		UseStudioDataStores = false, SessionLockSeconds = 180,
	},
	Progression = {
		RoundXP = 45, WinXP = 80, TagXP = 25, SurvivalXPPerSecond = 0.4,
		RoundCoins = 12, WinCoins = 25, TagCoins = 6,
	},
	-- Only set IDs for audio you own or have permission to use in this experience.
	-- Music=0 is silent; SFX=0 use quiet engine-bundled cues. Positive IDs override.
	-- Unavailable audio is skipped; every action also has visual feedback.
	Audio = {
		Music = 0, Sprint = 0, Slide = 0, Vault = 0, Tag = 0, Win = 0, Lose = 0,
		Level = 0, Countdown = 0, Final = 0, Purchase = 0,
	},
}
return table.freeze(Config)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- Pure domain rules. Works in Roblox and in the standalone Luau test runner.
local Catalog = if script then require(script.Parent.Catalog) else require("./Catalog")
local Rules = {}
local MAX_NUMBER = 1000000000
local function integer(value, fallback, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
	return math.clamp(math.floor(value), 0, maximum or MAX_NUMBER)
end
function Rules.HunterCount(count)
	count = integer(count, 0, 12)
	if count < 2 then return 0 end
	return if count >= 7 then 2 else 1
end
function Rules.XPForLevel(level)
	level = math.clamp(integer(level, 1, 10000), 1, 10000)
	return 100 * (level - 1) + 25 * (level - 1) * (level - 1)
end
function Rules.LevelFromXP(xp)
	xp = integer(xp, 0)
	return math.floor((-100 + math.sqrt(10000 + 100 * xp)) / 50) + 1
end
function Rules.Rank(rating)
	rating = integer(rating, 1000)
	if rating >= 1800 then return "Skyline Elite" end
	if rating >= 1500 then return "Diamond" end
	if rating >= 1250 then return "Gold" end
	if rating >= 1000 then return "Silver" end
	return "Bronze"
end
function Rules.DayKey(timestamp)
	return os.date("!%Y-%m-%d", timestamp or os.time())
end
function Rules.DailyQuests(_dayKey)
	return {
		{id="play_3",text="Finish 3 competitive rounds",stat="rounds",goal=3,xp=100,coins=40},
		{id="tag_5",text="Catch 5 runners",stat="tags",goal=5,xp=125,coins=50},
		{id="survive_120",text="Survive for 120 seconds",stat="survived",goal=120,xp=100,coins=40},
	}
end
function Rules.NewProfile(now)
	return {
		schemaVersion=1, coins=0, xp=0, level=1, rating=1000, streak=0, bestStreak=0,
		stats={rounds=0,wins=0,hunterWins=0,runnerWins=0,tags=0,survived=0},
		owned=Catalog.DefaultOwned(), equipped=table.clone(Catalog.DefaultEquipment),
		settings={music=true,sfx=true,reducedMotion=false,cameraShake=true},
		daily={day=Rules.DayKey(now),progress={rounds=0,tags=0,survived=0},claimed={}},
		achievements={},
	}
end
function Rules.NormalizeProfile(raw, now)
	local result = Rules.NewProfile(now)
	if type(raw) ~= "table" then return result end
	for _, key in ipairs({"coins","xp","rating","streak","bestStreak"}) do
		result[key] = integer(raw[key], result[key])
	end
	result.level = Rules.LevelFromXP(result.xp)
	result.bestStreak = math.max(result.bestStreak, result.streak)
	if type(raw.stats) == "table" then
		for key in pairs(result.stats) do result.stats[key] = integer(raw.stats[key], 0) end
	end
	if type(raw.owned) == "table" then
		for id, owned in pairs(raw.owned) do
			if type(id) == "string" and Catalog.Get(id) and owned == true then result.owned[id] = true end
		end
	end
	if type(raw.equipped) == "table" then
		for category in pairs(result.equipped) do
			local id = raw.equipped[category]
			local item = type(id) == "string" and Catalog.Get(id)
			if id == "" then result.equipped[category] = ""
			elseif item and item.category == category and result.owned[id] then result.equipped[category] = id end
		end
	end
	if type(raw.settings) == "table" then
		for key in pairs(result.settings) do
			if type(raw.settings[key]) == "boolean" then result.settings[key] = raw.settings[key] end
		end
	end
	if type(raw.daily) == "table" and raw.daily.day == result.daily.day then
		if type(raw.daily.progress) == "table" then
			for key in pairs(result.daily.progress) do result.daily.progress[key] = integer(raw.daily.progress[key], 0) end
		end
		if type(raw.daily.claimed) == "table" then
			for _, quest in ipairs(Rules.DailyQuests(result.daily.day)) do
				if raw.daily.claimed[quest.id] == true then result.daily.claimed[quest.id] = true end
			end
		end
	end
	if type(raw.achievements) == "table" then
		for id, value in pairs(raw.achievements) do
			if type(id) == "string" and #id < 80 and (value == true or type(value) == "number") then
				result.achievements[id] = if value == true then true else integer(value, 0)
			end
		end
	end
	return result
end
function Rules.QuestProgress(profile, quest)
	local progress = profile.daily and profile.daily.progress or {}
	return math.clamp(integer(progress[quest.stat], 0), 0, quest.goal)
end
function Rules.RoundReward(summary, config)
	if summary.practice then return {xp=0,coins=0,rating=0} end
	local progression = config.Progression or config
	local tags = if summary.role == "Hunter" then integer(summary.tags, 0, 10) else 0
	local survived = if summary.role == "Runner" then integer(summary.survived, 0, 180) else 0
	local win = summary.win == true
	return {
		xp=math.floor(progression.RoundXP + tags * progression.TagXP + survived * progression.SurvivalXPPerSecond + (if win then progression.WinXP else 0)),
		coins=progression.RoundCoins + tags * progression.TagCoins + (if win then progression.WinCoins else 0),
		rating=if win then 24 else -14,
	}
end
return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">CatchServer</string>
      </Properties>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- The server is the only authority for rounds, movement intent, inventory and rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
Players.CharacterAutoLoads = false
local shared = ReplicatedStorage:WaitForChild("CatchShared")
local Config = require(shared.Config)
local Catalog = require(shared.Catalog)
local Rules = require(shared.Rules)
local MapBuilder = require(script.Parent.World.MapBuilder)

local remotesFolder = Instance.new("Folder")
remotesFolder.Name = "CatchRemotes"
local remotes = {}
for _, name in ipairs({"State", "Action", "Profile", "Notice", "Query"}) do
	local remote = Instance.new(if name == "Query" then "RemoteFunction" else "RemoteEvent")
	remote.Name = name
	remote.Parent = remotesFolder
	remotes[name] = remote
end
local ctx = {Config=Config, Catalog=Catalog, Rules=Rules, Remotes=remotes, Services={}}
ctx.World = MapBuilder.Build()
for _, name in ipairs({"DataService", "CosmeticService", "ShopService", "MovementService", "RoundService"}) do
	ctx.Services[name] = require(script.Parent.Services[name]).new(ctx)
end

local limits = {
	Sprint={capacity=6,refill=4}, Slide={capacity=3,refill=1}, Vault={capacity=5,refill=3},
	Tag={capacity=5,refill=4}, Equip={capacity=4,refill=2}, Buy={capacity=2,refill=0.5},
	ClaimQuest={capacity=3,refill=1}, Settings={capacity=4,refill=2}, Emote={capacity=2,refill=0.5},
}
local buckets = {}
local queryTimes = {}
local function allow(player, action)
	local rule = limits[action]
	if not rule then return false end
	local byPlayer = buckets[player]
	if not byPlayer then byPlayer = {}; buckets[player] = byPlayer end
	local now = os.clock()
	local bucket = byPlayer[action] or {tokens=rule.capacity,time=now}
	byPlayer[action] = bucket
	bucket.tokens = math.min(rule.capacity, bucket.tokens + (now-bucket.time)*rule.refill)
	bucket.time = now
	if bucket.tokens < 1 then return false end
	bucket.tokens -= 1
	return true
end
local function validPayload(payload)
	if type(payload) ~= "table" then return false end
	local count = 0
	for key, value in pairs(payload) do
		count += 1
		if count > 8 or type(key) ~= "string" or #key > 30 then return false end
		if type(value) == "string" then
			if #value > 80 then return false end
		elseif type(value) ~= "boolean" then return false end
	end
	return true
end
local function dispatch(player, action, payload)
	if type(action) ~= "string" or #action > 20 or not allow(player, action) then return end
	payload = payload or {}
	if not validPayload(payload) or not ctx.Services.DataService:Ready(player) then return end
	if action == "Sprint" or action == "Slide" or action == "Vault" then
		ctx.Services.MovementService:Handle(player, action, payload)
	elseif action == "Tag" then
		ctx.Services.RoundService:TryTag(player)
	elseif action == "Equip" then
		if type(payload.category)=="string" and type(payload.id)=="string" then ctx.Services.DataService:Equip(player,payload.category,payload.id) end
	elseif action == "Buy" then
		if type(payload.id)=="string" then ctx.Services.ShopService:Purchase(player,payload.id) end
	elseif action == "ClaimQuest" then
		if type(payload.id)=="string" then ctx.Services.DataService:ClaimQuest(player,payload.id) end
	elseif action == "Settings" then
		ctx.Services.DataService:UpdateSettings(player, payload)
	elseif action == "Emote" then
		if type(payload.id)=="string" then ctx.Services.CosmeticService:Emote(player,payload.id) end
	end
end
remotes.Action.OnServerEvent:Connect(function(player, action, payload)
	local ok, err = pcall(dispatch, player, action, payload)
	if not ok then warn("[Catch] Action failed:", action, err) end
end)
remotes.Query.OnServerInvoke = function(player)
	local now = os.clock()
	if queryTimes[player] and now-queryTimes[player] < 0.75 then return nil end
	queryTimes[player] = now
	return {state=ctx.Services.RoundService:Snapshot(),profile=ctx.Services.DataService:Snapshot(player)}
end
Players.PlayerRemoving:Connect(function(player) buckets[player]=nil; queryTimes[player]=nil end)
for _, name in ipairs({"DataService", "CosmeticService", "ShopService", "MovementService", "RoundService"}) do
	local service = ctx.Services[name]
	if service.Start then service:Start() end
end
-- Publish only after handlers and service state are initialized.
remotesFolder.Parent = ReplicatedStorage
print("[Catch] Neon Heights initialized. " .. Config.Version)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Appearance = require(ReplicatedStorage:WaitForChild("CatchShared"):WaitForChild("Appearance"))

local CosmeticService = {}
CosmeticService.__index = CosmeticService

local plateStyles = {
	name_rookie = {label="CITY NEWCOMER",color=Color3.fromRGB(160,189,210)},
	name_survivor = {label="UNTOUCHABLE",color=Color3.fromRGB(73,227,204)},
	name_legend = {label="SKYLINE LEGEND",color=Color3.fromRGB(244,194,88)},
}

local function text(parent, name, value, size, position, color, bold)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size, label.Position = size,position
	label.Text = value
	label.FontFace = Font.fromEnum(bold and Enum.Font.GothamBold or Enum.Font.GothamMedium)
	label.TextSize = bold and 15 or 10
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.fromRGB(12,17,28)
	label.TextStrokeTransparency = 0.35
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = parent
	return label
end

local function nameplate(folder, rig, displayName, plateId, title)
	local head = rig:FindFirstChild("Head")
	if not head then return end
	local style = plateStyles[plateId] or plateStyles.name_rookie
	local gui = Instance.new("BillboardGui")
	gui.Name = "CatchNameplate"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(190,45)
	gui.StudsOffset = Vector3.new(0,1.45,0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 70
	gui.Parent = folder
	text(gui,"Identity",displayName,UDim2.fromScale(1,0.58),UDim2.fromScale(0,0),Color3.fromRGB(245,246,255),true)
	if title or plateId ~= "" then
		text(gui,"Title",title or style.label,UDim2.fromScale(1,0.42),UDim2.fromScale(0,0.58),style.color,false)
	end
end

local function ownedEquipment(ctx, profile)
	local result = {}
	for category, fallback in pairs(ctx.Catalog.DefaultEquipment) do
		local id = profile.equipped and profile.equipped[category] or fallback
		local item = ctx.Catalog.Get(id)
		if id == "" then
			result[category] = ""
		elseif item and item.category == category and profile.owned and profile.owned[id] then
			result[category] = id
		else
			result[category] = fallback
		end
	end
	return result
end

function CosmeticService.new(ctx)
	return setmetatable({ctx=ctx, connections={}, playerConnections={}, emotes={}, lastEmote={}, podiums=nil, podiumSpin=nil},CosmeticService)
end

function CosmeticService:Apply(player)
	local data = self.ctx.Services.DataService
	local profile = data and data:Get(player)
	local rig = player.Character
	if not profile or not rig or not rig:FindFirstChild("HumanoidRootPart") then return false end
	local equipped = ownedEquipment(self.ctx,profile)
	local folder = Appearance.Apply(rig,equipped.skins,equipped.masks,equipped)
	if not folder then return false end
	nameplate(folder,rig,player.DisplayName,equipped.nameplates)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	return true
end

function CosmeticService:Preview(rig, skinId, maskId, extra)
	return Appearance.Apply(rig,skinId,maskId,extra)
end

function CosmeticService:TagEffect(hunter, target)
	local profile = self.ctx.Services.DataService:Get(hunter)
	local rig = target and (target:IsA("Player") and target.Character or target)
	local root = rig and rig:FindFirstChild("HumanoidRootPart")
	if not profile or not root then return end
	local equipped = ownedEquipment(self.ctx,profile)
	self.ctx.Remotes.Notice:FireAllClients({kind="tag",position=root.Position,userId=hunter.UserId,
		victimUserId=target:IsA("Player") and target.UserId or nil,action=equipped.tagEffects or "tag_spark"})
end

function CosmeticService:_stopEmote(player)
	local current = self.emotes[player]
	if not current then return end
	self.emotes[player] = nil
	if current.connection then current.connection:Disconnect() end
	for motor,original in pairs(current.motors) do
		if motor.Parent then motor.C0 = original end
	end
	if current.character.Parent then current.character:SetAttribute("CatchEmoting",false) end
end

function CosmeticService:_canEmote(player)
	local round = self.ctx.Services.RoundService
	if not round then return false end
	local phase = round:Snapshot().phase
	if phase ~= "Waiting" and phase ~= "Intermission" and phase ~= "Results" then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid ~= nil and humanoid.Health > 0 and root ~= nil
end

function CosmeticService:Emote(player, id)
	if type(id) ~= "string" or (id ~= "emote_wave" and id ~= "emote_dance") then return false end
	local profile = self.ctx.Services.DataService:Get(player)
	if not profile or not profile.owned[id] or profile.equipped.emotes ~= id then return false end
	if not self:_canEmote(player) then
		self.ctx.Remotes.Notice:FireClient(player,{kind="toast",text="Emotes are available in the lobby and on the results screen."})
		return false
	end
	local now = os.clock()
	if now-(self.lastEmote[player] or -10) < 2 then return false end
	self.lastEmote[player] = now
	self:_stopEmote(player)
	local character = player.Character
	local motors = {}
	local named = {}
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("Motor6D") and (descendant.Name == "RightShoulder" or descendant.Name == "LeftShoulder" or descendant.Name == "Waist") then
			motors[descendant] = descendant.C0
			named[descendant.Name] = descendant
		end
	end
	local current = {character=character,motors=motors,connection=nil}
	self.emotes[player] = current
	character:SetAttribute("CatchEmoting",true)
	local duration = id == "emote_wave" and 3.4 or 5.0
	current.connection = RunService.Heartbeat:Connect(function()
		local elapsed = os.clock()-now
		local root = character:FindFirstChild("HumanoidRootPart")
		if self.emotes[player] ~= current or player.Character ~= character or not root or elapsed > duration or not self:_canEmote(player)
			or Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude > 4 then
			self:_stopEmote(player)
			return
		end
		local weight = math.min(1,elapsed/0.20,(duration-elapsed)/0.25)
		local wave = math.sin(elapsed*10)
		if named.RightShoulder then
			local pose = id=="emote_wave" and CFrame.Angles(math.rad(-20),0,math.rad(135+wave*18))
				or CFrame.Angles(math.rad(-25+math.sin(elapsed*6)*20),0,math.rad(65+wave*18))
			named.RightShoulder.C0 = motors[named.RightShoulder] * CFrame.new():Lerp(pose,weight)
		end
		if id=="emote_dance" then
			if named.LeftShoulder then named.LeftShoulder.C0 = motors[named.LeftShoulder] * CFrame.Angles(math.rad(-25-math.sin(elapsed*6)*20)*weight,0,math.rad(-65+wave*18)*weight) end
			if named.Waist then named.Waist.C0 = motors[named.Waist] * CFrame.Angles(0,math.sin(elapsed*6)*0.20*weight,math.sin(elapsed*6)*0.10*weight) end
		end
	end)
	return true
end

function CosmeticService:ShowWinners(players)
	if self.podiumSpin then self.podiumSpin:Disconnect(); self.podiumSpin=nil end
	if self.podiums then self.podiums:Destroy(); self.podiums=nil end
	if type(players) ~= "table" or #players == 0 then return end
	local positions = self.ctx.World and self.ctx.World.Podiums
	if not positions or #positions == 0 then return end
	local folder = Instance.new("Folder")
	folder.Name = "CatchWinnerShowcase"
	folder.Parent = workspace
	self.podiums = folder
	local showcases = {}
	for index=1,math.min(#players,#positions) do
		local player = players[index]
		local profile = self.ctx.Services.DataService:Get(player)
		if profile then
			local equipped = ownedEquipment(self.ctx,profile)
			local rig = Appearance.BuildPreview(equipped.skins,equipped.masks,equipped)
			rig.Name = "Winner_"..tostring(player.UserId)
			rig.Parent = folder
			rig:PivotTo(positions[index])
			nameplate(rig.CatchAppearance,rig,player.DisplayName,equipped.nameplates,"CHASE CHAMPION")
			local animate = Appearance.CreatePreviewPose(rig,equipped.victories)
			if animate then
				animate(0)
				table.insert(showcases,{rig=rig,origin=positions[index],spin=equipped.victories=="victory_spin",animate=animate})
			end
		end
	end
	if #showcases > 0 then
		local began = os.clock()
		self.podiumSpin = RunService.Heartbeat:Connect(function()
			if not folder.Parent then
				if self.podiumSpin then self.podiumSpin:Disconnect(); self.podiumSpin=nil end
				return
			end
			local elapsed = os.clock()-began
			for _, item in ipairs(showcases) do
				if item.rig.Parent then
					if item.spin then item.rig:PivotTo(item.origin*CFrame.Angles(0,elapsed*0.7,0)) end
					item.animate(elapsed)
				end
			end
		end)
	end
end

function CosmeticService:_watchPlayer(player)
	if self.playerConnections[player] then return end
	local function applyWhenReady(character)
		task.spawn(function()
			if not character:WaitForChild("HumanoidRootPart",10) then return end
			local deadline = os.clock()+20
			while player.Parent and player.Character==character and os.clock()<deadline do
				if self:Apply(player) then return end
				task.wait(0.25)
			end
		end)
	end
	self.playerConnections[player] = {
		player.CharacterAdded:Connect(function(character) self:_stopEmote(player); applyWhenReady(character) end),
		player.CharacterAppearanceLoaded:Connect(function(character)
			if player.Character == character then self:Apply(player) end
		end),
		player.CharacterRemoving:Connect(function() self:_stopEmote(player) end),
	}
	if player.Character then applyWhenReady(player.Character) end
end

function CosmeticService:_updateTrails()
	for _, player in ipairs(Players:GetPlayers()) do
		local rig = player.Character
		local root = rig and rig:FindFirstChild("HumanoidRootPart")
		local folder = rig and rig:FindFirstChild("CatchAppearance")
		if root and folder then
			local enabled = rig:GetAttribute("Sprinting") == true and root.AssemblyLinearVelocity.Magnitude > 3
			for _, effect in ipairs(folder:GetChildren()) do
				if effect:IsA("Trail") and effect.Enabled ~= enabled then effect.Enabled = enabled end
			end
		end
	end
end

function CosmeticService:Start()
	if self.started then return end
	self.started = true
	local elapsed = 0
	table.insert(self.connections, RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.15 then elapsed = 0; self:_updateTrails() end
	end))
	table.insert(self.connections,Players.PlayerAdded:Connect(function(player) self:_watchPlayer(player) end))
	table.insert(self.connections,Players.PlayerRemoving:Connect(function(player)
		self:_stopEmote(player)
		for _, connection in ipairs(self.playerConnections[player] or {}) do connection:Disconnect() end
		self.playerConnections[player] = nil
		self.lastEmote[player] = nil
	end))
	for _, player in ipairs(Players:GetPlayers()) do self:_watchPlayer(player) end
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Server-owned profiles. Every persistent write holds a renewable UpdateAsync lease.
-- Gameplay mutations never yield; saves take immutable snapshots and preserve newer edits.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local DataService = {}
DataService.__index = DataService

local FORMAT = "CatchMeIfYouCan.profile.v1"
local MAX_COUNTER = 1000000000
local ACHIEVEMENTS = {
	{ id = "first_round", name = "First chase", stat = "rounds", goal = 1 },
	{ id = "first_win", name = "First victory", stat = "wins", goal = 1 },
	{ id = "tag_10", name = "Tracker", stat = "tags", goal = 10 },
	{ id = "survivor_600", name = "Untouchable", stat = "survived", goal = 600 },
	{ id = "veteran_25", name = "City regular", stat = "rounds", goal = 25 },
	{ id = "streak_3", name = "On a roll", stat = "bestStreak", goal = 3 },
}

local function clone(value)
	if type(value) ~= "table" then return value end
	local copy = {}
	for key, child in pairs(value) do copy[key] = clone(child) end
	return copy
end

local function number(value, minimum, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return minimum end
	return math.clamp(math.floor(value), minimum, maximum)
end

local function add(value, amount)
	return number(value + amount, 0, MAX_COUNTER)
end

-- A future schema, malformed record, or unknown envelope is never replaced with defaults.
local function decode(raw)
	if raw == nil then return nil, nil end
	if type(raw) ~= "table" then return nil, "unsupported" end
	if raw._format == FORMAT then
		if type(raw.profile) ~= "table" or raw.profile.schemaVersion ~= 1 or type(raw.profile.stats) ~= "table"
			or type(raw.profile.owned) ~= "table" or type(raw.profile.equipped) ~= "table" then return nil, "unsupported" end
		if raw.session ~= nil then
			if type(raw.session) ~= "table" or type(raw.session.id) ~= "string"
				or type(raw.session.expiresAt) ~= "number" or raw.session.expiresAt ~= raw.session.expiresAt
				or math.abs(raw.session.expiresAt) == math.huge then return nil, "unsupported" end
		end
		return raw, nil
	end
	-- Supports the documented initial flat schema without accepting unrelated tables.
	if raw._format == nil and raw.schemaVersion == 1 and type(raw.stats) == "table"
		and type(raw.owned) == "table" and type(raw.equipped) == "table" then
		return { _format = FORMAT, profile = raw }, nil
	end
	return nil, "unsupported"
end

function DataService.new(ctx)
	local self = setmetatable({}, DataService)
	self.ctx = ctx
	self.records = {}
	self.sessionId = (game.JobId ~= "" and game.JobId or "studio") .. ":" .. HttpService:GenerateGUID(false)
	self.config = ctx.Config.Persistence
	self.sessionOnly = RunService:IsStudio() and self.config.UseStudioDataStores ~= true
	self.closing = false
	self.activeLoads = 0
	if not self.sessionOnly then
		local ok, store = pcall(function() return DataStoreService:GetDataStore(self.config.StoreName) end)
		if ok then self.store = store end
	end
	return self
end

function DataService:_Notice(player, text, kind)
	if player.Parent == Players then self.ctx.Remotes.Notice:FireClient(player, { kind = kind or "toast", text = text }) end
end

function DataService:_Sanitize(raw)
	local profile = self.ctx.Rules.NormalizeProfile(raw, os.time())
	for id in pairs(profile.owned) do
		if not self.ctx.Catalog.Get(id) then profile.owned[id] = nil end
	end
	for id in pairs(self.ctx.Catalog.DefaultOwned()) do profile.owned[id] = true end
	for category, id in pairs(profile.equipped) do
		local item = self.ctx.Catalog.Get(id)
		if not self.ctx.Catalog.IsEquippable(category) then
			profile.equipped[category] = nil
		elseif id ~= "" and (not item or item.category ~= category or not profile.owned[id]) then
			profile.equipped[category] = self.ctx.Catalog.DefaultEquipment[category] or ""
		end
	end
	return profile
end

function DataService:_Dirty(record)
	record.revision += 1
	if record.writable then record.saveMessage = "Changes pending autosave." end
end

function DataService:_RollDay(record)
	local day = self.ctx.Rules.DayKey(os.time())
	if record.profile.daily.day ~= day then
		record.profile.daily = { day = day, progress = { rounds = 0, tags = 0, survived = 0 }, claimed = {} }
		self:_Dirty(record)
	end
end

function DataService:_Leaderboard(player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then folder = Instance.new("Folder"); folder.Name = "leaderstats"; folder.Parent = player end
	local values = { Level = profile.level, Wins = profile.stats.wins, Tags = profile.stats.tags, Rating = profile.rating }
	for name, value in pairs(values) do
		local stat = folder:FindFirstChild(name)
		if not stat then stat = Instance.new("IntValue"); stat.Name = name; stat.Parent = folder end
		if stat:IsA("IntValue") then stat.Value = value end
	end
end

function DataService:_Unlocks(record, notify)
	local profile = record.profile
	local changed = false
	for _, definition in ipairs(ACHIEVEMENTS) do
		local progress = profile.stats[definition.stat] or profile[definition.stat] or 0
		if progress >= definition.goal and not profile.achievements[definition.id] then
			profile.achievements[definition.id] = true
			changed = true
			if notify then self:_Notice(record.player, "Achievement: " .. definition.name, "unlock") end
		end
	end
	for id, item in pairs(self.ctx.Catalog.Items) do
		local milestone = item.milestone
		if milestone and not profile.owned[id] then
			local progress = profile.stats[milestone.stat] or profile[milestone.stat] or 0
			if progress >= milestone.value then
				profile.owned[id] = true
				for _, grantedId in ipairs(item.grants or {}) do
					if self.ctx.Catalog.Get(grantedId) then profile.owned[grantedId] = true end
				end
				changed = true
				if notify then self:_Notice(record.player, "Unlocked " .. item.name, "unlock") end
			end
		end
	end
	if changed then self:_Dirty(record) end
end

function DataService:_Load(player)
	if self.records[player] or self.closing then return end
	local record = {
		player = player, loaded = false, accepting = true, departed = false, writable = false,
		revision = 0, savedRevision = 0, awarded = {}, receipts = {}, saving = false,
		persistence = self.sessionOnly and "session" or "unavailable",
		lockId = self.sessionId .. ":" .. HttpService:GenerateGUID(false), writeSequence = 0,
	}
	self.records[player] = record
	self.activeLoads += 1
	local loadedProfile, receiptList
	local failure = "unavailable"
	if self.store then
		for attempt = 1, number(self.config.Retries or 3, 1, 5) do
			if self.closing or record.departed then break end
			local denied
			local ok, result = pcall(function()
				return self.store:UpdateAsync("player_" .. player.UserId, function(raw)
					denied = nil
					local current, decodeError = decode(raw)
					if decodeError then denied = decodeError; return nil end
					local now = os.time()
					if current and current.session and current.session.id ~= record.lockId
						and current.session.expiresAt > now then denied = "locked"; return nil end
					local profile = self:_Sanitize(current and current.profile or self.ctx.Rules.NewProfile(now))
					local receipts = {}
					for _, receipt in ipairs(current and type(current.receipts) == "table" and current.receipts or {}) do
						if type(receipt) == "string" and #receipt <= 160 and #receipts < 40 then table.insert(receipts, receipt) end
					end
					return {
						_format = FORMAT, profile = profile, receipts = receipts, updatedAt = now,
						session = { id = record.lockId, expiresAt = now + number(self.config.SessionLockSeconds or 180, 90, 600) },
					}
				end)
			end)
			if ok and result and not denied then
				loadedProfile, receiptList = result.profile, result.receipts
				record.writable = true
				record.persistence = "saved"
				record.saveMessage = "Saved."
				break
			end
			failure = denied or "unavailable"
			if denied then break end
			if attempt < number(self.config.Retries or 3, 1, 5) then task.wait(2 ^ (attempt - 1)) end
		end
	end
	if not loadedProfile then
		loadedProfile = self.ctx.Rules.NewProfile(os.time())
		if self.sessionOnly then
			record.saveMessage = "Studio session only. Progress resets when this test ends."
		elseif failure == "locked" then
			record.saveMessage = "Your profile is active on another server. This session will not save; rejoin after leaving that server."
		elseif failure == "unsupported" then
			record.saveMessage = "Stored data needs a newer compatible server. Existing data is protected; this session will not save."
		else
			record.saveMessage = "Data storage is unavailable. This session will not save; rejoin to retry loading."
		end
	end
	record.profile = self:_Sanitize(loadedProfile)
	record.receipts = receiptList or {}
	for _, receipt in ipairs(record.receipts) do record.awarded[receipt] = true end
	record.loaded = true
	self:_RollDay(record)
	self:_Unlocks(record, false)
	if record.departed or self.closing or player.Parent ~= Players then
		record.accepting = false
		self:_SaveRecord(record, true)
		if self.records[player] == record then self.records[player] = nil end
		-- BindToClose must keep waiting while a load that finished during shutdown
		-- is still saving and releasing its newly acquired lease.
		self.activeLoads -= 1
		return
	end
	self.activeLoads -= 1
	self:_Leaderboard(player, record.profile)
	player:SetAttribute("DataReady", true)
	self:Send(player)
	if record.persistence ~= "saved" then self:_Notice(player, record.saveMessage) end
	local cosmeticService = self.ctx.Services.CosmeticService
	if cosmeticService and player.Character then task.defer(function() cosmeticService:Apply(player) end) end
end

function DataService:Get(player)
	local record = self.records[player]
	return record and record.loaded and record.profile or nil
end

function DataService:Ready(player)
	local record = self.records[player]
	return record ~= nil and record.loaded and record.accepting and not self.closing
end

function DataService:Snapshot(player)
	local record = self.records[player]
	if not record or not record.loaded then return { loaded = false, persistence = "unavailable", saveMessage = "Loading profile…" } end
	self:_RollDay(record)
	local snapshot = clone(record.profile)
	snapshot.loaded = true
	snapshot.persistence = record.persistence
	snapshot.saveMessage = record.saveMessage
	snapshot.rank = self.ctx.Rules.Rank(snapshot.rating)
	snapshot.quests = {}
	for _, quest in ipairs(self.ctx.Rules.DailyQuests(snapshot.daily.day)) do
		table.insert(snapshot.quests, {
			id = quest.id, text = quest.text, progress = self.ctx.Rules.QuestProgress(snapshot, quest), goal = quest.goal,
			claimed = snapshot.daily.claimed[quest.id] == true, xp = quest.xp, coins = quest.coins,
		})
	end
	return snapshot
end

function DataService:Send(player)
	if player.Parent == Players then self.ctx.Remotes.Profile:FireClient(player, self:Snapshot(player)) end
end

function DataService:_AfterProgress(record, previousLevel)
	local profile = record.profile
	profile.level = self.ctx.Rules.LevelFromXP(profile.xp)
	self:_Unlocks(record, true)
	self:_Leaderboard(record.player, profile)
	self:Send(record.player)
	if profile.level > previousLevel then self:_Notice(record.player, "Level " .. profile.level .. " reached!", "level") end
end

function DataService:AwardRound(player, summary)
	if not self:Ready(player) or type(summary) ~= "table" or summary.practice == true then return false, "No progression in practice." end
	if (summary.role ~= "Hunter" and summary.role ~= "Runner") or type(summary.win) ~= "boolean"
		or type(summary.roundId) ~= "number" or summary.roundId ~= number(summary.roundId, 1, MAX_COUNTER) then return false, "Invalid round." end
	local record = self.records[player]
	local receipt = self.sessionId .. ":" .. tostring(summary.roundId)
	if record.awarded[receipt] then return false, "Round already rewarded." end
	local safe = {
		role = summary.role, win = summary.win, practice = false, roundId = summary.roundId,
		tags = summary.role == "Hunter" and number(summary.tags, 0, self.ctx.Config.Round.MaxPlayers) or 0,
		survived = summary.role == "Runner" and number(summary.survived, 0, self.ctx.Config.Round.Duration) or 0,
	}
	local reward = self.ctx.Rules.RoundReward(safe, self.ctx.Config)
	-- Record receipt before changing balances; this section contains no yielding calls.
	record.awarded[receipt] = true
	table.insert(record.receipts, receipt)
	if #record.receipts > 40 then table.remove(record.receipts, 1) end
	self:_RollDay(record)
	local profile, previousLevel = record.profile, record.profile.level
	profile.coins = add(profile.coins, number(reward.coins, 0, MAX_COUNTER))
	profile.xp = add(profile.xp, number(reward.xp, 0, MAX_COUNTER))
	profile.rating = number(profile.rating + number(reward.rating, -1000, 1000), 0, MAX_COUNTER)
	profile.stats.rounds = add(profile.stats.rounds, 1)
	profile.stats.tags = add(profile.stats.tags, safe.tags)
	profile.stats.survived = add(profile.stats.survived, safe.survived)
	profile.daily.progress.rounds = add(profile.daily.progress.rounds, 1)
	profile.daily.progress.tags = add(profile.daily.progress.tags, safe.tags)
	profile.daily.progress.survived = add(profile.daily.progress.survived, safe.survived)
	if safe.win then
		profile.stats.wins = add(profile.stats.wins, 1)
		local stat = safe.role == "Hunter" and "hunterWins" or "runnerWins"
		profile.stats[stat] = add(profile.stats[stat], 1)
		profile.streak = add(profile.streak, 1)
		profile.bestStreak = math.max(profile.bestStreak, profile.streak)
	else profile.streak = 0 end
	self:_Dirty(record)
	self:_AfterProgress(record, previousLevel)
	task.defer(function() self:Save(player) end)
	return true
end

function DataService:Grant(player, ids, source)
	if not self:Ready(player) then return false, "Profile is not ready." end
	if type(ids) ~= "table" then return false, "Invalid grant." end
	local record = self.records[player]
	local changed = false
	for _, id in ipairs(ids) do
		local item = type(id) == "string" and self.ctx.Catalog.Get(id)
		if item then
			if not record.profile.owned[id] then record.profile.owned[id] = true; changed = true end
			for _, grantedId in ipairs(item.grants or {}) do
				if self.ctx.Catalog.Get(grantedId) and not record.profile.owned[grantedId] then
					record.profile.owned[grantedId] = true; changed = true
				end
			end
		end
	end
	if changed then
		self:_Dirty(record)
		self:Send(player)
		if source then self:_Notice(player, source, "unlock") end
		task.defer(function() self:Save(player) end)
	end
	return true, changed and "Granted." or "Already owned."
end

function DataService:_PurchaseWithCoins(player, id)
	if not self:Ready(player) then return false, "Profile is not ready." end
	local item = self.ctx.Catalog.Get(id)
	if not item or item.currency ~= "Coins" or type(item.price) ~= "number"
		or item.price ~= number(item.price, 0, MAX_COUNTER) then return false, "Item cannot be purchased with coins." end
	local record = self.records[player]
	local profile = record.profile
	if profile.owned[id] then return false, "You already own this cosmetic." end
	if profile.coins < item.price then return false, "You need " .. (item.price - profile.coins) .. " more coins." end
	-- Debit and ownership are one non-yielding transaction. Never trust a client price.
	profile.coins -= item.price
	profile.owned[id] = true
	for _, grantedId in ipairs(item.grants or {}) do
		if self.ctx.Catalog.Get(grantedId) then profile.owned[grantedId] = true end
	end
	self:_Dirty(record)
	self:Send(player)
	task.defer(function() self:Save(player) end)
	local suffix = record.writable and " Saving progress…" or " Session only; progress will not save."
	return true, "Purchased " .. item.name .. "." .. suffix
end

function DataService:Equip(player, category, id)
	if not self:Ready(player) then return false, "Profile is not ready." end
	if type(category) ~= "string" or type(id) ~= "string" or not self.ctx.Catalog.IsEquippable(category) then return false, "Invalid equipment slot." end
	if category == "skins" and id == "" then id = self.ctx.Catalog.DefaultEquipment.skins end
	local record = self.records[player]
	if id ~= "" then
		local item = self.ctx.Catalog.Get(id)
		if not item or item.category ~= category or not record.profile.owned[id] then return false, "You do not own that cosmetic." end
	end
	if record.profile.equipped[category] == id then return true end
	record.profile.equipped[category] = id
	self:_Dirty(record)
	self:Send(player)
	local cosmetics = self.ctx.Services.CosmeticService
	if cosmetics then cosmetics:Apply(player) end
	return true
end

function DataService:UpdateSettings(player, settings)
	if not self:Ready(player) or type(settings) ~= "table" then return false, "Profile is not ready." end
	local record = self.records[player]
	local changed = false
	for _, key in ipairs({ "music", "sfx", "reducedMotion", "cameraShake" }) do
		if type(settings[key]) == "boolean" and record.profile.settings[key] ~= settings[key] then
			record.profile.settings[key] = settings[key]; changed = true
		end
	end
	if changed then self:_Dirty(record); self:Send(player) end
	return true
end

function DataService:ClaimQuest(player, id)
	if not self:Ready(player) or type(id) ~= "string" then return false, "Profile is not ready." end
	local record = self.records[player]
	self:_RollDay(record)
	local profile = record.profile
	for _, quest in ipairs(self.ctx.Rules.DailyQuests(profile.daily.day)) do
		if quest.id == id then
			if profile.daily.claimed[id] then return false, "Reward already claimed." end
			if self.ctx.Rules.QuestProgress(profile, quest) < quest.goal then return false, "Quest is still in progress." end
			local previousLevel = profile.level
			profile.daily.claimed[id] = true
			profile.coins = add(profile.coins, quest.coins)
			profile.xp = add(profile.xp, quest.xp)
			self:_Dirty(record)
			self:_AfterProgress(record, previousLevel)
			self:_Notice(player, "Quest claimed: +" .. quest.coins .. " coins · +" .. quest.xp .. " XP", "unlock")
			task.defer(function() self:Save(player) end)
			return true
		end
	end
	return false, "Unknown quest."
end

function DataService:_SaveRecord(record, release)
	if not record.loaded or not record.writable or not self.store then return false, record.saveMessage end
	-- Concurrent autosave, reward, leave, and shutdown requests share this single writer.
	while record.saving do task.wait(0.05) end
	if not record.writable or record.released then return false, record.saveMessage end
	record.saving = true
	record.writeSequence += 1
	local writeId = record.lockId .. ":" .. record.writeSequence
	local revision = record.revision
	local snapshot = self:_Sanitize(clone(record.profile))
	local receipts = clone(record.receipts)
	local succeeded = false
	local denied
	for attempt = 1, number(self.config.Retries or 3, 1, 5) do
		local alreadyCommitted = false
		local ok, result = pcall(function()
			return self.store:UpdateAsync("player_" .. record.player.UserId, function(raw)
				denied = nil
				local current, decodeError = decode(raw)
				if decodeError then denied = decodeError; return nil end
				-- A response can be lost after a commit. Releasing twice must not look like
				-- a lost lease or cause a second write, even if the first response timed out.
				if current and current.lastWriteId == writeId then alreadyCommitted = true; return nil end
				if not current or not current.session or current.session.id ~= record.lockId then denied = "lease"; return nil end
				local now = os.time()
				return {
					_format = FORMAT, profile = snapshot, receipts = receipts, updatedAt = now, lastWriteId = writeId,
					session = not release and { id = record.lockId, expiresAt = now + number(self.config.SessionLockSeconds or 180, 90, 600) } or nil,
				}
			end)
		end)
		if ok and (result or alreadyCommitted) and not denied then succeeded = true; break end
		if denied then break end
		if attempt < number(self.config.Retries or 3, 1, 5) then task.wait(2 ^ (attempt - 1)) end
	end
	if succeeded then
		record.savedRevision = math.max(record.savedRevision, revision)
		record.persistence = "saved"
		record.saveMessage = record.revision == revision and "Saved." or "Changes pending autosave."
		if release then record.released = true; record.writable = false end
	else
		record.persistence = "unavailable"
		if denied then
			record.writable = false
			record.saveMessage = "Profile access changed on the server. Further changes will not save; rejoin to reload safely."
		else record.saveMessage = "Saving failed. Your latest changes are not saved; the server will retry." end
	end
	record.saving = false
	if not record.departed and not self.closing then self:Send(record.player) end
	return succeeded, record.saveMessage
end

function DataService:Save(player)
	local record = self.records[player]
	if not record then return false, "Profile is not loaded." end
	return self:_SaveRecord(record, false)
end

function DataService:Start()
	if self.started then return end
	self.started = true
	Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_Load(player) end) end)
	Players.PlayerRemoving:Connect(function(player)
		local record = self.records[player]
		if not record then return end
		record.departed = true
		record.accepting = false
		if record.loaded then
			self:_SaveRecord(record, true)
			if self.records[player] == record then self.records[player] = nil end
		end
	end)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() self:_Load(player) end) end
	task.spawn(function()
		local interval = math.min(number(self.config.AutosaveSeconds or 60, 15, 120), number(self.config.SessionLockSeconds or 180, 90, 600) / 3)
		while not self.closing do
			task.wait(interval)
			if self.closing then break end
			for _, record in pairs(self.records) do
				if record.loaded and not record.departed then task.spawn(function() self:_SaveRecord(record, false) end) end
			end
		end
	end)
	game:BindToClose(function()
		self.closing = true
		local waiting = 0
		for _, record in pairs(self.records) do
			record.accepting = false
			if record.loaded then
				waiting += 1
				task.spawn(function() self:_SaveRecord(record, true); waiting -= 1 end)
			end
		end
		local deadline = os.clock() + 25
		while (waiting > 0 or self.activeLoads > 0) and os.clock() < deadline do task.wait(0.1) end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[-- Clients send intentions only. The server chooses speed, geometry, and cooldowns.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MovementService = {}
MovementService.__index = MovementService

local function now()
	return Workspace:GetServerTimeNow()
end

local function horizontal(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function finiteVector(vector)
	return vector.X == vector.X and vector.Y == vector.Y and vector.Z == vector.Z
		and math.abs(vector.X) < 1e7 and math.abs(vector.Y) < 1e7 and math.abs(vector.Z) < 1e7
end

local function avatar(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root then
		return character, humanoid, root
	end
	return nil
end

local function rayParameters(character)
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.RespectCanCollide = true
	return parameters
end

function MovementService.new(ctx)
	return setmetatable({ ctx = ctx, states = {}, connections = {}, accumulator = 0 }, MovementService)
end

function MovementService:_state(player)
	local state = self.states[player]
	if not state then
		state = {
			sprint = false,
			slideUntil = 0,
			vaultUntil = 0,
			lastSlide = -math.huge,
			lastVault = -math.huge,
			modeId = 0,
			lastTime = now(),
			credit = 12,
		}
		self.states[player] = state
	end
	return state
end

function MovementService:_clearMotion(player, state)
	state.modeId += 1
	state.sprint = false
	state.slideUntil, state.vaultUntil = 0, 0
	local character = player.Character
	if character then
		character:SetAttribute("Sprinting", false)
		character:SetAttribute("Sliding", false)
		character:SetAttribute("Vaulting", false)
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.Anchored = character:GetAttribute("RoundFrozen") == true
			if not root.Anchored then
				pcall(function()
					root:SetNetworkOwnershipAuto()
				end)
			end
		end
	end
end

-- Only server code calls this immediately after its own spawn/teleport.
function MovementService:ResetPlayer(player)
	local state = self:_state(player)
	self:_clearMotion(player, state)
	local character, humanoid, root = avatar(player)
	state.character = character
	state.lastTime = now()
	state.lastSlide, state.lastVault = -math.huge, -math.huge
	state.airStart = nil
	state.groundY = root and root.Position.Y or 0
	state.credit = self.ctx.Config.Movement.RunnerSprint * 0.4 + 3
	state.lastPosition = root and root.Position or nil
	state.safeCFrame = root and root.CFrame or nil
	state.rejectUntil = 0
	if character then
		local frozen = character:GetAttribute("RoundFrozen") == true
		humanoid.WalkSpeed = frozen and 0 or self.ctx.Config.Movement.WalkSpeed
		humanoid.JumpPower = frozen and 0 or self.ctx.Config.Movement.JumpPower
		humanoid.AutoRotate = not frozen
	end
end

function MovementService:_grounded(character, humanoid, root)
	local distance = humanoid.HipHeight + root.Size.Y * 0.5 + 1.25
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -distance, 0), rayParameters(character))
	return hit ~= nil and hit.Normal.Y > 0.3, hit
end

function MovementService:_climbing(character, humanoid, root)
	if humanoid:GetState() ~= Enum.HumanoidStateType.Climbing then
		return false
	end
	-- A client-owned Humanoid state alone must not authorize unlimited ascent.
	local parameters = OverlapParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	for _, part in ipairs(Workspace:GetPartBoundsInBox(root.CFrame, Vector3.new(6, 8, 6), parameters)) do
		if part:IsA("TrussPart") then
			return true
		end
	end
	return false
end

function MovementService:_allowedSpeed(player, state)
	local config = self.ctx.Config.Movement
	if state.slideUntil > now() then
		return config.SlideSpeed + 5
	end
	if state.sprint then
		return (self.ctx.Services.RoundService:GetRole(player) == "Hunter" and config.HunterSprint or config.RunnerSprint) + 5
	end
	return config.WalkSpeed + 5
end

function MovementService:_correct(player, state, root)
	if state.safeCFrame then
		root.CFrame = state.safeCFrame
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	state.lastPosition = root.Position
	state.lastTime = now()
	state.credit = 2
	state.rejectUntil = now() + 0.35
	state.airStart = nil
	state.groundY = root.Position.Y
	self:_clearMotion(player, state)
	return false
end

-- Called both by Heartbeat and immediately before every tag/range-sensitive intent.
function MovementService:ValidatePosition(player)
	local character, humanoid, root = avatar(player)
	if not character then
		return false
	end
	local state = self:_state(player)
	if state.character ~= character or not state.lastPosition then
		self:ResetPlayer(player)
		return false
	end
	local timestamp = now()
	if timestamp < (state.rejectUntil or 0) then
		return false
	end
	if not finiteVector(root.Position) or not finiteVector(root.AssemblyLinearVelocity) then
		return self:_correct(player, state, root)
	end
	-- A vault has a server-owned, anchored trajectory and a strict expiration.
	if state.vaultUntil > timestamp and root.Anchored then
		state.lastPosition, state.safeCFrame, state.lastTime = root.Position, root.CFrame, timestamp
		return true
	end
	local dt = math.max(timestamp - state.lastTime, 0)
	if dt < 0.015 then
		-- Do not mint extra distance allowance by spamming the Tag remote.
		return (root.Position - state.lastPosition).Magnitude <= 2
	end
	local speed = self:_allowedSpeed(player, state)
	state.credit = math.min(speed * 0.55 + 3, state.credit + speed * math.min(dt, 0.75))
	local difference = root.Position - state.lastPosition
	local horizontalDistance = horizontal(difference).Magnitude
	local climbing = self:_climbing(character, humanoid, root)
	-- A nearby ladder permits climbing, but not unbounded vertical travel. Charge
	-- its full path against the same server speed budget used on the ground.
	local traveled = climbing and difference.Magnitude or horizontalDistance
	if traveled > state.credit or math.abs(difference.Y) > 110 * math.min(dt, 0.75) + 8 then
		return self:_correct(player, state, root)
	end
	if horizontalDistance > 0.25 then
		local wall = Workspace:Raycast(state.lastPosition, difference, rayParameters(character))
		if wall and wall.Instance.Anchored and math.abs(wall.Normal.Y) < 0.65 then
			local model = wall.Instance:FindFirstAncestorOfClass("Model")
			if not model or not model:FindFirstChildOfClass("Humanoid") then
				return self:_correct(player, state, root)
			end
		end
	end
	local bounds = self.ctx.World.Bounds
	if bounds and (root.Position.X < bounds.min.X - 20 or root.Position.X > bounds.max.X + 20
		or root.Position.Z < bounds.min.Z - 20 or root.Position.Z > bounds.max.Z + 20
		or root.Position.Y > bounds.max.Y + 30) then
		-- Lobby can be intentionally outside the arena bounds.
		if self.ctx.Services.RoundService:IsActive(player) then
			return self:_correct(player, state, root)
		end
	end
	local grounded = self:_grounded(character, humanoid, root)
	if grounded or climbing then
		state.airStart = nil
		state.groundY = root.Position.Y
	else
		state.airStart = state.airStart or timestamp
		local jumpRise = (self.ctx.Config.Movement.JumpPower ^ 2) / (2 * math.max(Workspace.Gravity, 1)) + 7
		if root.Position.Y - (state.groundY or root.Position.Y) > jumpRise then
			return self:_correct(player, state, root)
		end
		-- Long descents are valid. Hovering beyond a full jump is not.
		if timestamp - state.airStart > 2.4 and root.AssemblyLinearVelocity.Y > -7 then
			return self:_correct(player, state, root)
		end
	end
	state.credit -= traveled
	state.lastPosition, state.lastTime = root.Position, timestamp
	-- Retain a grounded recovery point so a flight correction cannot bless a hover.
	if grounded or climbing then
		state.safeCFrame = root.CFrame
	end
	return true
end

function MovementService:_canMove(player)
	local character, humanoid, root = avatar(player)
	if not character or character:GetAttribute("RoundFrozen") or humanoid.Sit then
		return nil
	end
	if not self:ValidatePosition(player) then
		return nil
	end
	return character, humanoid, root
end

function MovementService:_ack(player, action, cooldown)
	self.ctx.Remotes.Notice:FireClient(player, { kind = "ability", action = action, cooldown = cooldown })
end

function MovementService:_slide(player)
	local character, humanoid, root = self:_canMove(player)
	if not character then
		return
	end
	local state, config = self:_state(player), self.ctx.Config.Movement
	local timestamp = now()
	if timestamp - state.lastSlide < config.SlideCooldown or state.vaultUntil > timestamp or state.slideUntil > timestamp then
		return
	end
	if not self:_grounded(character, humanoid, root) or (not state.sprint and horizontal(root.AssemblyLinearVelocity).Magnitude < 6) then
		return
	end
	local direction = horizontal(root.CFrame.LookVector)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	-- Do not propel a player into a wall or launch a slide through thin geometry.
	local wall = Workspace:Raycast(root.Position - Vector3.new(0, 0.8, 0), direction * 3, rayParameters(character))
	if wall and math.abs(wall.Normal.Y) < 0.65 then
		return
	end
	state.lastSlide, state.slideUntil = timestamp, timestamp + config.SlideDuration
	state.slideDirection = direction
	state.credit = math.max(state.credit, config.SlideSpeed * 0.25)
	character:SetAttribute("Sliding", true)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	self:_ack(player, "Slide", config.SlideCooldown)
end

function MovementService:_clearBox(character, cframe, size)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.RespectCanCollide = true
	for _, part in ipairs(Workspace:GetPartBoundsInBox(cframe, size, params)) do
		if part.CanCollide then
			return false
		end
	end
	return true
end

function MovementService:_vault(player)
	local character, humanoid, root = self:_canMove(player)
	if not character then
		return
	end
	local state, config = self:_state(player), self.ctx.Config.Movement
	local timestamp = now()
	if timestamp - state.lastVault < config.VaultCooldown or state.slideUntil > timestamp or state.vaultUntil > timestamp then
		return
	end
	-- Accept the beginning of a normal jump too: Space intentionally preserves Jump.
	local grounded = self:_grounded(character, humanoid, root)
	if not grounded and (not state.airStart or timestamp - state.airStart > 0.22) then
		return
	end
	local direction = horizontal(root.CFrame.LookVector)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	local params = rayParameters(character)
	local front = Workspace:Raycast(root.Position - Vector3.new(0, 1, 0), direction * config.VaultDistance, params)
	if not front or not front.Instance.Anchored or math.abs(front.Normal.Y) > 0.45 then
		return
	end
	local groundOffset = humanoid.HipHeight + root.Size.Y * 0.5
	local topOrigin = front.Position + direction * 0.7 + Vector3.new(0, config.VaultHeight + 1, 0)
	local top = Workspace:Raycast(topOrigin, Vector3.new(0, -config.VaultHeight - 2, 0), params)
	if not top or top.Normal.Y < 0.7 then
		return
	end
	local height = top.Position.Y - (root.Position.Y - groundOffset)
	if height < 0.5 or height > config.VaultHeight then
		return
	end
	local beyond = front.Position + direction * 3.2
	local landing = Workspace:Raycast(Vector3.new(beyond.X, top.Position.Y + 2, beyond.Z), Vector3.new(0, -9, 0), params)
	if not landing or landing.Normal.Y < 0.65 then
		return
	end
	local destination = Vector3.new(beyond.X, landing.Position.Y + groundOffset + 0.15, beyond.Z)
	if horizontal(destination - root.Position).Magnitude > config.VaultDistance + 3.5 then
		return
	end
	local elevatedY = math.max(root.Position.Y, destination.Y, top.Position.Y + groundOffset + 0.4)
	local elevatedStart = Vector3.new(root.Position.X, elevatedY, root.Position.Z)
	local elevatedEnd = Vector3.new(destination.X, elevatedY, destination.Z)
	local boxSize = Vector3.new(2.1, math.max(3, groundOffset * 2 - 0.5), 2.1)
	local facing = CFrame.lookAt(Vector3.zero, direction)
	local endCF = CFrame.new(destination) * facing
	if not self:_clearBox(character, endCF, boxSize)
		or not self:_clearBox(character, CFrame.new(elevatedStart) * facing, boxSize)
		or not self:_clearBox(character, CFrame.new(elevatedEnd) * facing, boxSize) then
		return
	end
	local elevatedStartCF = CFrame.new(elevatedStart) * facing
	local pathHit = Workspace:Blockcast(elevatedStartCF, boxSize, elevatedEnd - elevatedStart, params)
	local lift = elevatedStart - root.Position
	local ceiling = lift.Magnitude > 0.05 and Workspace:Blockcast(root.CFrame, boxSize, lift, params)
	if pathHit or ceiling then
		return
	end
	state.lastVault = timestamp
	state.vaultUntil = timestamp + 0.48
	state.modeId += 1
	local modeId = state.modeId
	character:SetAttribute("Vaulting", true)
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	local startPosition = root.Position
	self:_ack(player, "Vault", config.VaultCooldown)
	task.spawn(function()
		local duration = 0.4
		while now() - timestamp < duration do
			if player.Character ~= character or self.states[player] ~= state or state.modeId ~= modeId or humanoid.Health <= 0 then
				break
			end
			local alpha = math.clamp((now() - timestamp) / duration, 0, 1)
			local position
			if alpha < 0.28 then
				position = startPosition:Lerp(elevatedStart, alpha / 0.28)
			elseif alpha < 0.76 then
				position = elevatedStart:Lerp(elevatedEnd, (alpha - 0.28) / 0.48)
			else
				position = elevatedEnd:Lerp(destination, (alpha - 0.76) / 0.24)
			end
			root.CFrame = CFrame.new(position) * facing
			RunService.Heartbeat:Wait()
		end
		if self.states[player] == state and state.modeId == modeId and player.Character == character then
			if humanoid.Health > 0 then
				root.CFrame = endCF
			end
			root.Anchored = character:GetAttribute("RoundFrozen") == true
			root.AssemblyLinearVelocity = Vector3.zero
			state.vaultUntil = 0
			state.lastPosition, state.safeCFrame, state.lastTime = root.Position, root.CFrame, now()
			state.groundY, state.airStart = root.Position.Y, nil
			state.credit = config.WalkSpeed * 0.4 + 3
			character:SetAttribute("Vaulting", false)
			if not root.Anchored then
				pcall(function()
					root:SetNetworkOwnershipAuto()
				end)
			end
		end
	end)
end

function MovementService:Handle(player, action, payload)
	if action == "Sprint" then
		if type(payload) ~= "table" or type(payload.active) ~= "boolean" then
			return
		end
		local state = self:_state(player)
		if not payload.active then
			state.sprint = false
			if player.Character then
				player.Character:SetAttribute("Sprinting", false)
			end
			return
		end
		local character = self:_canMove(player)
		if character then
			state.sprint = true
			character:SetAttribute("Sprinting", true)
		end
	elseif action == "Slide" then
		self:_slide(player)
	elseif action == "Vault" then
		self:_vault(player)
	end
end

function MovementService:_step(player, dt)
	local character, humanoid, root = avatar(player)
	if not character then
		return
	end
	local state = self:_state(player)
	if state.character ~= character then
		self:ResetPlayer(player)
	end
	local config, timestamp = self.ctx.Config.Movement, now()
	local frozen = character:GetAttribute("RoundFrozen") == true
	if frozen then
		root.Anchored = true
		humanoid.WalkSpeed, humanoid.JumpPower = 0, 0
		state.lastPosition, state.lastTime = root.Position, timestamp
		return
	end
	if not self:ValidatePosition(player) then
		return
	end
	local targetSpeed = state.sprint and (self.ctx.Services.RoundService:GetRole(player) == "Hunter" and config.HunterSprint or config.RunnerSprint) or config.WalkSpeed
	humanoid.WalkSpeed += (targetSpeed - humanoid.WalkSpeed) * math.min(1, config.Acceleration * dt)
	humanoid.JumpPower = config.JumpPower
	if state.slideUntil > timestamp then
		local direction = state.slideDirection
		local distance = config.SlideSpeed * dt + 1.7
		local wall = Workspace:Raycast(root.Position - Vector3.new(0, 0.8, 0), direction * distance, rayParameters(character))
		if wall and math.abs(wall.Normal.Y) < 0.65 then
			state.slideUntil = 0
		else
			local progress = math.clamp((timestamp - state.lastSlide) / config.SlideDuration, 0, 1)
			local slideSpeed = config.SlideSpeed * (1 - 0.28 * progress)
			root.AssemblyLinearVelocity = direction * slideSpeed + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
		end
	end
	if character:GetAttribute("Sliding") and state.slideUntil <= timestamp then
		character:SetAttribute("Sliding", false)
		local velocity = horizontal(root.AssemblyLinearVelocity)
		if velocity.Magnitude > targetSpeed then
			root.AssemblyLinearVelocity = velocity.Unit * targetSpeed + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
		end
		if not root.Anchored then
			pcall(function()
				root:SetNetworkOwnershipAuto()
			end)
		end
	end
	-- A fallen avatar is eliminated through the same death path as a reset.
	local bounds = self.ctx.World.Bounds
	if bounds and root.Position.Y < bounds.min.Y - 35 then
		humanoid.Health = 0
	end
end

function MovementService:Start()
	if self.started then
		return
	end
	self.started = true
	Players.PlayerRemoving:Connect(function(player)
		local state = self.states[player]
		if state then
			self:_clearMotion(player, state)
		end
		self.states[player] = nil
	end)
	RunService.Heartbeat:Connect(function(dt)
		self.accumulator += dt
		if self.accumulator < 0.08 then
			return
		end
		local elapsed = self.accumulator
		self.accumulator = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local ok, err = xpcall(function()
				self:_step(player, math.min(elapsed, 0.25))
			end, debug.traceback)
			if not ok then
				warn("[Catch] Movement update failed: " .. tostring(err))
			end
		end
	end)
end

return MovementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[-- Server-owned roster, timers, tags, respawns, and progression summaries.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local RoundService = {}
RoundService.__index = RoundService

local function now()
	return Workspace:GetServerTimeNow()
end

local function liveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if character and humanoid and humanoid.Health > 0 and root then
		return character, humanoid, root
	end
	return nil
end

function RoundService.new(ctx)
	return setmetatable({
		ctx = ctx,
		phase = "Waiting",
		endsAt = 0,
		roundId = 0,
		practice = false,
		roster = {},
		winners = {},
		resultText = "Waiting for players",
		tagTimes = {},
		loading = {},
		connections = {},
		characterConnections = {},
		departing = {},
		hunterTurns = {},
		random = Random.new(),
		startedAt = 0,
		lastBroadcast = 0,
	}, RoundService)
end

function RoundService:_playingPhase()
	return self.phase == "HeadStart" or self.phase == "Active"
end

function RoundService:GetRole(player)
	local entry = self.roster[player.UserId]
	if self:_playingPhase() then
		if entry and entry.alive then
			return entry.role
		end
		return "Spectator"
	end
	return "Lobby"
end

function RoundService:IsActive(player)
	local entry = self.roster[player.UserId]
	return self:_playingPhase() and entry ~= nil and entry.alive and not self.departing[player]
end

function RoundService:_counts()
	local runners, hunters = 0, 0
	for _, entry in pairs(self.roster) do
		if entry.alive and entry.player.Parent == Players and not self.departing[entry.player] then
			if entry.role == "Runner" then
				runners += 1
			else
				hunters += 1
			end
		end
	end
	return runners, hunters
end

function RoundService:Snapshot()
	local runners = self:_counts()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if not self.departing[player] then
			local entry = self.roster[player.UserId]
			table.insert(list, {
				userId = player.UserId,
				name = player.Name,
				displayName = player.DisplayName,
				role = self:GetRole(player),
				alive = entry ~= nil and entry.alive and self:_playingPhase(),
			})
		end
	end
	table.sort(list, function(a, b)
		return a.userId < b.userId
	end)
	return {
		phase = self.phase,
		endsAt = self.endsAt,
		roundId = self.roundId,
		practice = self.practice,
		finalChase = self.phase == "Active" and self.endsAt - now() <= self.ctx.Config.Round.FinalSeconds,
		lastRunner = self:_playingPhase() and runners == 1 and not self.practice,
		aliveRunners = runners,
		players = list,
		winners = table.clone(self.winners),
		resultText = self.resultText,
		mapName = "NEON HEIGHTS",
	}
end

function RoundService:_broadcast()
	self.lastBroadcast = now()
	self.ctx.Remotes.State:FireAllClients(self:Snapshot())
end

function RoundService:_notice(player, payload)
	if player.Parent == Players and not self.departing[player] then
		self.ctx.Remotes.Notice:FireClient(player, payload)
	end
end

function RoundService:_setCharacterRole(player, character)
	local role = self:GetRole(player)
	player:SetAttribute("RoundRole", role)
	character:SetAttribute("RoundRole", role)
	local held = self.phase == "HeadStart" and role == "Hunter"
	character:SetAttribute("RoundFrozen", held)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = held
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	if humanoid then
		humanoid.AutoRotate = not held
		humanoid.UseJumpPower = true
		humanoid.JumpPower = held and 0 or self.ctx.Config.Movement.JumpPower
		humanoid.WalkSpeed = held and 0 or self.ctx.Config.Movement.WalkSpeed
	end
	local movement = self.ctx.Services.MovementService
	if movement then
		movement:ResetPlayer(player)
	end
end

function RoundService:_destination(player)
	local entry = self.roster[player.UserId]
	if self:IsActive(player) and entry then
		return entry.spawn
	end
	-- Keep a dozen avatars from sharing one exact collision point.
	local offset = (math.abs(player.UserId) % 9) - 4
	return self.ctx.World.LobbySpawn * CFrame.new(offset * 2.5, 0, 0)
end

function RoundService:_place(player, character)
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	character:PivotTo(self:_destination(player))
	self:_setCharacterRole(player, character)
	local forceField = character:FindFirstChildOfClass("ForceField")
	if forceField then
		forceField:Destroy()
	end
end

function RoundService:_load(player)
	if self.loading[player] or player.Parent ~= Players or self.departing[player] then
		return
	end
	self.loading[player] = true
	task.spawn(function()
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		self.loading[player] = nil
		if not ok and player.Parent == Players then
			warn("[Catch] Character load failed for user " .. player.UserId .. ": " .. tostring(err))
			self:_notice(player, { kind = "toast", text = "Avatar is still loading. Retrying shortly." })
			task.delay(3, function()
				if player.Parent == Players and not liveCharacter(player) then
					self:_load(player)
				end
			end)
		end
	end)
end

function RoundService:_onCharacter(player, character)
	local previous = self.characterConnections[player]
	if previous then
		previous:Disconnect()
		self.characterConnections[player] = nil
	end
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not humanoid or not root or player.Character ~= character or player.Parent ~= Players then
			return
		end
		self:_place(player, character)
		self.characterConnections[player] = humanoid.Died:Connect(function()
			if player.Character ~= character then
				return
			end
			self:_eliminate(player, "reset")
			task.delay(self.ctx.Config.Round.RespawnDelay, function()
				if player.Parent == Players and player.Character == character then
					self:_load(player)
				end
			end)
		end)
	end)
end

function RoundService:_onPlayer(player)
	self.departing[player] = nil
	local connection = player.CharacterAdded:Connect(function(character)
		self:_onCharacter(player, character)
	end)
	self.connections[player] = connection
	if player.Character then
		self:_onCharacter(player, player.Character)
	else
		self:_load(player)
	end
	player:SetAttribute("RoundRole", self:GetRole(player))
	self:_broadcast()
end

function RoundService:_eligible()
	local eligible = {}
	local data = self.ctx.Services.DataService
	for _, player in ipairs(Players:GetPlayers()) do
		if not self.departing[player] and data:Ready(player) and liveCharacter(player) then
			table.insert(eligible, player)
		end
	end
	-- Late players still enter a full next round, with a hard cap matching place settings.
	table.sort(eligible, function(a, b)
		return a.UserId < b.UserId
	end)
	while #eligible > self.ctx.Config.Round.MaxPlayers do
		table.remove(eligible)
	end
	return eligible
end

function RoundService:_hasEnough(eligible)
	return #eligible >= self.ctx.Config.Round.MinimumPlayers
		or (#eligible == 1 and RunService:IsStudio() and self.ctx.Config.Round.StudioSolo)
end

function RoundService:_startRound(eligible)
	self.roundId += 1
	self.roster = {}
	self.tagTimes = {}
	self.winners = {}
	self.practice = #eligible == 1
	self.startedAt = now()
	self.phase = "HeadStart"
	self.endsAt = now() + self.ctx.Config.Round.HeadStart
	self.resultText = self.practice and "STUDIO PRACTICE · no rewards" or "Runners, find your route!"
	local cosmetic = self.ctx.Services.CosmeticService
	if cosmetic then
		cosmetic:ShowWinners({})
	end
	-- Shuffle ties, then prefer players who have spent fewer rounds hunting.
	for index = #eligible, 2, -1 do
		local swap = self.random:NextInteger(1, index)
		eligible[index], eligible[swap] = eligible[swap], eligible[index]
	end
	local tieBreak = {}
	for index, player in ipairs(eligible) do
		tieBreak[player] = index
	end
	table.sort(eligible, function(a, b)
		local aTurns, bTurns = self.hunterTurns[a.UserId] or 0, self.hunterTurns[b.UserId] or 0
		if aTurns == bTurns then
			return tieBreak[a] < tieBreak[b]
		end
		return aTurns < bTurns
	end)
	local hunters = self.practice and 0 or self.ctx.Rules.HunterCount(#eligible)
	local runnerIndex, hunterIndex = 0, 0
	for index, player in ipairs(eligible) do
		local role = index <= hunters and "Hunter" or "Runner"
		local spawns, spawnIndex
		if role == "Hunter" then
			hunterIndex += 1
			spawns, spawnIndex = self.ctx.World.HunterSpawns, hunterIndex
			self.hunterTurns[player.UserId] = (self.hunterTurns[player.UserId] or 0) + 1
		else
			runnerIndex += 1
			spawns, spawnIndex = self.ctx.World.RunnerSpawns, runnerIndex
		end
		local spawn = spawns[((spawnIndex - 1) % #spawns) + 1]
		self.roster[player.UserId] = {
			player = player,
			role = role,
			alive = true,
			tags = 0,
			joinedAt = self.startedAt,
			spawn = spawn,
		}
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			self:_place(player, player.Character)
		end
	end
	self:_broadcast()
	self.ctx.Remotes.Notice:FireAllClients({ kind = "round", text = self.resultText })
end

function RoundService:_activate()
	self.phase = "Active"
	self.startedAt = now()
	self.endsAt = self.startedAt + self.ctx.Config.Round.Duration
	self.resultText = self.practice and "Explore NEON HEIGHTS · practice awards no XP or coins" or "The chase is on!"
	for _, entry in pairs(self.roster) do
		entry.joinedAt = self.startedAt
		if entry.alive and entry.role == "Hunter" and entry.player.Character then
			-- Only held hunters need releasing. Resetting a running player's movement
			-- here would bless an unvalidated position and interrupt an in-flight vault.
			self:_setCharacterRole(entry.player, entry.player.Character)
		end
	end
	self:_broadcast()
	self.ctx.Remotes.Notice:FireAllClients({ kind = "round", text = self.resultText })
end

function RoundService:_endRound(winningRole, reason)
	if not self:_playingPhase() then
		return
	end
	local endedAt = now()
	self.phase = "Results" -- Guard reentry before touching avatars or awarding data.
	self.endsAt = endedAt + self.ctx.Config.Round.ResultsDuration
	self.winners = {}
	self.resultText = self.practice and (reason or "Practice complete · no progression awarded")
		or (reason or (winningRole == "Hunter" and "Hunters caught every runner!" or "Runners escaped!"))
	local winningPlayers = {}
	for _, entry in pairs(self.roster) do
		local player = entry.player
		local connected = player.Parent == Players and not self.departing[player]
		-- Eliminated runners do not receive a survival victory when a teammate escapes.
		local won = not self.practice and entry.role == winningRole and (entry.role == "Hunter" or entry.alive)
		if connected and won then
			table.insert(self.winners, player.UserId)
			table.insert(winningPlayers, player)
		end
		if connected then
			local survived = entry.role == "Runner"
				and math.clamp((entry.eliminatedAt or endedAt) - self.startedAt, 0, self.ctx.Config.Round.Duration)
				or 0
			local summary = {
				role = entry.role,
				win = won,
				tags = entry.tags,
				survived = survived,
				practice = self.practice,
				roundId = self.roundId,
			}
			task.spawn(function()
				local ok, err = pcall(function()
					self.ctx.Services.DataService:AwardRound(player, summary)
				end)
				if not ok then
					warn("[Catch] Round award failed: " .. tostring(err))
				end
			end)
		end
	end
	table.sort(self.winners)
	for _, player in ipairs(Players:GetPlayers()) do
		if not self.departing[player] then
			local character = liveCharacter(player)
			if character then
				self:_place(player, character)
			else
				self:_load(player)
			end
		end
	end
	local cosmetic = self.ctx.Services.CosmeticService
	if cosmetic then
		cosmetic:ShowWinners(winningPlayers)
	end
	self:_broadcast()
	self.ctx.Remotes.Notice:FireAllClients({ kind = "round", text = self.resultText })
end

function RoundService:_checkWin()
	if not self:_playingPhase() then
		return
	end
	local runners, hunters = self:_counts()
	if self.phase == "Active" and now() >= self.endsAt then
		self:_endRound("Runner", self.practice and "Practice complete · no XP or coins awarded" or "Time is up · runners escaped!")
	elseif runners == 0 then
		self:_endRound("Hunter", self.practice and "Practice ended · try another route next round" or "Hunters caught every runner!")
	elseif not self.practice and hunters == 0 then
		self:_endRound("Runner", "Runners win · no hunters remain")
	end
end

function RoundService:_eliminate(player, reason)
	-- Timer ticks are deliberately infrequent. A death/reset event arriving after
	-- the deadline must settle the completed chase before it changes the roster.
	if self.phase == "Active" and now() >= self.endsAt then
		self:_checkWin()
		return
	end
	local entry = self.roster[player.UserId]
	if not self:_playingPhase() or not entry or not entry.alive then
		return
	end
	entry.alive = false
	entry.eliminatedAt = now()
	player:SetAttribute("RoundRole", "Spectator")
	if player.Character then
		self:_setCharacterRole(player, player.Character)
	end
	if reason ~= "left" then
		self:_notice(player, {
			kind = "toast",
			text = reason == "tag" and "Caught! Watch the chase, then run again next round."
				or "Round ended for you. You will return to the lobby.",
		})
	end
	self:_checkWin()
	if self:_playingPhase() then
		self:_broadcast()
	end
end

function RoundService:TryTag(player)
	-- Resolve the deadline synchronously; a late remote must not steal a win in
	-- the interval between the visible timer reaching zero and the next tick.
	if self.phase == "Active" and now() >= self.endsAt then
		self:_checkWin()
		return false
	end
	if self.phase ~= "Active" or self:GetRole(player) ~= "Hunter" or not self:IsActive(player) then
		return false
	end
	local character, _, root = liveCharacter(player)
	if not character or character:GetAttribute("Vaulting") or character:GetAttribute("RoundFrozen") then
		return false
	end
	local movement = self.ctx.Services.MovementService
	if movement and not movement:ValidatePosition(player) then
		return false
	end
	local timestamp = now()
	local cooldown = self.ctx.Config.Movement.TagCooldown
	if timestamp - (self.tagTimes[player] or -math.huge) < cooldown then
		return false
	end
	self.tagTimes[player] = timestamp
	self:_notice(player, { kind = "ability", action = "Tag", cooldown = cooldown })
	local closest, closestDistance
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	rayParams.RespectCanCollide = true
	for _, entry in pairs(self.roster) do
		if entry.role == "Runner" and entry.alive and not self.departing[entry.player] then
			local targetCharacter, _, targetRoot = liveCharacter(entry.player)
			if targetCharacter and (not movement or movement:ValidatePosition(entry.player)) then
				local delta = targetRoot.Position - root.Position
				local distance = delta.Magnitude
				if distance <= self.ctx.Config.Movement.TagRange and (not closestDistance or distance < closestDistance) then
					local hit = Workspace:Raycast(root.Position, delta, rayParams)
					if not hit or hit.Instance:IsDescendantOf(targetCharacter) then
						closest = entry
						closestDistance = distance
					end
				end
			end
		end
	end
	if not closest then
		return false
	end
	local hunter = self.roster[player.UserId]
	hunter.tags += 1
	local target = closest.player
	local targetCharacter, _, targetRoot = liveCharacter(target)
	local cosmetic = self.ctx.Services.CosmeticService
	if cosmetic and cosmetic.TagEffect then
		cosmetic:TagEffect(player, target)
	elseif targetRoot then
		self.ctx.Remotes.Notice:FireAllClients({ kind = "tag", position = targetRoot.Position, userId = player.UserId, victimUserId = target.UserId })
	end
	self:_eliminate(target, "tag")
	-- A tagged avatar immediately leaves the arena; no invisible blockers or second tags.
	if targetCharacter and target.Character == targetCharacter then
		self:_place(target, targetCharacter)
	end
	return true
end

function RoundService:_step()
	if self.phase == "Waiting" then
		local eligible = self:_eligible()
		if self:_hasEnough(eligible) then
			self.phase = "Intermission"
			self.endsAt = now() + self.ctx.Config.Round.Intermission
			self.practice = #eligible == 1
			self.resultText = self.practice and "Studio solo practice starts soon · no rewards" or "Next chase starts soon"
			self:_broadcast()
		end
	elseif self.phase == "Intermission" then
		local eligible = self:_eligible()
		if not self:_hasEnough(eligible) then
			self.phase, self.endsAt = "Waiting", 0
			self.practice = false
			self.resultText = "Waiting for at least two ready players"
			self:_broadcast()
		elseif now() >= self.endsAt then
			self:_startRound(eligible)
		end
	elseif self.phase == "HeadStart" then
		self:_checkWin()
		if self.phase == "HeadStart" and now() >= self.endsAt then
			self:_activate()
		end
	elseif self.phase == "Active" then
		self:_checkWin()
	elseif self.phase == "Results" and now() >= self.endsAt then
		self.phase, self.endsAt = "Waiting", 0
		self.roster, self.winners = {}, {}
		self.practice = false
		self.resultText = "Waiting for players"
		local cosmetic = self.ctx.Services.CosmeticService
		if cosmetic then
			cosmetic:ShowWinners({})
		end
		self:_broadcast()
	end
	if now() - self.lastBroadcast >= 1 then
		self:_broadcast()
	end
end

function RoundService:Start()
	if self.started then
		return
	end
	self.started = true
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(function(player)
		self:_onPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self.departing[player] = true
		self:_eliminate(player, "left")
		self.tagTimes[player], self.loading[player], self.hunterTurns[player.UserId] = nil, nil, nil
		if self.connections[player] then
			self.connections[player]:Disconnect()
			self.connections[player] = nil
		end
		if self.characterConnections[player] then
			self.characterConnections[player]:Disconnect()
			self.characterConnections[player] = nil
		end
		self:_broadcast()
		-- Keep the departure marker only while a removed player's callbacks can still run.
		task.delay(10, function()
			self.departing[player] = nil
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		self:_onPlayer(player)
	end
	task.spawn(function()
		while self.started do
			local ok, err = xpcall(function()
				self:_step()
			end, debug.traceback)
			if not ok then
				warn("[Catch] Round step failed: " .. tostring(err))
			end
			task.wait(0.2)
		end
	end)
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- All prices, ownership, entitlements, and marketplace verification stay on the server.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local ShopService = {}
ShopService.__index = ShopService

local function validPass(id)
	return type(id) == "number" and id > 0 and id < 9007199254740991 and id % 1 == 0
end

function ShopService.new(ctx)
	return setmetatable({ ctx = ctx, busy = {}, pending = {}, verified = {}, lastPrompt = {} }, ShopService)
end

function ShopService:_Notice(player, text, success)
	if player.Parent == Players then self.ctx.Remotes.Notice:FireClient(player, { kind = "purchase", text = text, success = success == true }) end
end

function ShopService:_PassItems(passId)
	local ids = {}
	for id, item in pairs(self.ctx.Catalog.Items) do
		if item.currency == "Robux" and item.gamePassId == passId then table.insert(ids, id) end
	end
	return ids
end

function ShopService:_Verify(player, passId, afterPurchase)
	local data = self.ctx.Services.DataService
	if not validPass(passId) or #self:_PassItems(passId) == 0 or not data:Ready(player) then return false, "unavailable" end
	self.verified[player] = self.verified[player] or {}
	if self.verified[player][passId] then
		data:Grant(player, self:_PassItems(passId))
		return true
	end
	local successfulQuery = false
	for attempt = 1, afterPurchase and 3 or 1 do
		local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId) end)
		if player.Parent ~= Players or not data:Ready(player) then return false, "unavailable" end
		if ok then
			successfulQuery = true
			if owns then
				self.verified[player] = self.verified[player] or {}
				self.verified[player][passId] = true
				local granted = data:Grant(player, self:_PassItems(passId), afterPurchase and "Purchase verified. Your cosmetics are ready." or nil)
				return granted
			end
		end
		if afterPurchase and attempt < 3 then task.wait(attempt) end
	end
	return false, successfulQuery and "not_owned" or "unavailable"
end

function ShopService:Purchase(player, id)
	local data = self.ctx.Services.DataService
	if not data:Ready(player) then self:_Notice(player, "Your profile is still loading."); return false end
	local item = type(id) == "string" and self.ctx.Catalog.Get(id)
	if not item then self:_Notice(player, "This item is unavailable."); return false end
	local profile = data:Get(player)
	if profile.owned[id] then self:_Notice(player, "You already own " .. item.name .. ". Equip it from your inventory."); return true end
	if item.currency == "Free" then
		local ok = data:Grant(player, { id }, "Added " .. item.name .. " to your inventory.")
		return ok
	elseif item.currency == "Coins" then
		local ok, message = data:_PurchaseWithCoins(player, id)
		self:_Notice(player, message, ok)
		return ok
	elseif item.currency == "Milestone" then
		local milestone = item.milestone
		if not milestone then self:_Notice(player, "This reward is unavailable."); return false end
		local progress = profile.stats[milestone.stat] or profile[milestone.stat] or 0
		if progress >= milestone.value then return data:Grant(player, { id }, "Unlocked " .. item.name .. ".") end
		self:_Notice(player, "Reach " .. milestone.value .. " " .. milestone.stat .. " to unlock this cosmetic.")
		return false
	elseif item.currency ~= "Robux" then
		self:_Notice(player, "This item is unavailable.")
		return false
	end
	if not validPass(item.gamePassId) then
		self:_Notice(player, "This Robux cosmetic is not configured for sale yet.")
		return false
	end
	if self.busy[player] or self.pending[player] then self:_Notice(player, "Finish your current purchase first."); return false end
	if os.clock() - (self.lastPrompt[player] or -100) < 3 then self:_Notice(player, "Please wait a moment before trying again."); return false end
	self.busy[player] = true
	local owns, reason = self:_Verify(player, item.gamePassId, false)
	if player.Parent ~= Players then self.busy[player] = nil; return false end
	if owns then
		self.busy[player] = nil
		self:_Notice(player, "Ownership verified. " .. item.name .. " is in your inventory.", true)
		return true
	end
	if reason == "unavailable" then
		self.busy[player] = nil
		self:_Notice(player, "Roblox could not verify your ownership. Please try again shortly.")
		return false
	end
	self.pending[player] = item.gamePassId
	self.lastPrompt[player] = os.clock()
	local ok = pcall(function() MarketplaceService:PromptGamePassPurchase(player, item.gamePassId) end)
	self.busy[player] = nil
	if not ok then
		self.pending[player] = nil
		self:_Notice(player, "Roblox could not open the purchase prompt. Please try again later.")
		return false
	end
	self:_Notice(player, "Confirm the price and purchase in the Roblox prompt.")
	return true
end

function ShopService:_Refresh(player)
	local data = self.ctx.Services.DataService
	while player.Parent == Players and not data:Ready(player) do task.wait(0.2) end
	if player.Parent ~= Players then return end
	local seen = {}
	local failed = false
	for _, item in pairs(self.ctx.Catalog.Items) do
		if item.currency == "Robux" and validPass(item.gamePassId) and not seen[item.gamePassId] then
			seen[item.gamePassId] = true
			local _, reason = self:_Verify(player, item.gamePassId, false)
			if reason == "unavailable" then failed = true end
			if player.Parent ~= Players then return end
		end
	end
	if failed then self:_Notice(player, "Some pass ownership checks are unavailable. Rejoin or select the item later to retry.") end
end

function ShopService:Start()
	if self.started then return end
	self.started = true
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if self.pending[player] == passId then self.pending[player] = nil end
		if not wasPurchased or not validPass(passId) or #self:_PassItems(passId) == 0 then return end
		-- The prompt result is an intent signal. Grant only after a server ownership query.
		task.spawn(function()
			local verified = self:_Verify(player, passId, true)
			if not verified then self:_Notice(player, "Purchase verification is delayed. Rejoin to restore owned passes; you do not need to buy again.") end
		end)
	end)
	Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_Refresh(player) end) end)
	Players.PlayerRemoving:Connect(function(player)
		self.busy[player] = nil
		self.pending[player] = nil
		self.verified[player] = nil
		self.lastPrompt[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() self:_Refresh(player) end) end
end

return ShopService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- NEON HEIGHTS: a deliberately composed six-rooftop chase circuit.
-- All route endpoints are walking-surface coordinates. No asset downloads required.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local MapBuilder = {}
local built
local P = {
	ink = Color3.fromRGB(19, 29, 48),
	navy = Color3.fromRGB(30, 48, 70),
	steel = Color3.fromRGB(68, 88, 105),
	concrete = Color3.fromRGB(128, 143, 153),
	cream = Color3.fromRGB(240, 222, 186),
	white = Color3.fromRGB(228, 238, 233),
	teal = Color3.fromRGB(53, 161, 165),
	cyan = Color3.fromRGB(77, 239, 229),
	coral = Color3.fromRGB(232, 115, 117),
	pink = Color3.fromRGB(250, 113, 174),
	gold = Color3.fromRGB(255, 198, 100),
	purple = Color3.fromRGB(114, 104, 168),
	green = Color3.fromRGB(83, 150, 121),
	leaf = Color3.fromRGB(123, 184, 133),
	soil = Color3.fromRGB(57, 59, 61),
	road = Color3.fromRGB(36, 46, 62),
	glass = Color3.fromRGB(46, 86, 105),
}

local function applyLighting()
	Lighting.ClockTime = 18.6
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(91, 91, 119)
	Lighting.OutdoorAmbient = Color3.fromRGB(111, 118, 146)
	Lighting.ExposureCompensation = 0.12
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.65
	for _, name in ipairs({ "CatchAtmosphere", "CatchBloom", "CatchColor" }) do
		local old = Lighting:FindFirstChild(name)
		if old then old:Destroy() end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "CatchAtmosphere"
	atmosphere.Density = 0.29
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(182, 196, 227)
	atmosphere.Decay = Color3.fromRGB(101, 90, 132)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CatchBloom"
	bloom.Intensity = 0.25
	bloom.Size = 28
	bloom.Threshold = 1.3
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "CatchColor"
	color.Contrast = 0.1
	color.Saturation = -0.025
	color.TintColor = Color3.fromRGB(255, 245, 237)
	color.Parent = Lighting
end

local function activateObstacles(model)
	if model:GetAttribute("CatchRuntimeStarted") then return end
	model:SetAttribute("CatchRuntimeStarted", true)
	local tweens = {}
	for _, gate in ipairs(model:GetDescendants()) do
		if gate:IsA("BasePart") and gate:GetAttribute("DynamicObstacle") then
			local closed = gate:GetAttribute("GateClosedCFrame") or gate.CFrame
			gate.CFrame = closed
			local tween = TweenService:Create(gate, TweenInfo.new(gate:GetAttribute("GateCycle") or 3,
				Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 1.5),
				{CFrame = closed + Vector3.new(0, 5, 0)})
			table.insert(tweens, tween)
			tween:Play()
		end
	end
	model.Destroying:Connect(function()
		for _, tween in ipairs(tweens) do tween:Cancel() end
	end)
end

local function readBaked(model)
	local world = {Model=model, LobbySpawn=model:GetAttribute("LobbySpawn"), RunnerSpawns={}, HunterSpawns={}, Podiums={},
		Bounds={min=model:GetAttribute("BoundsMin"),max=model:GetAttribute("BoundsMax")}}
	for _, kind in ipairs({"Runner", "Hunter", "Podium"}) do
		local target = kind == "Podium" and world.Podiums or world[kind.."Spawns"]
		for i=1, model:GetAttribute(kind.."Count") or 0 do
			table.insert(target, model:GetAttribute(kind.."Spawn"..i))
		end
	end
	return world
end

function MapBuilder.Build(options)
	if built and built.Model.Parent then return built end
	local static = options and options.Static == true
	local existing = workspace:FindFirstChild("NeonHeights")
	if existing and existing:GetAttribute("CatchMapVersion") == 1 then
		built = readBaked(existing)
		applyLighting()
		if not static then activateObstacles(existing) end
		return built
	elseif existing then existing:Destroy() end
	local model = Instance.new("Model")
	model.Name = "NeonHeights"
	model:SetAttribute("MapName", "NEON HEIGHTS")
	model:SetAttribute("ArtDirection", "Twilight couriers / warm concrete / electric mint")
	local partCount = 0
	local gates = {}
	local function group(name)
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = model
		return folder
	end
	local terrain = group("StreetsAndPlaza")
	local district = group("Architecture")
	local routes = group("ParkourRoutes")
	local props = group("StreetLife")
	local skyline = group("DistantSkyline")
	local lobby = group("SocialDeck")
	local function part(parent, name, size, cf, color, material, collide)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = typeof(cf) == "Vector3" and CFrame.new(cf) or cf
		p.Color = color or P.concrete
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = collide ~= false
		p.CanTouch = false
		p.CanQuery = p.CanCollide
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CastShadow = material ~= Enum.Material.Neon
		p.Parent = parent
		partCount += 1
		return p
	end
	local function box(parent, name, x, y, z, sx, sy, sz, color, material, collide)
		return part(parent, name, Vector3.new(sx, sy, sz), Vector3.new(x, y, z), color, material, collide)
	end
	local function beam(parent, name, a, b, width, color, material, collide)
		local delta = b - a
		return part(parent, name, Vector3.new(width, width, delta.Magnitude), CFrame.lookAt((a + b) / 2, b), color, material, collide)
	end
	local function cylinder(parent, name, center, diameter, height, color, material, collide)
		local p = part(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), color, material, collide)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	local function sphere(parent, name, center, size, color)
		local p = part(parent, name, size, center, color, Enum.Material.SmoothPlastic, false)
		p.Shape = Enum.PartType.Ball
		return p
	end
	local function sign(parent, text, center, width, height, accent, rotation)
		local cf = CFrame.new(center) * CFrame.Angles(0, rotation or 0, 0)
		local backing = part(parent, "Sign_" .. text, Vector3.new(width, height, 0.35), cf, P.ink, nil, false)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 34
		gui.LightInfluence = 0
		gui.MaxDistance = 210
		gui.Parent = backing
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.94, 0.82)
		label.Position = UDim2.fromScale(0.03, 0.09)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = accent or P.white
		label.TextScaled = true
		label.FontFace = Font.fromEnum(Enum.Font.GothamBold)
		label.Parent = gui
		for _, side in ipairs({ -1, 1 }) do
			part(parent, "SignEdge", Vector3.new(width, 0.14, 0.16), cf * CFrame.new(0, side * height / 2, -0.22), accent, Enum.Material.Neon, false)
		end
		return backing
	end
	local function light(parent, center, color, brightness, range)
		local bulb = box(parent, "Lamp", center.X, center.Y, center.Z, 1.3, 0.25, 1.3, color, Enum.Material.Neon, false)
		local point = Instance.new("PointLight")
		point.Color = color
		point.Brightness = brightness or 0.6
		point.Range = range or 16
		point.Shadows = false
		point.Parent = bulb
	end
	local function route(name, a, b, width, color, rails)
		-- These broad, continuous surfaces stay below the default humanoid slope limit.
		local cf = CFrame.lookAt((a + b) / 2, b)
		local length = (b - a).Magnitude
		local deck = part(routes, name, Vector3.new(width, 0.7, length + 0.4), cf * CFrame.new(0, -0.35, 0), P.steel, Enum.Material.Metal)
		deck:SetAttribute("TraversalRoute", true)
		for _, side in ipairs({ -1, 1 }) do
			part(routes, name .. "_Edge", Vector3.new(0.18, 0.08, length), cf * CFrame.new(side * (width / 2 - 0.25), 0.07, 0), color or P.cyan, Enum.Material.Neon, false)
			if rails then
				part(routes, "Handrail", Vector3.new(0.18, 0.18, length), cf * CFrame.new(side * (width / 2 - 0.25), 2.8, 0), P.white, Enum.Material.Metal, false)
				for _, along in ipairs({ -length * 0.45, 0, length * 0.45 }) do
					part(routes, "RailPost", Vector3.new(0.2, 2.8, 0.2), cf * CFrame.new(side * (width / 2 - 0.25), 1.4, along), P.steel, Enum.Material.Metal, false)
				end
			end
		end
		return deck
	end
	local function stair(name, origin, width, rise, run, direction)
		local steps = math.ceil(rise / 0.8)
		local cf = CFrame.new(origin) * CFrame.Angles(0, direction or 0, 0)
		for i = 1, steps do
			local h = rise * i / steps
			part(routes, name, Vector3.new(width, h, run / steps + 0.05), cf * CFrame.new(0, h / 2, -run * (i - 0.5) / steps), P.concrete, Enum.Material.Concrete)
		end
	end
	local function ladder(x, z, roof, rotation)
		local cf = CFrame.new(x, roof / 2 + 0.25, z) * CFrame.Angles(0, rotation or 0, 0)
		local climb = Instance.new("TrussPart")
		climb.Name = "ServiceLadder"
		climb.Size = Vector3.new(2, roof + 2.5, 2)
		climb.CFrame = cf
		climb.Color = P.gold
		climb.Material = Enum.Material.Metal
		climb.Anchored = true
		climb.CanTouch = false
		climb.Parent = routes
		partCount += 1
	end
	local function planter(parent, x, y, z, length, orientation, flowers)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, orientation or 0, 0)
		part(parent, "Planter", Vector3.new(length, 1.5, 3), cf * CFrame.new(0, 0.75, 0), P.cream, Enum.Material.Concrete)
		part(parent, "PlantingSoil", Vector3.new(length - 0.5, 0.15, 2.5), cf * CFrame.new(0, 1.55, 0), P.soil, nil, false)
		for i = 1, math.max(2, math.floor(length / 2.6)) do
			local offset = -length / 2 + i * length / (math.floor(length / 2.6) + 1)
			local pos = (cf * CFrame.new(offset, 2.1, 0)).Position
			sphere(parent, "ClippedShrub", pos, Vector3.new(2.6, 2.2, 2.3), i % 2 == 0 and P.green or P.leaf)
			if flowers then sphere(parent, "Blossom", pos + Vector3.new(0.3, 0.9, 0), Vector3.new(0.6, 0.55, 0.6), i % 2 == 0 and P.pink or P.gold) end
		end
	end
	local function tree(parent, x, y, z, scale)
		scale = scale or 1
		cylinder(parent, "TreeWell", Vector3.new(x, y + 0.25, z), 7 * scale, 0.5, P.cream, Enum.Material.Concrete)
		cylinder(parent, "TreeTrunk", Vector3.new(x, y + 4 * scale, z), 0.85 * scale, 8 * scale, P.soil, Enum.Material.Wood)
		sphere(parent, "TreeCrown", Vector3.new(x, y + 9 * scale, z), Vector3.new(8, 7, 8) * scale, P.green)
		sphere(parent, "TreeCrownLight", Vector3.new(x - 1.8 * scale, y + 10.5 * scale, z - 0.8 * scale), Vector3.new(6, 5, 6) * scale, P.leaf)
	end
	local function bench(parent, x, y, z, rotation)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rotation or 0, 0)
		for _, offset in ipairs({ -2.7, 2.7 }) do
			part(parent, "BenchLeg", Vector3.new(0.5, 1.4, 2.5), cf * CFrame.new(offset, 0.7, 0), P.navy, Enum.Material.Metal)
		end
		for i = 1, 3 do
			part(parent, "BenchSlat", Vector3.new(7, 0.3, 0.6), cf * CFrame.new(0, 1.5, -1.1 + i * 0.7), P.cream, Enum.Material.Wood)
		end
		part(parent, "BenchBack", Vector3.new(7, 1.6, 0.3), cf * CFrame.new(0, 2.65, 1.1), P.cream, Enum.Material.Wood)
	end
	local function acUnit(x, y, z, rotation)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rotation or 0, 0)
		part(props, "ClimateUnit", Vector3.new(6, 2.8, 4), cf * CFrame.new(0, 1.4, 0), P.concrete, Enum.Material.Metal)
		part(props, "VentPanel", Vector3.new(5.2, 2, 0.12), cf * CFrame.new(0, 1.5, -2.07), P.ink, Enum.Material.Metal, false)
		for i = 1, 5 do
			part(props, "VentLouvre", Vector3.new(5, 0.12, 0.16), cf * CFrame.new(0, 0.5 + i * 0.32, -2.2), P.steel, Enum.Material.Metal, false)
		end
		cylinder(props, "FanRim", (cf * CFrame.new(0, 2.85, 0)).Position, 2.6, 0.2, P.ink, Enum.Material.Metal, false)
		for _, angle in ipairs({ 0, math.pi / 2 }) do
			part(props, "FanBlade", Vector3.new(2.3, 0.08, 0.5), cf * CFrame.new(0, 3, 0) * CFrame.Angles(0, angle, 0), P.steel, Enum.Material.Metal, false)
		end
	end
	local function pipe(a, b, color)
		beam(props, "ServicePipe", a, b, 0.65, color or P.coral, Enum.Material.Metal, false)
	end
	local function canopy(parent, x, y, z, width, depth, color, rotation)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rotation or 0, 0)
		part(parent, "Canopy", Vector3.new(width, 0.4, depth), cf * CFrame.Angles(math.rad(-8), 0, 0), color, Enum.Material.Fabric, false)
		part(parent, "CanopyValance", Vector3.new(width, 0.9, 0.2), cf * CFrame.new(0, -0.6, -depth / 2), color, Enum.Material.Fabric, false)
		local sections = math.floor(width / 3)
		for i = 1, sections, 2 do
			part(parent, "CanopyStripe", Vector3.new(width / sections, 0.04, depth), cf * CFrame.Angles(math.rad(-8), 0, 0) * CFrame.new(-width / 2 + (i - 0.5) * width / sections, 0.24, 0), P.cream, Enum.Material.Fabric, false)
		end
	end
	local function building(name, x, z, w, d, h, color, accent)
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = district
		box(folder, "Foundation", x, 0.7, z, w + 1.4, 1.4, d + 1.4, P.navy, Enum.Material.Concrete)
		box(folder, "Facade", x, h / 2 - 0.2, z, w, h - 0.4, d, color, Enum.Material.Concrete)
		box(folder, "GroundFloorBand", x, 4.2, z, w + 0.4, 6.4, d + 0.4, P.ink, Enum.Material.Brick)
		box(folder, "StringCourse", x, 7.6, z, w + 0.8, 0.6, d + 0.8, P.cream, Enum.Material.Concrete)
		box(folder, "RoofCornice", x, h - 0.6, z, w + 1.6, 1.2, d + 1.6, P.cream, Enum.Material.Concrete)
		box(folder, "WalkingRoof", x, h - 0.15, z, w, 0.3, d, P.navy, Enum.Material.Concrete)
		for _, side in ipairs({ -1, 1 }) do
			-- Layered corner pilasters and restrained neon cornices give every block depth.
			for _, endSide in ipairs({ -1, 1 }) do
				box(folder, "Pilaster", x + side * (w / 2 - 1.2), h / 2, z + endSide * (d / 2 + 0.25), 2.4, h - 1.2, 0.9, color, Enum.Material.Concrete)
			end
			box(folder, "CorniceLight", x, h - 1.35, z + side * (d / 2 + 0.85), w - 5, 0.13, 0.12, accent, Enum.Material.Neon, false)
			local columns = math.floor((w - 8) / 10)
			for i = 1, columns do
				local wx = x - w / 2 + 5 + (i - 0.5) * (w - 10) / columns
				box(folder, "ShopGlass", wx, 4.3, z + side * (d / 2 + 0.25), 6.2, 4.6, 0.2, P.glass, Enum.Material.Glass, false)
				box(folder, "WarmDisplay", wx, 5.9, z + side * (d / 2 + 0.4), 5.2, 0.14, 0.12, i % 3 == 0 and accent or P.gold, Enum.Material.Neon, false)
				if h > 15 then
					box(folder, "UpperWindow", wx, h - 5.3, z + side * (d / 2 + 0.2), 4.6, 5.4, 0.22, P.glass, Enum.Material.Glass, false)
					box(folder, "WindowSill", wx, h - 8.1, z + side * (d / 2 + 0.5), 5, 0.35, 0.8, P.cream, nil, false)
					box(folder, "WindowMullion", wx, h - 5.3, z + side * (d / 2 + 0.35), 0.2, 5.4, 0.14, P.cream, nil, false)
				end
			end
			for i = 1, math.floor(d / 12) do
				local wz = z - d / 2 + 5 + (i - 0.5) * (d - 10) / math.floor(d / 12)
				box(folder, "SideWindow", x + side * (w / 2 + 0.2), h > 15 and h - 5.3 or 4.4, wz, 0.2, 4.6, 5.6, P.glass, Enum.Material.Glass, false)
				box(folder, "SideWindowGlow", x + side * (w / 2 + 0.32), h > 15 and h - 3.3 or 6.4, wz, 0.15, 0.13, 5, accent, Enum.Material.Neon, false)
			end
		end
		-- Corner parapets leave the middle of every edge open for bridges and ladders.
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				box(folder, "CornerParapet", x + sx * (w / 2 - 7), h + 0.9, z + sz * (d / 2 - 0.25), 13, 1.8, 0.65, color, Enum.Material.Concrete)
				box(folder, "CornerParapet", x + sx * (w / 2 - 0.25), h + 0.9, z + sz * (d / 2 - 7), 0.65, 1.8, 13, color, Enum.Material.Concrete)
			end
		end
		return folder
	end

	-- The arena is a raised city island. Streets form a cross plus a complete outer loop.
	box(terrain, "CityIsland", 0, -3, 0, 310, 6, 280, P.navy, Enum.Material.Concrete)
	box(terrain, "Asphalt", 0, -0.15, 0, 302, 0.3, 272, P.road, Enum.Material.Asphalt)
