	end
	for _, edge in ipairs({ { -154, 0, 2, 280 }, { 154, 0, 2, 280 }, { 0, -139, 310, 2 }, { 0, 139, 310, 2 } }) do
		local wall = box(terrain, "ArenaBoundary", edge[1], 45, edge[2], edge[3], 100, edge[4], P.ink)
		wall.Transparency = 1
		wall.CastShadow = false
