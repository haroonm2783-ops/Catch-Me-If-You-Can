			box(terrain, "RoadDash", i * 20, 0.025, -7, 7, 0.05, 0.24, P.gold, nil, false)
			box(terrain, "RoadDash", 7, 0.025, i * 19, 0.24, 0.05, 6, P.gold, nil, false)
		end
	end
	for _, x in ipairs({ -27, 27 }) do
