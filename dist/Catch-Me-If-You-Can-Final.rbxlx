}

skins.skin_dragon = {
	build = function(k)
		local red, bone, orange, dark = C(215, 50, 40), C(250, 236, 206), C(255, 140, 40), C(120, 24, 30)
		-- Swept-back horns and a spiny crest.
		for _, s in ipairs(SIDES) do
			k.p("Head", "HornBase_" .. s[1], Vector3.new(0.34, 0.5, 0.34), offset(s[2] * 0.4, 0.7, 0.1, -14, 0, s[2] * -12), bone, nil, "Can")
			k.p("Head", "HornTip_" .. s[1], Vector3.new(0.26, 0.7, 0.26), offset(s[2] * 0.52, 1.18, 0.34, -40, 0, s[2] * -20), orange, nil, "Can")
		end
		for i = 1, 3 do
			k.p("UpperTorso", "BackSpike" .. i, Vector3.new(0.34, 0.5, 0.34), offset(0, 0.9 - i * 0.5, 0.62, 25, 0, 0), bone, nil, "Wedge")
		end
		-- Wings: a bone spar and four fanned feather panels per side, so the V reads from behind.
		for _, s in ipairs(SIDES) do
			local x = s[2]
			local function fan(name, angle, length, width, color, material)
				local a = math.rad(angle)
				local base = Vector3.new(x * 0.55, 0.45, 0.72)
				local center = base + Vector3.new(x * math.sin(a), math.cos(a), 0) * (length / 2)
				return k.p("UpperTorso", name .. "_" .. s[1], Vector3.new(width, length, 0.1), offset(center.X, center.Y, center.Z, 0, 0, -x * angle), color, material)
			end
			fan("WingSpar", 38, 3.1, 0.22, bone)
			fan("WingFeatherA", 14, 2.3, 0.7, red)
			fan("WingFeatherB", 36, 2.9, 0.7, dark)
			fan("WingFeatherC", 58, 2.6, 0.7, red)
			fan("WingFeatherD", 80, 2.0, 0.7, dark)
			k.p("UpperTorso", "WingClaw_" .. s[1], Vector3.new(0.22, 0.5, 0.22), offset(x * 2.5, 2.75, 0.76, 0, 0, -x * 38), orange, nil, "Wedge")
		end
		-- Tapering tail with a flame tip.
		k.p("LowerTorso", "TailA", Vector3.new(0.6, 0.6, 1.0), offset(0, -0.1, 0.9, -12, 0, 0), red)
		k.p("LowerTorso", "TailB", Vector3.new(0.46, 0.46, 1.0), offset(0, -0.34, 1.78, -22, 0, 0), red)
		k.p("LowerTorso", "TailC", Vector3.new(0.3, 0.3, 0.9), offset(0, -0.72, 2.5, -30, 0, 0), dark)
		k.p("LowerTorso", "TailFlame", Vector3.new(0.5, 0.6, 0.5), offset(0, -1.0, 3.0, -30, 0, 0), orange, nil, "Wedge")
		for _, s in ipairs(SIDES) do
			k.p(s[1] .. "LowerArm", "ClawBand_" .. s[1], Vector3.new(1.12, 0.3, 1.12), offset(0, -0.3, 0), bone, nil, "Can")
		end
	end,
	aura = {kind = "embers", color = {C(255, 210, 90), C(255, 80, 30)}, mount = "UpperTorso", at = offset(0, 0.2, 0.5)},
}

Appearance.SkinOrder = {"skin_courier", "skin_rooftop", "skin_pizza", "skin_bunny", "skin_panda", "skin_streetwear", "skin_cyber", "skin_ninja",
	"skin_neonphantom", "skin_midnight", "skin_candy", "skin_golden", "skin_dragon"}
function Appearance.HasSkin(id) return skins[id] ~= nil end

-- Presentational mood is a replicated attribute only. Roblox's own animations and face are untouched.
Appearance.Moods = {Idle = "idle", Run = "run", Hunt = "hunt", Scared = "scared", Hide = "hide", Win = "win", Lose = "lose"}
function Appearance.SetMood(rig, mood)
	if not rig then return false end
	rig:SetAttribute("CatchMood", Appearance.Moods[mood] and mood or "Idle")
	return true
end

-- ---------------------------------------------------------------------------------------
-- Masks sit in front of the player's real face. Bold, simple shapes; a little metal, no glow.
-- ---------------------------------------------------------------------------------------
local masks = {
	mask_street = true, mask_visor = true, mask_phantom = true, mask_kitsune = true,
	mask_skull = true, mask_ninja = true, mask_jester = true, mask_pixel = true,
}
function Appearance.HasMask(id) return masks[id] ~= nil end
Appearance.MaskOrder = {"mask_street", "mask_visor", "mask_ninja", "mask_jester", "mask_phantom", "mask_kitsune", "mask_skull", "mask_pixel"}

local function buildMask(k, maskId)
	local white, ink, gold = C(250, 246, 240), C(30, 30, 44), C(255, 205, 60)
	local m = function(name, size, cf, color, material, shape, opts) return k.p("Head", name, size, cf, color, material, shape, opts) end
	if maskId == "mask_street" then
		local teal, light = C(30, 190, 200), C(255, 255, 255)
		m("BandanaCloth", Vector3.new(1.34, 0.56, 0.24), offset(0, -0.26, -0.6), teal)
		m("BandanaPoint", Vector3.new(0.6, 0.34, 0.24), offset(0, -0.62, -0.58, 0, 0, 180), teal, nil, "Wedge")
		m("BandanaTopEdge", Vector3.new(1.34, 0.08, 0.26), offset(0, -0.02, -0.61), light)
		for _, x in ipairs({-0.4, 0, 0.4}) do m("BandanaDot", Vector3.new(0.12, 0.12, 0.05), offset(x, -0.3, -0.73), light, nil, "Disc") end
		m("BandanaKnot", Vector3.new(0.4, 0.34, 0.34), offset(0.3, -0.2, 0.66), teal, nil, "Ball")
		m("BandanaStrap", Vector3.new(1.28, 0.2, 1.28), offset(0, -0.2, 0.0), teal, nil, "Can")
	elseif maskId == "mask_visor" then
		-- Cool shades: opaque lenses, bright frame.
		local frame = C(255, 90, 160)
		m("ShadesBridge", Vector3.new(1.32, 0.12, 0.16), offset(0, 0.14, -0.64), frame)
		for _, s in ipairs(SIDES) do
			m("ShadesLens_" .. s[1], Vector3.new(0.54, 0.4, 0.14), offset(s[2] * 0.3, 0.1, -0.66), ink, M.Glass, nil, {transparency = 0.1})
			m("ShadesRim_" .. s[1], Vector3.new(0.6, 0.46, 0.1), offset(s[2] * 0.3, 0.1, -0.63), frame)
			m("ShadesShine_" .. s[1], Vector3.new(0.14, 0.06, 0.06), offset(s[2] * 0.4, 0.2, -0.74, 0, 0, 20), white)
			m("ShadesArm_" .. s[1], Vector3.new(0.1, 0.12, 1.0), offset(s[2] * 0.62, 0.14, -0.1), frame)
		end
	elseif maskId == "mask_ninja" then
		local cloth, wrap = C(40, 44, 70), C(230, 40, 50)
		m("WrapLower", Vector3.new(1.34, 0.62, 0.24), offset(0, -0.22, -0.6), cloth)
		m("WrapNose", Vector3.new(0.5, 0.24, 0.26), offset(0, 0.06, -0.62), cloth, nil, "Wedge")
		m("WrapStrap", Vector3.new(1.3, 0.24, 1.3), offset(0, -0.1, 0.0), cloth, nil, "Can")
		m("WrapStripe", Vector3.new(1.36, 0.08, 0.26), offset(0, -0.46, -0.6), wrap)
		m("WrapTail", Vector3.new(0.24, 0.9, 0.08), offset(0.4, -0.4, 0.68, 12, 0, -8), wrap)
	elseif maskId == "mask_jester" then
		local purple = C(150, 80, 230)
		m("JesterFace", Vector3.new(1.06, 0.84, 0.2), offset(0, -0.02, -0.62), white)
		m("JesterHalf", Vector3.new(0.53, 0.84, 0.21), offset(0.265, -0.02, -0.63), purple)
		for _, s in ipairs(SIDES) do
			m("JesterEye_" .. s[1], Vector3.new(0.32, 0.24, 0.06), offset(s[2] * 0.26, 0.14, -0.74, 0, 0, s[2] * 18), ink)
			m("JesterBrowPoint_" .. s[1], Vector3.new(0.4, 0.36, 0.22), offset(s[2] * 0.46, 0.52, -0.58, 0, 0, s[2] * -28), s[1] == "Left" and white or purple, nil, "Wedge")
			m("JesterBell_" .. s[1], Vector3.new(0.26, 0.26, 0.26), offset(s[2] * 0.74, 0.8, -0.58), gold, M.Metal, "Ball")
		end
		m("JesterGrin", Vector3.new(0.74, 0.22, 0.06), offset(0, -0.26, -0.74), ink)
		for x = -0.24, 0.24, 0.12 do m("JesterTooth", Vector3.new(0.07, 0.15, 0.06), offset(x, -0.24, -0.78), white) end
		m("JesterNose", Vector3.new(0.22, 0.22, 0.22), offset(0, -0.06, -0.78), C(236, 70, 80), nil, "Ball")
	elseif maskId == "mask_phantom" then
		m("PhantomCeramic", Vector3.new(1.06, 0.9, 0.2), offset(0, -0.02, -0.62), white)
		for _, s in ipairs(SIDES) do
			m("PhantomCheek_" .. s[1], Vector3.new(0.36, 0.42, 0.16), offset(s[2] * 0.36, -0.3, -0.68, 0, 0, s[2] * 20), white, nil, "Wedge")
			m("PhantomEye_" .. s[1], Vector3.new(0.34, 0.14, 0.06), offset(s[2] * 0.26, 0.12, -0.74, 0, 0, s[2] * 10), ink)
			m("PhantomGoldBrow_" .. s[1], Vector3.new(0.38, 0.06, 0.06), offset(s[2] * 0.26, 0.26, -0.75, 0, 0, s[2] * 10), gold, M.Metal)
			m("PhantomFiligree_" .. s[1], Vector3.new(0.08, 0.36, 0.06), offset(s[2] * 0.47, -0.03, -0.75, 0, 0, s[2] * 18), gold, M.Metal)
		end
		m("PhantomNose", Vector3.new(0.16, 0.28, 0.2), offset(0, -0.06, -0.78, 0, 0, 180), white, nil, "Wedge")
		m("PhantomMouth", Vector3.new(0.26, 0.06, 0.04), offset(0, -0.3, -0.75), ink)
	elseif maskId == "mask_kitsune" then
		local vermilion = C(226, 70, 70)
		m("FoxFace", Vector3.new(1.06, 0.82, 0.22), offset(0, -0.02, -0.63), white)
		for _, s in ipairs(SIDES) do
			m("FoxEar_" .. s[1], Vector3.new(0.4, 0.84, 0.2), offset(s[2] * 0.44, 0.66, -0.5, 0, 0, s[2] * -18), white, nil, "Wedge")
			m("FoxEarInner_" .. s[1], Vector3.new(0.2, 0.5, 0.06), offset(s[2] * 0.45, 0.64, -0.62, 0, 0, s[2] * -18), vermilion, nil, "Wedge")
			m("FoxEye_" .. s[1], Vector3.new(0.34, 0.1, 0.06), offset(s[2] * 0.26, 0.1, -0.75, 0, 0, s[2] * 20), vermilion)
			m("FoxCheekMark_" .. s[1], Vector3.new(0.3, 0.08, 0.06), offset(s[2] * 0.34, -0.14, -0.75, 0, 0, s[2] * -25), vermilion)
		end
		m("FoxMuzzle", Vector3.new(0.42, 0.28, 0.26), offset(0, -0.26, -0.78), white)
		m("FoxNose", Vector3.new(0.16, 0.1, 0.06), offset(0, -0.19, -0.92), ink)
		m("FoxForeheadSeal", Vector3.new(0.2, 0.26, 0.05), offset(0, 0.28, -0.75, 0, 0, 45), vermilion)
	elseif maskId == "mask_skull" then
		m("SkullForehead", Vector3.new(1.08, 0.54, 0.24), offset(0, 0.2, -0.62), gold, M.Metal)
		for _, s in ipairs(SIDES) do
			m("SkullCheek_" .. s[1], Vector3.new(0.34, 0.4, 0.18), offset(s[2] * 0.4, -0.14, -0.66, 0, 0, s[2] * 18), gold, M.Metal)
			m("SkullSocket_" .. s[1], Vector3.new(0.36, 0.3, 0.08), offset(s[2] * 0.27, 0.1, -0.78, 0, 0, s[2] * 9), ink)
			m("SkullEye_" .. s[1], Vector3.new(0.12, 0.12, 0.05), offset(s[2] * 0.27, 0.1, -0.83), C(255, 90, 90), nil, "Disc")
		end
		m("SkullJaw", Vector3.new(0.7, 0.3, 0.22), offset(0, -0.34, -0.64), gold, M.Metal)
		m("SkullNasal", Vector3.new(0.15, 0.19, 0.06), offset(0, -0.1, -0.8, 0, 0, 180), ink, nil, "Wedge")
		for x = -0.24, 0.24, 0.12 do m("ToothGap", Vector3.new(0.04, 0.17, 0.04), offset(x, -0.34, -0.77), ink) end
	elseif maskId == "mask_pixel" then
		local screen, glow = C(34, 40, 66), C(80, 235, 160)
		m("PixelScreen", Vector3.new(1.1, 0.9, 0.22), offset(0, -0.02, -0.62), screen, M.Metal)
		m("PixelFrame", Vector3.new(1.18, 0.98, 0.14), offset(0, -0.02, -0.58), C(100, 110, 150), M.Metal)
		for _, s in ipairs(SIDES) do
			m("PixelEye_" .. s[1], Vector3.new(0.26, 0.26, 0.06), offset(s[2] * 0.25, 0.14, -0.74), glow)
			m("PixelCheek_" .. s[1], Vector3.new(0.12, 0.12, 0.06), offset(s[2] * 0.36, -0.2, -0.74), C(255, 120, 190))
		end
		for i, x in ipairs({-0.3, -0.15, 0, 0.15, 0.3}) do
			m("PixelMouth" .. i, Vector3.new(0.12, 0.12, 0.06), offset(x, i % 2 == 0 and -0.34 or -0.28, -0.74), glow)
		end
		m("PixelAntenna", Vector3.new(0.06, 0.44, 0.06), offset(0, 0.78, -0.2), C(100, 110, 150), M.Metal)
		m("PixelAntennaTip", Vector3.new(0.18, 0.18, 0.18), offset(0, 1.02, -0.2), glow, nil, "Ball")
	end
end

-- ---------------------------------------------------------------------------------------
-- Effects: sprint trails and rarity auras. Both are tiny and switched off by distance LOD elsewhere.
-- ---------------------------------------------------------------------------------------
local function addTrail(folder, rig, id)
	if id ~= "trail_cyan" and id ~= "trail_sunset" and id ~= "trail_rainbow" and id ~= "trail_flame" and id ~= "trail_candy" then return end
	local root = rig:FindFirstChild("HumanoidRootPart")
	local mount = attach(folder, root, "TrailMount", Vector3.new(0.05, 0.05, 0.05), offset(0, -0.55, 0.6), Color3.new())
	if not mount then return end
	mount.Transparency = 1
	local a, b = Instance.new("Attachment"), Instance.new("Attachment")
	a.Position, b.Position = Vector3.new(-0.5, 0, 0), Vector3.new(0.5, 0, 0)
	a.Parent, b.Parent = mount, mount
	local trail = Instance.new("Trail")
	trail.Name = id
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	trail.Enabled = rig:GetAttribute("CatchPreview") == true or (humanoid ~= nil and humanoid.Health > 0
		and not root.Anchored and rig:GetAttribute("RoundFrozen") ~= true
		and rig:GetAttribute("Sprinting") == true
		and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude > 3)
	trail.Attachment0, trail.Attachment1 = a, b
	if id == "trail_cyan" then trail.Color = ColorSequence.new(C(59, 236, 228), C(85, 123, 239))
	elseif id == "trail_sunset" then trail.Color = ColorSequence.new(C(255, 196, 91), C(246, 86, 135))
	elseif id == "trail_flame" then trail.Color = ColorSequence.new(C(255, 220, 90), C(255, 70, 20))
	elseif id == "trail_candy" then trail.Color = ColorSequence.new(C(255, 140, 200), C(120, 235, 200))
	else
		trail.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, C(255, 90, 120)), ColorSequenceKeypoint.new(0.35, C(255, 220, 90)),
			ColorSequenceKeypoint.new(0.7, C(90, 240, 160)), ColorSequenceKeypoint.new(1, C(100, 150, 255))})
	end
	trail.Lifetime = 0.33
	trail.MinLength = 0.08
	trail.FaceCamera = true
	trail.LightEmission = 0.4
	trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
	trail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(1, 0)})
	trail.Parent = folder
end

-- Ambient auras: one small emitter per Epic/Legendary skin. `kind` shapes the motion.
local function addAura(folder, rig, definition)
	local aura = definition.aura
	if not aura then return end
	local target = bodyPart(rig, aura.mount or "UpperTorso")
	local mount = attach(folder, target, "AuraMount", Vector3.new(0.2, 0.2, 0.2), aura.at or offset(0, 0, 0), Color3.new())
	if not mount then return end
	mount.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Name = "Aura_" .. aura.kind
	e.Color = ColorSequence.new(aura.color[1], aura.color[2])
	e.LockedToPart = aura.kind == "jet"
	e.Shape = Enum.ParticleEmitterShape.Sphere
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	if aura.kind == "gold" or aura.kind == "stars" or aura.kind == "sprinkles" then
		e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 7, NumberRange.new(1.0, 1.8), NumberRange.new(0.5, 1.5), Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, 0.8, 0)
		e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
		e.LightEmission = 0.5
	elseif aura.kind == "embers" then
		e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 9, NumberRange.new(0.9, 1.6), NumberRange.new(1.5, 3), Vector2.new(30, 30)
		e.Acceleration = Vector3.new(0, 4, 0)
		e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0)})
		e.LightEmission = 0.6
	elseif aura.kind == "jet" then
		e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 14, NumberRange.new(0.25, 0.45), NumberRange.new(5, 8), Vector2.new(8, 8)
		e.Acceleration = Vector3.new(0, -6, 0)
		e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
		e.LightEmission = 0.7
	else -- wisps
		e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 6, NumberRange.new(1.2, 2.0), NumberRange.new(0.8, 1.6), Vector2.new(60, 60)
		e.Acceleration = Vector3.new(0, 1.2, 0)
		e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1)})
		e.LightEmission = 0.3
	end
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
	e.Enabled = true
	e.Parent = mount
end

-- ---------------------------------------------------------------------------------------
-- Reversible changes to the player's own avatar (hair hiding and full-body tint).
-- ---------------------------------------------------------------------------------------
local function restoreAvatar(rig)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local transparency = descendant:GetAttribute("CatchOriginalTransparency")
			if transparency ~= nil then
				descendant.Transparency = transparency
				descendant:SetAttribute("CatchOriginalTransparency", nil)
			end
			local color = descendant:GetAttribute("CatchOriginalColor")
			if color ~= nil then
				descendant.Color = color
				descendant:SetAttribute("CatchOriginalColor", nil)
				local material = descendant:GetAttribute("CatchOriginalMaterial")
				if material ~= nil then descendant.Material = Enum.Material[material] or descendant.Material end
				descendant:SetAttribute("CatchOriginalMaterial", nil)
			end
		end
	end
	local stash = rig:FindFirstChild("CatchStash")
	if stash then
		for _, item in ipairs(stash:GetChildren()) do item.Parent = rig end
		stash:Destroy()
	end
end

local TINT_PARTS = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand",
	"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

local function hideHair(rig)
	for _, child in ipairs(rig:GetChildren()) do
		if child:IsA("Accessory") then
			local kind = child.AccessoryType
			if kind == Enum.AccessoryType.Hair or kind == Enum.AccessoryType.Hat then
				for _, part in ipairs(child:GetDescendants()) do
					if part:IsA("BasePart") then
						if part:GetAttribute("CatchOriginalTransparency") == nil then part:SetAttribute("CatchOriginalTransparency", part.Transparency) end
						part.Transparency = 1
					end
				end
			end
		end
	end
end

local function tintAvatar(rig, tint)
	for _, name in ipairs(TINT_PARTS) do
		local part = rig:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			if part:GetAttribute("CatchOriginalColor") == nil then
				part:SetAttribute("CatchOriginalColor", part.Color)
				part:SetAttribute("CatchOriginalMaterial", part.Material.Name)
			end
			part.Color, part.Material = tint.color, tint.material
		end
	end
	if tint.stashClothes then
		local stash = rig:FindFirstChild("CatchStash")
		if not stash then
			stash = Instance.new("Folder")
			stash.Name = "CatchStash"
			stash.Parent = rig
		end
		for _, child in ipairs(rig:GetChildren()) do
			if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") then child.Parent = stash end
		end
	end
end

function Appearance.Apply(rig, skinId, maskId, equipped, identity)
	-- CharacterAdded can fire before all limb parts arrive. Do not replace a good
	-- outfit or claim success until every authored attachment has a valid target.
	if not Appearance.IsRigReady(rig) then return nil end
	local old = rig:FindFirstChild("CatchAppearance")
	if old then old:Destroy() end
	restoreAvatar(rig)
	skinId = skins[skinId] and skinId or "skin_courier"
	maskId = masks[maskId] and maskId or ""
	local definition = skins[skinId]
	if definition.hidesHair then hideHair(rig) end
	if definition.tint then tintAvatar(rig, definition.tint) end
	local folder = Instance.new("Folder")
	folder.Name = "CatchAppearance"
	folder.Parent = rig
	local kit = {isR6 = rig:FindFirstChild("UpperTorso") == nil}
	kit.p = function(targetName, name, size, cf, color, material, shape, opts)
		return attach(folder, bodyPart(rig, targetName), name, size, cf, color, material, shape, opts)
	end
	definition.build(kit)
	buildMask(kit, maskId)
	addAura(folder, rig, definition)
	if equipped then addTrail(folder, rig, equipped.trails) end
	folder:SetAttribute("AppearanceVersion", Appearance.Version)
	folder:SetAttribute("SkinId", skinId)
	folder:SetAttribute("MaskId", maskId)
	rig:SetAttribute("CatchAppearanceVersion", Appearance.Version)
	rig:SetAttribute("CatchAppearanceSkinId", skinId)
	rig:SetAttribute("CatchAppearanceRig", kit.isR6 and "R6" or "R15")
	return folder
end

-- Temporary team identity is separate from persistent ownership/equipment. It never replaces a chosen
-- mask or skin and is removed on spectator/lobby roles. Hunters get cuffs, a badge and a red outline.
function Appearance.ApplyRole(rig, role)
	if not Appearance.IsRigReady(rig) then return nil end
	local old = rig:FindFirstChild("CatchRoleAppearance")
	if old then old:Destroy() end
	rig:SetAttribute("CatchAppearanceRole", role or "Lobby")
	if role ~= "Hunter" then return nil end
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "CatchRoleAppearance", rig
	local coral, dark = C(255, 84, 70), C(60, 24, 34)
	for _, side in ipairs({"Left", "Right"}) do
		local arm = bodyPart(rig, side .. "LowerArm")
		attach(folder, arm, "HunterCuff", Vector3.new(1.16, 0.3, 1.16), offset(0, 0.3, 0), dark)
		attach(folder, arm, "HunterCuffStripe", Vector3.new(1.2, 0.1, 1.2), offset(0, 0.3, 0), coral)
	end
	local chest = bodyPart(rig, "UpperTorso")
	-- A bold diagonal sash, readable from the front and the back at a distance.
	attach(folder, chest, "HunterSashFront", Vector3.new(0.42, 2.4, 0.1), offset(0, 0, -0.54, 0, 0, -38), coral)
	attach(folder, chest, "HunterSashBack", Vector3.new(0.42, 2.4, 0.1), offset(0, 0, 0.54, 0, 0, 38), coral)
	attach(folder, chest, "HunterBadge", Vector3.new(0.5, 0.5, 0.08), offset(0.55, 0.4, -0.54), coral, nil, "Disc")
	attach(folder, chest, "HunterBadgeCore", Vector3.new(0.24, 0.24, 0.06), offset(0.55, 0.4, -0.6), C(255, 235, 235), nil, "Disc")
	local highlight = Instance.new("Highlight")
	highlight.Name, highlight.Adornee = "HunterSilhouette", rig
	highlight.FillTransparency = 1
	highlight.OutlineColor, highlight.OutlineTransparency = coral, 0.2
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = folder
	return folder
end

-- ---------------------------------------------------------------------------------------
-- Previews. The best preview is the player's real avatar (built from their HumanoidDescription),
-- so what is shown is exactly what equipping produces. A neutral mannequin is the fallback.
-- ---------------------------------------------------------------------------------------
local function anchorPreview(rig)
	rig:SetAttribute("CatchPreview", true)
	for _, descendant in ipairs(rig:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide, descendant.CanTouch, descendant.CanQuery = false, false, false
		elseif descendant:IsA("BaseScript") or descendant:IsA("Sound") or descendant:IsA("BillboardGui") or descendant:IsA("ForceField")
			or descendant:IsA("Highlight") then
			descendant:Destroy()
		end
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.AutoRotate = false
	end
end

-- Build a standing model of a real avatar from a HumanoidDescription (yields; wrap in pcall + task.spawn).
function Appearance.BuildAvatar(description, rigType)
	if description == nil then return nil end
	local ok, model = pcall(function()
		return game:GetService("Players"):CreateHumanoidModelFromDescription(description, rigType or Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then return nil end
	model.Name = "CatchAvatarBase"
	anchorPreview(model)
	-- Same frame as the mannequin: root at the origin, facing -Z, so previews can share cameras.
	pcall(function() model:PivotTo(CFrame.new()) end)
	return model
end

-- Neutral classic-proportion mannequin with the engine's stock face. Used when no real avatar is available.
function Appearance.BuildMannequin(identity)
	local rig = Instance.new("Model")
	rig.Name = "CatchPreview"
	rig:SetAttribute("CatchPreview", true)
	local tone = toneFor(identity)
	local shirt = Appearance.IdentityColor(identity and identity.userId or 0)
	local pants = C(60, 72, 110)
	local positions = {
		HumanoidRootPart = Vector3.new(0, 0, 0), LowerTorso = Vector3.new(0, -0.1, 0), UpperTorso = Vector3.new(0, 0.9, 0),
		Head = Vector3.new(0, 2.35, 0),
		LeftUpperArm = Vector3.new(-1.5, 1.1, 0), RightUpperArm = Vector3.new(1.5, 1.1, 0),
		LeftLowerArm = Vector3.new(-1.5, 0, 0), RightLowerArm = Vector3.new(1.5, 0, 0),
		LeftHand = Vector3.new(-1.5, -0.7, 0), RightHand = Vector3.new(1.5, -0.7, 0),
		LeftUpperLeg = Vector3.new(-0.5, -0.9, 0), RightUpperLeg = Vector3.new(0.5, -0.9, 0),
		LeftLowerLeg = Vector3.new(-0.5, -2.1, 0), RightLowerLeg = Vector3.new(0.5, -2.1, 0),
		LeftFoot = Vector3.new(-0.5, -2.85, 0), RightFoot = Vector3.new(0.5, -2.85, 0),
	}
	local colors = {
		UpperTorso = shirt, LowerTorso = shirt, LeftUpperArm = shirt, RightUpperArm = shirt,
		LeftLowerArm = tone, RightLowerArm = tone, LeftHand = tone, RightHand = tone, Head = tone,
		LeftUpperLeg = pants, RightUpperLeg = pants, LeftLowerLeg = pants, RightLowerLeg = pants,
		LeftFoot = C(40, 40, 52), RightFoot = C(40, 40, 52),
	}
	for name, position in pairs(positions) do
		local part = Instance.new("Part")
		part.Name = name
		part.Size = name == "Head" and Vector3.new(2, 1, 1) or nominal[name]
		part.CFrame = CFrame.new(position)
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.Massless = true
		part.Color = colors[name] or tone
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		if name == "HumanoidRootPart" then part.Transparency = 1 end
		if name == "Head" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
			mesh.Parent = part
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = part
		end
		part.Parent = rig
	end
	rig.PrimaryPart = rig:FindFirstChild("HumanoidRootPart")
	-- Preview joints make the model recognizable to avatar tools without live physics.
	local joints = {
		{"Root", "HumanoidRootPart", "LowerTorso"}, {"Waist", "LowerTorso", "UpperTorso"}, {"Neck", "UpperTorso", "Head"},
		{"LeftShoulder", "UpperTorso", "LeftUpperArm"}, {"RightShoulder", "UpperTorso", "RightUpperArm"},
		{"LeftElbow", "LeftUpperArm", "LeftLowerArm"}, {"RightElbow", "RightUpperArm", "RightLowerArm"},
		{"LeftWrist", "LeftLowerArm", "LeftHand"}, {"RightWrist", "RightLowerArm", "RightHand"},
		{"LeftHip", "LowerTorso", "LeftUpperLeg"}, {"RightHip", "LowerTorso", "RightUpperLeg"},
		{"LeftKnee", "LeftUpperLeg", "LeftLowerLeg"}, {"RightKnee", "RightUpperLeg", "RightLowerLeg"},
		{"LeftAnkle", "LeftLowerLeg", "LeftFoot"}, {"RightAnkle", "RightLowerLeg", "RightFoot"},
	}
	for _, spec in ipairs(joints) do
		local joint = Instance.new("Motor6D")
		joint.Name, joint.Part0, joint.Part1 = spec[1], rig:FindFirstChild(spec[2]), rig:FindFirstChild(spec[3])
		joint.C0 = joint.Part0.CFrame:ToObjectSpace(joint.Part1.CFrame)
		joint.Parent = joint.Part0
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Health = 100
	humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.AutoRotate = false
	humanoid.Parent = rig
	return rig
end

-- `base` is an optional avatar model from BuildAvatar (cached by the caller). It is cloned, never modified.
function Appearance.BuildPreview(skinId, maskId, extra, identity, base)
	local rig
	if base and base:IsA("Model") then
		local ok, copy = pcall(function() return base:Clone() end)
		if ok and copy then
			rig = copy
			rig.Name = "CatchPreview"
			rig:SetAttribute("CatchPreview", true)
		end
	end
	rig = rig or Appearance.BuildMannequin(identity)
	Appearance.Apply(rig, skinId, maskId, extra, identity)
	return rig
end

-- Anchored showroom models cannot rely on live Motor6D physics. Animate the arm
-- geometry and its clothing together, preserving the same pose after PivotTo.
-- The returned animator is intentionally unavailable for live character rigs.
function Appearance.CreatePreviewPose(rig, victoryId)
	if not rig or not rig:IsA("Model") or rig:GetAttribute("CatchPreview") ~= true then return nil end
	if victoryId ~= "victory_wave" and victoryId ~= "victory_spin" and victoryId ~= "victory_flex" then return nil end
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local parts = {}
	local sides = {LeftUpperArm = -1, LeftLowerArm = -1, LeftHand = -1, RightUpperArm = 1, RightLowerArm = 1, RightHand = 1}
	for _, part in ipairs(rig:GetDescendants()) do
		if part:IsA("BasePart") then
			if not part.Anchored then return nil end
			local weld = part:FindFirstChildOfClass("WeldConstraint")
			local targetName = weld and weld.Part0 and weld.Part0.Name or part.Name
			local side = sides[targetName]
			if side then table.insert(parts, {part = part, side = side, rest = root.CFrame:ToObjectSpace(part.CFrame)}) end
		end
	end
	Appearance.SetMood(rig, "Win")
	return function(elapsed)
		if not rig.Parent or not root.Parent then return end
		elapsed = type(elapsed) == "number" and elapsed == elapsed and math.abs(elapsed) < math.huge and elapsed or 0
		local wave = math.sin(elapsed * 5.5)
		for _, item in ipairs(parts) do
			if item.part.Parent then
				local angle
				if victoryId == "victory_spin" then angle = item.side * 72
				elseif victoryId == "victory_flex" then angle = item.side * (95 + math.sin(elapsed * 4) * 8)
				else angle = item.side == 1 and 138 + wave * 11 or -8 end
				local pivot = CFrame.new(item.side * 1.5, 1.65, 0)
				local rotation = pivot * CFrame.Angles(0, 0, math.rad(angle)) * pivot:Inverse()
				item.part.CFrame = root.CFrame * rotation * item.rest
			end
		end
	end
end

return Appearance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[-- Original cosmetics, all cosmetic-only. Enter real experience pass IDs here.
-- The Robux price shown here is a design price: set the matching price in Creator
-- Dashboard. Roblox's purchase prompt remains the authority for charged prices.
local Catalog = {}
Catalog.Categories = {
	{id="skins",label="Skins"}, {id="masks",label="Masks"},
	{id="trails",label="Trails"}, {id="emotes",label="Emotes"},
	{id="tagEffects",label="Tag effects"}, {id="victories",label="Victories"},
	{id="nameplates",label="Nameplates"}, {id="bundles",label="Bundles"},
	{id="vip",label="VIP"},
}
local entries = {
	-- Skins are optional looks worn ON TOP of the player's own Roblox avatar (their face, hair, clothes and
	-- animations never change). Rarity tiers: Common = free, Rare = a few rounds of coins, Epic = a goal worth
	-- chasing (adds an aura), Legendary = the showpieces (adds a body treatment or aura). All cosmetic only.
	{id="skin_courier",category="skins",name="Original You",description="Just your own avatar, untouched. Everything else in here layers on top of you.",currency="Free",price=0,rarity="Common",accent={120,200,255}},
	{id="skin_rooftop",category="skins",name="Skate Kid",description="Yellow beanie with a pompom and a skateboard on your back. Reach level 5.",currency="Milestone",price=0,milestone={stat="level",value=5},rarity="Rare",accent={255,208,40}},
	{id="skin_pizza",category="skins",name="Pizza Courier",description="Red delivery cap and a giant pizza box on your back. Always on time, never caught.",currency="Coins",price=600,rarity="Rare",accent={235,60,50}},
	{id="skin_bunny",category="skins",name="Bunny Hop",description="Tall floppy ears, a fluffy tail and a big pink bow. Built for jumping.",currency="Coins",price=900,rarity="Rare",accent={255,150,200}},
	{id="skin_panda",category="skins",name="Bamboo Panda",description="A cozy panda hood and bamboo stalks tied to your back.",currency="Coins",price=1200,rarity="Rare",accent={110,200,90}},
	{id="skin_streetwear",category="skins",name="Streetwear Star",description="Cream bucket hat, chunky gold chain and a crossbody bag. Epic style.",currency="Coins",price=1800,rarity="Epic",accent={255,200,40}},
	{id="skin_candy",category="skins",name="Candy Pop",description="Ice-cream scoop hat, a giant lollipop and a sprinkle trail of sparkles.",currency="Coins",price=2600,rarity="Epic",accent={255,140,200}},
	{id="skin_cyber",category="skins",name="Jet Runner",description="Pilot goggles and a jet pack with real flames. Win 25 rounds to unlock it.",currency="Milestone",price=0,milestone={stat="wins",value=25},rarity="Epic",accent={255,140,40}},
	{id="skin_ninja",category="skins",name="Shadow Ninja",description="Red headband, katana on your back, a bold sash and shuriken at your hip.",currency="Robux",price=349,gamePassId=0,rarity="Epic",accent={230,40,50}},
	{id="skin_neonphantom",category="skins",name="Phantom Prankster",description="A purple hood and a flowing ghost cape that leaves spooky wisps behind you.",currency="Robux",price=399,gamePassId=0,rarity="Epic",accent={170,110,255}},
	{id="skin_midnight",category="skins",name="Midnight Magician",description="Starry top hat, a long flowing cape and a trail of magic stars.",currency="Robux",price=449,gamePassId=0,rarity="Epic",accent={150,90,230}},
	{id="skin_golden",category="skins",name="Golden Champion",description="You turn to solid gold. Crown, royal cape, champion belt and a shower of gold sparkles.",currency="Robux",price=599,gamePassId=0,rarity="Legendary",accent={255,200,50}},
	{id="skin_dragon",category="skins",name="Dragon Racer",description="Horns, big wings, a spiky tail and drifting embers. Win 60 rounds to earn it.",currency="Milestone",price=0,milestone={stat="wins",value=60},rarity="Legendary",accent={255,100,40}},
	-- Masks: every mask works with every skin and sits in front of your real face.
	{id="mask_street",category="masks",name="Street Bandana",description="A teal polka-dot bandana pulled up over your nose. Yours from the start.",currency="Free",price=0,rarity="Common",accent={40,196,190}},
	{id="mask_visor",category="masks",name="Cool Shades",description="Dark wraparound shades with a hot-pink frame.",currency="Coins",price=300,rarity="Rare",accent={255,90,160}},
	{id="mask_ninja",category="masks",name="Shinobi Wrap",description="A dark face wrap with a crimson stripe and a trailing tail.",currency="Coins",price=450,rarity="Rare",accent={226,48,58}},
	{id="mask_jester",category="masks",name="Jester Grin",description="Split-color jester face with bells, pointed brows and a huge toothy grin.",currency="Coins",price=900,rarity="Epic",accent={150,90,230}},
	{id="mask_pixel",category="masks",name="Pixel Visage",description="A game-screen face with a smiling pixel mouth and an antenna. Make 75 tags to unlock.",currency="Milestone",price=0,milestone={stat="tags",value=75},rarity="Epic",accent={80,235,160}},
	{id="mask_phantom",category="masks",name="Phantom Mask",description="An ivory phantom face with faceted cheeks, gold brows and temple filigree.",currency="Robux",price=149,gamePassId=0,rarity="Epic",accent={202,188,255}},
	{id="mask_kitsune",category="masks",name="Kitsune Mask",description="Sculpted fox ears, an ivory muzzle and vermilion markings.",currency="Robux",price=199,gamePassId=0,rarity="Epic",accent={255,119,104}},
	{id="mask_skull",category="masks",name="Gold Skull Mask",description="A gilded skull face with glowing red eyes and an engraved brow.",currency="Robux",price=349,gamePassId=0,rarity="Legendary",accent={255,204,91}},
	{id="trail_cyan",category="trails",name="Afterglow",description="A cyan ribbon that wakes up while you sprint.",currency="Coins",price=250,rarity="Rare",accent={87,238,237}},
	{id="trail_sunset",category="trails",name="Sunset Circuit",description="Warm coral light for runners who have earned 20 wins.",currency="Milestone",price=0,milestone={stat="wins",value=20},rarity="Epic",accent={255,140,117}},
	{id="trail_rainbow",category="trails",name="Prism Streak",description="A shifting rainbow ribbon behind every sprint.",currency="Coins",price=1500,rarity="Epic",accent={255,200,90}},
	{id="trail_flame",category="trails",name="Hot Foot",description="A blazing orange streak for fast feet.",currency="Coins",price=900,rarity="Rare",accent={255,150,50}},
	{id="trail_candy",category="trails",name="Candy Swirl",description="Bubblegum pink and mint ribbons. Sweet and speedy.",currency="Coins",price=1600,rarity="Epic",accent={255,140,200}},
	{id="tag_spark",category="tagEffects",name="Signal Burst",description="A crisp cyan pulse on every successful catch.",currency="Free",price=0,rarity="Common",accent={81,231,240}},
	{id="tag_bloom",category="tagEffects",name="Cherry Bloom",description="A coral burst of petals. Unlock after 50 tags.",currency="Milestone",price=0,milestone={stat="tags",value=50},rarity="Epic",accent={255,128,174}},
	{id="tag_star",category="tagEffects",name="Star Pop",description="A burst of golden stars on every catch.",currency="Coins",price=700,rarity="Rare",accent={255,208,64}},
	{id="tag_confetti",category="tagEffects",name="Party Pop",description="Rainbow confetti for every catch. Win 40 rounds to unlock.",currency="Milestone",price=0,milestone={stat="wins",value=40},rarity="Epic",accent={255,120,200}},
	{id="victory_wave",category="victories",name="Mall Salute",description="Wave to the whole mall from the winners' podium.",currency="Free",price=0,rarity="Common",accent={121,228,231}},
	{id="victory_spin",category="victories",name="Victory Lap",description="An animated podium turn with both arms up.",currency="Coins",price=350,rarity="Rare",accent={255,190,95}},
	{id="victory_flex",category="victories",name="Champion Flex",description="Strike a power pose and hold it for the crowd.",currency="Coins",price=600,rarity="Rare",accent={255,160,80}},
	{id="emote_wave",category="emotes",name="Hey, Shopper",description="A friendly wave in the lobby or after a round.",currency="Free",price=0,rarity="Common",accent={112,215,242}},
	{id="emote_dance",category="emotes",name="Food Court Shuffle",description="A quick shoulder-and-step dance for your crew.",currency="Coins",price=220,rarity="Rare",accent={221,151,255}},
	{id="name_rookie",category="nameplates",name="MALL NEWCOMER",description="Every mall legend starts somewhere.",currency="Free",price=0,rarity="Common",accent={172,193,208}},
	{id="name_survivor",category="nameplates",name="UNTOUCHABLE",description="Earn 10 wins and let your name do the talking.",currency="Milestone",price=0,milestone={stat="wins",value=10},rarity="Rare",accent={87,238,237}},
	{id="name_legend",category="nameplates",name="MALL LEGEND",description="Reach level 30. A badge of long-term mastery.",currency="Milestone",price=0,milestone={stat="level",value=30},rarity="Legendary",accent={255,204,91}},
	{id="name_regular",category="nameplates",name="MALL REGULAR",description="Finish 50 rounds. You know every shortcut by heart.",currency="Milestone",price=0,milestone={stat="rounds",value=50},rarity="Rare",accent={120,226,198}},
	{id="name_relentless",category="nameplates",name="RELENTLESS",description="Catch 100 runners. Nobody stays hidden for long.",currency="Milestone",price=0,milestone={stat="tags",value=100},rarity="Rare",accent={255,128,120}},
	{id="name_hotstreak",category="nameplates",name="HOT STREAK",description="Win 5 rounds in a row.",currency="Milestone",price=0,milestone={stat="bestStreak",value=5},rarity="Epic",accent={255,160,90}},
	{id="name_apex",category="nameplates",name="APEX HUNTER",description="Win 15 rounds as a hunter.",currency="Milestone",price=0,milestone={stat="hunterWins",value=15},rarity="Epic",accent={255,88,109}},
	{id="name_ghost",category="nameplates",name="GHOST RUNNER",description="Survive 3,000 seconds across your career.",currency="Milestone",price=0,milestone={stat="survived",value=3000},rarity="Epic",accent={190,170,255}},
	{id="bundle_night",category="bundles",name="Midnight Collection",description="Midnight Magician, Phantom Mask and Afterglow trail. Appearance only.",currency="Robux",price=649,gamePassId=0,grants={"skin_midnight","mask_phantom","trail_cyan"},rarity="Legendary",accent={190,110,255}},
	{id="bundle_ninja",category="bundles",name="Shadow Ninja Crew",description="Shadow Ninja, Shinobi Wrap and Sunset Circuit trail. Appearance only.",currency="Robux",price=549,gamePassId=0,grants={"skin_ninja","mask_ninja","trail_sunset"},rarity="Epic",accent={226,48,58}},
	{id="vip_founder",category="vip",name="Superstar Club",description="Streetwear Star, Jester Grin and Food Court Shuffle. No XP, speed or currency boosts.",currency="Robux",price=799,gamePassId=0,grants={"skin_streetwear","mask_jester","emote_dance"},rarity="Legendary",accent={255,204,91}},
}
Catalog.Items = {}
for order, item in ipairs(entries) do
	item.order = order
	Catalog.Items[item.id] = item
end
Catalog.DefaultEquipment = {
	skins="skin_courier", masks="", trails="", tagEffects="tag_spark",
	victories="victory_wave", emotes="emote_wave", nameplates="name_rookie",
}
function Catalog.Get(id) return Catalog.Items[id] end
-- Developer-product coin packs. Coins only ever buy cosmetics, so these are convenience, never power.
-- productId stays 0 until a real developer product is created; a 0 pack can be seen but never prompts.
Catalog.Products = {
	{id="coins_pocket",name="Pocket Change",coins=500,robux=49,productId=0,accent={255,208,64}},
	{id="coins_bag",name="Shopping Bag",coins=1200,robux=99,productId=0,accent={86,232,142}},
	{id="coins_haul",name="Mall Haul",coins=3200,robux=249,productId=0,accent={52,220,255}},
	{id="coins_mogul",name="Mall Mogul",coins=9000,robux=599,productId=0,accent={255,96,184}},
}
Catalog.ProductsById = {}
for _, product in ipairs(Catalog.Products) do Catalog.ProductsById[product.id] = product end
function Catalog.Product(id) return Catalog.ProductsById[id] end
function Catalog.ProductByRobloxId(productId)
	if type(productId) ~= "number" or productId <= 0 then return nil end
	for _, product in ipairs(Catalog.Products) do
		if product.productId == productId then return product end
	end
	return nil
end
function Catalog.ForCategory(category)
	local result = {}
	for _, item in ipairs(entries) do
		if item.category == category then table.insert(result, item) end
	end
	return result
end
function Catalog.IsEquippable(category)
	return Catalog.DefaultEquipment[category] ~= nil
end
function Catalog.DefaultOwned()
	local owned = {}
	for _, item in ipairs(entries) do
		if item.currency == "Free" then owned[item.id] = true end
	end
	return owned
end
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Shared tunables. Prices and pass IDs live in Catalog.lua.
local Config = {
	GameName = "CATCH ME IF YOU CAN",
	Version = "0.5.0",
	-- "Mall" (default) or "NeonHeights" (the earlier rooftop map, kept as an alternate).
	Map = "Mall",
	Round = {
		MaxPlayers = 12, MinimumPlayers = 2, Duration = 180, Intermission = 16,
		ResultsDuration = 10, HeadStart = 5, FinalSeconds = 30, RespawnDelay = 2, ScareDistance = 34,
		StudioSolo = true,
	},
	Movement = {
		WalkSpeed = 17, RunnerSprint = 26, HunterSprint = 27, Acceleration = 7,
		JumpPower = 48, SlideSpeed = 35, SlideDuration = 0.72, SlideCooldown = 3,
		SlideAccelerationTime = 0.1, SlideMinimumSpeed = 4,
		VaultCooldown = 1.1, VaultDistance = 5, VaultHeight = 4.5,
		TagRange = 5.8, TagCooldown = 0.65,
	},
	Persistence = {
		StoreName = "CatchMeIfYouCan_v1", AutosaveSeconds = 60, Retries = 3,
		UseStudioDataStores = false, SessionLockSeconds = 180,
	},
	Progression = {
		RoundXP = 45, WinXP = 80, TagXP = 25, SurvivalXPPerSecond = 0.4,
		RoundCoins = 12, WinCoins = 25, TagCoins = 6,
		PickupXP = 3, PickupCoins = 1, CloseCallXP = 5, FindXP = 8,
	},
	-- Hiding, searching and scanning: tuned so hiding is a short breather, never a safe zone.
	Hide = {
		MaxSeconds = 7, Cooldown = 12, SpotLock = 3, SearchCooldown = 0.9, PromptSlack = 4,
		ScanCooldown = 25, ScanRadius = 45, ScanDuration = 2.2,
		PickupRadius = 4.6, PickupCap = 25, CloseCallNear = 7, CloseCallFar = 22, CloseCallMax = 5, CloseCallGap = 8,
	},
	-- Only set IDs for audio you own or have permission to use in this experience.
	-- Music=0 is silent; SFX=0 use quiet engine-bundled cues. Positive IDs override.
	-- Unavailable audio is skipped; every action also has visual feedback.
	Audio = {
		Music = 0, Sprint = 0, Slide = 0, Vault = 0, Land = 0, Tag = 0, Win = 0, Lose = 0,
		Level = 0, Countdown = 0, Final = 0, Purchase = 0,
		-- Mall gameplay cues. Leave 0 to use the bundled engine fallbacks; paste a verified rbxassetid to override.
		Pickup = 0, CloseCall = 0, Found = 0, Hide = 0, Reveal = 0, Scan = 0,
		-- Looping mall ambience (crowd, fountain, muzak) under the music; 0 = silent.
		Ambience = 0,
	},
}
return table.freeze(Config)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Modifiers</string>
          <string name="Source"><![CDATA[-- Round modifiers: pure data and selection so the server and tests share one definition.
-- Every modifier applies equally to both teams; none can be bought.
local Modifiers = {}

local list = {
	{id="classic", name="CLASSIC CHASE", tagline="Caught runners watch the chase. Survive until time runs out.",
		minPlayers=2, weight=3, duration=180},
	{id="infection", name="INFECTION", tagline="Caught runners join the hunt. Be the last runner standing.",
		minPlayers=4, weight=3, duration=180, infection=true, infectDelay=4, infectCutoff=6},
	{id="swarm", name="SWARM", tagline="Extra hunter, shorter chase. Stay moving.",
		minPlayers=6, weight=2, duration=120, extraHunters=1},
	{id="frenzy", name="SLIDE FRENZY", tagline="Slides and vaults recharge twice as fast for everyone.",
		minPlayers=2, weight=2, duration=180, cooldownScale=0.5},
}
Modifiers.List = list
Modifiers.ById = {}
for _, modifier in ipairs(list) do Modifiers.ById[modifier.id] = modifier end
Modifiers.Default = Modifiers.ById.classic

function Modifiers.Get(id)
	return Modifiers.ById[id] or Modifiers.Default
end

-- Hunters for a modifier: never leave fewer than two runners, never fewer than one hunter.
function Modifiers.HunterCount(modifier, playerCount, baseCount)
	local count = baseCount + (modifier.extraHunters or 0)
	return math.max(math.min(count, playerCount - 2), math.min(baseCount, 1) )
end

-- Weighted choice among modifiers the lobby is big enough for, avoiding an immediate repeat.
-- `roll` is a function(maximumInclusive) -> integer in [1, maximum]. Practice is always Classic.
function Modifiers.Pick(playerCount, lastId, practice, roll)
	if practice then return Modifiers.Default end
	local pool, total = {}, 0
	for _, modifier in ipairs(list) do
		if playerCount >= modifier.minPlayers and modifier.id ~= lastId then
			table.insert(pool, modifier)
			total += modifier.weight
		end
	end
	if #pool == 0 then return Modifiers.Default end
	local target = roll(total)
	for _, modifier in ipairs(pool) do
		target -= modifier.weight
		if target <= 0 then return modifier end
	end
	return pool[#pool]
end

-- Safe subset for clients.
function Modifiers.Public(modifier)
	return {id=modifier.id, name=modifier.name, tagline=modifier.tagline, duration=modifier.duration}
end

return Modifiers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- Pure domain rules. Works in Roblox and in the standalone Luau test runner.
local Catalog = if script then require(script.Parent.Catalog) else require("./Catalog")
local Rules = {}
local MAX_NUMBER = 1000000000
local function integer(value, fallback, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return fallback end
	return math.clamp(math.floor(value), 0, maximum or MAX_NUMBER)
end
function Rules.HunterCount(count)
	count = integer(count, 0, 12)
	if count < 2 then return 0 end
	return if count >= 7 then 2 else 1
end
function Rules.XPForLevel(level)
	level = math.clamp(integer(level, 1, 10000), 1, 10000)
	return 100 * (level - 1) + 25 * (level - 1) * (level - 1)
end
function Rules.LevelFromXP(xp)
	xp = integer(xp, 0)
	return math.floor((-100 + math.sqrt(10000 + 100 * xp)) / 50) + 1
end
function Rules.Rank(rating)
	rating = integer(rating, 1000)
	if rating >= 1800 then return "Skyline Elite" end
	if rating >= 1500 then return "Diamond" end
	if rating >= 1250 then return "Gold" end
	if rating >= 1000 then return "Silver" end
	return "Bronze"
end
function Rules.DayKey(timestamp)
	return os.date("!%Y-%m-%d", timestamp or os.time())
end
function Rules.DailyQuests(_dayKey)
	return {
		{id="play_3",text="Finish 3 competitive rounds",stat="rounds",goal=3,xp=100,coins=40},
		{id="tag_5",text="Catch 5 runners",stat="tags",goal=5,xp=125,coins=50},
		{id="survive_120",text="Survive for 120 seconds",stat="survived",goal=120,xp=100,coins=40},
	}
end
-- Seven-day login cycle. Coins and a little XP only; nothing here affects chase outcomes.
Rules.LoginCycle = {
	{coins=25,xp=25}, {coins=30,xp=25}, {coins=40,xp=30}, {coins=50,xp=30},
	{coins=60,xp=40}, {coins=75,xp=40}, {coins=150,xp=75},
}
-- Returns nil when today's reward was already claimed, else the streak this claim would reach.
function Rules.NextLoginStreak(login, now)
	local today = Rules.DayKey(now)
	if login.lastClaim == today then return nil end
	local yesterday = Rules.DayKey((now or os.time()) - 86400)
	if login.lastClaim == yesterday then return login.streak + 1 end
	return 1
end
function Rules.LoginReward(streak)
	streak = math.max(1, integer(streak, 1))
	return Rules.LoginCycle[((streak - 1) % #Rules.LoginCycle) + 1], ((streak - 1) % #Rules.LoginCycle) + 1
end
function Rules.NewProfile(now)
	return {
		schemaVersion=1, coins=0, xp=0, level=1, rating=1000, streak=0, bestStreak=0,
		stats={rounds=0,wins=0,hunterWins=0,runnerWins=0,tags=0,survived=0,pickups=0,finds=0,closeCalls=0},
		owned=Catalog.DefaultOwned(), equipped=table.clone(Catalog.DefaultEquipment),
		settings={music=true,sfx=true,reducedMotion=false,cameraShake=true,tutorialDone=false},
		daily={day=Rules.DayKey(now),progress={rounds=0,tags=0,survived=0},claimed={}},
		achievements={},
		login={streak=0,lastClaim=""},
	}
end
function Rules.NormalizeProfile(raw, now)
	local result = Rules.NewProfile(now)
	if type(raw) ~= "table" then return result end
	for _, key in ipairs({"coins","xp","rating","streak","bestStreak"}) do
		result[key] = integer(raw[key], result[key])
	end
	result.level = Rules.LevelFromXP(result.xp)
	result.bestStreak = math.max(result.bestStreak, result.streak)
	if type(raw.stats) == "table" then
		for key in pairs(result.stats) do result.stats[key] = integer(raw.stats[key], 0) end
	end
	if type(raw.owned) == "table" then
		for id, owned in pairs(raw.owned) do
			if type(id) == "string" and Catalog.Get(id) and owned == true then result.owned[id] = true end
		end
	end
	if type(raw.equipped) == "table" then
		for category in pairs(result.equipped) do
			local id = raw.equipped[category]
			local item = type(id) == "string" and Catalog.Get(id)
			if id == "" then result.equipped[category] = ""
			elseif item and item.category == category and result.owned[id] then result.equipped[category] = id end
		end
	end
	if type(raw.settings) == "table" then
		for key in pairs(result.settings) do
			if type(raw.settings[key]) == "boolean" then result.settings[key] = raw.settings[key] end
		end
	end
	if type(raw.daily) == "table" and raw.daily.day == result.daily.day then
		if type(raw.daily.progress) == "table" then
			for key in pairs(result.daily.progress) do result.daily.progress[key] = integer(raw.daily.progress[key], 0) end
		end
		if type(raw.daily.claimed) == "table" then
			for _, quest in ipairs(Rules.DailyQuests(result.daily.day)) do
				if raw.daily.claimed[quest.id] == true then result.daily.claimed[quest.id] = true end
			end
		end
	end
	if type(raw.login) == "table" then
		result.login.streak = integer(raw.login.streak, 0, 100000)
		local last = raw.login.lastClaim
		if type(last) == "string" and (last == "" or last:match("^%d%d%d%d%-%d%d%-%d%d$")) then result.login.lastClaim = last end
	end
	if type(raw.achievements) == "table" then
		for id, value in pairs(raw.achievements) do
			if type(id) == "string" and #id < 80 and (value == true or type(value) == "number") then
				result.achievements[id] = if value == true then true else integer(value, 0)
			end
		end
	end
	return result
end
function Rules.QuestProgress(profile, quest)
	local progress = profile.daily and profile.daily.progress or {}
	return math.clamp(integer(progress[quest.stat], 0), 0, quest.goal)
end
function Rules.RoundReward(summary, config)
	if summary.practice then return {xp=0,coins=0,rating=0} end
	local progression = config.Progression or config
	local tags = if summary.role == "Hunter" then integer(summary.tags, 0, 10) else 0
	local survived = integer(summary.survived, 0, 180)
	local win = summary.win == true
	-- Runner objectives: coin pickups and close calls. Hunter objective: finding hidden runners.
	local pickups = if summary.role == "Runner" then integer(summary.pickups, 0, 25) else 0
	local closeCalls = if summary.role == "Runner" then integer(summary.closeCalls, 0, 5) else 0
	local finds = if summary.role == "Hunter" then integer(summary.finds, 0, 10) else 0
	return {
		xp=math.floor(progression.RoundXP + tags * progression.TagXP + survived * progression.SurvivalXPPerSecond + (if win then progression.WinXP else 0)
			+ pickups * (progression.PickupXP or 0) + closeCalls * (progression.CloseCallXP or 0) + finds * (progression.FindXP or 0)),
		coins=progression.RoundCoins + tags * progression.TagCoins + (if win then progression.WinCoins else 0) + pickups * (progression.PickupCoins or 0),
		rating=if win then 24 else -14,
		pickups=pickups, closeCalls=closeCalls, finds=finds, tags=tags, survived=survived,
	}
end
return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">CatchServer</string>
      </Properties>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- The server is the only authority for rounds, movement intent, inventory and rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
Players.CharacterAutoLoads = false
local shared = ReplicatedStorage:WaitForChild("CatchShared")
local Config = require(shared.Config)
local Catalog = require(shared.Catalog)
local Rules = require(shared.Rules)
local Modifiers = require(shared.Modifiers)
local Achievements = require(shared.Achievements)
local MapBuilder = require(script.Parent.World[Config.Map == "NeonHeights" and "MapBuilder" or "MallBuilder"])

local remotesFolder = Instance.new("Folder")
remotesFolder.Name = "CatchRemotes"
local remotes = {}
for _, name in ipairs({"State", "Action", "Profile", "Notice", "Query"}) do
	local remote = Instance.new(if name == "Query" then "RemoteFunction" else "RemoteEvent")
	remote.Name = name
	remote.Parent = remotesFolder
	remotes[name] = remote
end
local ctx = {Config=Config, Catalog=Catalog, Rules=Rules, Modifiers=Modifiers, Achievements=Achievements, Remotes=remotes, Services={}}
ctx.World = MapBuilder.Build()
for _, name in ipairs({"DataService", "CosmeticService", "ShopService", "MovementService", "RoundService", "HideService", "HubService"}) do
	ctx.Services[name] = require(script.Parent.Services[name]).new(ctx)
end

local limits = {
	Sprint={capacity=6,refill=4}, Slide={capacity=3,refill=1}, Vault={capacity=5,refill=3},
	Tag={capacity=5,refill=4}, Equip={capacity=4,refill=2}, Buy={capacity=2,refill=0.5},
	ClaimQuest={capacity=3,refill=1}, ClaimLogin={capacity=2,refill=0.2}, Settings={capacity=4,refill=2}, Emote={capacity=2,refill=0.5},
	Scan={capacity=2,refill=0.2}, Unhide={capacity=3,refill=1}, BuyCoins={capacity=2,refill=0.3},
}
local buckets = {}
local queryTimes = {}
local function allow(player, action)
	local rule = limits[action]
	if not rule then return false end
	local byPlayer = buckets[player]
	if not byPlayer then byPlayer = {}; buckets[player] = byPlayer end
	local now = os.clock()
	local bucket = byPlayer[action] or {tokens=rule.capacity,time=now}
	byPlayer[action] = bucket
	bucket.tokens = math.min(rule.capacity, bucket.tokens + (now-bucket.time)*rule.refill)
	bucket.time = now
	if bucket.tokens < 1 then return false end
	bucket.tokens -= 1
	return true
end
local function validPayload(payload)
	if type(payload) ~= "table" then return false end
	local count = 0
	for key, value in pairs(payload) do
		count += 1
		if count > 8 or type(key) ~= "string" or #key > 30 then return false end
		if type(value) == "string" then
			if #value > 80 then return false end
		elseif type(value) ~= "boolean" then return false end
	end
	return true
end
local function dispatch(player, action, payload)
	if type(action) ~= "string" or #action > 20 or not allow(player, action) then return end
	payload = payload or {}
	if not validPayload(payload) or not ctx.Services.DataService:Ready(player) then return end
	if action == "Sprint" or action == "Slide" or action == "Vault" then
		ctx.Services.MovementService:Handle(player, action, payload)
	elseif action == "Tag" then
	ctx.Services.RoundService:TryTag(player)
	elseif action == "Scan" then
	ctx.Services.HideService:Scan(player)
	elseif action == "Unhide" then
	ctx.Services.HideService:Leave(player)
	elseif action == "Equip" then
		if type(payload.category)=="string" and type(payload.id)=="string" then ctx.Services.DataService:Equip(player,payload.category,payload.id) end
	elseif action == "Buy" then
		if type(payload.id)=="string" then ctx.Services.ShopService:Purchase(player,payload.id) end
	elseif action == "BuyCoins" then
		if type(payload.id)=="string" then ctx.Services.ShopService:PurchaseProduct(player,payload.id) end
	elseif action == "ClaimQuest" then
		if type(payload.id)=="string" then ctx.Services.DataService:ClaimQuest(player,payload.id) end
	elseif action == "ClaimLogin" then
		ctx.Services.DataService:ClaimLogin(player)
	elseif action == "Settings" then
		ctx.Services.DataService:UpdateSettings(player, payload)
	elseif action == "Emote" then
		if type(payload.id)=="string" then ctx.Services.CosmeticService:Emote(player,payload.id) end
	end
end
remotes.Action.OnServerEvent:Connect(function(player, action, payload)
	local ok, err = pcall(dispatch, player, action, payload)
	if not ok then warn("[Catch] Action failed:", action, err) end
end)
remotes.Query.OnServerInvoke = function(player)
	local now = os.clock()
	if queryTimes[player] and now-queryTimes[player] < 0.75 then return nil end
	queryTimes[player] = now
	return {state=ctx.Services.RoundService:Snapshot(),profile=ctx.Services.DataService:Snapshot(player)}
end
Players.PlayerRemoving:Connect(function(player) buckets[player]=nil; queryTimes[player]=nil end)
for _, name in ipairs({"DataService", "CosmeticService", "ShopService", "MovementService", "RoundService", "HideService", "HubService"}) do
	local service = ctx.Services[name]
	if service.Start then service:Start() end
end
-- Publish only after handlers and service state are initialized.
remotesFolder.Parent = ReplicatedStorage
print("[Catch] " .. tostring(ctx.World.Model:GetAttribute("MapName") or "Map") .. " initialized. " .. Config.Version)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Appearance = require(ReplicatedStorage:WaitForChild("CatchShared"):WaitForChild("Appearance"))

local CosmeticService = {}
CosmeticService.__index = CosmeticService

local function plateStyle(catalog, plateId)
	local item = catalog and (catalog.Get(plateId) or catalog.Get("name_rookie"))
	local rgb = item and item.accent or {160,189,210}
	return {label = item and item.name or "MALL NEWCOMER", color = Color3.fromRGB(rgb[1],rgb[2],rgb[3])}
end

local function text(parent, name, value, size, position, color, bold)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size, label.Position = size,position
	label.Text = value
	label.FontFace = Font.fromEnum(bold and Enum.Font.GothamBold or Enum.Font.GothamMedium)
	label.TextSize = bold and 15 or 10
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.fromRGB(12,17,28)
	label.TextStrokeTransparency = 0.35
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = parent
	return label
end

local function nameplate(folder, rig, displayName, plateId, title, catalog, userId)
	local head = rig:FindFirstChild("Head")
	if not head then return end
	local style = plateStyle(catalog, plateId)
	local gui = Instance.new("BillboardGui")
	gui.Name = "CatchNameplate"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(200,52)
	gui.StudsOffset = Vector3.new(0,1.65,0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 70
	gui.Parent = folder
	text(gui,"Identity",displayName,UDim2.fromScale(1,0.55),UDim2.fromScale(0,0),Color3.fromRGB(255,255,255),true)
	-- A per-player identity bar keeps every runner recognizable whatever they wear.
	local bar = Instance.new("Frame")
	bar.Name = "IdentityBar"
	bar.BackgroundColor3 = Appearance.IdentityColor(userId)
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0.5,0)
	bar.Position = UDim2.fromScale(0.5,0.56)
	bar.Size = UDim2.fromOffset(46,3)
	bar.Parent = gui
	if title or plateId ~= "" then
		text(gui,"Title",title or style.label,UDim2.fromScale(1,0.38),UDim2.fromScale(0,0.62),style.color,false)
	end
end

local function ownedEquipment(ctx, profile)
	local result = {}
	for category, fallback in pairs(ctx.Catalog.DefaultEquipment) do
		local id = profile.equipped and profile.equipped[category] or fallback
		local item = ctx.Catalog.Get(id)
		if id == "" then
			result[category] = ""
		elseif item and item.category == category and profile.owned and profile.owned[id] then
			result[category] = id
		else
			result[category] = fallback
		end
	end
	return result
end

function CosmeticService.new(ctx)
	return setmetatable({ctx=ctx, connections={}, playerConnections={}, characterConnections={}, emotes={}, lastEmote={}, podiums=nil, podiumSpin=nil, pendingLook={}, moodClock=0},CosmeticService)
end

function CosmeticService:_inRound(player)
	local round = self.ctx.Services.RoundService
	return round ~= nil and round.IsActive ~= nil and round:IsActive(player) == true
end

function CosmeticService:Apply(player, refreshLoadingAppearance, force)
	local data = self.ctx.Services.DataService
	local profile = data and data:Get(player)
	local rig = player.Character
	if not Appearance.IsRigReady(rig) then return false end
	-- A slow profile read should not expose an unfinished avatar. Render the free
	-- outfit once while loading; DataService reapplies verified owned items on load.
	if not profile and not refreshLoadingAppearance and rig:FindFirstChild("CatchAppearance")
		and rig:GetAttribute("CatchAppearanceVersion") == Appearance.Version then return false end
	-- Never change a participant's silhouette mid-chase: the choice is saved at once but the
	-- new look is applied when they are next out of the round (results, lobby, or respawn).
	if profile and not force and rig:FindFirstChild("CatchAppearance") and self:_inRound(player) then
		if not self.pendingLook[player] then
			self.pendingLook[player] = true
			self.ctx.Remotes.Notice:FireClient(player,{kind="toast",text="Saved! Your new look appears after this round."})
		end
		return true
	end
	self.pendingLook[player] = nil
	local equipped = profile and ownedEquipment(self.ctx,profile) or self.ctx.Catalog.DefaultEquipment
	local previousSkin = rig:GetAttribute("CatchAppearanceSkinId")
	local folder = Appearance.Apply(rig,equipped.skins,equipped.masks,equipped,{userId=player.UserId})
	if not folder then return false end
	if profile and previousSkin ~= nil and previousSkin ~= equipped.skins then self:_celebrate(rig,equipped.skins) end
	nameplate(folder,rig,player.DisplayName,equipped.nameplates,nil,self.ctx.Catalog,player.UserId)
	Appearance.ApplyRole(rig,player:GetAttribute("RoundRole") or rig:GetAttribute("RoundRole") or "Lobby")
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	return profile ~= nil
end

-- A short rarity-colored sparkle burst when a better look is equipped. Cosmetic only and capped to one emitter.
local BURST = {Rare={count=14,color=Color3.fromRGB(90,180,255)},Epic={count=24,color=Color3.fromRGB(200,120,255)},Legendary={count=40,color=Color3.fromRGB(255,205,70)}}
function CosmeticService:_celebrate(rig,skinId)
	local item = self.ctx.Catalog.Get(skinId)
	local style = item and BURST[item.rarity]
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not style or not root then return end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "CatchEquipBurst"
	emitter.Color = ColorSequence.new(style.color,Color3.fromRGB(255,255,255))
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Lifetime = NumberRange.new(0.7,1.2)
	emitter.Speed = NumberRange.new(8,15)
	emitter.SpreadAngle = Vector2.new(180,180)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,0.9),NumberSequenceKeypoint.new(1,0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)})
	emitter.LightEmission = 0.6
	emitter.Rate = 0
	emitter.Parent = root
	emitter:Emit(style.count)
	game:GetService("Debris"):AddItem(emitter,1.6)
end

function CosmeticService:UpdateRole(player)
	local rig = player.Character
	if rig and rig:FindFirstChild("CatchAppearance") then
		local role = player:GetAttribute("RoundRole") or rig:GetAttribute("RoundRole") or "Lobby"
		if rig:GetAttribute("CatchAppearanceRole") ~= role then Appearance.ApplyRole(rig,role) end
	end
end

function CosmeticService:Preview(rig, skinId, maskId, extra)
	return Appearance.Apply(rig,skinId,maskId,extra)
end

function CosmeticService:TagEffect(hunter, target)
	local profile = self.ctx.Services.DataService:Get(hunter)
	local rig = target and (target:IsA("Player") and target.Character or target)
	local root = rig and rig:FindFirstChild("HumanoidRootPart")
	if not profile or not root then return end
	local equipped = ownedEquipment(self.ctx,profile)
	self.ctx.Remotes.Notice:FireAllClients({kind="tag",position=root.Position,userId=hunter.UserId,
		victimUserId=target:IsA("Player") and target.UserId or nil,action=equipped.tagEffects or "tag_spark"})
end

function CosmeticService:_stopEmote(player)
	local current = self.emotes[player]
	if not current then return end
	self.emotes[player] = nil
	if current.connection then current.connection:Disconnect() end
	for motor,original in pairs(current.motors) do
		if motor.Parent then motor.C0 = original end
	end
	if current.character.Parent then current.character:SetAttribute("CatchEmoting",false) end
end

function CosmeticService:_canEmote(player)
	local round = self.ctx.Services.RoundService
	if not round then return false end
	local phase = round:Snapshot().phase
	if phase ~= "Waiting" and phase ~= "Intermission" and phase ~= "Results" then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid ~= nil and humanoid.Health > 0 and root ~= nil
end

function CosmeticService:Emote(player, id)
	if type(id) ~= "string" or (id ~= "emote_wave" and id ~= "emote_dance") then return false end
	local profile = self.ctx.Services.DataService:Get(player)
	if not profile or not profile.owned[id] or profile.equipped.emotes ~= id then return false end
	if not self:_canEmote(player) then
		self.ctx.Remotes.Notice:FireClient(player,{kind="toast",text="Emotes are available in the lobby and on the results screen."})
		return false
	end
	local now = os.clock()
	if now-(self.lastEmote[player] or -10) < 2 then return false end
	self.lastEmote[player] = now
	self:_stopEmote(player)
	local character = player.Character
	local motors = {}
	local named = {}
	for _, descendant in ipairs(character:GetDescendants()) do
		local jointName = descendant.Name:gsub("%s", "")
		if descendant:IsA("Motor6D") and (jointName == "RightShoulder" or jointName == "LeftShoulder" or jointName == "Waist") then
			motors[descendant] = descendant.C0
			named[jointName] = descendant
		end
	end
	local current = {character=character,motors=motors,connection=nil}
	self.emotes[player] = current
	character:SetAttribute("CatchEmoting",true)
	local duration = id == "emote_wave" and 3.4 or 5.0
	current.connection = RunService.Heartbeat:Connect(function()
		local elapsed = os.clock()-now
		local root = character:FindFirstChild("HumanoidRootPart")
		if self.emotes[player] ~= current or player.Character ~= character or not root or elapsed > duration or not self:_canEmote(player)
			or Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude > 4 then
			self:_stopEmote(player)
			return
		end
		local weight = math.min(1,elapsed/0.20,(duration-elapsed)/0.25)
		local wave = math.sin(elapsed*10)
		if named.RightShoulder then
			local pose = id=="emote_wave" and CFrame.Angles(math.rad(-20),0,math.rad(135+wave*18))
				or CFrame.Angles(math.rad(-25+math.sin(elapsed*6)*20),0,math.rad(65+wave*18))
			named.RightShoulder.C0 = motors[named.RightShoulder] * CFrame.new():Lerp(pose,weight)
		end
		if id=="emote_dance" then
			if named.LeftShoulder then named.LeftShoulder.C0 = motors[named.LeftShoulder] * CFrame.Angles(math.rad(-25-math.sin(elapsed*6)*20)*weight,0,math.rad(-65+wave*18)*weight) end
			if named.Waist then named.Waist.C0 = motors[named.Waist] * CFrame.Angles(0,math.sin(elapsed*6)*0.20*weight,math.sin(elapsed*6)*0.10*weight) end
		end
	end)
	return true
end

-- Winners stand on the podium as their REAL avatar (from their HumanoidDescription) wearing their equipped
-- cosmetics. If the description cannot be fetched, a neutral mannequin wearing the same cosmetics is used.
function CosmeticService:_buildShowcase(player,profile)
	local equipped = ownedEquipment(self.ctx,profile)
	local base
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local ok,description = pcall(function() return humanoid:GetAppliedDescription() end)
		if ok and description then base = Appearance.BuildAvatar(description,humanoid.RigType) end
	end
	local rig = Appearance.BuildPreview(equipped.skins,equipped.masks,equipped,{userId=player.UserId},base)
	if base then base:Destroy() end
	return rig,equipped
end

function CosmeticService:ShowWinners(players)
	if self.podiumSpin then self.podiumSpin:Disconnect(); self.podiumSpin=nil end
	if self.podiums then self.podiums:Destroy(); self.podiums=nil end
	if type(players) ~= "table" or #players == 0 then return end
	local positions = self.ctx.World and self.ctx.World.Podiums
	if not positions or #positions == 0 then return end
	local folder = Instance.new("Folder")
	folder.Name = "CatchWinnerShowcase"
	folder.Parent = workspace
	self.podiums = folder
	local showcases = {}
	local began = os.clock()
	for index=1,math.min(#players,#positions) do
		local player = players[index]
		local profile = self.ctx.Services.DataService:Get(player)
		if profile then
			task.spawn(function()
				local ok,rig,equipped = pcall(function() return self:_buildShowcase(player,profile) end)
				if not ok or not rig then return end
				if self.podiums ~= folder or not folder.Parent then rig:Destroy(); return end
				rig.Name = "Winner_"..tostring(player.UserId)
				rig.Parent = folder
				rig:PivotTo(positions[index])
				nameplate(rig.CatchAppearance,rig,player.DisplayName,equipped.nameplates,"CHASE CHAMPION",self.ctx.Catalog,player.UserId)
				local animate = Appearance.CreatePreviewPose(rig,equipped.victories)
				if animate then
					animate(0)
					table.insert(showcases,{rig=rig,origin=positions[index],spin=equipped.victories=="victory_spin",animate=animate})
				end
			end)
		end
	end
	self.podiumSpin = RunService.Heartbeat:Connect(function()
		if not folder.Parent then
			if self.podiumSpin then self.podiumSpin:Disconnect(); self.podiumSpin=nil end
			return
		end
		local elapsed = os.clock()-began
		for _, item in ipairs(showcases) do
			if item.rig.Parent then
				if item.spin then item.rig:PivotTo(item.origin*CFrame.Angles(0,elapsed*0.7,0)) end
				item.animate(elapsed)
			end
		end
	end)
end

function CosmeticService:_watchPlayer(player)
	if self.playerConnections[player] then return end
	local function clearCharacter()
		for _, connection in ipairs(self.characterConnections[player] or {}) do connection:Disconnect() end
		self.characterConnections[player] = nil
	end
	local function applyWhenReady(character)
		clearCharacter()
		local refreshQueued = false
		self.characterConnections[player] = {
			character:GetAttributeChangedSignal("RoundRole"):Connect(function() self:UpdateRole(player) end),
			character.ChildAdded:Connect(function(child)
				-- Roblox may insert BodyColors/accessories after CharacterAdded even
				-- when LoadCharacterAppearance is disabled. Our own folders are ignored.
				if (child:IsA("BodyColors") or child:IsA("Accessory") or child:IsA("BasePart") or child:IsA("Humanoid")) and not refreshQueued then
					refreshQueued = true
					task.defer(function()
						refreshQueued = false
						if player.Character==character then self:Apply(player,true) end
					end)
				end
			end),
		}
		task.spawn(function()
			local deadline = os.clock()+20
			while player.Parent and player.Character==character and os.clock()<deadline do
				if self:Apply(player) then return end
				task.wait(0.25)
			end
			if player.Character==character and not character:FindFirstChild("CatchAppearance") then
				warn("[Catch cosmetics] Outfit unavailable for "..tostring(player.UserId).."; character needs a complete R15 or R6 rig. Appearance version "..Appearance.Version)
			end
		end)
	end
	self.playerConnections[player] = {
		player.CharacterAdded:Connect(function(character) self:_stopEmote(player); applyWhenReady(character) end),
		player.CharacterAppearanceLoaded:Connect(function(character)
			if player.Character == character then self:Apply(player,true) end
		end),
		player.CharacterRemoving:Connect(function() self:_stopEmote(player); clearCharacter() end),
		player:GetAttributeChangedSignal("RoundRole"):Connect(function() self:UpdateRole(player) end),
	}
	if player.Character then applyWhenReady(player.Character) end
end

-- Moods drive replicated face geometry; the round service owns the facts behind them.
function CosmeticService:_updateMoods()
	local round = self.ctx.Services.RoundService
	if not round or not round.MoodFor then return end
	for _, player in ipairs(Players:GetPlayers()) do
		local rig = player.Character
		if rig and rig:FindFirstChild("CatchAppearance") then
			local mood = round:MoodFor(player)
			if rig:GetAttribute("CatchMood") ~= mood then rig:SetAttribute("CatchMood",mood) end
			Appearance.SetMood(rig,mood)
			local plate = rig.CatchAppearance:FindFirstChild("CatchNameplate")
			if plate then
				local visible = rig:GetAttribute("CatchHiding") ~= true
				if plate.Enabled ~= visible then plate.Enabled = visible end
			end
		end
	end
end

function CosmeticService:_flushPending()
	for player in pairs(self.pendingLook) do
		if not self:_inRound(player) then
			self:Apply(player,false,true)
		end
	end
end

function CosmeticService:_updateTrails()
	for _, player in ipairs(Players:GetPlayers()) do
		local rig = player.Character
		local root = rig and rig:FindFirstChild("HumanoidRootPart")
		local folder = rig and rig:FindFirstChild("CatchAppearance")
		local humanoid = rig and rig:FindFirstChildOfClass("Humanoid")
		if folder then
			local enabled = root ~= nil and humanoid ~= nil and humanoid.Health > 0 and not root.Anchored
				and rig:GetAttribute("RoundFrozen") ~= true and rig:GetAttribute("Sprinting") == true
				and Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude > 3
			for _, effect in ipairs(folder:GetChildren()) do
				if effect:IsA("Trail") and effect.Enabled ~= enabled then effect.Enabled = enabled end
			end
		end
	end
end

function CosmeticService:Start()
	if self.started then return end
	self.started = true
	local elapsed = 0
	table.insert(self.connections, RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.15 then
			self.moodClock += elapsed
			elapsed = 0
			self:_updateTrails()
			if self.moodClock >= 0.45 then
				self.moodClock = 0
				self:_flushPending()
				self:_updateMoods()
			end
		end
	end))
	table.insert(self.connections,Players.PlayerAdded:Connect(function(player) self:_watchPlayer(player) end))
	table.insert(self.connections,Players.PlayerRemoving:Connect(function(player)
		self:_stopEmote(player)
		for _, connection in ipairs(self.playerConnections[player] or {}) do connection:Disconnect() end
		for _, connection in ipairs(self.characterConnections[player] or {}) do connection:Disconnect() end
		self.playerConnections[player] = nil
		self.characterConnections[player] = nil
		self.lastEmote[player] = nil
		self.pendingLook[player] = nil
	end))
	for _, player in ipairs(Players:GetPlayers()) do self:_watchPlayer(player) end
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Server-owned profiles. Every persistent write holds a renewable UpdateAsync lease.
-- Gameplay mutations never yield; saves take immutable snapshots and preserve newer edits.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local DataService = {}
DataService.__index = DataService

local FORMAT = "CatchMeIfYouCan.profile.v1"
local MAX_COUNTER = 1000000000
local function clone(value)
	if type(value) ~= "table" then return value end
	local copy = {}
	for key, child in pairs(value) do copy[key] = clone(child) end
	return copy
end

local function number(value, minimum, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return minimum end
	return math.clamp(math.floor(value), minimum, maximum)
end

local function add(value, amount)
	return number(value + amount, 0, MAX_COUNTER)
end

-- A future schema, malformed record, or unknown envelope is never replaced with defaults.
local function decode(raw)
	if raw == nil then return nil, nil end
	if type(raw) ~= "table" then return nil, "unsupported" end
	if raw._format == FORMAT then
		if type(raw.profile) ~= "table" or raw.profile.schemaVersion ~= 1 or type(raw.profile.stats) ~= "table"
			or type(raw.profile.owned) ~= "table" or type(raw.profile.equipped) ~= "table" then return nil, "unsupported" end
		if raw.session ~= nil then
			if type(raw.session) ~= "table" or type(raw.session.id) ~= "string"
				or type(raw.session.expiresAt) ~= "number" or raw.session.expiresAt ~= raw.session.expiresAt
				or math.abs(raw.session.expiresAt) == math.huge then return nil, "unsupported" end
		end
		return raw, nil
	end
	-- Supports the documented initial flat schema without accepting unrelated tables.
	if raw._format == nil and raw.schemaVersion == 1 and type(raw.stats) == "table"
		and type(raw.owned) == "table" and type(raw.equipped) == "table" then
		return { _format = FORMAT, profile = raw }, nil
	end
	return nil, "unsupported"
end

function DataService.new(ctx)
	local self = setmetatable({}, DataService)
	self.ctx = ctx
	self.records = {}
	self.sessionId = (game.JobId ~= "" and game.JobId or "studio") .. ":" .. HttpService:GenerateGUID(false)
	self.config = ctx.Config.Persistence
	self.sessionOnly = RunService:IsStudio() and self.config.UseStudioDataStores ~= true
	self.closing = false
	self.activeLoads = 0
	if not self.sessionOnly then
		local ok, store = pcall(function() return DataStoreService:GetDataStore(self.config.StoreName) end)
		if ok then self.store = store end
	end
	return self
end

function DataService:_Notice(player, text, kind)
	if player.Parent == Players then self.ctx.Remotes.Notice:FireClient(player, { kind = kind or "toast", text = text }) end
end

function DataService:_Sanitize(raw)
	local profile = self.ctx.Rules.NormalizeProfile(raw, os.time())
	for id in pairs(profile.owned) do
		if not self.ctx.Catalog.Get(id) then profile.owned[id] = nil end
	end
	for id in pairs(self.ctx.Catalog.DefaultOwned()) do profile.owned[id] = true end
	for category, id in pairs(profile.equipped) do
		local item = self.ctx.Catalog.Get(id)
		if not self.ctx.Catalog.IsEquippable(category) then
			profile.equipped[category] = nil
		elseif id ~= "" and (not item or item.category ~= category or not profile.owned[id]) then
			profile.equipped[category] = self.ctx.Catalog.DefaultEquipment[category] or ""
		end
	end
	return profile
end

function DataService:_Dirty(record)
	record.revision += 1
	if record.writable then record.saveMessage = "Changes pending autosave." end
end

function DataService:_RollDay(record)
	local day = self.ctx.Rules.DayKey(os.time())
	if record.profile.daily.day ~= day then
		record.profile.daily = { day = day, progress = { rounds = 0, tags = 0, survived = 0 }, claimed = {} }
		self:_Dirty(record)
	end
end

function DataService:_Leaderboard(player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then folder = Instance.new("Folder"); folder.Name = "leaderstats"; folder.Parent = player end
	local values = { Level = profile.level, Wins = profile.stats.wins, Tags = profile.stats.tags, Rating = profile.rating }
	for name, value in pairs(values) do
		local stat = folder:FindFirstChild(name)
		if not stat then stat = Instance.new("IntValue"); stat.Name = name; stat.Parent = folder end
		if stat:IsA("IntValue") then stat.Value = value end
	end
end

function DataService:_Unlocks(record, notify)
	local profile = record.profile
	local changed = false
	for _, definition in ipairs(self.ctx.Achievements.List) do
		local progress = profile.stats[definition.stat] or profile[definition.stat] or 0
		if progress >= definition.goal and not profile.achievements[definition.id] then
			profile.achievements[definition.id] = true
			profile.coins = add(profile.coins, definition.coins or 0)
			changed = true
			if notify then
				self:_Notice(record.player, "Achievement: " .. definition.name .. " · +" .. (definition.coins or 0) .. " coins", "unlock")
			end
		end
	end
	for id, item in pairs(self.ctx.Catalog.Items) do
		local milestone = item.milestone
		if milestone and not profile.owned[id] then
			local progress = profile.stats[milestone.stat] or profile[milestone.stat] or 0
			if progress >= milestone.value then
				profile.owned[id] = true
				for _, grantedId in ipairs(item.grants or {}) do
					if self.ctx.Catalog.Get(grantedId) then profile.owned[grantedId] = true end
				end
				changed = true
				if notify then self:_Notice(record.player, "Unlocked " .. item.name, "unlock") end
			end
		end
	end
	if changed then self:_Dirty(record) end
end

function DataService:_Load(player)
	if self.records[player] or self.closing then return end
	local record = {
		player = player, loaded = false, accepting = true, departed = false, writable = false,
		revision = 0, savedRevision = 0, awarded = {}, receipts = {}, productRevision = {}, saving = false,
		persistence = self.sessionOnly and "session" or "unavailable",
		lockId = self.sessionId .. ":" .. HttpService:GenerateGUID(false), writeSequence = 0,
	}
	self.records[player] = record
	self.activeLoads += 1
	local loadedProfile, receiptList
	local failure = "unavailable"
	if self.store then
		for attempt = 1, number(self.config.Retries or 3, 1, 5) do
			if self.closing or record.departed then break end
			local denied
			local ok, result = pcall(function()
				return self.store:UpdateAsync("player_" .. player.UserId, function(raw)
					denied = nil
					local current, decodeError = decode(raw)
					if decodeError then denied = decodeError; return nil end
					local now = os.time()
					if current and current.session and current.session.id ~= record.lockId
						and current.session.expiresAt > now then denied = "locked"; return nil end
					local profile = self:_Sanitize(current and current.profile or self.ctx.Rules.NewProfile(now))
					local receipts = {}
					for _, receipt in ipairs(current and type(current.receipts) == "table" and current.receipts or {}) do
						if type(receipt) == "string" and #receipt <= 160 and #receipts < 40 then table.insert(receipts, receipt) end
					end
					return {
						_format = FORMAT, profile = profile, receipts = receipts, updatedAt = now,
						session = { id = record.lockId, expiresAt = now + number(self.config.SessionLockSeconds or 180, 90, 600) },
					}
				end)
			end)
			if ok and result and not denied then
				loadedProfile, receiptList = result.profile, result.receipts
				record.writable = true
				record.persistence = "saved"
				record.saveMessage = "Saved."
				break
			end
			failure = denied or "unavailable"
			if denied then break end
			if attempt < number(self.config.Retries or 3, 1, 5) then task.wait(2 ^ (attempt - 1)) end
		end
	end
	if not loadedProfile then
		loadedProfile = self.ctx.Rules.NewProfile(os.time())
		if self.sessionOnly then
			record.saveMessage = "Studio session only. Progress resets when this test ends."
		elseif failure == "locked" then
			record.saveMessage = "Your profile is active on another server. This session will not save; rejoin after leaving that server."
		elseif failure == "unsupported" then
			record.saveMessage = "Stored data needs a newer compatible server. Existing data is protected; this session will not save."
		else
			record.saveMessage = "Data storage is unavailable. This session will not save; rejoin to retry loading."
		end
	end
	record.profile = self:_Sanitize(loadedProfile)
	record.receipts = receiptList or {}
	for _, receipt in ipairs(record.receipts) do record.awarded[receipt] = true end
	record.loaded = true
	self:_RollDay(record)
	self:_Unlocks(record, false)
	if record.departed or self.closing or player.Parent ~= Players then
		record.accepting = false
		self:_SaveRecord(record, true)
		if self.records[player] == record then self.records[player] = nil end
		-- BindToClose must keep waiting while a load that finished during shutdown
		-- is still saving and releasing its newly acquired lease.
		self.activeLoads -= 1
		return
	end
	self.activeLoads -= 1
	self:_Leaderboard(player, record.profile)
	player:SetAttribute("DataReady", true)
	self:Send(player)
	if record.persistence ~= "saved" then self:_Notice(player, record.saveMessage) end
	local cosmeticService = self.ctx.Services.CosmeticService
	if cosmeticService and player.Character then task.defer(function() cosmeticService:Apply(player) end) end
end

function DataService:Get(player)
	local record = self.records[player]
	return record and record.loaded and record.profile or nil
end

function DataService:Ready(player)
	local record = self.records[player]
	return record ~= nil and record.loaded and record.accepting and not self.closing
end

function DataService:Snapshot(player)
	local record = self.records[player]
	if not record or not record.loaded then return { loaded = false, persistence = "unavailable", saveMessage = "Loading profile…" } end
	self:_RollDay(record)
	local snapshot = clone(record.profile)
	snapshot.loaded = true
	snapshot.persistence = record.persistence
	snapshot.saveMessage = record.saveMessage
	snapshot.rank = self.ctx.Rules.Rank(snapshot.rating)
	local login = snapshot.login
	local nextStreak = self.ctx.Rules.NextLoginStreak(login, os.time())
	local reward, day = self.ctx.Rules.LoginReward(nextStreak or login.streak)
	snapshot.loginStatus = {
		streak = login.streak, canClaim = nextStreak ~= nil, day = day, coins = reward.coins, xp = reward.xp,
		cycle = self.ctx.Rules.LoginCycle,
	}
	snapshot.quests = {}
	for _, quest in ipairs(self.ctx.Rules.DailyQuests(snapshot.daily.day)) do
		table.insert(snapshot.quests, {
			id = quest.id, text = quest.text, progress = self.ctx.Rules.QuestProgress(snapshot, quest), goal = quest.goal,
			claimed = snapshot.daily.claimed[quest.id] == true, xp = quest.xp, coins = quest.coins,
		})
	end
	return snapshot
end

function DataService:Send(player)
	if player.Parent == Players then self.ctx.Remotes.Profile:FireClient(player, self:Snapshot(player)) end
end

function DataService:_AfterProgress(record, previousLevel)
	local profile = record.profile
	profile.level = self.ctx.Rules.LevelFromXP(profile.xp)
	self:_Unlocks(record, true)
	self:_Leaderboard(record.player, profile)
	self:Send(record.player)
	if profile.level > previousLevel then self:_Notice(record.player, "Level " .. profile.level .. " reached!", "level") end
end

function DataService:AwardRound(player, summary)
	if not self:Ready(player) or type(summary) ~= "table" or summary.practice == true then return false, "No progression in practice." end
	if (summary.role ~= "Hunter" and summary.role ~= "Runner") or type(summary.win) ~= "boolean"
		or type(summary.roundId) ~= "number" or summary.roundId ~= number(summary.roundId, 1, MAX_COUNTER) then return false, "Invalid round." end
	local record = self.records[player]
	local receipt = self.sessionId .. ":" .. tostring(summary.roundId)
	if record.awarded[receipt] then return false, "Round already rewarded." end
	local hide = self.ctx.Config.Hide or {}
	local safe = {
		role = summary.role, win = summary.win, practice = false, roundId = summary.roundId,
		tags = summary.role == "Hunter" and number(summary.tags, 0, self.ctx.Config.Round.MaxPlayers) or 0,
		survived = number(summary.survived, 0, self.ctx.Config.Round.Duration),
		pickups = summary.role == "Runner" and number(summary.pickups, 0, hide.PickupCap or 25) or 0,
		closeCalls = summary.role == "Runner" and number(summary.closeCalls, 0, hide.CloseCallMax or 5) or 0,
		finds = summary.role == "Hunter" and number(summary.finds, 0, 10) or 0,
	}
	local reward = self.ctx.Rules.RoundReward(safe, self.ctx.Config)
	-- Record receipt before changing balances; this section contains no yielding calls.
	record.awarded[receipt] = true
	table.insert(record.receipts, receipt)
	if #record.receipts > 40 then table.remove(record.receipts, 1) end
	self:_RollDay(record)
	local profile, previousLevel = record.profile, record.profile.level
	profile.coins = add(profile.coins, number(reward.coins, 0, MAX_COUNTER))
	profile.xp = add(profile.xp, number(reward.xp, 0, MAX_COUNTER))
	profile.rating = number(profile.rating + number(reward.rating, -1000, 1000), 0, MAX_COUNTER)
	profile.stats.rounds = add(profile.stats.rounds, 1)
	profile.stats.tags = add(profile.stats.tags, safe.tags)
	profile.stats.survived = add(profile.stats.survived, safe.survived)
	profile.stats.pickups = add(profile.stats.pickups or 0, safe.pickups)
	profile.stats.finds = add(profile.stats.finds or 0, safe.finds)
	profile.stats.closeCalls = add(profile.stats.closeCalls or 0, safe.closeCalls)
	profile.daily.progress.rounds = add(profile.daily.progress.rounds, 1)
	profile.daily.progress.tags = add(profile.daily.progress.tags, safe.tags)
	profile.daily.progress.survived = add(profile.daily.progress.survived, safe.survived)
	if safe.win then
		profile.stats.wins = add(profile.stats.wins, 1)
		local stat = safe.role == "Hunter" and "hunterWins" or "runnerWins"
		profile.stats[stat] = add(profile.stats[stat], 1)
		profile.streak = add(profile.streak, 1)
		profile.bestStreak = math.max(profile.bestStreak, profile.streak)
	else profile.streak = 0 end
	self:_Dirty(record)
	self:_AfterProgress(record, previousLevel)
	task.defer(function() self:Save(player) end)
	return true, {
		xp = number(reward.xp, 0, MAX_COUNTER), coins = number(reward.coins, 0, MAX_COUNTER), rating = reward.rating,
		pickups = safe.pickups, closeCalls = safe.closeCalls, finds = safe.finds, tags = safe.tags, survived = safe.survived,
		win = safe.win, role = safe.role, level = profile.level, totalCoins = profile.coins, totalXP = profile.xp,
	}
end

function DataService:Grant(player, ids, source)
	if not self:Ready(player) then return false, "Profile is not ready." end
	if type(ids) ~= "table" then return false, "Invalid grant." end
	local record = self.records[player]
	local changed = false
	for _, id in ipairs(ids) do
		local item = type(id) == "string" and self.ctx.Catalog.Get(id)
		if item then
			if not record.profile.owned[id] then record.profile.owned[id] = true; changed = true end
			for _, grantedId in ipairs(item.grants or {}) do
				if self.ctx.Catalog.Get(grantedId) and not record.profile.owned[grantedId] then
					record.profile.owned[grantedId] = true; changed = true
				end
			end
		end
	end
	if changed then
		self:_Dirty(record)
		self:Send(player)
		if source then self:_Notice(player, source, "unlock") end
		task.defer(function() self:Save(player) end)
	end
	return true, changed and "Granted." or "Already owned."
end

-- Developer-product coins. Idempotent per Roblox PurchaseId and only reports success once the
-- balance is durable (or the server is intentionally session-only, as in Studio).
function DataService:GrantProductCoins(player, purchaseId, coins)
	if not self:Ready(player) then return false, "not_ready" end
	if type(purchaseId) ~= "string" or #purchaseId == 0 or #purchaseId > 100 then return false, "invalid" end
	coins = number(coins, 0, MAX_COUNTER)
	if coins <= 0 then return false, "invalid" end
	local record = self.records[player]
	local receipt = "P:" .. purchaseId
	if not record.awarded[receipt] then
		-- Record before changing the balance; no yielding call sits between these lines.
		record.awarded[receipt] = true
		table.insert(record.receipts, receipt)
		if #record.receipts > 40 then table.remove(record.receipts, 1) end
		record.profile.coins = add(record.profile.coins, coins)
		self:_Dirty(record)
		record.productRevision[receipt] = record.revision
		self:Send(player)
	end
	if self.sessionOnly then return true, "session" end
	local needed = record.productRevision[receipt]
	if needed == nil or record.savedRevision >= needed then return true, "saved" end
	local saved = self:Save(player)
	if saved or (record.savedRevision >= needed) then return true, "saved" end
	return false, "save_failed"
end

function DataService:_PurchaseWithCoins(player, id)
	if not self:Ready(player) then return false, "Profile is not ready." end
	local item = self.ctx.Catalog.Get(id)
	if not item or item.currency ~= "Coins" or type(item.price) ~= "number"
		or item.price ~= number(item.price, 0, MAX_COUNTER) then return false, "Item cannot be purchased with coins." end
	local record = self.records[player]
	local profile = record.profile
	if profile.owned[id] then return false, "You already own this cosmetic." end
	if profile.coins < item.price then return false, "You need " .. (item.price - profile.coins) .. " more coins." end
	-- Debit and ownership are one non-yielding transaction. Never trust a client price.
	profile.coins -= item.price
	profile.owned[id] = true
	for _, grantedId in ipairs(item.grants or {}) do
		if self.ctx.Catalog.Get(grantedId) then profile.owned[grantedId] = true end
	end
	self:_Dirty(record)
	self:Send(player)
	task.defer(function() self:Save(player) end)
	local suffix = record.writable and " Saving progress…" or " Session only; progress will not save."
	return true, "Purchased " .. item.name .. "." .. suffix
end

function DataService:Equip(player, category, id)
	if not self:Ready(player) then return false, "Profile is not ready." end
	if type(category) ~= "string" or type(id) ~= "string" or not self.ctx.Catalog.IsEquippable(category) then return false, "Invalid equipment slot." end
	if category == "skins" and id == "" then id = self.ctx.Catalog.DefaultEquipment.skins end
	local record = self.records[player]
	if id ~= "" then
		local item = self.ctx.Catalog.Get(id)
		if not item or item.category ~= category or not record.profile.owned[id] then return false, "You do not own that cosmetic." end
	end
	if record.profile.equipped[category] == id then return true end
	record.profile.equipped[category] = id
	self:_Dirty(record)
	self:Send(player)
	local cosmetics = self.ctx.Services.CosmeticService
	if cosmetics then cosmetics:Apply(player) end
	return true
end

function DataService:UpdateSettings(player, settings)
	if not self:Ready(player) or type(settings) ~= "table" then return false, "Profile is not ready." end
	local record = self.records[player]
	local changed = false
	for _, key in ipairs({ "music", "sfx", "reducedMotion", "cameraShake", "tutorialDone" }) do
		if type(settings[key]) == "boolean" and record.profile.settings[key] ~= settings[key] then
			record.profile.settings[key] = settings[key]; changed = true
		end
	end
	if changed then self:_Dirty(record); self:Send(player) end
	return true
end

function DataService:ClaimQuest(player, id)
	if not self:Ready(player) or type(id) ~= "string" then return false, "Profile is not ready." end
	local record = self.records[player]
	self:_RollDay(record)
	local profile = record.profile
	for _, quest in ipairs(self.ctx.Rules.DailyQuests(profile.daily.day)) do
		if quest.id == id then
			if profile.daily.claimed[id] then return false, "Reward already claimed." end
			if self.ctx.Rules.QuestProgress(profile, quest) < quest.goal then return false, "Quest is still in progress." end
			local previousLevel = profile.level
			profile.daily.claimed[id] = true
			profile.coins = add(profile.coins, quest.coins)
			profile.xp = add(profile.xp, quest.xp)
			self:_Dirty(record)
			self:_AfterProgress(record, previousLevel)
			self:_Notice(player, "Quest claimed: +" .. quest.coins .. " coins · +" .. quest.xp .. " XP", "unlock")
			task.defer(function() self:Save(player) end)
			return true
		end
	end
	return false, "Unknown quest."
end

-- One reward per UTC day; the server decides streak, amount and eligibility.
function DataService:ClaimLogin(player)
	if not self:Ready(player) then return false, "Profile is not ready." end
	local record = self.records[player]
	local profile = record.profile
	local streak = self.ctx.Rules.NextLoginStreak(profile.login, os.time())
	if not streak then return false, "Today's reward is already claimed." end
	local reward = self.ctx.Rules.LoginReward(streak)
	local previousLevel = profile.level
	profile.login = { streak = streak, lastClaim = self.ctx.Rules.DayKey(os.time()) }
	profile.coins = add(profile.coins, reward.coins)
	profile.xp = add(profile.xp, reward.xp)
	self:_Dirty(record)
	self:_AfterProgress(record, previousLevel)
	self:_Notice(player, "Daily reward: +" .. reward.coins .. " coins · +" .. reward.xp .. " XP · day " .. streak, "unlock")
	task.defer(function() self:Save(player) end)
	return true
end

function DataService:_SaveRecord(record, release)
	if not record.loaded or not record.writable or not self.store then return false, record.saveMessage end
	-- Concurrent autosave, reward, leave, and shutdown requests share this single writer.
	while record.saving do task.wait(0.05) end
	if not record.writable or record.released then return false, record.saveMessage end
	record.saving = true
	record.writeSequence += 1
	local writeId = record.lockId .. ":" .. record.writeSequence
	local revision = record.revision
	local snapshot = self:_Sanitize(clone(record.profile))
	local receipts = clone(record.receipts)
	local succeeded = false
	local denied
	for attempt = 1, number(self.config.Retries or 3, 1, 5) do
		local alreadyCommitted = false
		local ok, result = pcall(function()
			return self.store:UpdateAsync("player_" .. record.player.UserId, function(raw)
				denied = nil
				local current, decodeError = decode(raw)
				if decodeError then denied = decodeError; return nil end
				-- A response can be lost after a commit. Releasing twice must not look like
				-- a lost lease or cause a second write, even if the first response timed out.
				if current and current.lastWriteId == writeId then alreadyCommitted = true; return nil end
				if not current or not current.session or current.session.id ~= record.lockId then denied = "lease"; return nil end
				local now = os.time()
				return {
					_format = FORMAT, profile = snapshot, receipts = receipts, updatedAt = now, lastWriteId = writeId,
					session = not release and { id = record.lockId, expiresAt = now + number(self.config.SessionLockSeconds or 180, 90, 600) } or nil,
				}
			end)
		end)
		if ok and (result or alreadyCommitted) and not denied then succeeded = true; break end
		if denied then break end
		if attempt < number(self.config.Retries or 3, 1, 5) then task.wait(2 ^ (attempt - 1)) end
	end
	if succeeded then
		record.savedRevision = math.max(record.savedRevision, revision)
		record.persistence = "saved"
		record.saveMessage = record.revision == revision and "Saved." or "Changes pending autosave."
		if release then record.released = true; record.writable = false end
	else
		record.persistence = "unavailable"
		if denied then
			record.writable = false
			record.saveMessage = "Profile access changed on the server. Further changes will not save; rejoin to reload safely."
		else record.saveMessage = "Saving failed. Your latest changes are not saved; the server will retry." end
	end
	record.saving = false
	if not record.departed and not self.closing then self:Send(record.player) end
	return succeeded, record.saveMessage
end

function DataService:Save(player)
	local record = self.records[player]
	if not record then return false, "Profile is not loaded." end
	return self:_SaveRecord(record, false)
end

function DataService:Start()
	if self.started then return end
	self.started = true
	Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_Load(player) end) end)
	Players.PlayerRemoving:Connect(function(player)
		local record = self.records[player]
		if not record then return end
		record.departed = true
		record.accepting = false
		if record.loaded then
			self:_SaveRecord(record, true)
			if self.records[player] == record then self.records[player] = nil end
		end
	end)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() self:_Load(player) end) end
	task.spawn(function()
		local interval = math.min(number(self.config.AutosaveSeconds or 60, 15, 120), number(self.config.SessionLockSeconds or 180, 90, 600) / 3)
		while not self.closing do
			task.wait(interval)
			if self.closing then break end
			for _, record in pairs(self.records) do
				if record.loaded and not record.departed then task.spawn(function() self:_SaveRecord(record, false) end) end
			end
		end
	end)
	game:BindToClose(function()
		self.closing = true
		local waiting = 0
		for _, record in pairs(self.records) do
			record.accepting = false
			if record.loaded then
				waiting += 1
				task.spawn(function() self:_SaveRecord(record, true); waiting -= 1 end)
			end
		end
		local deadline = os.clock() + 25
		while (waiting > 0 or self.activeLoads > 0) and os.clock() < deadline do task.wait(0.1) end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">HideService</string>
            <string name="Source"><![CDATA[-- Hiding, searching, scanning and mall-coin pickups. Every rule here is server-owned: clients only
-- fire ProximityPrompts or the Scan/Unhide actions; the server validates role, phase, distance,
-- cooldowns and then moves avatars itself.
--
-- Design goals: hiding is a short breather that costs a cooldown, never a safe zone. Hunters have
-- three fair counters: spot a tell (feet under the curtain), Search a cell (ejects an occupant next
-- to the searcher), or pulse a Scan that exposes nearby runners and occupied cells.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local HideService = {}
HideService.__index = HideService

local function now()
	return Workspace:GetServerTimeNow()
end

local function liveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if character and humanoid and humanoid.Health > 0 and root then
		return character, humanoid, root
	end
	return nil
end

function HideService.new(ctx)
	return setmetatable({
		ctx = ctx,
		spots = {},
		spotByPrompt = {},
		hiding = {},          -- player -> {spot, endsAt, character}
		cooldownUntil = {},   -- player -> hide cooldown deadline
		lastSearch = {},      -- hunter -> time
		scanReadyAt = {},     -- hunter -> time
		closeCall = {},       -- runner -> {near, last}
		coins = {},
		coinBuckets = {},
		connections = {},
		accumulator = 0,
	}, HideService)
end

function HideService:_config()
	return self.ctx.Config.Hide
end

function HideService:_notice(player, payload)
	if player.Parent == Players then
		self.ctx.Remotes.Notice:FireClient(player, payload)
	end
end

function HideService:_round()
	return self.ctx.Services.RoundService
end

-- Map data ---------------------------------------------------------------------------------------

function HideService:_collect()
	local model = self.ctx.World and self.ctx.World.Model
	if not model then
		return
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Model") and descendant:GetAttribute("CatchHideSpot") then
			local prompt = descendant:FindFirstChild("HidePrompt", true)
			local door = descendant:FindFirstChild("Door")
			local inside, exit = descendant:GetAttribute("InsideCFrame"), descendant:GetAttribute("ExitCFrame")
			if prompt and prompt:IsA("ProximityPrompt") and typeof(inside) == "CFrame" and typeof(exit) == "CFrame" then
				local spot = {
					id = descendant:GetAttribute("SpotId"), model = descendant, prompt = prompt, door = door,
					inside = inside, exit = exit, occupant = nil, lockedUntil = 0, anchorPart = prompt.Parent,
				}
				table.insert(self.spots, spot)
				self.spotByPrompt[prompt] = spot
				descendant:SetAttribute("Occupied", false)
				table.insert(self.connections, prompt.Triggered:Connect(function(player)
					local ok, err = pcall(function() self:_triggered(player, spot) end)
					if not ok then warn("[Catch hide] prompt failed: " .. tostring(err)) end
				end))
			end
		end
	end
	local folder = model:FindFirstChild("MallCoins")
	if folder then
		for _, coin in ipairs(folder:GetChildren()) do
			if coin:IsA("BasePart") then
				local position = coin.Position
				local record = {part = coin, position = position, collected = false}
				table.insert(self.coins, record)
				local key = math.floor(position.X / 12) .. "," .. math.floor(position.Z / 12) .. "," .. math.floor(position.Y / 12)
				local bucket = self.coinBuckets[key]
				if not bucket then
					bucket = {}
					self.coinBuckets[key] = bucket
				end
				table.insert(bucket, record)
			end
		end
	end
end

-- Hiding -----------------------------------------------------------------------------------------

function HideService:IsHiding(player)
	return self.hiding[player] ~= nil
end

function HideService:_release(player, reason, teleport)
	local state = self.hiding[player]
	if not state then
		return false
	end
	self.hiding[player] = nil
	local spot, config = state.spot, self:_config()
	spot.occupant = nil
	spot.lockedUntil = now() + config.SpotLock
	spot.model:SetAttribute("Occupied", false)
	spot.model:SetAttribute("OccupantUserId", 0)
	local character = state.character
	local movement = self.ctx.Services.MovementService
	if character and character.Parent then
		character:SetAttribute("CatchHiding", false)
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.Anchored = character:GetAttribute("RoundFrozen") == true
			if teleport then
				root.CFrame = spot.exit
				root.AssemblyLinearVelocity = Vector3.zero
			end
			if movement and player.Character == character then
				movement:ResetPlayer(player)
			end
		end
	end
	if reason ~= "round" then
		self.cooldownUntil[player] = now() + config.Cooldown
	end
	self:_notice(player, {kind = "hide", state = "out", reason = reason, cooldown = reason ~= "round" and config.Cooldown or 0})
	return true
end

function HideService:_enter(player, spot)
	local character, humanoid, root = liveCharacter(player)
	if not character or character:GetAttribute("Sliding") or character:GetAttribute("Vaulting") or character:GetAttribute("RoundFrozen") then
		return
	end
	local config = self:_config()
	local movement = self.ctx.Services.MovementService
	root.CFrame = spot.inside
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	if movement then
		movement:ResetPlayer(player)
	end
	root.Anchored = true
	humanoid.AutoRotate = false
	character:SetAttribute("CatchHiding", true)
	character:SetAttribute("Sprinting", false)
	local endsAt = now() + config.MaxSeconds
	self.hiding[player] = {spot = spot, endsAt = endsAt, character = character}
	spot.occupant = player
	spot.model:SetAttribute("Occupied", true)
	spot.model:SetAttribute("OccupantUserId", player.UserId)
	self:_notice(player, {kind = "hide", state = "in", endsAt = endsAt, duration = config.MaxSeconds, spotId = spot.id})
end

function HideService:_eject(spot, reason)
	local occupant = spot.occupant
	if not occupant then
		return nil
	end
	self:_release(occupant, reason, true)
	return occupant
end

-- A runner asks to leave early (also fired by the prompt on their own cell).
function HideService:Leave(player)
	local state = self.hiding[player]
	if not state then
		return false
	end
	-- A short minimum stay stops a flicker of in-and-out used to dodge a tag.
	if now() - (state.endsAt - self:_config().MaxSeconds) < 0.6 then
		return false
	end
	self:_release(player, "left", true)
	return true
end

function HideService:_inRange(player, spot)
	local _, _, root = liveCharacter(player)
	if not root then
		return false
	end
	local part = spot.anchorPart
	local reach = (spot.prompt.MaxActivationDistance or 8) + self:_config().PromptSlack
	return (root.Position - part.Position).Magnitude <= reach
end

function HideService:_triggered(player, spot)
	local round = self:_round()
	if not round or round.phase ~= "Active" or not round:IsActive(player) or not self:_inRange(player, spot) then
		return
	end
	local role = round:GetRole(player)
	local timestamp = now()
	local config = self:_config()
	if role == "Runner" then
		local state = self.hiding[player]
		if state then
			if state.spot == spot then
				self:Leave(player)
			end
			return
		end
		if spot.occupant then
			self:_notice(player, {kind = "toast", text = "Someone is already in there!"})
			return
		end
		if timestamp < spot.lockedUntil then
			self:_notice(player, {kind = "toast", text = "The door is still swinging. Try another spot."})
			return
		end
		local waiting = (self.cooldownUntil[player] or 0) - timestamp
		if waiting > 0 then
			self:_notice(player, {kind = "toast", text = string.format("Catch your breath: %d s until you can hide again.", math.ceil(waiting))})
			return
		end
		self:_enter(player, spot)
	elseif role == "Hunter" then
		if timestamp - (self.lastSearch[player] or -math.huge) < config.SearchCooldown then
			return
		end
		local character = player.Character
		if not character or character:GetAttribute("RoundFrozen") then
			return
		end
		self.lastSearch[player] = timestamp
		local found = self:_eject(spot, "found")
		if found then
			local entry = round.roster[player.UserId]
			if entry then entry.finds = math.min((entry.finds or 0) + 1, 10) end
			-- Everyone nearby sees the reveal; the searcher gets the discovery cue.
			self.ctx.Remotes.Notice:FireAllClients({kind = "reveal", userId = found.UserId, duration = 2.5})
			self:_notice(player, {kind = "found", text = "FOUND " .. string.upper(found.DisplayName) .. "!"})
		else
			self:_notice(player, {kind = "toast", text = "Nobody here. Keep looking!"})
		end
	end
end

-- Hunter scan ------------------------------------------------------------------------------------

function HideService:Scan(player)
	local round = self:_round()
	if not round or round.phase ~= "Active" or not round:IsActive(player) or round:GetRole(player) ~= "Hunter" then
		return false
	end
	local config, timestamp = self:_config(), now()
	if timestamp < (self.scanReadyAt[player] or 0) then
		return false
	end
	local character, _, root = liveCharacter(player)
	if not character or character:GetAttribute("RoundFrozen") then
		return false
	end
	self.scanReadyAt[player] = timestamp + config.ScanCooldown
	local targets, spots = {}, {}
	for _, entry in pairs(round.roster) do
		if entry.role == "Runner" and entry.alive and entry.player ~= player and entry.player.Parent == Players then
			local _, _, targetRoot = liveCharacter(entry.player)
			if targetRoot and (targetRoot.Position - root.Position).Magnitude <= config.ScanRadius then
				if not self.hiding[entry.player] then
					table.insert(targets, entry.player.UserId)
				end
			end
		end
	end
	-- Occupied cells are exposed as "something is in there", never as a named player.
	for _, spot in ipairs(self.spots) do
		if spot.occupant and (spot.anchorPart.Position - root.Position).Magnitude <= config.ScanRadius then
			table.insert(spots, spot.anchorPart.Position + Vector3.new(0, 4, 0))
		end
	end
	self:_notice(player, {kind = "ability", action = "Scan", cooldown = config.ScanCooldown})
	self:_notice(player, {kind = "scan", targets = targets, spots = spots, duration = config.ScanDuration})
	return true
end

-- Coins and close calls --------------------------------------------------------------------------

function HideService:_collectCoins(player, root)
	local position = root.Position
	local radius = self:_config().PickupRadius
	local cx, cz, cy = math.floor(position.X / 12), math.floor(position.Z / 12), math.floor((position.Y + 3) / 12)
	local round = self:_round()
	for dx = -1, 1 do
		for dz = -1, 1 do
			for dy = -1, 1 do
				local bucket = self.coinBuckets[(cx + dx) .. "," .. (cz + dz) .. "," .. (cy + dy)]
				if bucket then
					for _, coin in ipairs(bucket) do
						if not coin.collected and (coin.position - position).Magnitude <= radius then
							local count = round:AddPickup(player)
							if count then
								coin.collected = true
								coin.part.Transparency = 1
								coin.part:SetAttribute("Collected", true)
								for _, child in ipairs(coin.part:GetChildren()) do
									if child:IsA("BasePart") then child.Transparency = 1 end
								end
								self:_notice(player, {kind = "pickup", count = count, cap = self:_config().PickupCap, position = coin.position})
							end
						end
					end
				end
			end
		end
	end
end

function HideService:_closeCalls(player, root, hunterRoots)
	local config, timestamp = self:_config(), now()
	local record = self.closeCall[player]
	if not record then
		record = {}
		self.closeCall[player] = record
	end
	local nearest = math.huge
	for _, hunterRoot in ipairs(hunterRoots) do
		nearest = math.min(nearest, (hunterRoot.Position - root.Position).Magnitude)
	end
	if nearest <= config.CloseCallNear then
		record.near = timestamp
	elseif record.near then
		if nearest >= config.CloseCallFar then
			if timestamp - record.near <= 4 and timestamp - (record.last or -math.huge) >= config.CloseCallGap then
				record.last = timestamp
				self:_round():AddCloseCall(player)
			end
			record.near = nil
		elseif timestamp - record.near > 4 then
			record.near = nil
		end
	end
end

-- Lifecycle --------------------------------------------------------------------------------------

function HideService:ResetRound()
	for player in pairs(self.hiding) do
		self:_release(player, "round", false)
	end
	table.clear(self.cooldownUntil)
	table.clear(self.lastSearch)
	table.clear(self.scanReadyAt)
	table.clear(self.closeCall)
	for _, coin in ipairs(self.coins) do
		coin.collected = false
		coin.part.Transparency = 0
		coin.part:SetAttribute("Collected", false)
		for _, child in ipairs(coin.part:GetChildren()) do
			if child:IsA("BasePart") then child.Transparency = 0 end
		end
	end
end

function HideService:_tick()
	local round = self:_round()
	if not round then
		return
	end
	local timestamp = now()
	local active = round.phase == "Active"
	for player, state in pairs(self.hiding) do
		local character = state.character
		if not active or player.Parent ~= Players or player.Character ~= character or not round:IsActive(player)
			or round:GetRole(player) ~= "Runner" or not liveCharacter(player) then
			self:_release(player, active and "gone" or "round", false)
		elseif timestamp >= state.endsAt then
			self:_release(player, "timeout", true)
		end
	end
	if not active then
		return
	end
	local hunterRoots = {}
	for _, entry in pairs(round.roster) do
		if entry.role == "Hunter" and entry.alive and entry.player.Parent == Players then
			local _, _, root = liveCharacter(entry.player)
			if root then table.insert(hunterRoots, root) end
		end
	end
	for _, entry in pairs(round.roster) do
		local player = entry.player
		if entry.role == "Runner" and entry.alive and player.Parent == Players and not self.hiding[player] and not round.practice then
			local character, _, root = liveCharacter(player)
			if character and not character:GetAttribute("RoundFrozen") then
				if #self.coins > 0 then self:_collectCoins(player, root) end
				if #hunterRoots > 0 then self:_closeCalls(player, root, hunterRoots) end
			end
		elseif entry.role == "Runner" and entry.alive and round.practice and player.Parent == Players and not self.hiding[player] then
			-- Practice still lets you collect coins for the feel of it (no rewards are granted).
			local character, _, root = liveCharacter(player)
			if character and #self.coins > 0 then self:_collectCoins(player, root) end
		end
	end
end

function HideService:Start()
	if self.started then
		return
	end
	self.started = true
	self:_collect()
	table.insert(self.connections, RunService.Heartbeat:Connect(function(dt)
		self.accumulator += dt
		if self.accumulator >= 0.12 then
			self.accumulator = 0
			local ok, err = pcall(function() self:_tick() end)
			if not ok then warn("[Catch hide] tick failed: " .. tostring(err)) end
		end
	end))
	table.insert(self.connections, Players.PlayerRemoving:Connect(function(player)
		if self.hiding[player] then self:_release(player, "round", false) end
		self.cooldownUntil[player], self.lastSearch[player], self.scanReadyAt[player], self.closeCall[player] = nil, nil, nil, nil
	end))
end

return HideService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">HubService</string>
            <string name="Source"><![CDATA[-- The spawn hub's live parts: two leaderboards (this server, from leaderstats), the status board over the mall
-- entrance, and the Shop / Locker kiosks. Everything here is presentation: it reads public state and never
-- changes rounds, rewards or inventory. Kiosks only ask the player's own client to open a menu.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local HubService = {}
HubService.__index = HubService

local PHASE_TEXT = {
	Waiting = "WAITING FOR PLAYERS",
	Intermission = "NEXT CHASE IN",
	HeadStart = "RUNNERS GET A HEAD START",
	Active = "CHASE IN PROGRESS",
	Results = "WINNERS ON THE PODIUM",
}
local MENUS = {Shop = true, Inventory = true}

function HubService.new(ctx)
	return setmetatable({ctx = ctx, boards = {}, statusGui = nil, connections = {}, lastOpen = {}, boardClock = 0, statusClock = 0}, HubService)
end

function HubService:_collect()
	local model = self.ctx.World and self.ctx.World.Model
	if not model then return end
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and item.Name == "HubLeaderboard" then
			local gui = item:FindFirstChild("Board")
			if gui then table.insert(self.boards, {gui = gui, stat = item:GetAttribute("Stat") or "Wins"}) end
		elseif item:IsA("BasePart") and item.Name == "StatusBoard" then
			self.statusGui = item:FindFirstChild("Board")
		elseif item:IsA("ProximityPrompt") and item.Name == "MenuPrompt" then
			local menu = item.Parent and item.Parent:GetAttribute("Menu")
			if MENUS[menu] then
				table.insert(self.connections, item.Triggered:Connect(function(player) self:_openMenu(player, menu) end))
			end
		end
	end
end

-- Ask the triggering player's own client to open Shop or Locker. Throttled so a held key cannot spam.
function HubService:_openMenu(player, menu)
	local now = os.clock()
	if now - (self.lastOpen[player] or -1) < 0.6 or not MENUS[menu] then return end
	self.lastOpen[player] = now
	if player.Parent then self.ctx.Remotes.Notice:FireClient(player, {kind = "menu", menu = menu}) end
end

function HubService:_rows(stat)
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local folder = player:FindFirstChild("leaderstats")
		local value = folder and folder:FindFirstChild(stat)
		if value then table.insert(list, {name = player.DisplayName, value = value.Value, userId = player.UserId}) end
	end
	table.sort(list, function(a, b)
		if a.value == b.value then return a.userId < b.userId end
		return a.value > b.value
	end)
	return list
end

function HubService:UpdateBoards()
	for _, board in ipairs(self.boards) do
		local rows = self:_rows(board.stat)
		for index = 1, 5 do
			local label = board.gui:FindFirstChild("Row" .. index)
			if label then
				local entry = rows[index]
				local text = entry and string.format("%d.  %s  %d", index, string.sub(entry.name, 1, 14), entry.value) or (index .. ".  ---")
				if label.Text ~= text then label.Text = text end
			end
		end
	end
end

local function clock(seconds)
	local value = math.max(0, math.ceil(seconds))
	return string.format("%02d:%02d", math.floor(value / 60), value % 60)
end

function HubService:UpdateStatus()
	local gui = self.statusGui
	local round = self.ctx.Services.RoundService
	if not gui or not round then return end
	local state = round:Snapshot()
	local phase = state.practice and state.phase ~= "Results" and "SOLO PRACTICE" or (PHASE_TEXT[state.phase] or "WELCOME TO THE MALL")
	local timer = state.phase == "Waiting" and "--:--" or clock((state.endsAt or 0) - Workspace:GetServerTimeNow())
	local count = #Players:GetPlayers()
	local labels = {Phase = phase, Timer = timer, Players = count .. (count == 1 and " PLAYER" or " PLAYERS")}
	for name, text in pairs(labels) do
		local label = gui:FindFirstChild(name)
		if label and label.Text ~= text then label.Text = text end
	end
end

function HubService:Start()
	if self.started then return end
	self.started = true
	self:_collect()
	self:UpdateBoards()
	self:UpdateStatus()
	table.insert(self.connections, RunService.Heartbeat:Connect(function(dt)
		self.boardClock += dt
		self.statusClock += dt
		if self.statusClock >= 0.5 then
			self.statusClock = 0
			local ok, err = pcall(function() self:UpdateStatus() end)
			if not ok then warn("[Catch hub] status failed: " .. tostring(err)) end
		end
		if self.boardClock >= 3 then
			self.boardClock = 0
			local ok, err = pcall(function() self:UpdateBoards() end)
			if not ok then warn("[Catch hub] boards failed: " .. tostring(err)) end
		end
	end))
	table.insert(self.connections, Players.PlayerRemoving:Connect(function(player) self.lastOpen[player] = nil end))
end

return HubService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[-- Clients send intentions only. The server chooses speed, geometry, and cooldowns.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MovementService = {}
MovementService.__index = MovementService

local function now()
	return Workspace:GetServerTimeNow()
end

local function horizontal(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function finiteVector(vector)
	return vector.X == vector.X and vector.Y == vector.Y and vector.Z == vector.Z
		and math.abs(vector.X) < 1e7 and math.abs(vector.Y) < 1e7 and math.abs(vector.Z) < 1e7
end

local function avatar(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root then
		return character, humanoid, root
	end
	return nil
end

local function rayParameters(character)
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.RespectCanCollide = true
	return parameters
end

-- HipHeight measures different things on the two supported Humanoid rigs.
-- R15 already includes the legs in HipHeight; R6 keeps HipHeight at zero and
-- places its root one full leg plus half a root above the floor. Omitting that
-- leg made every grounded R6 slide fail before its actuator could be created.
local function groundOffset(character, humanoid, root)
	local offset = humanoid.HipHeight + root.Size.Y * 0.5
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
		if leg and leg:IsA("BasePart") then offset += leg.Size.Y end
	end
	return offset
end

function MovementService.new(ctx)
	return setmetatable({ ctx = ctx, states = {}, connections = {}, accumulator = 0 }, MovementService)
end

function MovementService:_state(player)
	local state = self.states[player]
	if not state then
		state = {
			sprint = false,
			slideUntil = 0,
			vaultUntil = 0,
			lastSlide = -math.huge,
			lastVault = -math.huge,
			modeId = 0,
			lastTime = now(),
			credit = 12,
		}
		self.states[player] = state
	end
	return state
end

function MovementService:_clearMotion(player, state)
	self:_finishSlide(player, state)
	state.modeId += 1
	state.sprint = false
	state.slideUntil, state.vaultUntil = 0, 0
	local character = player.Character
	if character then
		character:SetAttribute("Sprinting", false)
		character:SetAttribute("Sliding", false)
		character:SetAttribute("Vaulting", false)
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.Anchored = character:GetAttribute("RoundFrozen") == true
			if not root.Anchored then
				pcall(function()
					root:SetNetworkOwnershipAuto()
				end)
			end
		end
	end
end

function MovementService:_targetSpeed(player, state)
	local config = self.ctx.Config.Movement
	return state.sprint and (self.ctx.Services.RoundService:GetRole(player) == "Hunter" and config.HunterSprint or config.RunnerSprint)
		or config.WalkSpeed
end

-- Keep the exact old avatar references: a respawn can replace player.Character
-- before cleanup runs. No actuator or Physics state may survive its own slide.
function MovementService:_finishSlide(player, state, jump)
	local motion = state.slideMotion
	state.slideUntil = 0
	state.slideMotion = nil
	if not motion then return end
	for _, object in ipairs({ motion.velocity, motion.orientation, motion.attachment }) do
		object:Destroy()
	end
	local character, humanoid, root = motion.character, motion.humanoid, motion.root
	character:SetAttribute("Sliding", false)
	if not root.Parent or not humanoid.Parent then return end
	local frozen = character:GetAttribute("RoundFrozen") == true
	local targetSpeed = self:_targetSpeed(player, state)
	humanoid.AutoRotate = not frozen and motion.autoRotate
	humanoid.WalkSpeed = frozen and 0 or targetSpeed
	humanoid.JumpPower = frozen and 0 or self.ctx.Config.Movement.JumpPower
	if humanoid.Health > 0 then
		local velocity = horizontal(root.AssemblyLinearVelocity)
		if velocity.Magnitude > targetSpeed then velocity = velocity.Unit * targetSpeed end
		local grounded = self:_grounded(character, humanoid, root)
		local jumping = jump and grounded and not frozen
		root.AssemblyLinearVelocity = frozen and Vector3.zero or velocity + Vector3.new(0,
			jumping and self.ctx.Config.Movement.JumpPower or root.AssemblyLinearVelocity.Y, 0)
		-- Physics does not exit on its own. Restore locomotion even if the round
		-- just froze this avatar; anchoring and zero speed still hold the hunter,
		-- and releasing the head start must not leave it permanently in Physics.
		humanoid:ChangeState(jumping and Enum.HumanoidStateType.Jumping
			or (grounded and Enum.HumanoidStateType.Running or Enum.HumanoidStateType.Freefall))
		if jumping then
			state.airStart = now()
			state.groundY = root.Position.Y
		end
	end
	if not root.Anchored then
		pcall(function() root:SetNetworkOwnershipAuto() end)
	end
end

-- Only server code calls this immediately after its own spawn/teleport.
function MovementService:ResetPlayer(player)
	local state = self:_state(player)
	self:_clearMotion(player, state)
	local character, humanoid, root = avatar(player)
	state.character = character
	state.lastTime = now()
	state.lastSlide, state.lastVault = -math.huge, -math.huge
	state.airStart = nil
	state.groundY = root and root.Position.Y or 0
	state.credit = self.ctx.Config.Movement.RunnerSprint * 0.4 + 3
	state.lastPosition = root and root.Position or nil
	state.safeCFrame = root and root.CFrame or nil
	state.rejectUntil = 0
	if character then
		local frozen = character:GetAttribute("RoundFrozen") == true
		humanoid.WalkSpeed = frozen and 0 or self.ctx.Config.Movement.WalkSpeed
		humanoid.JumpPower = frozen and 0 or self.ctx.Config.Movement.JumpPower
		humanoid.AutoRotate = not frozen
	end
end

function MovementService:_grounded(character, humanoid, root)
	-- Permit small floor seams and replicated bobbing without making a taller
	-- avatar's extra leg height into an unrestricted airborne slide allowance.
	local tolerance = math.clamp(root.Size.Y * 0.625, 0.5, 1.25)
	local distance = groundOffset(character, humanoid, root) + tolerance
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -distance, 0), rayParameters(character))
	return hit ~= nil and hit.Normal.Y > 0.3, hit
end

function MovementService:_climbing(character, humanoid, root)
	if humanoid:GetState() ~= Enum.HumanoidStateType.Climbing then
		return false
	end
	-- A client-owned Humanoid state alone must not authorize unlimited ascent.
	local parameters = OverlapParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	for _, part in ipairs(Workspace:GetPartBoundsInBox(root.CFrame, Vector3.new(6, 8, 6), parameters)) do
		if part:IsA("TrussPart") then
			return true
		end
	end
	return false
end

function MovementService:_allowedSpeed(player, state)
	local config = self.ctx.Config.Movement
	if state.slideUntil > now() then
		return config.SlideSpeed + 5
	end
	if state.sprint then
		return (self.ctx.Services.RoundService:GetRole(player) == "Hunter" and config.HunterSprint or config.RunnerSprint) + 5
	end
	return config.WalkSpeed + 5
end

function MovementService:_correct(player, state, root)
	if state.safeCFrame then
		root.CFrame = state.safeCFrame
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	state.lastPosition = root.Position
	state.lastTime = now()
	state.credit = 2
	state.rejectUntil = now() + 0.35
	state.airStart = nil
	state.groundY = root.Position.Y
	self:_clearMotion(player, state)
	return false
end

-- Called both by Heartbeat and immediately before every tag/range-sensitive intent.
function MovementService:ValidatePosition(player)
	local character, humanoid, root = avatar(player)
	if not character then
		return false
	end
	local state = self:_state(player)
	if state.character ~= character or not state.lastPosition then
		self:ResetPlayer(player)
		return false
	end
	local timestamp = now()
	if timestamp < (state.rejectUntil or 0) then
		return false
	end
	if not finiteVector(root.Position) or not finiteVector(root.AssemblyLinearVelocity) then
		return self:_correct(player, state, root)
	end
	-- A vault has a server-owned, anchored trajectory and a strict expiration.
	if state.vaultUntil > timestamp and root.Anchored then
		state.lastPosition, state.safeCFrame, state.lastTime = root.Position, root.CFrame, timestamp
		return true
	end
	local dt = math.max(timestamp - state.lastTime, 0)
	if dt < 0.015 then
		-- Do not mint extra distance allowance by spamming the Tag remote.
		return (root.Position - state.lastPosition).Magnitude <= 2
	end
	local speed = self:_allowedSpeed(player, state)
	state.credit = math.min(speed * 0.55 + 3, state.credit + speed * math.min(dt, 0.75))
	local difference = root.Position - state.lastPosition
	local horizontalDistance = horizontal(difference).Magnitude
	local climbing = self:_climbing(character, humanoid, root)
	-- A nearby ladder permits climbing, but not unbounded vertical travel. Charge
	-- its full path against the same server speed budget used on the ground.
	local traveled = climbing and difference.Magnitude or horizontalDistance
	if traveled > state.credit or math.abs(difference.Y) > 110 * math.min(dt, 0.75) + 8 then
		return self:_correct(player, state, root)
	end
	if horizontalDistance > 0.25 then
		local wall = Workspace:Raycast(state.lastPosition, difference, rayParameters(character))
		if wall and wall.Instance.Anchored and math.abs(wall.Normal.Y) < 0.65 then
			local model = wall.Instance:FindFirstAncestorOfClass("Model")
			if not model or not model:FindFirstChildOfClass("Humanoid") then
				return self:_correct(player, state, root)
			end
		end
	end
	local bounds = self.ctx.World.Bounds
	if bounds and (root.Position.X < bounds.min.X - 20 or root.Position.X > bounds.max.X + 20
		or root.Position.Z < bounds.min.Z - 20 or root.Position.Z > bounds.max.Z + 20
		or root.Position.Y > bounds.max.Y + 30) then
		-- Lobby can be intentionally outside the arena bounds.
		if self.ctx.Services.RoundService:IsActive(player) then
			return self:_correct(player, state, root)
		end
	end
	local grounded = self:_grounded(character, humanoid, root)
	if grounded or climbing then
		state.airStart = nil
		state.groundY = root.Position.Y
	else
		state.airStart = state.airStart or timestamp
		local jumpRise = (self.ctx.Config.Movement.JumpPower ^ 2) / (2 * math.max(Workspace.Gravity, 1)) + 7
		if root.Position.Y - (state.groundY or root.Position.Y) > jumpRise then
			return self:_correct(player, state, root)
		end
		-- Long descents are valid. Hovering beyond a full jump is not.
		if timestamp - state.airStart > 2.4 and root.AssemblyLinearVelocity.Y > -7 then
			return self:_correct(player, state, root)
		end
	end
	state.credit -= traveled
	state.lastPosition, state.lastTime = root.Position, timestamp
	-- Retain a grounded recovery point so a flight correction cannot bless a hover.
	if grounded or climbing then
		state.safeCFrame = root.CFrame
	end
	return true
end

function MovementService:_canMove(player)
	local character, humanoid, root = avatar(player)
	if not character or character:GetAttribute("RoundFrozen") or humanoid.Sit or root.Anchored then
		return nil
	end
	if not self:ValidatePosition(player) then
		return nil
	end
	return character, humanoid, root
end

function MovementService:_cooldown(base)
	local round = self.ctx.Services.RoundService
	local scale = round and round.CooldownScale and round:CooldownScale() or 1
	return base * scale
end

function MovementService:_ack(player, action, cooldown)
	self.ctx.Remotes.Notice:FireClient(player, { kind = "ability", action = action, cooldown = cooldown })
end

function MovementService:_slide(player)
	local character, humanoid, root = self:_canMove(player)
	if not character then
		return
	end
	local state, config = self:_state(player), self.ctx.Config.Movement
	local timestamp = now()
	if timestamp - state.lastSlide < self:_cooldown(config.SlideCooldown) or state.vaultUntil > timestamp or state.slideUntil > timestamp then
		return
	end
	local momentum = horizontal(root.AssemblyLinearVelocity)
	if not self:_grounded(character, humanoid, root) or momentum.Magnitude < config.SlideMinimumSpeed then
		return
	end
	local direction = momentum.Unit
	-- Do not propel a player into a wall or launch a slide through thin geometry.
	local wall = Workspace:Raycast(root.Position - Vector3.new(0, 0.8, 0), direction * 3, rayParameters(character))
	if wall and math.abs(wall.Normal.Y) < 0.65 then
		return
	end
	state.lastSlide, state.slideUntil = timestamp, timestamp + config.SlideDuration
	state.slideDirection = direction
	state.credit = math.max(state.credit, config.SlideSpeed * 0.25)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	-- A velocity pulse once every 0.08 seconds competes with the Humanoid's
	-- ground controller. Hold a bounded horizontal target through the physics
	-- solver instead; gravity still owns Y and every obstacle remains collidable.
	local attachment = Instance.new("Attachment")
	attachment.Name = "CatchSlideAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "CatchSlideVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.ForceLimitsEnabled = true
	velocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	local force = math.max(root.AssemblyMass, 1) * 1200
	velocity.MaxPlanarAxesForce = Vector2.new(force, force)
	local initialSpeed = math.clamp(momentum.Magnitude, config.WalkSpeed, config.SlideSpeed)
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * initialSpeed
	velocity.Parent = root
	local orientation = Instance.new("AlignOrientation")
	orientation.Name = "CatchSlideUpright"
	orientation.Attachment0 = attachment
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.CFrame = CFrame.lookAt(Vector3.zero, direction)
	orientation.MaxTorque = math.max(root.AssemblyMass, 1) * 4000
	orientation.MaxAngularVelocity = 20
	orientation.Responsiveness = 40
	orientation.Parent = root
	state.slideMotion = {
		character = character, humanoid = humanoid, root = root,
		attachment = attachment, velocity = velocity, orientation = orientation,
		autoRotate = humanoid.AutoRotate, initialSpeed = initialSpeed,
	}
	humanoid.AutoRotate = false
	humanoid.WalkSpeed = 0
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	root.AssemblyAngularVelocity = Vector3.zero
	character:SetAttribute("Sliding", true)
	self:_ack(player, "Slide", self:_cooldown(config.SlideCooldown))
end

function MovementService:_stepSlide(player, state, dt)
	local motion = state.slideMotion
	if not motion then return end
	local character, humanoid, root = motion.character, motion.humanoid, motion.root
	local timestamp, config = now(), self.ctx.Config.Movement
	if player.Character ~= character or not root.Parent or humanoid.Health <= 0 or humanoid.Sit or root.Anchored
		or character:GetAttribute("RoundFrozen") or timestamp >= state.slideUntil then
		self:_finishSlide(player, state)
		return
	end
	local direction = state.slideDirection
	local grounded = self:_grounded(character, humanoid, root)
	-- A torso sweep catches corners that a single center ray misses. Leaving a
	-- ledge ends propulsion, so sliding cannot become a sustained air dash.
	local lookAhead = config.SlideSpeed * math.min(dt, 0.1) + 0.6
	local wall = Workspace:Blockcast(root.CFrame, Vector3.new(1.8, 1.5, 1.8), direction * lookAhead, rayParameters(character))
	if not grounded or (wall and math.abs(wall.Normal.Y) < 0.65) then
		self:_finishSlide(player, state)
		return
	end
	local elapsed = timestamp - state.lastSlide
	local attack = config.SlideAccelerationTime
	local alpha, speed
	if elapsed < attack then
		alpha = math.clamp(elapsed / attack, 0, 1)
		alpha = alpha * alpha * (3 - 2 * alpha)
		speed = motion.initialSpeed + (config.SlideSpeed - motion.initialSpeed) * alpha
	else
		alpha = math.clamp((elapsed - attack) / (config.SlideDuration - attack), 0, 1)
		alpha = alpha * alpha * (3 - 2 * alpha)
		speed = config.SlideSpeed + (self:_targetSpeed(player, state) - config.SlideSpeed) * alpha
	end
	motion.velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
end

function MovementService:_clearBox(character, cframe, size)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.RespectCanCollide = true
	for _, part in ipairs(Workspace:GetPartBoundsInBox(cframe, size, params)) do
		if part.CanCollide then
			return false
		end
	end
	return true
end

function MovementService:_vault(player)
	local character, humanoid, root = self:_canMove(player)
	if not character then
		return
	end
	local state, config = self:_state(player), self.ctx.Config.Movement
	local timestamp = now()
	-- Space/A/native touch Jump uses this existing intent too. Release the slide
	-- physics state immediately, then allow either a jump or the usual vault.
	if state.slideMotion then self:_finishSlide(player, state, true) end
	if timestamp - state.lastVault < self:_cooldown(config.VaultCooldown) or state.slideUntil > timestamp or state.vaultUntil > timestamp then
		return
	end
	-- Accept the beginning of a normal jump too: Space intentionally preserves Jump.
	local grounded = self:_grounded(character, humanoid, root)
	if not grounded and (not state.airStart or timestamp - state.airStart > 0.22) then
		return
	end
	local direction = horizontal(root.CFrame.LookVector)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	local params = rayParameters(character)
	local front = Workspace:Raycast(root.Position - Vector3.new(0, 1, 0), direction * config.VaultDistance, params)
	if not front or not front.Instance.Anchored or math.abs(front.Normal.Y) > 0.45 then
		return
	end
	local supportOffset = groundOffset(character, humanoid, root)
	local topOrigin = front.Position + direction * 0.7 + Vector3.new(0, config.VaultHeight + 1, 0)
	local top = Workspace:Raycast(topOrigin, Vector3.new(0, -config.VaultHeight - 2, 0), params)
	if not top or top.Normal.Y < 0.7 then
		return
	end
	local height = top.Position.Y - (root.Position.Y - supportOffset)
	if height < 0.5 or height > config.VaultHeight then
		return
	end
	local beyond = front.Position + direction * 3.2
	local landing = Workspace:Raycast(Vector3.new(beyond.X, top.Position.Y + 2, beyond.Z), Vector3.new(0, -9, 0), params)
	if not landing or landing.Normal.Y < 0.65 then
		return
	end
	local destination = Vector3.new(beyond.X, landing.Position.Y + supportOffset + 0.15, beyond.Z)
	if horizontal(destination - root.Position).Magnitude > config.VaultDistance + 3.5 then
		return
	end
	local elevatedY = math.max(root.Position.Y, destination.Y, top.Position.Y + supportOffset + 0.4)
	local elevatedStart = Vector3.new(root.Position.X, elevatedY, root.Position.Z)
	local elevatedEnd = Vector3.new(destination.X, elevatedY, destination.Z)
	local boxSize = Vector3.new(2.1, math.max(3, supportOffset * 2 - 0.5), 2.1)
	local facing = CFrame.lookAt(Vector3.zero, direction)
	local endCF = CFrame.new(destination) * facing
	if not self:_clearBox(character, endCF, boxSize)
		or not self:_clearBox(character, CFrame.new(elevatedStart) * facing, boxSize)
		or not self:_clearBox(character, CFrame.new(elevatedEnd) * facing, boxSize) then
		return
	end
	local elevatedStartCF = CFrame.new(elevatedStart) * facing
	local pathHit = Workspace:Blockcast(elevatedStartCF, boxSize, elevatedEnd - elevatedStart, params)
	local lift = elevatedStart - root.Position
	local ceiling = lift.Magnitude > 0.05 and Workspace:Blockcast(root.CFrame, boxSize, lift, params)
	if pathHit or ceiling then
		return
	end
	state.lastVault = timestamp
	state.vaultUntil = timestamp + 0.48
	state.modeId += 1
	local modeId = state.modeId
	character:SetAttribute("Vaulting", true)
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	local startPosition = root.Position
	self:_ack(player, "Vault", self:_cooldown(config.VaultCooldown))
	task.spawn(function()
		local duration = 0.4
		while now() - timestamp < duration do
			if player.Character ~= character or self.states[player] ~= state or state.modeId ~= modeId or humanoid.Health <= 0 then
				break
			end
			local alpha = math.clamp((now() - timestamp) / duration, 0, 1)
			local position
			if alpha < 0.28 then
				position = startPosition:Lerp(elevatedStart, alpha / 0.28)
			elseif alpha < 0.76 then
				position = elevatedStart:Lerp(elevatedEnd, (alpha - 0.28) / 0.48)
			else
				position = elevatedEnd:Lerp(destination, (alpha - 0.76) / 0.24)
			end
			root.CFrame = CFrame.new(position) * facing
			RunService.Heartbeat:Wait()
		end
		if self.states[player] == state and state.modeId == modeId and player.Character == character then
			if humanoid.Health > 0 then
				root.CFrame = endCF
			end
			root.Anchored = character:GetAttribute("RoundFrozen") == true
			root.AssemblyLinearVelocity = Vector3.zero
			state.vaultUntil = 0
			state.lastPosition, state.safeCFrame, state.lastTime = root.Position, root.CFrame, now()
			state.groundY, state.airStart = root.Position.Y, nil
			state.credit = config.WalkSpeed * 0.4 + 3
			character:SetAttribute("Vaulting", false)
			if not root.Anchored then
				pcall(function()
					root:SetNetworkOwnershipAuto()
				end)
			end
		end
	end)
end

function MovementService:Handle(player, action, payload)
	if action == "Sprint" then
		if type(payload) ~= "table" or type(payload.active) ~= "boolean" then
			return
		end
		local state = self:_state(player)
		if not payload.active then
			state.sprint = false
			if player.Character then
				player.Character:SetAttribute("Sprinting", false)
			end
			return
		end
		local character = self:_canMove(player)
		if character then
			state.sprint = true
			character:SetAttribute("Sprinting", true)
		end
	elseif action == "Slide" then
		self:_slide(player)
	elseif action == "Vault" then
		self:_vault(player)
	end
end

function MovementService:_step(player, dt)
	local character, humanoid, root = avatar(player)
	if not character then
		local oldState = self.states[player]
		if oldState and oldState.slideMotion then self:_finishSlide(player, oldState) end
		return
	end
	local state = self:_state(player)
	if state.character ~= character then
		self:ResetPlayer(player)
	end
	local config, timestamp = self.ctx.Config.Movement, now()
	local frozen = character:GetAttribute("RoundFrozen") == true
	if frozen then
		self:_finishSlide(player, state)
		root.Anchored = true
		humanoid.WalkSpeed, humanoid.JumpPower = 0, 0
		state.lastPosition, state.lastTime = root.Position, timestamp
		return
	end
	if not self:ValidatePosition(player) then
		return
	end
	local targetSpeed = self:_targetSpeed(player, state)
	if not state.slideMotion then
		humanoid.WalkSpeed += (targetSpeed - humanoid.WalkSpeed) * math.min(1, config.Acceleration * dt)
	end
	humanoid.JumpPower = config.JumpPower
	self:_stepSlide(player, state, dt)
	-- A fallen avatar is eliminated through the same death path as a reset.
	local bounds = self.ctx.World.Bounds
	if bounds and root.Position.Y < bounds.min.Y - 35 then
		humanoid.Health = 0
	end
end

function MovementService:Start()
	if self.started then
		return
	end
	self.started = true
	Players.PlayerRemoving:Connect(function(player)
		local state = self.states[player]
		if state then
			self:_clearMotion(player, state)
		end
		self.states[player] = nil
	end)
	RunService.Heartbeat:Connect(function(dt)
		-- Smooth actuator updates run every frame; expensive general movement
		-- validation retains its bounded 12.5 Hz cadence for twelve-player games.
		for player, state in pairs(self.states) do
			if state.slideMotion then
				local ok, err = xpcall(function() self:_stepSlide(player, state, dt) end, debug.traceback)
				if not ok then
					self:_finishSlide(player, state)
					warn("[Catch] Slide update failed: " .. tostring(err))
				end
			end
		end
		self.accumulator += dt
		if self.accumulator < 0.08 then
			return
		end
		local elapsed = self.accumulator
		self.accumulator = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local ok, err = xpcall(function()
				self:_step(player, math.min(elapsed, 0.25))
			end, debug.traceback)
			if not ok then
				warn("[Catch] Movement update failed: " .. tostring(err))
			end
		end
	end)
end

return MovementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[-- Server-owned roster, timers, tags, respawns, and progression summaries.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local RoundService = {}
RoundService.__index = RoundService

local function now()
	return Workspace:GetServerTimeNow()
end

local function liveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if character and humanoid and humanoid.Health > 0 and root then
		return character, humanoid, root
	end
	return nil
end

function RoundService.new(ctx)
	return setmetatable({
		ctx = ctx,
		phase = "Waiting",
		endsAt = 0,
		roundId = 0,
		practice = false,
		roster = {},
		winners = {},
		resultText = "Waiting for players",
		tagTimes = {},
		loading = {},
		connections = {},
		characterConnections = {},
		departing = {},
		hunterTurns = {},
		random = Random.new(),
		startedAt = 0,
		lastBroadcast = 0,
		modifier = ctx.Modifiers.Default,
		lastModifierId = nil,
	}, RoundService)
end

function RoundService:_playingPhase()
	return self.phase == "HeadStart" or self.phase == "Active"
end

-- Slide/vault cooldown multiplier for the running round (Slide Frenzy halves it).
function RoundService:CooldownScale()
	if self:_playingPhase() then
		return self.modifier.cooldownScale or 1
	end
	return 1
end

function RoundService:_pickModifier(playerCount)
	local roll = function(maximum)
		return self.random:NextInteger(1, maximum)
	end
	self.modifier = self.ctx.Modifiers.Pick(playerCount, self.lastModifierId, playerCount < 2, roll)
end

function RoundService:GetRole(player)
	local entry = self.roster[player.UserId]
	if self:_playingPhase() then
		if entry and entry.alive then
			return entry.role
		end
		return "Spectator"
	end
	return "Lobby"
end

function RoundService:IsActive(player)
	local entry = self.roster[player.UserId]
	return self:_playingPhase() and entry ~= nil and entry.alive and not self.departing[player]
end

function RoundService:_counts()
	local runners, hunters = 0, 0
	for _, entry in pairs(self.roster) do
		if entry.alive and entry.player.Parent == Players and not self.departing[entry.player] then
			if entry.role == "Runner" then
				runners += 1
			else
				hunters += 1
			end
		end
	end
	return runners, hunters
end

function RoundService:Snapshot()
	local runners = self:_counts()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if not self.departing[player] then
			local entry = self.roster[player.UserId]
			table.insert(list, {
				userId = player.UserId,
				name = player.Name,
				displayName = player.DisplayName,
				role = self:GetRole(player),
				alive = entry ~= nil and entry.alive and self:_playingPhase(),
				pickups = entry and entry.pickups or 0,
				finds = entry and entry.finds or 0,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.userId < b.userId
	end)
	return {
		phase = self.phase,
		endsAt = self.endsAt,
		roundId = self.roundId,
		practice = self.practice,
		finalChase = self.phase == "Active" and self.endsAt - now() <= self.ctx.Config.Round.FinalSeconds,
		lastRunner = self:_playingPhase() and runners == 1 and not self.practice,
		aliveRunners = runners,
		players = list,
		winners = table.clone(self.winners),
		pickupCap = self.ctx.Config.Hide.PickupCap,
		resultText = self.resultText,
		modifier = self.ctx.Modifiers.Public(self.modifier),
		mapName = self.ctx.World.Model and self.ctx.World.Model:GetAttribute("MapName") or "CATCH MALL",
	}
end

function RoundService:_broadcast()
	self.lastBroadcast = now()
	self.ctx.Remotes.State:FireAllClients(self:Snapshot())
end

function RoundService:_notice(player, payload)
	if player.Parent == Players and not self.departing[player] then
		self.ctx.Remotes.Notice:FireClient(player, payload)
	end
end

function RoundService:_setCharacterRole(player, character)
	local role = self:GetRole(player)
	player:SetAttribute("RoundRole", role)
	character:SetAttribute("RoundRole", role)
	local entry = self.roster[player.UserId]
	local held = (self.phase == "HeadStart" and role == "Hunter")
		or (entry ~= nil and entry.frozenUntil ~= nil and entry.frozenUntil > now())
	character:SetAttribute("RoundFrozen", held)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = held
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	if humanoid then
		humanoid.AutoRotate = not held
		humanoid.UseJumpPower = true
		humanoid.JumpPower = held and 0 or self.ctx.Config.Movement.JumpPower
		humanoid.WalkSpeed = held and 0 or self.ctx.Config.Movement.WalkSpeed
	end
	local movement = self.ctx.Services.MovementService
	if movement then
		movement:ResetPlayer(player)
	end
end

function RoundService:_destination(player)
	local entry = self.roster[player.UserId]
	if self:IsActive(player) and entry then
		return entry.spawn
	end
	-- Keep a dozen avatars from sharing one exact collision point.
	local offset = (math.abs(player.UserId) % 9) - 4
	return self.ctx.World.LobbySpawn * CFrame.new(offset * 2.5, 0, 0)
end

function RoundService:_place(player, character)
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	character:PivotTo(self:_destination(player))
	self:_setCharacterRole(player, character)
	local forceField = character:FindFirstChildOfClass("ForceField")
	if forceField then
		forceField:Destroy()
	end
end

function RoundService:_load(player)
	if self.loading[player] or player.Parent ~= Players or self.departing[player] then
		return
	end
	self.loading[player] = true
	task.spawn(function()
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		self.loading[player] = nil
		if not ok and player.Parent == Players then
			warn("[Catch] Character load failed for user " .. player.UserId .. ": " .. tostring(err))
			self:_notice(player, { kind = "toast", text = "Avatar is still loading. Retrying shortly." })
			task.delay(3, function()
				if player.Parent == Players and not liveCharacter(player) then
					self:_load(player)
				end
			end)
		end
	end)
end

function RoundService:_onCharacter(player, character)
	local previous = self.characterConnections[player]
	if previous then
		previous:Disconnect()
		self.characterConnections[player] = nil
	end
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not humanoid or not root or player.Character ~= character or player.Parent ~= Players then
			return
		end
		self:_place(player, character)
		self.characterConnections[player] = humanoid.Died:Connect(function()
			if player.Character ~= character then
				return
			end
			self:_eliminate(player, "reset")
			task.delay(self.ctx.Config.Round.RespawnDelay, function()
				if player.Parent == Players and player.Character == character then
					self:_load(player)
				end
			end)
		end)
	end)
end

function RoundService:_onPlayer(player)
	self.departing[player] = nil
	local connection = player.CharacterAdded:Connect(function(character)
		self:_onCharacter(player, character)
	end)
	self.connections[player] = connection
	if player.Character then
		self:_onCharacter(player, player.Character)
	else
		self:_load(player)
	end
	player:SetAttribute("RoundRole", self:GetRole(player))
	self:_broadcast()
end

function RoundService:_eligible()
	local eligible = {}
	local data = self.ctx.Services.DataService
	for _, player in ipairs(Players:GetPlayers()) do
		if not self.departing[player] and data:Ready(player) and liveCharacter(player) then
			table.insert(eligible, player)
		end
	end
	-- Late players still enter a full next round, with a hard cap matching place settings.
	table.sort(eligible, function(a, b)
		return a.UserId < b.UserId
	end)
	while #eligible > self.ctx.Config.Round.MaxPlayers do
		table.remove(eligible)
	end
	return eligible
end

function RoundService:_hasEnough(eligible)
	return #eligible >= self.ctx.Config.Round.MinimumPlayers
		or (#eligible == 1 and RunService:IsStudio() and self.ctx.Config.Round.StudioSolo)
end

function RoundService:_startRound(eligible)
	self.roundId += 1
	self.roster = {}
	self.tagTimes = {}
	self.winners = {}
	self.practice = #eligible == 1
	-- Player counts can change during intermission; never keep a modifier the lobby no longer supports.
	if self.practice or #eligible < self.modifier.minPlayers then
		self:_pickModifier(#eligible)
	end
	self.lastModifierId = self.modifier.id
	self.startedAt = now()
	self.phase = "HeadStart"
	self.endsAt = now() + self.ctx.Config.Round.HeadStart
	self.resultText = self.practice and "PRACTICE · nothing is saved"
		or (self.modifier.id == "classic" and "Runners, find your route!" or (self.modifier.name .. " · " .. self.modifier.tagline))
	local cosmetic = self.ctx.Services.CosmeticService
	if cosmetic then
		cosmetic:ShowWinners({})
	end
	-- Shuffle ties, then prefer players who have spent fewer rounds hunting.
	for index = #eligible, 2, -1 do
		local swap = self.random:NextInteger(1, index)
		eligible[index], eligible[swap] = eligible[swap], eligible[index]
	end
	local tieBreak = {}
	for index, player in ipairs(eligible) do
		tieBreak[player] = index
	end
	table.sort(eligible, function(a, b)
		local aTurns, bTurns = self.hunterTurns[a.UserId] or 0, self.hunterTurns[b.UserId] or 0
		if aTurns == bTurns then
			return tieBreak[a] < tieBreak[b]
		end
		return aTurns < bTurns
	end)
	local hide = self.ctx.Services.HideService
	if hide then
		hide:ResetRound()
	end
	local hunters = self.practice and 0
		or self.ctx.Modifiers.HunterCount(self.modifier, #eligible, self.ctx.Rules.HunterCount(#eligible))
	local runnerIndex, hunterIndex = 0, 0
	for index, player in ipairs(eligible) do
		local role = index <= hunters and "Hunter" or "Runner"
		local spawns, spawnIndex
		if role == "Hunter" then
			hunterIndex += 1
			spawns, spawnIndex = self.ctx.World.HunterSpawns, hunterIndex
			self.hunterTurns[player.UserId] = (self.hunterTurns[player.UserId] or 0) + 1
		else
			runnerIndex += 1
			spawns, spawnIndex = self.ctx.World.RunnerSpawns, runnerIndex
		end
		local spawn = spawns[((spawnIndex - 1) % #spawns) + 1]
		self.roster[player.UserId] = {
			player = player,
			role = role,
			alive = true,
			tags = 0,
			pickups = 0,
			closeCalls = 0,
			finds = 0,
			joinedAt = self.startedAt,
			spawn = spawn,
		}
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			self:_place(player, player.Character)
		end
	end
	self:_broadcast()
	self.ctx.Remotes.Notice:FireAllClients({ kind = "round", text = self.resultText })
end

function RoundService:_activate()
	self.phase = "Active"
	self.startedAt = now()
	self.endsAt = self.startedAt + self.modifier.duration
	self.resultText = self.practice and "Practice round · nothing is saved: no XP, coins or rating" or (self.modifier.id == "classic" and "The chase is on!" or (self.modifier.name .. " · " .. self.modifier.tagline))
	for _, entry in pairs(self.roster) do
		entry.joinedAt = self.startedAt
		if entry.alive and entry.role == "Hunter" and entry.player.Character then
			-- Only held hunters need releasing. Resetting a running player's movement
			-- here would bless an unvalidated position and interrupt an in-flight vault.
			self:_setCharacterRole(entry.player, entry.player.Character)
		end
	end
	self:_broadcast()
	self.ctx.Remotes.Notice:FireAllClients({ kind = "round", text = self.resultText })
end

function RoundService:_endRound(winningRole, reason)
	if not self:_playingPhase() then
		return
	end
	local endedAt = now()
	self.phase = "Results" -- Guard reentry before touching avatars or awarding data.
	self.endsAt = endedAt + self.ctx.Config.Round.ResultsDuration
	self.winners = {}
	self.resultText = self.practice and (reason or "Practice complete · nothing was saved")
		or (reason or (winningRole == "Hunter" and "Hunters caught every runner!" or "Runners escaped!"))
	local winningPlayers = {}
	for _, entry in pairs(self.roster) do
		local player = entry.player
		local connected = player.Parent == Players and not self.departing[player]
		-- Eliminated runners do not receive a survival victory when a teammate escapes.
		local won = not self.practice and entry.role == winningRole and (entry.role == "Hunter" or entry.alive)
		if connected and won then
			table.insert(self.winners, player.UserId)
			table.insert(winningPlayers, player)
		end
		if connected then
			-- Infected hunters keep the time they survived as runners.
			local survived = (entry.role == "Runner" or entry.infected == true)
				and math.clamp((entry.eliminatedAt or endedAt) - self.startedAt, 0, self.modifier.duration)
				or 0
			local summary = {
				role = entry.role,
				win = won,
				tags = entry.tags,
				survived = survived,
				pickups = entry.pickups,
				closeCalls = entry.closeCalls,
				finds = entry.finds,
				practice = self.practice,
				roundId = self.roundId,
				}
				task.spawn(function()
				local ok, awarded, reward = pcall(function()
					return self.ctx.Services.DataService:AwardRound(player, summary)
				end)
				if not ok then
					warn("[Catch] Round award failed: " .. tostring(awarded))
				elseif awarded == true and type(reward) == "table" then
					-- The results screen shows exactly what the server granted.
					reward.kind = "reward"
					self:_notice(player, reward)
				end
				end)
		end
	end
	table.sort(self.winners)
	for _, player in ipairs(Players:GetPlayers()) do
		if not self.departing[player] then
			local character = liveCharacter(player)
			if character then
				self:_place(player, character)
			else
				self:_load(player)
			end
		end
	end
	local cosmetic = self.ctx.Services.CosmeticService
	if cosmetic then
		cosmetic:ShowWinners(winningPlayers)
	end
	self:_broadcast()
	self.ctx.Remotes.Notice:FireAllClients({ kind = "round", text = self.resultText })
end

function RoundService:_checkWin()
	if not self:_playingPhase() then
		return
	end
	local runners, hunters = self:_counts()
	if self.phase == "Active" and now() >= self.endsAt then
		self:_endRound("Runner", self.practice and "Practice complete · nothing was saved" or "Time is up · runners escaped!")
	elseif runners == 0 then
		self:_endRound("Hunter", self.practice and "Practice ended · try another route next round" or "Hunters caught every runner!")
	elseif not self.practice and hunters == 0 then
		self:_endRound("Runner", "Runners win · no hunters remain")
	end
end

function RoundService:_eliminate(player, reason)
	-- Timer ticks are deliberately infrequent. A death/reset event arriving after
	-- the deadline must settle the completed chase before it changes the roster.
	if self.phase == "Active" and now() >= self.endsAt then
		self:_checkWin()
		return
	end
	local entry = self.roster[player.UserId]
	if not self:_playingPhase() or not entry or not entry.alive then
		return
	end
	entry.alive = false
	entry.eliminatedAt = now()
	player:SetAttribute("RoundRole", "Spectator")
	if player.Character then
		self:_setCharacterRole(player, player.Character)
	end
	if reason ~= "left" then
		self:_notice(player, {
			kind = "toast",
			text = reason == "tag" and "Caught! Watch the chase, then run again next round."
				or "Round ended for you. You will return to the lobby.",
		})
	end
	self:_checkWin()
	if self:_playingPhase() then
		self:_broadcast()
	end
end

function RoundService:TryTag(player)
	-- Resolve the deadline synchronously; a late remote must not steal a win in
	-- the interval between the visible timer reaching zero and the next tick.
	if self.phase == "Active" and now() >= self.endsAt then
		self:_checkWin()
		return false
	end
	if self.phase ~= "Active" or self:GetRole(player) ~= "Hunter" or not self:IsActive(player) then
		return false
	end
	local character, _, root = liveCharacter(player)
	if not character or character:GetAttribute("Vaulting") or character:GetAttribute("RoundFrozen") then
		return false
	end
	local movement = self.ctx.Services.MovementService
	if movement and not movement:ValidatePosition(player) then
		return false
	end
	local timestamp = now()
	local cooldown = self.ctx.Config.Movement.TagCooldown
	if timestamp - (self.tagTimes[player] or -math.huge) < cooldown then
		return false
	end
	self.tagTimes[player] = timestamp
	self:_notice(player, { kind = "ability", action = "Tag", cooldown = cooldown })
	local closest, closestDistance
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	rayParams.RespectCanCollide = true
	for _, entry in pairs(self.roster) do
		if entry.role == "Runner" and entry.alive and not self.departing[entry.player] then
			local targetCharacter, _, targetRoot = liveCharacter(entry.player)
			-- A hiding runner can only be found with Search or Scan, never tagged through the door.
			if targetCharacter and targetCharacter:GetAttribute("CatchHiding") == true then
				targetCharacter = nil
			end
			if targetCharacter and (not movement or movement:ValidatePosition(entry.player)) then
				local delta = targetRoot.Position - root.Position
				local distance = delta.Magnitude
				if distance <= self.ctx.Config.Movement.TagRange and (not closestDistance or distance < closestDistance) then
					local hit = Workspace:Raycast(root.Position, delta, rayParams)
					if not hit or hit.Instance:IsDescendantOf(targetCharacter) then
						closest = entry
						closestDistance = distance
					end
				end
			end
		end
	end
	if not closest then
		return false
	end
	local hunter = self.roster[player.UserId]
	hunter.tags += 1
	local target = closest.player
	local targetCharacter, _, targetRoot = liveCharacter(target)
	local cosmetic = self.ctx.Services.CosmeticService
	if cosmetic and cosmetic.TagEffect then
		cosmetic:TagEffect(player, target)
	elseif targetRoot then
		self.ctx.Remotes.Notice:FireAllClients({ kind = "tag", position = targetRoot.Position, userId = player.UserId, victimUserId = target.UserId })
	end
	local modifier = self.modifier
	if modifier.infection and closest.alive and self.endsAt - now() > (modifier.infectCutoff or 0) then
		self:_infect(closest)
		return true
	end
	self:_eliminate(target, "tag")
	-- A tagged avatar immediately leaves the arena; no invisible blockers or second tags.
	if targetCharacter and target.Character == targetCharacter then
		self:_place(target, targetCharacter)
	end
	return true
end

-- Infection: a tagged runner joins the hunters at a hunter spawn after a short, server-held pause.
function RoundService:_infect(entry)
	local player = entry.player
	local hunterSpawns = self.ctx.World.HunterSpawns
	self.infections = (self.infections or 0) + 1
	entry.role = "Hunter"
	entry.infected = true
	entry.eliminatedAt = now()
	entry.spawn = hunterSpawns[((self.infections - 1) % #hunterSpawns) + 1]
	local delay = self.modifier.infectDelay or 3
	entry.frozenUntil = now() + delay
	self:_notice(player, {
		kind = "toast",
		text = "Infected! You are a hunter now. Tag the remaining runners.",
	})
	local character = player.Character
	if character then
		self:_place(player, character)
	end
	local roundId = self.roundId
	task.delay(delay, function()
		if self.roundId ~= roundId or not self:_playingPhase() or not entry.alive then
			return
		end
		entry.frozenUntil = nil
		local current = player.Character
		if player.Parent == Players and current and current:GetAttribute("RoundFrozen") then
			self:_setCharacterRole(player, current)
		end
	end)
	self:_checkWin()
	if self:_playingPhase() then
		self:_broadcast()
	end
end

-- Face mood for a player: purely presentational, derived from facts the server already owns.
function RoundService:MoodFor(player)
	if self.phase == "Results" then
		if table.find(self.winners, player.UserId) then return "Win" end
		return self.roster[player.UserId] and "Lose" or "Idle"
	end
	if not self:_playingPhase() then return "Idle" end
	local entry = self.roster[player.UserId]
	if not entry or not entry.alive then return "Idle" end
	if entry.role == "Hunter" then return "Hunt" end
	local character, _, root = liveCharacter(player)
	if not character then return "Idle" end
	if character:GetAttribute("CatchHiding") == true then return "Hide" end
	for _, other in pairs(self.roster) do
		if other.role == "Hunter" and other.alive and not self.departing[other.player] then
			local _, _, hunterRoot = liveCharacter(other.player)
			if hunterRoot and (hunterRoot.Position - root.Position).Magnitude <= self.ctx.Config.Round.ScareDistance then
				return "Scared"
			end
		end
	end
	return "Run"
end

-- Objectives. Both return the new running count, or nil when nothing was credited.
function RoundService:AddPickup(player)
	local entry = self.roster[player.UserId]
	if self.phase ~= "Active" or not entry or entry.role ~= "Runner" or not entry.alive then
		return nil
	end
	if entry.pickups >= self.ctx.Config.Hide.PickupCap then
		return nil
	end
	entry.pickups += 1
	return entry.pickups
end

function RoundService:AddCloseCall(player)
	local entry = self.roster[player.UserId]
	if self.phase ~= "Active" or not entry or entry.role ~= "Runner" or not entry.alive then
		return nil
	end
	if entry.closeCalls >= self.ctx.Config.Hide.CloseCallMax then
		return nil
	end
	entry.closeCalls += 1
	self:_notice(player, {kind = "closecall", count = entry.closeCalls})
	return entry.closeCalls
end

function RoundService:_step()
	if self.phase == "Waiting" then
		local eligible = self:_eligible()
		if self:_hasEnough(eligible) then
			self.phase = "Intermission"
			self.endsAt = now() + self.ctx.Config.Round.Intermission
			self.practice = #eligible == 1
			self:_pickModifier(#eligible)
			self.resultText = self.practice and "Practice round starts soon · nothing is saved" or "Next chase starts soon"
			self:_broadcast()
		end
	elseif self.phase == "Intermission" then
		local eligible = self:_eligible()
		if not self:_hasEnough(eligible) then
			self.phase, self.endsAt = "Waiting", 0
			self.practice = false
			self.modifier = self.ctx.Modifiers.Default
			self.resultText = "Waiting for at least two ready players"
			self:_broadcast()
		elseif now() >= self.endsAt then
			self:_startRound(eligible)
		end
	elseif self.phase == "HeadStart" then
		self:_checkWin()
		if self.phase == "HeadStart" and now() >= self.endsAt then
			self:_activate()
		end
	elseif self.phase == "Active" then
		self:_checkWin()
	elseif self.phase == "Results" and now() >= self.endsAt then
		self.phase, self.endsAt = "Waiting", 0
		self.roster, self.winners = {}, {}
		self.practice = false
		self.resultText = "Waiting for players"
		local cosmetic = self.ctx.Services.CosmeticService
		if cosmetic then
			cosmetic:ShowWinners({})
		end
		self:_broadcast()
	end
	if now() - self.lastBroadcast >= 1 then
		self:_broadcast()
	end
end

function RoundService:Start()
	if self.started then
		return
	end
	self.started = true
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(function(player)
		self:_onPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self.departing[player] = true
		self:_eliminate(player, "left")
		self.tagTimes[player], self.loading[player], self.hunterTurns[player.UserId] = nil, nil, nil
		if self.connections[player] then
			self.connections[player]:Disconnect()
			self.connections[player] = nil
		end
		if self.characterConnections[player] then
			self.characterConnections[player]:Disconnect()
			self.characterConnections[player] = nil
		end
		self:_broadcast()
		-- Keep the departure marker only while a removed player's callbacks can still run.
		task.delay(10, function()
			self.departing[player] = nil
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		self:_onPlayer(player)
	end
	task.spawn(function()
		while self.started do
			local ok, err = xpcall(function()
				self:_step()
			end, debug.traceback)
			if not ok then
				warn("[Catch] Round step failed: " .. tostring(err))
			end
			task.wait(0.2)
		end
	end)
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- All prices, ownership, entitlements, and marketplace verification stay on the server.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local ShopService = {}
ShopService.__index = ShopService

local function validPass(id)
	return type(id) == "number" and id > 0 and id < 9007199254740991 and id % 1 == 0
end

function ShopService.new(ctx)
	return setmetatable({ ctx = ctx, busy = {}, pending = {}, verified = {}, lastPrompt = {} }, ShopService)
end

function ShopService:_Notice(player, text, success)
	if player.Parent == Players then self.ctx.Remotes.Notice:FireClient(player, { kind = "purchase", text = text, success = success == true }) end
end

function ShopService:_PassItems(passId)
	local ids = {}
	for id, item in pairs(self.ctx.Catalog.Items) do
		if item.currency == "Robux" and item.gamePassId == passId then table.insert(ids, id) end
	end
	return ids
end

function ShopService:_Verify(player, passId, afterPurchase)
	local data = self.ctx.Services.DataService
	if not validPass(passId) or #self:_PassItems(passId) == 0 or not data:Ready(player) then return false, "unavailable" end
	self.verified[player] = self.verified[player] or {}
	if self.verified[player][passId] then
		data:Grant(player, self:_PassItems(passId))
		return true
	end
	local successfulQuery = false
	for attempt = 1, afterPurchase and 3 or 1 do
		local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId) end)
		if player.Parent ~= Players or not data:Ready(player) then return false, "unavailable" end
		if ok then
			successfulQuery = true
			if owns then
				self.verified[player] = self.verified[player] or {}
				self.verified[player][passId] = true
				local granted = data:Grant(player, self:_PassItems(passId), afterPurchase and "Purchase verified. Your cosmetics are ready." or nil)
				return granted
			end
		end
		if afterPurchase and attempt < 3 then task.wait(attempt) end
	end
	return false, successfulQuery and "not_owned" or "unavailable"
end

function ShopService:Purchase(player, id)
	local data = self.ctx.Services.DataService
	if not data:Ready(player) then self:_Notice(player, "Your profile is still loading."); return false end
	local item = type(id) == "string" and self.ctx.Catalog.Get(id)
	if not item then self:_Notice(player, "This item is unavailable."); return false end
	local profile = data:Get(player)
	if profile.owned[id] then self:_Notice(player, "You already own " .. item.name .. ". Equip it from your inventory."); return true end
	if item.currency == "Free" then
		local ok = data:Grant(player, { id }, "Added " .. item.name .. " to your inventory.")
		return ok
	elseif item.currency == "Coins" then
		local ok, message = data:_PurchaseWithCoins(player, id)
		self:_Notice(player, message, ok)
		return ok
	elseif item.currency == "Milestone" then
		local milestone = item.milestone
		if not milestone then self:_Notice(player, "This reward is unavailable."); return false end
		local progress = profile.stats[milestone.stat] or profile[milestone.stat] or 0
		if progress >= milestone.value then return data:Grant(player, { id }, "Unlocked " .. item.name .. ".") end
		self:_Notice(player, "Reach " .. milestone.value .. " " .. milestone.stat .. " to unlock this cosmetic.")
		return false
	elseif item.currency ~= "Robux" then
		self:_Notice(player, "This item is unavailable.")
		return false
	end
	if not validPass(item.gamePassId) then
		self:_Notice(player, "This Robux cosmetic is not configured for sale yet.")
		return false
	end
	if self.busy[player] or self.pending[player] then self:_Notice(player, "Finish your current purchase first."); return false end
	if os.clock() - (self.lastPrompt[player] or -100) < 3 then self:_Notice(player, "Please wait a moment before trying again."); return false end
	self.busy[player] = true
	local owns, reason = self:_Verify(player, item.gamePassId, false)
	if player.Parent ~= Players then self.busy[player] = nil; return false end
	if owns then
		self.busy[player] = nil
		self:_Notice(player, "Ownership verified. " .. item.name .. " is in your inventory.", true)
		return true
	end
	if reason == "unavailable" then
		self.busy[player] = nil
		self:_Notice(player, "Roblox could not verify your ownership. Please try again shortly.")
		return false
	end
	self.pending[player] = item.gamePassId
	self.lastPrompt[player] = os.clock()
	local ok = pcall(function() MarketplaceService:PromptGamePassPurchase(player, item.gamePassId) end)
	self.busy[player] = nil
	if not ok then
		self.pending[player] = nil
		self:_Notice(player, "Roblox could not open the purchase prompt. Please try again later.")
		return false
	end
	self:_Notice(player, "Confirm the price and purchase in the Roblox prompt.")
	return true
end

-- Coin packs. The prompt is only intent; coins are granted from ProcessReceipt below.
function ShopService:PurchaseProduct(player, id)
	local data = self.ctx.Services.DataService
	if not data:Ready(player) then self:_Notice(player, "Your profile is still loading."); return false end
	local product = type(id) == "string" and self.ctx.Catalog.Product(id)
	if not product then self:_Notice(player, "This coin pack is unavailable."); return false end
	if not validPass(product.productId) then
		self:_Notice(player, "Coin packs are not configured for sale yet.")
		return false
	end
	if os.clock() - (self.lastPrompt[player] or -100) < 3 then self:_Notice(player, "Please wait a moment before trying again."); return false end
	self.lastPrompt[player] = os.clock()
	local ok = pcall(function() MarketplaceService:PromptProductPurchase(player, product.productId) end)
	if not ok then self:_Notice(player, "Roblox could not open the purchase prompt. Please try again later."); return false end
	return true
end

function ShopService:ProcessReceipt(info)
	local notYet = Enum.ProductPurchaseDecision.NotProcessedYet
	if type(info) ~= "table" or type(info.PurchaseId) ~= "string" or info.PurchaseId == "" then return notYet end
	local player = Players:GetPlayerByUserId(info.PlayerId)
	-- A player who left gets the receipt again next join; Roblox keeps resending until it is granted.
	if not player then return notYet end
	local product = self.ctx.Catalog.ProductByRobloxId(info.ProductId)
	if not product then
		warn("[Catch] Receipt for unknown developer product " .. tostring(info.ProductId))
		return notYet
	end
	local data = self.ctx.Services.DataService
	local ok, granted = pcall(function()
		return data:GrantProductCoins(player, info.PurchaseId, product.coins)
	end)
	if not ok or not granted then return notYet end
	self:_Notice(player, "+" .. product.coins .. " coins added. Spend them on any cosmetic!", true)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService:_Refresh(player)
	local data = self.ctx.Services.DataService
	while player.Parent == Players and not data:Ready(player) do task.wait(0.2) end
	if player.Parent ~= Players then return end
	local seen = {}
	local failed = false
	for _, item in pairs(self.ctx.Catalog.Items) do
		if item.currency == "Robux" and validPass(item.gamePassId) and not seen[item.gamePassId] then
			seen[item.gamePassId] = true
			local _, reason = self:_Verify(player, item.gamePassId, false)
			if reason == "unavailable" then failed = true end
			if player.Parent ~= Players then return end
		end
	end
	if failed then self:_Notice(player, "Some pass ownership checks are unavailable. Rejoin or select the item later to retry.") end
end

function ShopService:Start()
	if self.started then return end
	self.started = true
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if self.pending[player] == passId then self.pending[player] = nil end
		if not wasPurchased or not validPass(passId) or #self:_PassItems(passId) == 0 then return end
		-- The prompt result is an intent signal. Grant only after a server ownership query.
		task.spawn(function()
			local verified = self:_Verify(player, passId, true)
			if not verified then self:_Notice(player, "Purchase verification is delayed. Rejoin to restore owned passes; you do not need to buy again.") end
		end)
	end)
	MarketplaceService.ProcessReceipt = function(info) return self:ProcessReceipt(info) end
	Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_Refresh(player) end) end)
	Players.PlayerRemoving:Connect(function(player)
		self.busy[player] = nil
		self.pending[player] = nil
		self.verified[player] = nil
		self.lastPrompt[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() self:_Refresh(player) end) end
end

return ShopService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="Folder" referent="25">
          <Properties>
            <string name="Name">Mall</string>
          </Properties>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Atrium</string>
              <string name="Source"><![CDATA[-- The public spaces: the central fountain plaza, kiosks, planters, seating, wayfinding and the
-- second-floor balcony. Obstacles here form loops around the fountain and planters, with every
-- drop landing and escalator mouth kept clear (checked by tests/mall.spec.luau).
local Atrium = {}

local function bench(kit, parent, x, y, z, yaw, color)
	local f = kit.frame(parent, Vector3.new(x, y, z), yaw, y)
	local P = kit.P
	f.b("BenchSeat", 0, 1.4, 0, 6.4, 0.5, 2, color or P.wood, Enum.Material.Wood, true, {cover = "Low", vault = true})
	f.b("BenchBack", 0, 2.4, 0.9, 6.4, 1.6, 0.4, color or P.wood, Enum.Material.Wood, false)
	for _, s in ipairs({-1, 1}) do f.b("BenchLeg", s * 2.8, 0, 0, 0.5, 1.4, 1.8, P.dark, Enum.Material.Metal, false) end
end

local function planter(kit, parent, x, y, z, radius, flower)
	local P = kit.P
	kit.can(parent, "PlanterWall", x, y + 1.1, z, radius * 2, 2.2, P.terracotta, Enum.Material.Concrete, true, {cover = "Low", vault = true})
	kit.can(parent, "PlanterSoil", x, y + 2.25, z, radius * 2 - 1, 0.2, P.soil, Enum.Material.SmoothPlastic, false)
	kit.can(parent, "PlanterRim", x, y + 2.2, z, radius * 2 + 0.3, 0.3, flower, Enum.Material.SmoothPlastic, false)
	kit.can(parent, "TreeTrunk", x, y + 5.5, z, 1.2, 7, P.darkwood, Enum.Material.Wood, true, {cover = "Soft"})
	kit.ball(parent, "TreeCrown", x, y + 10, z, radius * 1.8, 6, radius * 1.8, P.leaf, Enum.Material.SmoothPlastic, false, {cover = "Soft"})
	kit.ball(parent, "TreeCrownTop", x + 0.8, y + 12.5, z - 0.5, radius * 1.1, 3.4, radius * 1.1, P.lime, Enum.Material.SmoothPlastic, false)
	kit.ball(parent, "TreeCrownSide", x - radius * 0.6, y + 8.6, z + radius * 0.3, radius * 1.1, 3.6, radius * 1.1, P.leaf, Enum.Material.SmoothPlastic, false)
	kit.ball(parent, "TreeCrownSide", x + radius * 0.6, y + 8.4, z - radius * 0.3, radius * 1.0, 3.4, radius * 1.0, P.lime, Enum.Material.SmoothPlastic, false)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		kit.ball(parent, "Blossom", x + math.cos(a) * (radius - 1.2), y + 2.6, z + math.sin(a) * (radius - 1.2), 1, 0.8, 1, flower, Enum.Material.SmoothPlastic, false)
	end
end

local function kiosk(kit, parent, x, y, z, yaw, color, label)
	local f = kit.frame(parent, Vector3.new(x, y, z), yaw, y)
	local P = kit.P
	f.b("KioskBase", 0, 0, 0, 7, 3.6, 4, color, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
	f.b("KioskTop", 0, 3.6, 0, 7.4, 0.3, 4.4, P.cream, Enum.Material.SmoothPlastic, false)
	for _, sx in ipairs({-3.2, 3.2}) do f.b("KioskPole", sx, 3.9, 0, 0.3, 4.4, 0.3, P.steel, Enum.Material.Metal, false) end
	f.b("KioskCanopy", 0, 8.2, 0, 8.6, 0.5, 5.6, color, Enum.Material.Fabric, false)
	for i = 0, 3 do f.b("CanopyStripe", -3.2 + i * 2.1, 8.25, 0, 1, 0.52, 5.7, P.white, Enum.Material.Fabric, false) end
	f.sign(label, 0, 5.2, -2.3, 6, 1.8, P.white, color, false, {pixels = 24})
	for i = 1, 4 do f.b("Goods", -2.4 + (i - 1) * 1.6, 3.9, 0.2, 1, 1 + (i % 2) * 0.6, 1, ({P.red, P.sun, P.sky, P.pink})[i], Enum.Material.SmoothPlastic, false) end
end

function Atrium.build(kit, Layout)
	local P = kit.P
	local plaza = kit.group("Atrium")
	local balcony = kit.group("Balcony")
	local Y2 = Layout.FloorY[2]

	-- Centre: fountain with tiered column, jets and a colour medallion beneath.
	for i, d in ipairs({50, 44, 38}) do
		kit.can(plaza, "Medallion", 0, 0.08 + i * 0.02, 0, d, 0.04, ({P.teal, P.cream, P.sun})[i], Enum.Material.SmoothPlastic, false, {shadow = false})
	end
	kit.can(plaza, "FountainBasin", 0, 1.3, 0, 34, 2.6, P.cream, Enum.Material.Concrete, true, {cover = "Low", vault = true})
	kit.can(plaza, "FountainWater", 0, 2.3, 0, 31.4, 0.5, P.sky, Enum.Material.Glass, false, {transparency = 0.35})
	kit.can(plaza, "FountainRim", 0, 2.7, 0, 34.6, 0.3, P.gold, Enum.Material.Metal, false)
	kit.can(plaza, "FountainTier1", 0, 3.8, 0, 10, 2.4, P.cream, Enum.Material.Concrete, true, {cover = "Full"})
	kit.can(plaza, "FountainTier2", 0, 7, 0, 6, 4, P.cream, Enum.Material.Concrete, true, {cover = "Full"})
	kit.can(plaza, "FountainBowl", 0, 9.4, 0, 12, 0.6, P.sky, Enum.Material.Glass, false, {transparency = 0.3})
	kit.can(plaza, "FountainTopRing", 0, 10.2, 0, 3.4, 1.2, P.gold, Enum.Material.Metal, false)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		kit.can(plaza, "FountainJet", math.cos(a) * 11, 5, math.sin(a) * 11, 0.9, 5, P.white, Enum.Material.Glass, false, {transparency = 0.5})
		kit.ball(plaza, "FountainSplash", math.cos(a) * 11, 7.6, math.sin(a) * 11, 1.6, 1.2, 1.6, P.white, Enum.Material.Glass, false, {transparency = 0.45})
	end
	-- Water leaps from the top ring and the eight jets; sparkles hang over the basin.
	kit.emitter(plaza:FindFirstChild("FountainTopRing"), "spray")
	for _, child in ipairs(plaza:GetChildren()) do
		if child.Name == "FountainJet" then kit.emitter(child, "spray").Rate = 8 end
	end
	kit.emitter(plaza:FindFirstChild("FountainWater"), "sparkle")
	kit.lamp(plaza, Vector3.new(0, 12.4, 0), P.sky, 1.0, 40)

	-- Planter islands in the four quadrants, clear of stairs, ramps and drop landings.
	planter(kit, plaza, 30, 0, 34, 5.5, P.pink)
	planter(kit, plaza, -30, 0, 36, 5.5, P.sun)
	planter(kit, plaza, -30, 0, -34, 5.5, P.coral)
	planter(kit, plaza, 30, 0, -34, 5.5, P.violet)

	-- Kiosks along the ring corridors (clear of the escalator mouths).
	local kiosks = {
		{30, 75, 0, P.coral, "PRETZELS"}, {58, 75, 0, P.sky, "PHONE CASES"},
		{-30, -75, 180, P.sun, "LEMONADE"}, {-58, -75, 180, P.mint, "PLUSHIES"},
		{70, -25, 90, P.pink, "CANDY"}, {70, -45, 90, P.violet, "TEA"},
		{-70, 25, -90, P.orange, "CHURROS"}, {-70, 45, -90, P.teal, "SUNGLASSES"},
	}
	for _, k in ipairs(kiosks) do kiosk(kit, plaza, k[1], 0, k[2], math.rad(k[3]), k[4], k[5]) end

	-- Information desk (round) and directory boards.
	kit.can(plaza, "InfoDesk", -2, 1.8, -40, 9, 3.6, P.teal, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
	kit.can(plaza, "InfoDeskTop", -2, 3.7, -40, 9.6, 0.3, P.white, Enum.Material.Marble, false)
	kit.can(plaza, "InfoDeskPillar", -2, 8, -40, 1.6, 8, P.white, Enum.Material.SmoothPlastic, false)
	kit.sign(plaza, "INFO", CFrame.new(-2, 12.4, -40), 6, 2.2, P.white, P.teal)
	local boards = {{50, 2, "MALL MAP / LEVEL 1"}, {-50, -2, "MALL MAP / LEVEL 1"}, {2, 50, "TODAY: STORES + ARCADE"}, {-2, -52, "EAT UPSTAIRS!"}}
	for i, b in ipairs(boards) do
		kit.box(plaza, "BoardFrame", b[1], 4.2, b[2], 7, 8.4, 0.8, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Full"})
		kit.sign(plaza, b[3], CFrame.new(b[1], 5.2, b[2] - 0.5), 6, 3, P.white, P.sky, {pixels = 20})
		for k = 1, 4 do kit.box(plaza, "BoardStripe", b[1], 1.4 + k * 0.6, b[2] - 0.45, 5.6 - k * 0.5, 0.25, 0.1, ({P.coral, P.sun, P.mint, P.violet})[k], Enum.Material.SmoothPlastic, false) end
	end
	-- Benches with clear ends: pairs facing the fountain and others along the corridors.
	bench(kit, plaza, 8, 0, 28, math.pi, P.wood)
	bench(kit, plaza, -8, 0, -28, 0, P.wood)
	bench(kit, plaza, 78, 0, 0, -math.pi / 2, P.wood)
	bench(kit, plaza, -78, 0, 0, math.pi / 2, P.wood)
	bench(kit, plaza, 40, 0, 66, math.pi, P.teal)
	bench(kit, plaza, -40, 0, -66, 0, P.teal)

	-- Hanging mega screen above the bridge crossing, a landmark from every direction.
	local cubeY = 36
	kit.box(plaza, "MegaCube", 0, cubeY, 0, 12, 8, 12, P.dark, Enum.Material.SmoothPlastic, false, {shadow = false})
	local faces = {{0, -6.2, 0, "CATCH ME"}, {0, 6.2, math.pi, "IF YOU CAN"}, {6.2, 0, -math.pi / 2, "CATCH MALL"}, {-6.2, 0, math.pi / 2, "RUN! RUN!"}}
	for i, face in ipairs(faces) do
		local cf = CFrame.new(face[1], cubeY, face[2]) * CFrame.Angles(0, face[3], 0)
		kit.sign(plaza, face[4], cf, 11, 7, P.white, ({P.coral, P.sky, P.violet, P.teal})[i], {material = Enum.Material.Neon, pixels = 28, distance = 250})
	end
	for _, c in ipairs({{-5, -5}, {5, -5}, {-5, 5}, {5, 5}}) do
		kit.box(plaza, "MegaCable", c[1], (cubeY + 4 + Layout.AtriumRoofY) / 2, c[2], 0.25, Layout.AtriumRoofY - cubeY - 4, 0.25, P.steel, Enum.Material.Metal, false)
	end
	-- Banners hanging from the roof ribs.
	local banners = {P.coral, P.sun, P.sky, P.mint, P.violet, P.pink}
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		local x, z = math.cos(a) * 46, math.sin(a) * 52
		kit.box(plaza, "HangingBanner", math.max(-52, math.min(52, x)), 52, math.max(-57, math.min(57, z)), 3, 9, 0.3, banners[(i % #banners) + 1], Enum.Material.Fabric, false, {shadow = false})
	end

	-- Pennant strings across the ring corridors on level one.
	for _, z in ipairs({-76, 76}) do
		for i = 0, 15, 2 do
			kit.box(plaza, "Pennant", -75 + i * 10, 19.2, z, 3.2, 2.6, 0.15, banners[(i % #banners) + 1], Enum.Material.Fabric, false, {shadow = false})
		end
		kit.box(plaza, "PennantLine", 0, 20.3, z, 160, 0.1, 0.1, P.dark, Enum.Material.SmoothPlastic, false)
	end

	-- Second floor balcony: benches by the rail, planters and kiosks on the ring.
	-- Benches sit beside, never in front of, the stair landings, bridge landings and drop gaps.
	for _, x in ipairs({-30, 30, -58, 58}) do
		bench(kit, balcony, x, Y2, 63.5, 0, P.coral)
		bench(kit, balcony, x, Y2, -63.5, math.pi, P.sky)
	end
	for _, z in ipairs({-24, -50}) do bench(kit, balcony, 58.5, Y2, z, -math.pi / 2, P.mint) end
	for _, z in ipairs({24, 50}) do bench(kit, balcony, -58.5, Y2, z, math.pi / 2, P.violet) end
	for _, p in ipairs({{70, 75}, {-70, 75}, {70, -75}, {-70, -75}}) do planter(kit, balcony, p[1], Y2, p[2], 4.5, P.pink) end
	kiosk(kit, balcony, 30, Y2, 78, 0, P.sky, "SMOOTHIES")
	kiosk(kit, balcony, -30, Y2, -78, math.pi, P.coral, "COOKIES")
	kiosk(kit, balcony, 72, Y2, -30, math.pi / 2, P.sun, "BALLOONS")
	kiosk(kit, balcony, -72, Y2, 30, -math.pi / 2, P.mint, "GADGETS")
	-- Pennants over the second-floor corridors.
	for _, z in ipairs({-76, 76}) do
		for i = 0, 15, 2 do kit.box(balcony, "Pennant", -75 + i * 10, Y2 + 19.2, z, 3.2, 2.6, 0.15, banners[((i + 2) % #banners) + 1], Enum.Material.Fabric, false, {shadow = false}) end
	end
end

return Atrium
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Decor</string>
              <string name="Source"><![CDATA[-- Reusable decoration pieces (cheap, chunky and cheerful). Everything is built from the kit's primitives, so the
-- art direction (palette, neon policy) stays in one place. Decor never blocks gameplay routes: trunks and
-- planters collide, everything else is visual only.
local Decor = {}

-- A round, chunky cartoon tree: tapered trunk and three overlapping crowns.
function Decor.tree(kit, parent, x, y, z, scale, palette)
	local P = kit.P
	scale = scale or 1
	palette = palette or {P.leaf, P.lime, P.mint}
	kit.can(parent, "TreeTrunk", x, y + 3.4 * scale, z, 1.5 * scale, 6.8 * scale, P.darkwood, Enum.Material.Wood, true, {shadow = false})
	kit.ball(parent, "TreeCrown", x, y + 9 * scale, z, 8 * scale, 6.6 * scale, 8 * scale, palette[1], Enum.Material.SmoothPlastic, false)
	kit.ball(parent, "TreeCrown", x - 2.2 * scale, y + 7.6 * scale, z + 0.8 * scale, 5.4 * scale, 4.6 * scale, 5.4 * scale, palette[2], Enum.Material.SmoothPlastic, false)
	kit.ball(parent, "TreeCrown", x + 2 * scale, y + 11 * scale, z - 0.6 * scale, 5 * scale, 4.4 * scale, 5 * scale, palette[3], Enum.Material.SmoothPlastic, false)
end

-- A palm: leaning trunk segments and six drooping fronds. A cheerful vacation-mall landmark.
function Decor.palm(kit, parent, x, y, z, scale)
	local P = kit.P
	scale = scale or 1
	local lean = 0.35 * scale
	for i = 1, 3 do
		kit.can(parent, "PalmTrunk", x + lean * i * 0.6, y + (i - 0.5) * 2.4 * scale, z, (1.5 - i * 0.12) * scale, 2.5 * scale, i % 2 == 0 and P.wood or P.darkwood, Enum.Material.Wood, i == 1, {shadow = false})
	end
	local topX, topY = x + lean * 3 * 0.6, y + 7.4 * scale
	for i = 0, 5 do
		local yaw = i * math.pi / 3
		local dir = Vector3.new(math.cos(yaw), 0, math.sin(yaw))
		local length = 5.6 * scale
		local center = Vector3.new(topX, topY, z) + dir * (length * 0.45) - Vector3.new(0, length * 0.12, 0)
		local cf = CFrame.lookAt(center, center + dir) * CFrame.Angles(math.rad(-16), 0, 0)
		kit.part(parent, "PalmFrond", Vector3.new(1.8 * scale, 0.25, length), cf, i % 2 == 0 and P.leaf or P.lime, Enum.Material.SmoothPlastic, false, {shadow = false})
	end
	kit.ball(parent, "Coconut", topX + 0.5 * scale, topY - 0.7 * scale, z, 0.9 * scale, 0.9 * scale, 0.9 * scale, P.darkwood, Enum.Material.SmoothPlastic, false)
	kit.ball(parent, "Coconut", topX - 0.5 * scale, topY - 0.7 * scale, z + 0.4 * scale, 0.9 * scale, 0.9 * scale, 0.9 * scale, P.darkwood, Enum.Material.SmoothPlastic, false)
end

-- A planter box with a flower border; `plant` adds a tree/palm on top.
function Decor.planterBox(kit, parent, x, y, z, sx, sz, flower)
	local P = kit.P
	kit.box(parent, "PlanterBox", x, y + 1.2, z, sx, 2.4, sz, P.terracotta, Enum.Material.Concrete, true, {cover = "Low", vault = true})
	kit.box(parent, "PlanterSoil", x, y + 2.45, z, sx - 0.8, 0.2, sz - 0.8, P.soil, Enum.Material.SmoothPlastic, false)
	local count = math.max(3, math.floor(math.max(sx, sz) / 2.6))
	for i = 1, count do
		local t = (i - 0.5) / count - 0.5
		local px = sx >= sz and x + t * (sx - 2) or x
		local pz = sx >= sz and z or z + t * (sz - 2)
		kit.ball(parent, "Blossom", px, y + 2.9, pz, 1.2, 1, 1.2, i % 2 == 0 and flower or P.sun, Enum.Material.SmoothPlastic, false)
	end
end

function Decor.bench(kit, parent, x, y, z, yaw, color)
	local P = kit.P
	local f = kit.frame(parent, Vector3.new(x, y, z), yaw, y)
	f.b("BenchSeat", 0, 1.4, 0, 6.4, 0.5, 2, color or P.sun, Enum.Material.SmoothPlastic, false)
	f.b("BenchBack", 0, 2.4, 0.9, 6.4, 1.6, 0.4, color or P.sun, Enum.Material.SmoothPlastic, false)
	for _, s in ipairs({-1, 1}) do f.b("BenchLeg", s * 2.8, 0, 0, 0.5, 1.4, 1.8, P.dark, Enum.Material.Metal, false) end
end

-- A lamp post with a round shade. `lit` adds one budgeted point light.
function Decor.lampPost(kit, parent, x, y, z, color, lit)
	local P = kit.P
	kit.can(parent, "LampPole", x, y + 6, z, 0.7, 12, P.dark, Enum.Material.Metal, false)
	kit.can(parent, "LampBase", x, y + 0.6, z, 1.6, 1.2, P.dark, Enum.Material.Metal, false)
	kit.ball(parent, "LampShade", x, y + 12.6, z, 2.4, 2.4, 2.4, color or P.cream, Enum.Material.SmoothPlastic, false)
	if lit then kit.lamp(parent, Vector3.new(x, y + 12.6, z), color or P.sun, 0.7, 34) end
end

-- A string of triangular pennants between two points (decor only).
function Decor.bunting(kit, parent, a, b, count, colors)
	local P = kit.P
	local line = b - a
	kit.beam(parent, "BuntingLine", a, b, 0.12, P.dark, Enum.Material.SmoothPlastic, false)
	for i = 1, count do
		local t = (i - 0.5) / count
		local p = a + line * t - Vector3.new(0, math.sin(t * math.pi) * 1.2, 0)
		kit.part(parent, "Pennant", Vector3.new(1.4, 1.8, 0.12), CFrame.new(p - Vector3.new(0, 0.9, 0)), colors[(i % #colors) + 1], Enum.Material.Fabric, false, {shadow = false})
	end
end

-- A semicircle balloon arch in the XY plane at (x, y, z).
function Decor.balloonArch(kit, parent, x, y, z, radius, colors)
	for i = 0, 10 do
		local a = i / 10 * math.pi
		local bx, by = x + math.cos(a) * radius, y + math.sin(a) * radius
		kit.ball(parent, "Balloon", bx, by + 2, z, 2.8, 3.2, 2.8, colors[(i % #colors) + 1], Enum.Material.SmoothPlastic, false, {shadow = false})
	end
	for _, side in ipairs({-1, 1}) do
		kit.can(parent, "BalloonPost", x + side * radius, y + 1, z, 2.4, 2, colors[1], Enum.Material.SmoothPlastic, false)
	end
end

-- A striped fabric canopy tilted down toward -Z (outward from a wall). Returns nothing; visual only.
function Decor.awning(kit, parent, cx, cy, cz, width, depth, a, b, stripe)
	local tilt = CFrame.Angles(math.rad(-18), 0, 0)
	kit.part(parent, "AwningBase", Vector3.new(width, 0.4, depth), CFrame.new(cx, cy, cz) * tilt, a, Enum.Material.Fabric, false, {shadow = false})
	stripe = stripe or 4
	for i = 0, math.floor(width / stripe) - 1 do
		if i % 2 == 1 then
			kit.part(parent, "AwningStripe", Vector3.new(stripe, 0.44, depth + 0.02), CFrame.new(cx - width / 2 + stripe * (i + 0.5), cy + 0.02, cz) * tilt, b, Enum.Material.Fabric, false, {shadow = false})
		end
	end
end

return Decor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Exterior</string>
              <string name="Source"><![CDATA[-- Outside the arena: the sunburst mall entrance and the compact spawn hub in front of it. The hub is a
-- self-contained 100 x 78 stud plaza (outside the arena, so spectators can never body-block a chase) packed
-- with things to do and read: a chevron path to the entrance, the winners' podium, two leaderboards, a Shop
-- and a Locker kiosk, palms, benches and bunting. HubService fills in the live boards at runtime.
local Exterior = {}

-- Hub footprint (world space). The mall facade is at z = -154.
local HUB = {x0 = -50, x1 = 50, z0 = -232, z1 = -154}

local function surfaceLabel(parent, name, text, size, position, color, font, align)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	label.FontFace = Font.fromEnum(font or Enum.Font.FredokaOne)
	label.TextXAlignment = align or Enum.TextXAlignment.Center
	label.TextStrokeColor3 = Color3.fromRGB(40, 44, 78)
	label.TextStrokeTransparency = 0.4
	label.Parent = parent
	return label
end

local function surfaceGui(part, pixels)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixels or 30
	gui.LightInfluence = 0
	gui.MaxDistance = 260
	gui.Parent = part
	return gui
end

function Exterior.build(kit, Layout, Decor)
	local P = kit.P
	local lot = kit.group("Facade")
	local hub = kit.group("Hub")
	local sky = kit.group("Skyline")
	local SZ = Layout.Service.z
	local zFace = -SZ - 1.6

	-- ---------------------------------------------------------------------------------------------
	-- The sunburst entrance: two striped towers, a big sign, a status board and a canopy over glass doors.
	-- ---------------------------------------------------------------------------------------------
	-- Base dado and colored bands along the whole facade.
	kit.box(lot, "FacadeDado", 0, 4, zFace, 324, 8, 0.6, P.deepTeal, Enum.Material.SmoothPlastic, false)
	kit.box(lot, "FacadeBandCoral", 0, 30, zFace, 324, 4.5, 0.6, P.coral, Enum.Material.SmoothPlastic, false)
	kit.box(lot, "FacadeBandSun", 0, 33.4, zFace, 324, 1.4, 0.6, P.sun, Enum.Material.SmoothPlastic, false)
	for x = -150, 150, 30 do
		if math.abs(x) > 34 then
			kit.box(lot, "FacadeWindow", x, 14, zFace - 0.2, 20, 9, 0.3, P.glass, Enum.Material.Glass, false, {transparency = 0.35})
			kit.box(lot, "FacadeWindowFrame", x, 14, zFace - 0.35, 21.6, 10.6, 0.2, P.cream, Enum.Material.SmoothPlastic, false)
			kit.box(lot, "FacadeWindowSill", x, 8.4, zFace - 1, 22, 0.6, 1.8, P.deepCoral, Enum.Material.SmoothPlastic, false)
		end
	end
	for _, x in ipairs({-110, -70, 70, 110}) do
		kit.box(lot, "BannerPole", x, 20, zFace - 1, 0.6, 40, 0.6, P.steel, Enum.Material.Metal, false)
		kit.box(lot, "FacadeBanner", x, 22, zFace - 2, 8, 24, 0.3, ({P.pink, P.sky, P.sun, P.mint})[(x // 40 % 4) + 1], Enum.Material.Fabric, false)
	end
	-- Glass entrance doors with a warm interior glow panel behind them.
	kit.box(lot, "EntranceBacking", 0, 11, zFace + 0.25, 40, 22, 0.3, P.deepTeal, Enum.Material.SmoothPlastic, false)
	kit.box(lot, "EntranceGlow", 0, 11, zFace - 0.05, 36, 18, 0.2, P.butter, Enum.Material.SmoothPlastic, false, {shadow = false})
	kit.box(lot, "EntranceGlass", 0, 11, zFace - 0.4, 40, 22, 0.3, P.glass, Enum.Material.Glass, false, {transparency = 0.5, shadow = false})
	for i = -2, 2 do kit.box(lot, "EntranceMullion", i * 10, 11, zFace - 0.6, 0.8, 22, 0.5, P.steel, Enum.Material.Metal, false) end
	kit.box(lot, "EntranceMullion", 0, 22, zFace - 0.6, 40, 0.8, 0.5, P.steel, Enum.Material.Metal, false)
	for _, x in ipairs({-3.4, 3.4}) do kit.box(lot, "DoorHandle", x, 10, zFace - 0.9, 0.4, 4, 0.5, P.gold, Enum.Material.Metal, false) end
	kit.box(lot, "EntranceMat", 0, 0.08, zFace - 4, 30, 0.12, 6, P.coral, Enum.Material.Fabric, false, {shadow = false})
	-- Towers.
	for _, side in ipairs({-1, 1}) do
		local x = side * 26
		kit.box(lot, "GateTower", x, 26, zFace - 3, 8, 52, 6, P.coral, Enum.Material.SmoothPlastic, true)
		for _, y in ipairs({10, 24, 38}) do
			kit.box(lot, "GateStripe", x, y, zFace - 3, 8.4, 2.4, 6.4, P.sun, Enum.Material.SmoothPlastic, false)
		end
		kit.ball(lot, "GateCap", x, 54, zFace - 3, 8, 6, 6.4, P.teal, Enum.Material.SmoothPlastic, false)
	end
	kit.box(lot, "GateHeader", 0, 48, zFace - 3, 44, 8, 6, P.teal, Enum.Material.SmoothPlastic, true)
	kit.box(lot, "GateHeaderTrim", 0, 52.4, zFace - 3, 46, 0.9, 6.6, P.sun, Enum.Material.SmoothPlastic, false)
	kit.sign(lot, "CATCH MALL", CFrame.new(0, 48, zFace - 6.2), 40, 6.4, P.white, P.coral, {pixels = 34, distance = 700, material = Enum.Material.SmoothPlastic})
	kit.sign(lot, "CATCH ME IF YOU CAN", CFrame.new(0, 43.2, zFace - 6.2), 30, 2.6, P.sun, P.ink, {pixels = 34, distance = 500})
	-- Live status board above the doors (HubService writes the text).
	local board = kit.box(lot, "StatusBoard", 0, 35.6, zFace - 6.2, 30, 7, 0.5, P.ink, Enum.Material.SmoothPlastic, false, {shadow = false})
	local gui = surfaceGui(board, 30)
	surfaceLabel(gui, "Phase", "WELCOME TO THE MALL", UDim2.fromScale(0.94, 0.3), UDim2.fromScale(0.03, 0.04), P.sun)
	surfaceLabel(gui, "Timer", "--:--", UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.25, 0.32), P.white)
	surfaceLabel(gui, "Players", "0 PLAYERS", UDim2.fromScale(0.94, 0.2), UDim2.fromScale(0.03, 0.78), P.mint)
	kit.box(lot, "StatusFrame", 0, 35.6, zFace - 6.0, 31.2, 8.2, 0.3, P.sun, Enum.Material.SmoothPlastic, false)
	-- Striped canopy over the doors.
	Decor.awning(kit, lot, 0, 24.6, zFace - 8, 52, 9, P.coral, P.cream, 4)
	-- The sunburst brand mark: a big yellow sun with rays above the gate.
	local sun = kit.part(lot, "SunburstDisc", Vector3.new(1, 26, 26), CFrame.new(0, 66, zFace - 3.6) * CFrame.Angles(0, math.pi / 2, 0), P.sun, Enum.Material.SmoothPlastic, false, {shape = "Cylinder", shadow = false})
	kit.part(lot, "SunburstCore", Vector3.new(1, 17, 17), CFrame.new(0, 66, zFace - 4.1) * CFrame.Angles(0, math.pi / 2, 0), P.butter, Enum.Material.SmoothPlastic, false, {shape = "Cylinder", shadow = false})
	for i = 0, 10 do
		local a = math.rad(-8 + i * 19.6)
		local r = 24
		local pos = Vector3.new(math.cos(a) * r, 66 + math.sin(a) * r, zFace - 3.3)
		kit.part(lot, "SunburstRay", Vector3.new(11, 2.6, 0.8), CFrame.new(pos) * CFrame.Angles(0, 0, a), i % 2 == 0 and P.sun or P.orange, Enum.Material.SmoothPlastic, false, {shadow = false})
	end
	kit.sign(lot, "WELCOME", CFrame.new(0, 66, zFace - 4.8), 15, 3.6, P.ink, P.butter, {pixels = 34, distance = 700, noStroke = true, material = Enum.Material.SmoothPlastic})
	sun.Name = "SunburstDisc"

	-- ---------------------------------------------------------------------------------------------
	-- Lawn, skyline and trees around the hub.
	-- ---------------------------------------------------------------------------------------------
	for i = 1, 26 do
		local a = i / 26 * math.pi * 2
		local r = 520 + (i % 3) * 60
		local h = 70 + (i * 37) % 140
		local w = 40 + (i * 13) % 40
		local x, z = math.cos(a) * r, math.sin(a) * r
		kit.box(sky, "Tower", x, h / 2 - 4, z, w, h, w, ({P.sky, P.lilac, P.mint, P.peach, P.seafoam})[(i % 5) + 1], Enum.Material.SmoothPlastic, false, {shadow = false})
		for k = 1, 4, 2 do kit.box(sky, "TowerWindows", x, 10 + k * (h / 5), z - w / 2 - 0.1, w * 0.8, 3, 0.2, P.white, Enum.Material.SmoothPlastic, false, {shadow = false}) end
	end
	for _, spec in ipairs({{-64, -172}, {64, -172}, {-66, -196}, {66, -196}, {-64, -222}, {64, -222}, {-30, -246}, {30, -246}, {0, -252}}) do
		Decor.tree(kit, hub, spec[1], -1.2, spec[2], 1.1, {P.leaf, P.lime, P.mint})
	end

	-- ---------------------------------------------------------------------------------------------
	-- The hub plaza.
	-- ---------------------------------------------------------------------------------------------
	local cx, cz = (HUB.x0 + HUB.x1) / 2, (HUB.z0 + HUB.z1) / 2
	local width, depth = HUB.x1 - HUB.x0, HUB.z1 - HUB.z0
	kit.box(hub, "HubDeck", cx, -1, cz, width, 2, depth, P.stone, Enum.Material.Slate, true)
	for ix = 0, 4 do
		for iz = 0, 3 do
			if (ix + iz) % 2 == 0 then
				kit.box(hub, "HubTile", HUB.x0 + ix * 20 + 10, 0.03, HUB.z0 + iz * 20 + 10, 19.6, 0.06, 19.6, P.terracotta, Enum.Material.Slate, false, {shadow = false})
			end
		end
	end
	-- Chevron path from the spawn pad toward the podium and the entrance.
	kit.box(hub, "HubPath", 0, 0.08, -208, 12, 0.06, 46, P.butter, Enum.Material.SmoothPlastic, false, {shadow = false})
	for k = 0, 5 do
		local zc = -226 + k * 8
		for _, side in ipairs({-1, 1}) do
			kit.part(hub, "PathChevron", Vector3.new(4.4, 0.06, 1.1), CFrame.new(side * 1.7, 0.13, zc) * CFrame.Angles(0, side * math.rad(40), 0), P.coral, Enum.Material.SmoothPlastic, false, {shadow = false})
		end
	end
	-- Spawn emblem and balloon arch.
	kit.can(hub, "SpawnRing", 0, 0.1, -226, 16, 0.06, P.teal, Enum.Material.SmoothPlastic, false, {shadow = false})
	kit.can(hub, "SpawnRingInner", 0, 0.12, -226, 12, 0.06, P.sun, Enum.Material.SmoothPlastic, false, {shadow = false})
	kit.can(hub, "SpawnRingCore", 0, 0.14, -226, 8, 0.06, P.cream, Enum.Material.SmoothPlastic, false, {shadow = false})
	Decor.balloonArch(kit, hub, 0, 0, -230.5, 9, {P.coral, P.sun, P.teal, P.pink, P.sky})
	kit.sign(hub, "WELCOME!", CFrame.new(0, 14, -231) * CFrame.Angles(0, math.pi, 0), 14, 3, P.white, P.coral, {pixels = 36, distance = 120})
	-- Winners' podium: a stage, a colorful backdrop and a bold sign.
	local py = 0
	kit.box(hub, "PodiumStage", 0, py + 0.6, -176, 44, 1.2, 12, P.deepViolet, Enum.Material.SmoothPlastic, true)
	kit.box(hub, "PodiumStageTrim", 0, py + 1.25, -170.1, 44, 0.2, 0.3, P.sun, Enum.Material.SmoothPlastic, false)
	local podiums = {}
	for i, spec in ipairs({{0, 2.6, "1", P.gold}, {-13, 1.6, "2", P.sky}, {13, 1.0, "3", P.coral}}) do
		local x, h, numeral, accent = spec[1], spec[2], spec[3], spec[4]
		kit.can(hub, "WinnerPodium_" .. numeral, x, py + 1.2 + h / 2, -176, 10, h, P.cream, Enum.Material.SmoothPlastic, true)
		kit.can(hub, "PodiumTop", x, py + 1.2 + h + 0.1, -176, 10.2, 0.25, accent, Enum.Material.SmoothPlastic, false)
		kit.sign(hub, numeral, CFrame.new(x, py + 1.2 + h / 2, -180.8), 3.2, 2.6, P.white, accent, {pixels = 40, distance = 100})
		podiums[i] = CFrame.lookAt(Vector3.new(x, py + 1.2 + h + 3.1, -176), Vector3.new(x, py + 1.2 + h + 3.1, -230))
	end
	kit.box(hub, "PodiumBackdrop", 0, 8, -166.4, 46, 14, 1, P.coral, Enum.Material.SmoothPlastic, false)
	for i = 0, 8 do kit.box(hub, "BackdropStripe", -20 + i * 5, 8, -167.1, 2.4, 14, 0.3, i % 2 == 0 and P.sun or P.pink, Enum.Material.SmoothPlastic, false) end
	kit.sign(hub, "WINNERS", CFrame.new(0, 12.6, -167.6), 26, 5, P.sun, P.ink, {pixels = 34, distance = 260})
	for _, side in ipairs({-1, 1}) do
		kit.box(hub, "StagePylon", side * 22, 8, -166.6, 1.4, 16, 1.4, P.teal, Enum.Material.Metal, false)
		kit.ball(hub, "StagePylonCap", side * 22, 16.6, -166.6, 3, 3, 3, P.sun, Enum.Material.SmoothPlastic, false)
	end

	-- Leaderboards: wins on the west wall, tags on the east wall. HubService writes the rows.
	local function leaderboard(x, yaw, stat, title)
		local f = kit.frame(hub, Vector3.new(x, 0, -200), yaw, 0)
		f.b("BoardLeg", -7, 0, 0, 1, 5, 1, P.dark, Enum.Material.Metal, false)
		f.b("BoardLeg", 7, 0, 0, 1, 5, 1, P.dark, Enum.Material.Metal, false)
		f.b("BoardFrame", 0, 4.4, 0.2, 21.6, 16.6, 0.8, P.sun, Enum.Material.SmoothPlastic, true, {cover = "Full"})
		local face = f.b("HubLeaderboard", 0, 4.8, -0.35, 20, 15.8, 0.5, P.ink, Enum.Material.SmoothPlastic, false, {shadow = false})
		face:SetAttribute("Stat", stat)
		face:SetAttribute("Title", title)
		local g = surfaceGui(face, 30)
		surfaceLabel(g, "Title", title, UDim2.fromScale(0.92, 0.15), UDim2.fromScale(0.04, 0.03), P.sun)
		for row = 1, 5 do
			surfaceLabel(g, "Row" .. row, row .. ".  ---", UDim2.fromScale(0.9, 0.12), UDim2.fromScale(0.05, 0.19 + (row - 1) * 0.15), row == 1 and P.sun or P.white, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
		end
	end
	leaderboard(-46, -math.pi / 2, "Wins", "TOP RUNNERS / WINS")
	leaderboard(46, math.pi / 2, "Tags", "TOP HUNTERS / TAGS")

	-- Shop and Locker kiosks beside the path: stand close and press the prompt to open the menu.
	local function kiosk(x, label, icon, color, menu)
		local f = kit.frame(hub, Vector3.new(x, 0, -214), 0, 0)
		f.b("KioskBase", 0, 0, 0, 9, 4, 5, color, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
		f.b("KioskTop", 0, 4, 0, 9.6, 0.4, 5.6, P.cream, Enum.Material.SmoothPlastic, false)
		for _, sx in ipairs({-4, 4}) do f.b("KioskPole", sx, 4.4, 0, 0.4, 5.6, 0.4, P.steel, Enum.Material.Metal, false) end
		Decor.awning(kit, hub, x, 11, -214 - 1.4, 11, 6.4, color, P.cream, 2.75)
		f.sign(icon .. " " .. label, 0, 6.4, -2.9, 8, 2.4, P.white, color, false, {pixels = 40, distance = 140})
		local promptPart = f.b("PromptPart", 0, 2, -3.2, 5, 4, 0.4, P.white, Enum.Material.SmoothPlastic, false)
		promptPart.Transparency = 1
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "MenuPrompt"
		prompt.ActionText = "Open " .. label
		prompt.ObjectText = icon
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = promptPart
		promptPart:SetAttribute("Menu", menu)
	end
	kiosk(-18, "SHOP", "🛒", P.pink, "Shop")
	kiosk(18, "LOCKER", "👕", P.sky, "Inventory")

	-- A signpost with arrows, and the plaza dressing.
	local sf = kit.frame(hub, Vector3.new(9, 0, -204), 0, 0)
	sf.can("PostPole", 0, 0, 0, 0.9, 12, P.darkwood, Enum.Material.Wood, true)
	for i, spec in ipairs({{"MALL ENTRANCE  ↑", P.coral, 0}, {"← SHOP", P.pink, 4}, {"LOCKER →", P.sky, 8}}) do
		sf.sign(spec[1], 0, 3 + (i - 1) * 2.8, -0.6, 8, 2.2, P.white, spec[2], false, {pixels = 40, distance = 110})
	end
	for _, spec in ipairs({{-44, -160}, {44, -160}, {-44, -226}, {44, -226}}) do
		Decor.planterBox(kit, hub, spec[1], 0, spec[2], 9, 9, P.pink)
		Decor.palm(kit, hub, spec[1], 2.4, spec[2], 1.15)
	end
	for _, spec in ipairs({{-32, -190, math.pi / 2}, {32, -190, -math.pi / 2}, {-32, -164, math.pi}, {32, -164, math.pi}}) do
		Decor.bench(kit, hub, spec[1], 0, spec[2], spec[3], P.sun)
	end
	for _, spec in ipairs({{-11, -222}, {11, -222}, {-11, -196}, {11, -196}}) do Decor.lampPost(kit, hub, spec[1], 0, spec[2], P.butter, math.abs(spec[2]) < 205) end
	Decor.bunting(kit, hub, Vector3.new(-50, 13, -222), Vector3.new(50, 13, -222), 22, {P.coral, P.sun, P.teal, P.pink, P.sky, P.lime})
	for _, x in ipairs({-50, 50}) do kit.box(hub, "BuntingPole", x, 7, -222, 0.6, 14, 0.6, P.steel, Enum.Material.Metal, false) end
	-- Hedges frame the plaza; invisible walls keep it self-contained.
	for _, side in ipairs({-1, 1}) do
		kit.box(hub, "Hedge", side * 51.6, 2.5, cz, 3, 5, depth, P.leaf, Enum.Material.SmoothPlastic, true, {shadow = false})
		kit.box(hub, "HedgeSouth", side * 31, 2.5, HUB.z0 - 1.5, 38, 5, 3, P.leaf, Enum.Material.SmoothPlastic, true, {shadow = false})
	end
	for _, e in ipairs({{-52, cz, 2, depth + 6}, {52, cz, 2, depth + 6}, {0, HUB.z0 - 2, 108, 2}}) do
		local wall = kit.box(hub, "HubBoundary", e[1], 25, e[2], e[3], 50, e[4], P.ink, Enum.Material.SmoothPlastic, true, {shadow = false})
		wall.Transparency = 1
	end
	-- The spawn pad.
	local lobbySpawn = CFrame.lookAt(Vector3.new(0, 3.2, -226), Vector3.new(0, 3.2, -176))
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(8, 0.2, 8)
	spawn.CFrame = CFrame.new(0, 0.1, -226)
	spawn.Transparency = 1
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.CanTouch = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = hub
	kit.count += 1
	return {LobbySpawn = lobbySpawn, Podiums = podiums}
end

return Exterior
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">Fixtures</string>
              <string name="Source"><![CDATA[-- Reusable interior fixtures. Every function works in a store-local frame (`ctx.f`):
-- local +Z runs from the front wall into the store, local X across it, bottoms sit at y0.
-- Cover rules: gondolas, bookcases and wardrobes are full cover (7+ studs); racks are soft cover
-- (walk-through fabric); counters and tables are low (vaultable, <= 4 studs); hide cells are
-- interactive and enclosed.
local Fx = {}

local function pick(list, i) return list[((i - 1) % #list) + 1] end

-- Axis helpers: a fixture may run along local X ("h") or local Z ("v").
local function dims(len, depth, vertical)
	if vertical then return depth, len end
	return len, depth
end

function Fx.gondola(ctx, lx, lz, len, vertical, bodyColor, itemColors, height)
	local f, P = ctx.f, ctx.P
	height = height or 7
	local sx, sz = dims(len, 2.6, vertical)
	f.b("GondolaBody", lx, 0, lz, sx, height, sz, bodyColor, Enum.Material.SmoothPlastic, true, {cover = "Full"})
	f.b("GondolaCap", lx, height, lz, sx + 0.2, 0.4, sz + 0.2, P.white, Enum.Material.SmoothPlastic, false)
	-- Merchandise on both faces: three tiers of coloured product blocks.
	-- Wider product blocks (fewer parts) still read as stocked shelves in three colored tiers.
	local count = math.max(2, math.floor(len / 9))
	for tier = 1, 3 do
		local y0 = 0.9 + (tier - 1) * 2.1
		for i = 1, count do
			local along = -len / 2 + (i - 0.5) * len / count
			local color = pick(itemColors, i + tier)
			for _, face in ipairs({-1, 1}) do
				local px, pz
				if vertical then px, pz = lx + face * 1.45, lz + along else px, pz = lx + along, lz + face * 1.45 end
				local bx, bz
				if vertical then bx, bz = 0.5, len / count - 0.5 else bx, bz = len / count - 0.5, 0.5 end
				f.b("Product", px, y0, pz, bx, 1.4, bz, color, Enum.Material.SmoothPlastic, false)
			end
		end
	end
end

-- Soft cover: a hanging rail of clothes. Garments do not collide, so runners can slip inside.
function Fx.rack(ctx, lx, lz, len, vertical, colorA, colorB)
	local f, P = ctx.f, ctx.P
	local sx, sz = dims(len, 0.4, vertical)
	for _, end_ in ipairs({-1, 1}) do
		local px, pz = lx, lz
		if vertical then pz += end_ * (len / 2 - 0.2) else px += end_ * (len / 2 - 0.2) end
		f.b("RackPost", px, 0, pz, 0.4, 5.6, 0.4, P.steel, Enum.Material.Metal, true)
		f.b("RackFoot", px, 0, pz, vertical and 3 or 0.4, 0.3, vertical and 0.4 or 3, P.steel, Enum.Material.Metal, false)
	end
	f.b("RackRail", lx, 5.4, lz, sx, 0.3, sz, P.steel, Enum.Material.Metal, false)
	local count = math.max(2, math.floor(len / 2.4))
	for i = 1, count do
		local along = -len / 2 + (i - 0.5) * len / count
		local bx, bz = lx, lz
		if vertical then bz += along else bx += along end
		local w = len / count - 0.15
		f.b("Garment", bx, 1.6, bz, vertical and 1.2 or w, 3.8, vertical and w or 1.2, i % 2 == 0 and colorA or colorB, Enum.Material.Fabric, false, {cover = "Soft"})
	end
end

function Fx.counter(ctx, lx, lz, w, d, bodyColor, topColor, screenColor)
	local f, P = ctx.f, ctx.P
	f.b("CounterBody", lx, 0, lz, w, 3.6, d, bodyColor, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
	f.b("CounterTop", lx, 3.6, lz, w + 0.3, 0.3, d + 0.3, topColor or P.white, Enum.Material.Marble, true, {cover = "Low", vault = true})
	f.b("Register", lx - w / 4, 3.9, lz, 1.8, 1.2, 1.4, P.dark, Enum.Material.Metal, false)
	f.b("RegisterScreen", lx - w / 4, 5.1, lz, 1.4, 0.9, 0.2, screenColor or P.mint, Enum.Material.Neon, false)
	f.b("CounterGlow", lx, 0.15, lz - d / 2 - 0.05, w - 0.6, 0.15, 0.1, screenColor or P.mint, Enum.Material.Neon, false)
end

-- Low display table: vaultable, with coloured products.
function Fx.table(ctx, lx, lz, sx, sz, height, color, itemColors)
	local f, P = ctx.f, ctx.P
	f.b("DisplayTable", lx, 0, lz, sx, height, sz, color, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
	f.b("DisplayTop", lx, height, lz, sx + 0.2, 0.2, sz + 0.2, P.white, Enum.Material.SmoothPlastic, false)
	local nx, nz = math.max(1, math.floor(sx / 2.6)), math.max(1, math.floor(sz / 2.6))
	local n = 0
	for ix = 1, nx do
		for iz = 1, nz do
			n += 1
			f.b("Item", lx - sx / 2 + (ix - 0.5) * sx / nx, height + 0.2, lz - sz / 2 + (iz - 0.5) * sz / nz, 1.5, 1 + (n % 3) * 0.4, 1.5, pick(itemColors, n), Enum.Material.SmoothPlastic, false)
		end
	end
end

function Fx.mannequin(ctx, lx, lz, outfit, accent)
	local f, P = ctx.f, ctx.P
	f.b("MannequinBase", lx, 0, lz, 2, 0.3, 2, P.dark, Enum.Material.Metal, false)
	f.b("MannequinLegs", lx, 0.3, lz, 0.9, 2.6, 0.7, outfit, Enum.Material.Fabric, false)
	f.b("MannequinTorso", lx, 2.9, lz, 1.7, 2.2, 0.9, accent, Enum.Material.Fabric, false)
	f.ball("MannequinHead", lx, 5.1, lz, 0.95, 1.05, 0.95, P.white, Enum.Material.SmoothPlastic, false)
	f.b("MannequinPole", lx, 0.3, lz + 0.8, 0.2, 5, 0.2, P.steel, Enum.Material.Metal, false)
end

function Fx.plant(ctx, lx, lz, scale)
	local f, P = ctx.f, ctx.P
	scale = scale or 1
	f.can("PlantPot", lx, 0, lz, 2.6 * scale, 2 * scale, P.coral, Enum.Material.SmoothPlastic, true, {cover = "Soft"})
	f.ball("Foliage", lx, 2 * scale, lz, 3.4 * scale, 3 * scale, 3.4 * scale, P.leaf, Enum.Material.SmoothPlastic, false, {cover = "Soft"})
	f.ball("FoliageHigh", lx + 0.4 * scale, 3.6 * scale, lz, 2.4 * scale, 2.2 * scale, 2.4 * scale, P.lime, Enum.Material.SmoothPlastic, false)
end

function Fx.sofa(ctx, lx, lz, yawDeg, color)
	local g = ctx.sub(lx, lz, yawDeg or 0)
	local P = ctx.P
	g.b("SofaSeat", 0, 0.4, 0, 6.4, 1.6, 2.8, color, Enum.Material.Fabric, true, {cover = "Low", vault = true})
	g.b("SofaBack", 0, 2, 1.1, 6.4, 2.6, 0.8, color, Enum.Material.Fabric, true, {cover = "Low"})
	for _, s in ipairs({-1, 1}) do g.b("SofaArm", s * 3.2, 0.4, 0, 0.8, 2.6, 2.8, color, Enum.Material.Fabric, true) end
	g.b("SofaCushion", -1.4, 2, -0.1, 2.6, 0.6, 2, P.white, Enum.Material.Fabric, false)
	g.b("SofaCushion", 1.4, 2, -0.1, 2.6, 0.6, 2, P.cream, Enum.Material.Fabric, false)
end

function Fx.tv(ctx, lx, y0, lz, w, h, color, inward)
	local f, P = ctx.f, ctx.P
	f.b("TVFrame", lx, y0, lz, w + 0.5, h + 0.5, 0.3, P.black, Enum.Material.Metal, false)
	f.b("TVScreen", lx, y0 + 0.25, lz + (inward and -0.2 or 0.2), w, h, 0.2, color, Enum.Material.Neon, false)
end

function Fx.bookcase(ctx, lx, lz, len, vertical, color, bookColors)
	local f, P = ctx.f, ctx.P
	local sx, sz = dims(len, 1.8, vertical)
	f.b("BookcaseBody", lx, 0, lz, sx, 9, sz, color, Enum.Material.Wood, true, {cover = "Full"})
	local rows = 3
	local count = math.max(3, math.floor(len / 4.6))
	for r = 1, rows do
		for i = 1, count do
			local along = -len / 2 + (i - 0.5) * len / count
			for _, face in ipairs({-1, 1}) do
				local px, pz = lx + (vertical and face * 0.95 or along), lz + (vertical and along or face * 0.95)
				f.b("Books", px, 0.7 + (r - 1) * 2.7, pz, vertical and 0.3 or len / count - 0.3, 1.6, vertical and len / count - 0.3 or 0.3, pick(bookColors, i + r), Enum.Material.SmoothPlastic, false)
			end
		end
	end
end

-- Sub-frame helper for rotated furniture (degrees).
function Fx.shelfWall(ctx, lx, lz, len, vertical, colors)
	-- Wall units hug a wall: tall, shallow, collidable, packed with colour.
	Fx.gondola(ctx, lx, lz, len, vertical, ctx.P.white, colors, 9)
end

function Fx.hangBanner(ctx, lx, lz, w, h, color)
	local f = ctx.f
	f.b("Banner", lx, 20 - h, lz, w, h, 0.2, color, Enum.Material.Fabric, false)
	f.b("BannerRod", lx, 20, lz, w + 0.6, 0.3, 0.3, ctx.P.dark, Enum.Material.Metal, false)
end

-- Enclosed hide cell: fitting room, restroom stall, locker, booth. The cell is built in a sub-frame
-- whose local +Z is the back wall and whose opening faces -Z. Returns the registered spot data.
function Fx.hideCell(ctx, opts)
	local P, kit = ctx.P, ctx.kit
	local model = Instance.new("Model")
	model.Name = "HideSpot_" .. opts.id
	model.Parent = ctx.parent
	local g = ctx.sub(opts.lx, opts.lz, opts.yaw or 0, model)
	local w, d, h = opts.w or 6, opts.d or 6, opts.h or 9
	local wall = opts.wall or P.blush
	-- Walls and roof (collidable so the hunter cannot see or tag through them).
	g.b("CellBack", 0, 0, d / 2 - 0.25, w, h, 0.5, wall, Enum.Material.SmoothPlastic, true)
	g.b("CellLeft", -w / 2 + 0.25, 0, 0, 0.5, h, d, wall, Enum.Material.SmoothPlastic, true)
	g.b("CellRight", w / 2 - 0.25, 0, 0, 0.5, h, d, wall, Enum.Material.SmoothPlastic, true)
	g.b("CellRoof", 0, h - 0.4, 0, w, 0.4, d, opts.roof or wall, Enum.Material.SmoothPlastic, true)
	if opts.interior then opts.interior(g, w, d, h) end
	local decorate = opts.decor
	-- The door is always closed and solid. Whether someone hides inside is deliberately not visible
	-- from the door itself: hunters get tells (feet under the gap, a scan pulse) and a fair Search.
	local doorY = opts.doorGap or 1.2
	local door = g.b("Door", 0, doorY, -d / 2 + 0.2, w - 0.6, h - doorY - 1.4, 0.3, opts.door or P.pink, opts.doorMaterial or Enum.Material.Fabric, true)
	door:SetAttribute("HideDoor", true)
	g.b("DoorHandle", w / 2 - 1, doorY + 2.4, -d / 2 - 0.1, 0.3, 0.9, 0.2, P.steel, Enum.Material.Metal, false)
	if decorate then decorate(g, w, d, h, doorY) end
	local promptPart = g.b("PromptPart", 0, 2.2, -d / 2 - 0.4, 3, 3, 0.3, P.white, Enum.Material.SmoothPlastic, false)
	promptPart.Transparency = 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HidePrompt"
	prompt.ActionText = "Hide"
	prompt.ObjectText = opts.kind
	prompt.HoldDuration = 0.35
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = promptPart
	local rootY = 3.1
	local inside = g.base * CFrame.new(0, rootY, 0)
	local facing = g.base:VectorToWorldSpace(Vector3.new(0, 0, -1))
	local insideCF = CFrame.lookAt(inside.Position, inside.Position + facing)
	local exitPos = g.base:PointToWorldSpace(Vector3.new(0, rootY, -d / 2 - 4.5))
	local exitCF = CFrame.lookAt(exitPos, exitPos + facing)
	model:SetAttribute("CatchHideSpot", true)
	model:SetAttribute("SpotId", opts.id)
	model:SetAttribute("Kind", opts.kind)
	model:SetAttribute("InsideCFrame", insideCF)
	model:SetAttribute("ExitCFrame", exitCF)
	model:SetAttribute("Floor", ctx.floor)
	local spot = {id = opts.id, kind = opts.kind, model = model, door = door, prompt = prompt, inside = insideCF, exit = exitCF, store = ctx.name}
	table.insert(kit.hideSpots, spot)
	return spot
end

return Fx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Primitive builders shared by every mall module. Everything is anchored, original geometry.
-- Collision policy: solid architecture and furniture collide; small decoration never does,
-- so props can never snag a sprinting avatar or block a tag raycast.
local Kit = {}

local C = Color3.fromRGB
-- ART DIRECTION: "Sunburst Mall". Cheerful, saturated, toy-like colors with warm neutrals. Large surfaces
-- (floors, walls) stay mid-tone so nothing blows out; whites are warm; glow is reserved for screens and bulbs.
Kit.P = {
	cream = C(247, 230, 196), white = C(250, 246, 238), ink = C(40, 44, 78), stone = C(228, 202, 160),
	coral = C(255, 94, 84), teal = C(0, 175, 180), sun = C(255, 196, 30), violet = C(128, 88, 230),
	pink = C(255, 100, 170), sky = C(50, 150, 255), mint = C(70, 210, 140), orange = C(255, 138, 30),
	navy = C(36, 62, 140), red = C(226, 48, 62), lime = C(140, 210, 50), wood = C(200, 140, 84),
	darkwood = C(120, 78, 50), steel = C(160, 172, 190), grey = C(190, 194, 206), dark = C(54, 58, 84),
	glass = C(150, 215, 245), leaf = C(70, 185, 90), soil = C(96, 70, 54), gold = C(255, 196, 60),
	black = C(32, 32, 42), blush = C(255, 205, 215), peach = C(255, 208, 170), lilac = C(206, 190, 250),
	-- Deeper tones for large store walls and floors.
	deepTeal = C(18, 120, 130), deepCoral = C(214, 70, 70), deepViolet = C(92, 62, 170), deepBlue = C(30, 70, 160),
	sand = C(236, 214, 170), terracotta = C(214, 120, 90), butter = C(255, 232, 140), seafoam = C(160, 230, 200), honey = C(222, 188, 128),
}

-- Parts allowed to keep the Neon material. Everything else that asks for Neon is built as plain colored
-- plastic, so the mall reads as cheerful and solid rather than glowing. Screens, bulbs and coins glow.
Kit.GlowNames = {
	MallCoin = true, CoinInner = true, Lamp = true, TVScreen = true, CabinetScreen = true, CabinetMarquee = true,
	ScreenWall = true, RegisterScreen = true, FridgeGlass = true, ConsoleScreen = true, MarqueeBulb = true,
	DanceTile = true, StatusBoard = true,
}

-- Parts that must never be culled: gameplay markers and light sources.
Kit.KeepVisible = {MallCoin = true, CoinInner = true, Lamp = true, PromptPart = true}

function Kit.new(model)
	local kit = {
		model = model, count = 0, lights = 0, signs = 0, detail = 0, emitters = 0, P = Kit.P,
		hideSpots = {}, coins = {}, landmarks = {}, covers = {}, doors = {},
	}

	function kit.group(name, parent)
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent or model
		return folder
	end

	-- Core part factory. `opts`: shape (Ball|Cylinder|Can|Wedge), transparency, shadow, cover, attrs.
	function kit.part(parent, name, size, cf, color, material, collide, opts)
		opts = opts or {}
		if material == Enum.Material.Neon and not (opts.glow or Kit.GlowNames[name]) then material = Enum.Material.SmoothPlastic end
		local shape = opts.shape
		if typeof(cf) == "Vector3" then cf = CFrame.new(cf) end
		local part = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
		part.Name = name
		if shape == "Can" then
			part.Size = Vector3.new(size.Y, size.X, size.Z)
			cf = cf * CFrame.Angles(0, 0, math.pi / 2)
			part.Shape = Enum.PartType.Cylinder
		else
			part.Size = size
			if shape == "Ball" then part.Shape = Enum.PartType.Ball end
			if shape == "Cylinder" then part.Shape = Enum.PartType.Cylinder end
		end
		part.CFrame = cf
		part.Color = color or Kit.P.cream
		part.Material = material or Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = collide == true
		part.CanTouch = false
		part.CanQuery = part.CanCollide
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		local biggest = math.max(size.X, size.Y, size.Z)
		if opts.shadow ~= nil then part.CastShadow = opts.shadow
		else part.CastShadow = part.CanCollide and biggest >= 8 and material ~= Enum.Material.Neon end
		if opts.transparency then part.Transparency = opts.transparency end
		if opts.cover then
			part:SetAttribute("Cover", opts.cover)
			table.insert(kit.covers, part)
		end
		if opts.vault then part:SetAttribute("Vaultable", true) end
		-- Small non-colliding decoration: the client may hide it by distance on weaker devices (see PerformanceController).
		if not part.CanCollide and biggest < 3 and not Kit.KeepVisible[name] and string.sub(name, 1, 5) ~= "Sign_" then
			part:SetAttribute("CatchDetail", true)
			kit.detail += 1
		end
		if opts.attrs then for key, value in pairs(opts.attrs) do part:SetAttribute(key, value) end end
		part.Parent = parent
		kit.count += 1
		return part
	end

	-- World-space centre-based box.
	function kit.box(parent, name, cx, cy, cz, sx, sy, sz, color, material, collide, opts)
		return kit.part(parent, name, Vector3.new(sx, sy, sz), Vector3.new(cx, cy, cz), color, material, collide, opts)
	end
	-- Box spanning [x0,x1] x [y0,y1] x [z0,z1].
	function kit.span(parent, name, x0, x1, y0, y1, z0, z1, color, material, collide, opts)
		return kit.box(parent, name, (x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2, x1 - x0, y1 - y0, z1 - z0, color, material, collide, opts)
	end
	function kit.can(parent, name, cx, cy, cz, diameter, height, color, material, collide, opts)
		opts = opts or {}
		opts.shape = "Can"
		return kit.part(parent, name, Vector3.new(diameter, height, diameter), Vector3.new(cx, cy, cz), color, material, collide, opts)
	end
	function kit.ball(parent, name, cx, cy, cz, sx, sy, sz, color, material, collide, opts)
		opts = opts or {}
		opts.shape = "Ball"
		return kit.part(parent, name, Vector3.new(sx, sy, sz), Vector3.new(cx, cy, cz), color, material, collide, opts)
	end

	-- A beam between two points (visual by default).
	function kit.beam(parent, name, a, b, width, color, material, collide)
		local direction = b - a
		local up = math.abs(direction.Unit.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
		return kit.part(parent, name, Vector3.new(width, width, direction.Magnitude), CFrame.lookAt((a + b) / 2, b, up), color, material, collide)
	end

	-- A text sign. `cf` places the backing plate; the readable face looks along the plate's -Z.
	function kit.sign(parent, text, cf, width, height, textColor, backColor, opts)
		opts = opts or {}
		local backing = kit.part(parent, "Sign_" .. text, Vector3.new(width, height, 0.4), cf, backColor or Kit.P.ink, opts.material, false, {shadow = false})
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = opts.pixels or 30
		gui.LightInfluence = 0
		gui.MaxDistance = opts.distance or 130
		gui.Parent = backing
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.94, 0.8)
		label.Position = UDim2.fromScale(0.03, 0.1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = textColor or Kit.P.white
		label.TextScaled = true
		label.FontFace = Font.fromEnum(opts.font or Enum.Font.FredokaOne)
		label.TextStrokeColor3 = opts.stroke or Kit.P.ink
		label.TextStrokeTransparency = opts.noStroke and 1 or 0.35
		label.Parent = gui
		kit.signs += 1
		return backing
	end

	-- Small emissive bulb with a shadowless point light. Lights are budgeted: use sparingly.
	function kit.lamp(parent, pos, color, brightness, range)
		local bulb = kit.box(parent, "Lamp", pos.X, pos.Y, pos.Z, 1.2, 0.3, 1.2, color, Enum.Material.Neon, false)
		local light = Instance.new("PointLight")
		light.Color = color
		light.Brightness = brightness or 0.8
		light.Range = range or 24
		light.Shadows = false
		light.Parent = bulb
		kit.lights += 1
		return bulb
	end

	-- Ambient particles. Budgeted (see tests) and switched off or halved by the client's performance tier.
	-- kinds: "spray" (fountain water), "sparkle" (glitter), "steam" (kitchen vapour).
	function kit.emitter(part, kind)
		local e = Instance.new("ParticleEmitter")
		e.Name = "Ambient_" .. kind
		e.LockedToPart = false
		e.Shape = Enum.ParticleEmitterShape.Box
		if kind == "spray" then
			e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 22, NumberRange.new(1.1, 1.7), NumberRange.new(9, 13), Vector2.new(22, 22)
			e.Acceleration = Vector3.new(0, -28, 0)
			e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.15)})
			e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1)})
			e.Color = ColorSequence.new(Color3.fromRGB(190, 230, 255), Color3.fromRGB(255, 255, 255))
			e.LightEmission = 0.35
		elseif kind == "sparkle" then
			e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 6, NumberRange.new(1.2, 2.2), NumberRange.new(1, 3), Vector2.new(180, 180)
			e.Acceleration = Vector3.new(0, 1.5, 0)
			e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0)})
			e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)})
			e.Color = ColorSequence.new(Color3.fromRGB(255, 226, 120), Color3.fromRGB(255, 160, 220))
			e.LightEmission = 0.8
		else
			e.Rate, e.Lifetime, e.Speed, e.SpreadAngle = 3, NumberRange.new(1.8, 2.8), NumberRange.new(1.5, 2.5), Vector2.new(15, 15)
			e.Acceleration = Vector3.new(0, 1, 0)
			e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.2)})
			e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1)})
			e.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		end
		e.Parent = part
		kit.emitters += 1
		return e
	end

	-- Local frame: origin on the floor, yaw about Y; boxes are bottom-based (`y0` is the base height).
	function kit.frame(parent, origin, yaw, baseY)
		local f = {parent = parent, yaw = yaw}
		local base = CFrame.new(origin.X, baseY or origin.Y, origin.Z) * CFrame.Angles(0, yaw, 0)
		f.base = base
		function f.pos(lx, y, lz) return base:PointToWorldSpace(Vector3.new(lx, y, lz)) end
		function f.cf(lx, y, lz, rx, ry, rz)
			return base * CFrame.new(lx, y, lz) * CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
		end
		-- Box whose bottom is at y0, centred on (lx, lz).
		function f.b(name, lx, y0, lz, sx, sy, sz, color, material, collide, opts)
			return kit.part(parent, name, Vector3.new(sx, sy, sz), base * CFrame.new(lx, y0 + sy / 2, lz), color, material, collide, opts)
		end
		-- Tilted box: rotation in degrees about the box centre.
		function f.t(name, lx, y0, lz, sx, sy, sz, rx, ry, rz, color, material, collide, opts)
			return kit.part(parent, name, Vector3.new(sx, sy, sz), f.cf(lx, y0 + sy / 2, lz, rx, ry, rz), color, material, collide, opts)
		end
		function f.can(name, lx, y0, lz, d, h, color, material, collide, opts)
			opts = opts or {}
			opts.shape = "Can"
			return kit.part(parent, name, Vector3.new(d, h, d), base * CFrame.new(lx, y0 + h / 2, lz), color, material, collide, opts)
		end
		function f.ball(name, lx, y0, lz, sx, sy, sz, color, material, collide, opts)
			opts = opts or {}
			opts.shape = "Ball"
			return kit.part(parent, name, Vector3.new(sx, sy, sz), base * CFrame.new(lx, y0 + sy / 2, lz), color, material, collide, opts)
		end
		function f.wedge(name, lx, y0, lz, sx, sy, sz, ry, color, material, collide, opts)
			opts = opts or {}
			opts.shape = "Wedge"
			return kit.part(parent, name, Vector3.new(sx, sy, sz), f.cf(lx, y0 + sy / 2, lz, 0, ry or 0, 0), color, material, collide, opts)
		end
		-- Sign plate whose readable side faces local -Z (outward from a store); `inward` turns it +Z.
		function f.sign(text, lx, y0, lz, w, h, textColor, backColor, inward, opts)
			local cf = base * CFrame.new(lx, y0 + h / 2, lz) * CFrame.Angles(0, inward and math.pi or 0, 0)
			return kit.sign(parent, text, cf, w, h, textColor, backColor, opts)
		end
		function f.lamp(lx, y0, lz, color, brightness, range) return kit.lamp(parent, f.pos(lx, y0, lz), color, brightness, range) end
		return f
	end

	return kit
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[-- Shared constants for the mall: every module reads the same numbers so floors, walls,
-- stores, hiding spots and spawns always agree. All units are studs; X east, Z north.
local Layout = {}

Layout.FloorY = {[1] = 0, [2] = 24}      -- walking surface of each floor
Layout.SlabBottom, Layout.SlabTop = 22, 24 -- first-floor ceiling / second-floor deck
Layout.RoofBottom, Layout.RoofTop = 46, 48
Layout.AtriumRoofY = 64
Layout.StoreHeight = 22                  -- clear height of every level (floor to ceiling)

Layout.Atrium = {x = 55, z = 60}         -- half extents of the open atrium void
Layout.Ring = {x = 85, z = 90}           -- outer half extents of the public ring corridor
Layout.Stores = {x = 150, z = 140}       -- outer half extents of the store zone
Layout.Service = {x = 162, z = 152}      -- outer half extents of the back-of-house ring (and shell)
Layout.ServiceWidth = 12

Layout.WallThickness = 1
Layout.EntranceHeight = 14
Layout.Bounds = {min = Vector3.new(-175, -12, -165), max = Vector3.new(175, 75, 165)}

-- Store slots. Index runs west->east (N,S) or north->south (E,W). `origin` is the centre of the
-- front wall at floor level and `yaw` turns local +Z (into the store) toward the interior.
local function slot(id, side, rect, entrance)
	return {id = id, side = side, x0 = rect[1], x1 = rect[2], z0 = rect[3], z1 = rect[4], entrance = entrance}
end
Layout.Slots = {
	slot("N1", "N", {-150, -50, 90, 140}, Vector3.new(-67.5, 0, 90)),
	slot("N2", "N", {-50, 50, 90, 140}, Vector3.new(0, 0, 90)),
	slot("N3", "N", {50, 150, 90, 140}, Vector3.new(67.5, 0, 90)),
	slot("S1", "S", {-150, -50, -140, -90}, Vector3.new(-67.5, 0, -90)),
	slot("S2", "S", {-50, 50, -140, -90}, Vector3.new(0, 0, -90)),
	slot("S3", "S", {50, 150, -140, -90}, Vector3.new(67.5, 0, -90)),
	slot("E1", "E", {85, 150, 30, 90}, Vector3.new(85, 0, 60)),
	slot("E2", "E", {85, 150, -30, 30}, Vector3.new(85, 0, 0)),
	slot("E3", "E", {85, 150, -90, -30}, Vector3.new(85, 0, -60)),
	slot("W1", "W", {-150, -85, 30, 90}, Vector3.new(-85, 0, 60)),
	slot("W2", "W", {-150, -85, -30, 30}, Vector3.new(-85, 0, 0)),
	slot("W3", "W", {-150, -85, -90, -30}, Vector3.new(-85, 0, -60)),
}
Layout.SlotById = {}
local YAW = {N = 0, S = math.pi, E = math.pi / 2, W = -math.pi / 2}
for _, s in ipairs(Layout.Slots) do
	Layout.SlotById[s.id] = s
	s.yaw = YAW[s.side]
	s.center = Vector3.new((s.x0 + s.x1) / 2, 0, (s.z0 + s.z1) / 2)
	-- Width runs along the entrance wall, depth into the store.
	if s.side == "N" or s.side == "S" then s.width, s.depth = s.x1 - s.x0, s.z1 - s.z0
	else s.width, s.depth = s.z1 - s.z0, s.x1 - s.x0 end
	local front
	if s.side == "N" then front = Vector3.new(s.center.X, 0, s.z0)
	elseif s.side == "S" then front = Vector3.new(s.center.X, 0, s.z1)
	elseif s.side == "E" then front = Vector3.new(s.x0, 0, s.center.Z)
	else front = Vector3.new(s.x1, 0, s.center.Z) end
	s.front = front
	local frame = CFrame.new(front) * CFrame.Angles(0, s.yaw, 0)
	s.entranceX = frame:PointToObjectSpace(s.entrance).X
	s.entranceWidth = (s.id == "N2" or s.id == "S2") and 40 or (s.width > 80 and 30 or 28)
end

-- Scenic rectangles that must stay free of obstacles on level one (drop landings, ramps).
Layout.Escalators = {
	-- Each ramp: base (L1) and top (L2) in plan view. Pairs run opposite directions and sit in the
	-- 30-stud gaps between storefront entrances so they never block a shop door.
	{id = "NA", from = Vector2.new(-51, 76), to = Vector2.new(-21, 76)},
	{id = "NB", from = Vector2.new(-21, 66), to = Vector2.new(-51, 66)},
	{id = "SA", from = Vector2.new(51, -76), to = Vector2.new(21, -76)},
	{id = "SB", from = Vector2.new(21, -66), to = Vector2.new(51, -66)},
	{id = "EA", from = Vector2.new(74, 16), to = Vector2.new(74, 45)},
	{id = "EB", from = Vector2.new(64, 45), to = Vector2.new(64, 16)},
	{id = "WA", from = Vector2.new(-74, -16), to = Vector2.new(-74, -45)},
	{id = "WB", from = Vector2.new(-64, -45), to = Vector2.new(-64, -16)},
}
Layout.EscalatorWidth = 8
Layout.DropGaps = {
	{edge = "N", at = 21}, {edge = "N", at = 43}, {edge = "S", at = -21}, {edge = "S", at = -43},
	{edge = "E", at = -35}, {edge = "E", at = 35}, {edge = "W", at = -35}, {edge = "W", at = 35},
}
Layout.DropGapWidth = 10

function Layout.Rect(x0, x1, z0, z1) return {x0 = x0, x1 = x1, z0 = z0, z1 = z1} end
-- Subtract hole rectangles from a base rectangle, returning the remaining axis-aligned pieces.
function Layout.Subtract(base, holes)
	local pieces = {base}
	for _, hole in ipairs(holes) do
		local nextPieces = {}
		for _, r in ipairs(pieces) do
			if hole.x1 <= r.x0 or hole.x0 >= r.x1 or hole.z1 <= r.z0 or hole.z0 >= r.z1 then
				table.insert(nextPieces, r)
			else
				if hole.z0 > r.z0 then table.insert(nextPieces, Layout.Rect(r.x0, r.x1, r.z0, hole.z0)) end
				if hole.z1 < r.z1 then table.insert(nextPieces, Layout.Rect(r.x0, r.x1, hole.z1, r.z1)) end
				local z0, z1 = math.max(r.z0, hole.z0), math.min(r.z1, hole.z1)
				if hole.x0 > r.x0 then table.insert(nextPieces, Layout.Rect(r.x0, hole.x0, z0, z1)) end
				if hole.x1 < r.x1 then table.insert(nextPieces, Layout.Rect(hole.x1, r.x1, z0, z1)) end
			end
		end
		pieces = nextPieces
	end
	return pieces
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Service</string>
              <string name="Source"><![CDATA[-- Back of house: the service corridor ring on both floors. It links every store's rear door,
-- gives chasers and runners loops that bypass the public corridors, and holds staff lockers.
local Service = {}

function Service.build(kit, Layout, Fx)
	local P = kit.P
	local folder = kit.group("BackOfHouse")
	local SX, SZ = Layout.Service.x, Layout.Service.z
	local StX, StZ = Layout.Stores.x, Layout.Stores.z
	local mid = (StZ + SZ) / 2
	local midX = (StX + SX) / 2

	for level = 1, 2 do
		local y = Layout.FloorY[level]
		-- Floor inlay (industrial grey with yellow guide lines) and light strips.
		for _, z in ipairs({mid, -mid}) do
			kit.box(folder, "ServiceFloor", 0, y + 0.03, z, SX * 2 - 2, 0.05, Layout.ServiceWidth - 1, P.grey, Enum.Material.Concrete, false)
			kit.box(folder, "ServiceGuide", 0, y + 0.07, z, SX * 2 - 4, 0.05, 0.5, P.sun, Enum.Material.SmoothPlastic, false)
			kit.box(folder, "ServiceLight", 0, y + 21.7, z, SX * 2 - 6, 0.3, 0.8, P.white, Enum.Material.Neon, false)
		end
		for _, x in ipairs({midX, -midX}) do
			kit.box(folder, "ServiceFloor", x, y + 0.03, 0, Layout.ServiceWidth - 1, 0.05, SZ * 2 - 2, P.grey, Enum.Material.Concrete, false)
			kit.box(folder, "ServiceGuide", x, y + 0.07, 0, 0.5, 0.05, SZ * 2 - 4, P.sun, Enum.Material.SmoothPlastic, false)
			kit.box(folder, "ServiceLight", x, y + 21.7, 0, 0.8, 0.3, SZ * 2 - 6, P.white, Enum.Material.Neon, false)
		end
		-- Pipes along the outer walls (visual only) and "STAFF ONLY" signs by the stairs.
		for _, z in ipairs({SZ - 0.8, -SZ + 0.8}) do
			kit.box(folder, "Pipe", 0, y + 17, z, SX * 2 - 4, 0.7, 0.7, level == 1 and P.coral or P.sky, Enum.Material.Metal, false)
			kit.box(folder, "PipeLow", 0, y + 13, z, SX * 2 - 4, 0.5, 0.5, P.steel, Enum.Material.Metal, false)
		end
		for _, x in ipairs({SX - 0.8, -SX + 0.8}) do
			kit.box(folder, "Pipe", x, y + 17, 0, 0.7, 0.7, SZ * 2 - 4, level == 1 and P.coral or P.sky, Enum.Material.Metal, false)
		end
		-- Crate stacks: 2-high vaultable cover, always leaving a clear 6-stud lane.
		local crates = {
			{-110, mid + 3.5}, {-55, mid - 3.5}, {0, mid + 3.5}, {95, mid - 3.5}, {120, mid + 3.5},
			{-100, -mid - 3.5}, {-55, -mid + 3.5}, {0, -mid - 3.5}, {75, -mid + 3.5}, {140, -mid - 3.5},
			{midX + 3.5, 40}, {midX - 3.5, -30}, {midX + 3.5, 110}, {midX - 3.5, -115},
			{-midX - 3.5, -45}, {-midX + 3.5, 45}, {-midX - 3.5, 110}, {-midX + 3.5, -115},
		}
		for i, c in ipairs(crates) do
			local color = ({P.wood, P.orange, P.sky, P.mint})[(i % 4) + 1]
			kit.box(folder, "CrateLarge", c[1], y + 1.8, c[2], 3.6, 3.6, 3.6, color, Enum.Material.Wood, true, {cover = "Low", vault = true})
			kit.box(folder, "CrateSmall", c[1], y + 4.4, c[2], 2.4, 1.6, 2.4, P.wood, Enum.Material.Wood, true)
			kit.box(folder, "CrateStrap", c[1], y + 1.8, c[2], 3.7, 0.3, 3.7, P.dark, Enum.Material.SmoothPlastic, false)
		end
		-- Staff lockers (hiding cells) in groups along the outer walls.
		local ctx = {P = P, kit = kit, parent = folder, floor = level, name = "Back of House"}
		function ctx.sub(wx, wz, yawDeg, par) return kit.frame(par or folder, Vector3.new(wx, y, wz), math.rad(yawDeg or 0), y) end
		local groups = {
			{-135, SZ - 2.4, 0, "N"}, {70, SZ - 2.4, 0, "N"}, {-70, -SZ + 2.4, 180, "S"}, {135, -SZ + 2.4, 180, "S"},
			{SX - 2.4, 60, 90, "E"}, {-SX + 2.4, -60, -90, "W"},
		}
		for gi, g in ipairs(groups) do
			for i = 1, 3 do
				local ox, oz = 0, 0
				if g[4] == "N" or g[4] == "S" then ox = (i - 1) * 4.4 * (g[4] == "N" and 1 or -1) else oz = (i - 1) * 4.4 * (g[4] == "E" and -1 or 1) end
				ctx.name = "Back of House"
				local spotId = string.format("staff_l%d_%s%d_%d", level, g[4], gi, i)
				local localCtx = setmetatable({}, {__index = ctx})
				Fx.hideCell(localCtx, {id = spotId, kind = "Staff Locker", lx = g[1] + ox, lz = g[2] + oz, yaw = g[3], w = 3.8, d = 4, h = 8,
					wall = P.steel, accent = P.orange, door = P.dark, doorMaterial = Enum.Material.Metal, carpet = P.dark, doorGap = 0.6})
			end
		end
	end
	-- Air vents: big duct housings with a slatted grate. A creative hiding spot along the back corridors.
	local function ventDecor(g, w, d, h, doorY)
		for i = 1, 4 do g.b("VentSlat", 0, doorY + 0.8 + i * 1.0, -d / 2 - 0.15, w - 1.2, 0.3, 0.2, P.dark, Enum.Material.Metal, false) end
		g.b("VentFrame", 0, doorY + 0.4, -d / 2 - 0.1, w - 0.4, 0.3, 0.2, P.sky, Enum.Material.Metal, false)
	end
	for level = 1, 2 do
		local y = Layout.FloorY[level]
		local vents = {
			{-30, SZ - 2.6, 0, "N1"}, {40, SZ - 2.6, 0, "N2"}, {30, -SZ + 2.6, 180, "S1"}, {-40, -SZ + 2.6, 180, "S2"},
			{SX - 2.6, -70, 90, "E1"}, {SX - 2.6, 95, 90, "E2"}, {-SX + 2.6, 70, -90, "W1"}, {-SX + 2.6, -95, -90, "W2"},
		}
		local ctx = {P = P, kit = kit, parent = folder, floor = level, name = "Back of House"}
		function ctx.sub(wx, wz, yawDeg, par) return kit.frame(par or folder, Vector3.new(wx, y, wz), math.rad(yawDeg or 0), y) end
		for _, v in ipairs(vents) do
			Fx.hideCell(ctx, {id = string.format("vent_l%d_%s", level, v[4]), kind = "Air Vent", lx = v[1], lz = v[2], yaw = v[3], w = 5, d = 5, h = 6.8,
				wall = P.steel, accent = P.sky, door = P.steel, doorMaterial = Enum.Material.Metal, carpet = P.dark, doorGap = 0.5, decor = ventDecor})
		end
	end
	-- Loading-dock roll-up doors (decor) at the four corners of the ground floor.
	for _, c in ipairs({{SX - 0.4, SZ - 6, -1, 0}, {-SX + 0.4, SZ - 6, 1, 0}, {SX - 0.4, -SZ + 6, -1, 0}, {-SX + 0.4, -SZ + 6, 1, 0}}) do
		kit.box(folder, "DockDoor", c[1], 6, c[2], 0.6, 10, 10, P.steel, Enum.Material.Metal, false)
		for i = 1, 5 do kit.box(folder, "DockSlat", c[1] + c[3] * 0.4, 1.5 + i * 1.6, c[2], 0.2, 0.2, 9.6, P.grey, Enum.Material.Metal, false) end
	end
end

return Service
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Shell</string>
              <string name="Source"><![CDATA[-- Mall structure: foundation, upper deck, roof, atrium, escalators, stairs, bridges, railings.
local Shell = {}

-- Straight stairs. `from`/`to` are plan points (Vector2) at floor level and deck level.
local function stairs(kit, parent, name, from, to, width, rise, color, y0)
	local direction = (to - from)
	local run = direction.Magnitude
	local dir = direction.Unit
	local steps = math.ceil(rise / 0.8)
	local base = y0 or 0
	for i = 1, steps do
		local h = rise * i / steps
		local along = run * (i - 0.5) / steps
		local center = from + dir * along
		local cf = CFrame.lookAt(Vector3.new(center.X, base + h / 2, center.Y), Vector3.new(center.X + dir.X, base + h / 2, center.Y + dir.Y))
		kit.part(parent, name, Vector3.new(width, h, run / steps + 0.06), cf, color, Enum.Material.Concrete, true)
	end
	return run
end

-- Rail with glass infill and a coloured handrail. Axis-aligned segment from a to b (plan points).
local function railing(kit, parent, a, b, y, color, height)
	height = height or 3.6
	local delta = b - a
	local length = delta.Magnitude
	if length < 0.5 then return end
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(Vector3.new(mid.X, y + height / 2, mid.Y), Vector3.new(mid.X + delta.X, y + height / 2, mid.Y + delta.Y))
	-- Glass is solid so nobody slides through it, but low enough to be jumped.
	kit.part(parent, "RailGlass", Vector3.new(0.3, height - 0.6, length), cf * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, -math.pi / 2, 0) * CFrame.new(0, -0.3, 0), kit.P.glass, Enum.Material.Glass, true, {transparency = 0.55, shadow = false})
	kit.part(parent, "RailTop", Vector3.new(0.6, 0.3, length), cf * CFrame.new(0, height / 2 - 0.15, 0), color, Enum.Material.SmoothPlastic, false)
	local posts = math.max(2, math.floor(length / 16) + 1)
	for i = 0, posts - 1 do
		local p = a + delta * (i / (posts - 1))
		kit.box(parent, "RailPost", p.X, y + height / 2, p.Y, 0.5, height, 0.5, color, Enum.Material.Metal, false)
	end
end

function Shell.build(kit, Layout)
	local P = kit.P
	local model = kit.model
	local structure = kit.group("Structure")
	local floors = kit.group("Floors")
	local routes = kit.group("Routes")
	local details = kit.group("Architecture")
	local AX, AZ = Layout.Atrium.x, Layout.Atrium.z
	local SX, SZ = Layout.Service.x, Layout.Service.z
	local RX, RZ = Layout.Ring.x, Layout.Ring.z
	local Y2 = Layout.FloorY[2]

	-- Foundation: the whole ground floor is one marble slab; carpets and lanes are inlays.
	kit.box(floors, "GroundSlab", 0, -1.5, 0, SX * 2, 3, SZ * 2, P.stone, Enum.Material.Slate, true)
	-- Bold checker over the public ground floor (visual only): 20-stud tiles so it reads at any distance.
	for ix = -4, 3 do
		for iz = -4, 3 do
			if (ix + iz) % 2 == 0 then
				kit.box(floors, "FloorTile", ix * 20 + 10, 0.025, iz * 20 + 10, 19.6, 0.05, 19.6, P.terracotta, Enum.Material.Slate, false, {shadow = false})
			end
		end
	end
	kit.box(floors, "OutsideLot", 0, -3.2, 0, 900, 4, 900, Color3.fromRGB(112, 190, 92), Enum.Material.Grass, true)

	-- Holes through the second-floor deck: the atrium void plus the head of every ramp/stair.
	local holes = {Layout.Rect(-AX, AX, -AZ, AZ)}
	local ramps = {}
	local half = Layout.EscalatorWidth / 2 + 0.5
	for _, e in ipairs(Layout.Escalators) do
		local a, b = e.from, e.to
		local dir = (b - a).Unit
		local headStart = a + (b - a) * 0.6
		local lo = Vector2.new(math.min(headStart.X, b.X), math.min(headStart.Y, b.Y))
		local hi = Vector2.new(math.max(headStart.X, b.X), math.max(headStart.Y, b.Y))
		if math.abs(dir.X) > 0.5 then
			table.insert(holes, Layout.Rect(lo.X, hi.X, a.Y - half, a.Y + half))
		else
			table.insert(holes, Layout.Rect(a.X - half, a.X + half, lo.Y, hi.Y))
		end
		table.insert(ramps, e)
	end
	-- Corner ladders connect the back-of-house corridors of both floors (a vertical shortcut).
	local ladders = {
		{x = SX - 1.5, z = SZ - 1.5, dir = -1}, {x = -SX + 1.5, z = SZ - 1.5, dir = 1},
		{x = SX - 1.5, z = -SZ + 1.5, dir = -1}, {x = -SX + 1.5, z = -SZ + 1.5, dir = 1},
	}
	for _, l in ipairs(ladders) do
		table.insert(holes, Layout.Rect(math.min(l.x, l.x - l.dir * 2.5) - 0.5, math.max(l.x, l.x - l.dir * 2.5) + 0.5, l.z - 1.5, l.z + 1.5))
	end
	local slabBase = Layout.Rect(-SX, SX, -SZ, SZ)
	for _, r in ipairs(Layout.Subtract(slabBase, holes)) do
		kit.span(structure, "UpperDeck", r.x0, r.x1, Layout.SlabBottom, Layout.SlabTop, r.z0, r.z1, P.honey, Enum.Material.Slate, true)
	end

	-- Roof with skylight strips; the atrium gets a tall glass clerestory and roof.
	local skylights = {
		Layout.Rect(-80, 80, 70, 80), Layout.Rect(-80, 80, -80, -70),
		Layout.Rect(70, 80, -60, 60), Layout.Rect(-80, -70, -60, 60),
	}
	local roofHoles = {Layout.Rect(-AX, AX, -AZ, AZ)}
	for _, r in ipairs(skylights) do table.insert(roofHoles, r) end
	for _, r in ipairs(Layout.Subtract(Layout.Rect(-SX - 1.5, SX + 1.5, -SZ - 1.5, SZ + 1.5), roofHoles)) do
		kit.span(structure, "Roof", r.x0, r.x1, Layout.RoofBottom, Layout.RoofTop, r.z0, r.z1, P.cream, Enum.Material.Concrete, true)
	end
	for _, r in ipairs(skylights) do
		kit.span(structure, "Skylight", r.x0, r.x1, Layout.RoofBottom + 0.4, Layout.RoofBottom + 0.7, r.z0, r.z1, P.glass, Enum.Material.Glass, true, {transparency = 0.6, shadow = false})
		for x = r.x0 + 10, r.x1 - 1, 20 do
			if r.x1 - r.x0 > 30 then kit.span(structure, "SkylightBeam", x - 0.4, x + 0.4, Layout.RoofBottom, Layout.RoofBottom + 1, r.z0, r.z1, P.white, Enum.Material.Metal, false) end
		end
	end
	local topY = Layout.AtriumRoofY
	kit.span(structure, "AtriumRoofGlass", -AX - 1, AX + 1, topY, topY + 0.5, -AZ - 1, AZ + 1, P.glass, Enum.Material.Glass, true, {transparency = 0.55, shadow = false})
	for _, sign in ipairs({-1, 1}) do
		kit.span(structure, "ClerestoryGlassX", sign * AX - 0.3, sign * AX + 0.3, Layout.RoofTop, topY, -AZ, AZ, P.glass, Enum.Material.Glass, true, {transparency = 0.6, shadow = false})
		kit.span(structure, "ClerestoryGlassZ", -AX, AX, Layout.RoofTop, topY, sign * AZ - 0.3, sign * AZ + 0.3, P.glass, Enum.Material.Glass, true, {transparency = 0.6, shadow = false})
	end
	for x = -AX, AX, AX / 2.5 do
		kit.span(structure, "AtriumRib", x - 0.6, x + 0.6, Layout.RoofTop, topY + 0.8, -AZ - 1, AZ + 1, P.white, Enum.Material.Metal, false)
	end
	for z = -AZ, AZ, AZ / 2 do
		kit.span(structure, "AtriumPurlin", -AX - 1, AX + 1, topY - 0.2, topY + 0.8, z - 0.5, z + 0.5, P.white, Enum.Material.Metal, false)
	end

	-- Exterior shell walls, both floors, with a coloured band so facades read from the lobby.
	local T = 1.5
	local function shellWall(name, x0, x1, z0, z1)
		kit.span(structure, name, x0, x1, -1, Layout.RoofTop, z0, z1, P.cream, Enum.Material.Concrete, true)
	end
	shellWall("ShellWest", -SX - T, -SX, -SZ - T, SZ + T)
	shellWall("ShellEast", SX, SX + T, -SZ - T, SZ + T)
	shellWall("ShellSouth", -SX, SX, -SZ - T, -SZ)
	shellWall("ShellNorth", -SX, SX, SZ, SZ + T)

	-- Colour bands and window pretend-glass on the exterior and service-corridor faces.
	for _, level in ipairs({1, 2}) do
		local y = Layout.FloorY[level]
		for _, z in ipairs({-SZ, SZ}) do
			local s = z > 0 and 1 or -1
			for x = -SX + 20, SX - 20, 26 do
				kit.box(details, "ShellWindow", x, y + 11, z + s * (T + 0.1), 16, 8, 0.2, P.sky, Enum.Material.Glass, false, {transparency = 0.3})
			end
		end
		for _, x in ipairs({-SX, SX}) do
			local s = x > 0 and 1 or -1
			for z = -SZ + 20, SZ - 20, 26 do
				kit.box(details, "ShellWindow", x + s * (T + 0.1), y + 11, z, 0.2, 8, 16, P.sky, Enum.Material.Glass, false, {transparency = 0.3})
			end
		end
	end

	-- Ramps ("escalators"). Solid skirt panels close the space beneath so there is no hiding nook.
	for _, e in ipairs(ramps) do
		local a3 = Vector3.new(e.from.X, 0, e.from.Y)
		local b3 = Vector3.new(e.to.X, Y2, e.to.Y)
		local width = Layout.EscalatorWidth
		local cf = CFrame.lookAt((a3 + b3) / 2, b3)
		local length = (b3 - a3).Magnitude
		local deck = kit.part(routes, "Escalator_" .. e.id, Vector3.new(width, 1, length), cf * CFrame.new(0, -0.5, 0), P.steel, Enum.Material.Metal, true, {attrs = {TraversalRoute = true}})
		deck:SetAttribute("TraversalRoute", true)
		-- Treads: thin ridges, visual only.
		for i = 1, math.floor(length / 6.8) do
			kit.part(routes, "Tread", Vector3.new(width - 0.6, 0.12, 0.3), cf * CFrame.new(0, 0.07, -length / 2 + i * 6.8), P.dark, Enum.Material.SmoothPlastic, false)
		end
		local dir = (b3 - a3) * Vector3.new(1, 0, 1)
		local dirUnit = dir.Unit
		local mid = (a3 + b3) / 2
		for _, side in ipairs({-1, 1}) do
			local right = Vector3.new(-dirUnit.Z, 0, dirUnit.X) * side * (width / 2 + 0.3)
			local wedgeCF = CFrame.lookAt(Vector3.new(mid.X + right.X, Y2 / 2, mid.Z + right.Z), Vector3.new(mid.X + right.X - dirUnit.X, Y2 / 2, mid.Z + right.Z - dirUnit.Z))
			kit.part(routes, "EscalatorSkirt", Vector3.new(0.6, Y2, dir.Magnitude), wedgeCF, P.steel, Enum.Material.SmoothPlastic, true, {shape = "Wedge"})
			-- Handrail above the skirt, following the slope.
			local railA = a3 + right + Vector3.new(0, 3.2, 0)
			local railB = b3 + right + Vector3.new(0, 3.2, 0)
			kit.beam(routes, "EscalatorHandrail", railA, railB, 0.4, e.id:find("A") and P.teal or P.coral, Enum.Material.Metal, false)
		end
		local frontPoint = a3 + (b3 - a3) * 0.24
		kit.part(routes, "EscalatorFront", Vector3.new(width + 1.4, 5.8, 0.6), CFrame.lookAt(Vector3.new(frontPoint.X, 2.9, frontPoint.Z), Vector3.new(frontPoint.X + dirUnit.X, 2.9, frontPoint.Z + dirUnit.Z)), e.id:find("A") and P.teal or P.coral, Enum.Material.SmoothPlastic, true)
		-- Guard on the open edges of the deck hole so nobody falls into the notch.
		local headStart = a3 + (b3 - a3) * 0.6
		for _, side in ipairs({-1, 1}) do
			local right = Vector3.new(-dirUnit.Z, 0, dirUnit.X) * side * (width / 2 + 0.6)
			railing(kit, routes, Vector2.new(headStart.X + right.X, headStart.Z + right.Z), Vector2.new(b3.X + right.X, b3.Z + right.Z), Y2, e.id:find("A") and P.teal or P.coral, 3.4)
		end
	end

	-- Grand staircases rise inside the atrium void to the balcony; a wide, readable climb.
	local grand = {
		{from = Vector2.new(-17, 20), to = Vector2.new(-17, AZ), color = P.coral},
		{from = Vector2.new(17, -20), to = Vector2.new(17, -AZ), color = P.teal},
		{from = Vector2.new(22, 17), to = Vector2.new(AX, 17), color = P.sun},
		{from = Vector2.new(-22, -17), to = Vector2.new(-AX, -17), color = P.violet},
	}
	for i, g in ipairs(grand) do
		stairs(kit, routes, "GrandStair" .. i, g.from, g.to, 14, Y2, P.cream, 0)
		local dir = (g.to - g.from).Unit
		local perp = Vector2.new(-dir.Y, dir.X)
		for _, side in ipairs({-1, 1}) do
			local a = g.from + perp * side * 7.3
			local b = g.to + perp * side * 7.3
			kit.beam(routes, "StairBanister", Vector3.new(a.X, 3.2, a.Y), Vector3.new(b.X, Y2 + 3.2, b.Y), 0.5, g.color, Enum.Material.Metal, false)
			kit.beam(routes, "StairNeon", Vector3.new(a.X, 0.3, a.Y), Vector3.new(b.X, Y2 + 0.3, b.Y), 0.25, g.color, Enum.Material.Neon, false)
		end
	end
	-- Ladders: climbable trusses through a deck opening; each is a deliberate risk/reward shortcut.
	kit.ladders = {}
	for i, l in ipairs(ladders) do
		local truss = Instance.new("TrussPart")
		truss.Name = "ServiceLadder"
		truss.Size = Vector3.new(2, Y2 + 3, 2)
		truss.CFrame = CFrame.new(l.x, (Y2 + 3) / 2, l.z)
		truss.Color = P.orange
		truss.Material = Enum.Material.Metal
		truss.Anchored = true
		truss.CanTouch = false
		truss.Parent = routes
		kit.count += 1
		kit.box(routes, "LadderSign", l.x + l.dir * -0.1, 8, l.z - (l.z > 0 and 2 or -2), 0.2, 0.2, 0.2, P.sun, Enum.Material.Neon, false)
		local standX = l.x + l.dir * 3.2
		table.insert(kit.ladders, {base = Vector3.new(standX, 0, l.z), top = Vector3.new(standX, Y2, l.z)})
	end
	-- Two skybridges cross the void; the second is split around the crossing.
	local function bridge(name, x0, x1, z0, z1)
		kit.span(routes, name, x0, x1, Y2 - 1.5, Y2, z0, z1, P.cream, Enum.Material.Slate, true, {attrs = {TraversalRoute = true}})
		kit.span(routes, name .. "Underglow", x0 + 0.5, x1 - 0.5, Y2 - 1.6, Y2 - 1.45, z0 + 0.5, z1 - 0.5, P.sky, Enum.Material.Neon, false)
	end
	bridge("SkybridgeEW", -AX, AX, -7, 7)
	bridge("SkybridgeNS_S", -7, 7, -AZ, -7)
	bridge("SkybridgeNS_N", -7, 7, 7, AZ)
	for _, side in ipairs({-1, 1}) do
		railing(kit, routes, Vector2.new(-AX, side * 7), Vector2.new(-7, side * 7), Y2, P.sky, 3.6)
		railing(kit, routes, Vector2.new(7, side * 7), Vector2.new(AX, side * 7), Y2, P.sky, 3.6)
		railing(kit, routes, Vector2.new(side * 7, -AZ), Vector2.new(side * 7, -7), Y2, P.sky, 3.6)
		railing(kit, routes, Vector2.new(side * 7, 7), Vector2.new(side * 7, AZ), Y2, P.sky, 3.6)
	end

	-- Balcony railing around the void. Openings: grand-stair landings, skybridge landings, and
	-- deliberate drop gaps (vertical escapes with yellow marker posts).
	local openings = {
		N = {{-24, -10, "stair"}, {-7, 7, "bridge"}},
		S = {{10, 24, "stair"}, {-7, 7, "bridge"}},
		E = {{10, 24, "stair"}, {-7, 7, "bridge"}},
		W = {{-24, -10, "stair"}, {-7, 7, "bridge"}},
	}
	for _, g in ipairs(Layout.DropGaps) do
		table.insert(openings[g.edge], {g.at - Layout.DropGapWidth / 2, g.at + Layout.DropGapWidth / 2, "drop"})
	end
	local function edgeRailing(edge, from, to, fixed, horizontal)
		local list = openings[edge]
		table.sort(list, function(a, b) return a[1] < b[1] end)
		local function rail(a, b)
			if b - a < 0.8 then return end
			if horizontal then railing(kit, routes, Vector2.new(a, fixed), Vector2.new(b, fixed), Y2, P.coral, 3.6)
			else railing(kit, routes, Vector2.new(fixed, a), Vector2.new(fixed, b), Y2, P.coral, 3.6) end
		end
		local cursor = from
		for _, o in ipairs(list) do
			rail(cursor, o[1])
			cursor = o[2]
			if o[3] == "drop" then
				for _, at in ipairs({o[1], o[2]}) do
					if horizontal then kit.box(routes, "DropPost", at, Y2 + 2, fixed, 0.8, 4, 0.8, P.sun, Enum.Material.Metal, false)
					else kit.box(routes, "DropPost", fixed, Y2 + 2, at, 0.8, 4, 0.8, P.sun, Enum.Material.Metal, false) end
				end
				local mid = (o[1] + o[2]) / 2
				if horizontal then kit.box(routes, "DropStrip", mid, Y2 + 0.05, fixed, o[2] - o[1], 0.1, 1.2, P.sun, Enum.Material.Neon, false)
				else kit.box(routes, "DropStrip", fixed, Y2 + 0.05, mid, 1.2, 0.1, o[2] - o[1], P.sun, Enum.Material.Neon, false) end
			end
		end
		rail(cursor, to)
	end
	edgeRailing("N", -AX, AX, AZ, true)
	edgeRailing("S", -AX, AX, -AZ, true)
	edgeRailing("E", -AZ, AZ, AX, false)
	edgeRailing("W", -AZ, AZ, -AX, false)

	-- Columns around the atrium on both floors: sturdy partial cover with colour bands.
	local colors = {P.coral, P.teal, P.sun, P.violet}
	local index = 0
	local function nearRamp(x, z)
		for _, e in ipairs(ramps) do
			local x0, x1 = math.min(e.from.X, e.to.X) - 7, math.max(e.from.X, e.to.X) + 7
			local z0, z1 = math.min(e.from.Y, e.to.Y) - 7, math.max(e.from.Y, e.to.Y) + 7
			if x >= x0 and x <= x1 and z >= z0 and z <= z1 then return true end
		end
		return false
	end
	local function column(x, z)
		if nearRamp(x, z) then return end
		index += 1
		local color = colors[(index % #colors) + 1]
		for _, level in ipairs({1, 2}) do
			local y = Layout.FloorY[level]
			kit.can(structure, "Column", x, y + 11, z, 3.4, 22, P.cream, Enum.Material.Concrete, true, {cover = "Full"})
			kit.can(details, "ColumnBand", x, y + 4, z, 3.8, 3.2, color, Enum.Material.SmoothPlastic, false)
			kit.can(details, "ColumnCollar", x, y + 20.5, z, 4.0, 2, color, Enum.Material.SmoothPlastic, false)
		end
	end
	for _, z in ipairs({-45, -22, 22, 45}) do column(-AX - 6, z) column(AX + 6, z) end
	for _, x in ipairs({-42, -22, 22, 42}) do column(x, -AZ - 6) column(x, AZ + 6) end

	-- Ceiling light strips under the deck and roof, bright warm white.
	for _, level in ipairs({1, 2}) do
		local ceiling = level == 1 and Layout.SlabBottom or Layout.RoofBottom
		local rows = level == 1 and {66, 76, 86} or {64, 86}
		for _, z in ipairs(rows) do
			kit.span(details, "CeilingStrip", -82, 82, ceiling - 0.25, ceiling, z - 0.4, z + 0.4, P.white, Enum.Material.Neon, false)
			kit.span(details, "CeilingStrip", -82, 82, ceiling - 0.25, ceiling, -z - 0.4, -z + 0.4, P.white, Enum.Material.Neon, false)
		end
		local cols = level == 1 and {62, 72, 82} or {64, 84}
		for _, x in ipairs(cols) do
			kit.span(details, "CeilingStrip", x - 0.4, x + 0.4, ceiling - 0.25, ceiling, -58, 58, P.white, Enum.Material.Neon, false)
			kit.span(details, "CeilingStrip", -x - 0.4, -x + 0.4, ceiling - 0.25, ceiling, -58, 58, P.white, Enum.Material.Neon, false)
		end
	end
	return {ramps = ramps, grand = grand}
end

return Shell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">StoreShell</string>
              <string name="Source"><![CDATA[-- Builds the walls, entrance, signage, floor and lighting of one store or zone on one floor.
-- Walls are generated in world space from the slot rectangle, so neighbouring stores get
-- matching door openings and nothing overlaps. Interiors are built by `def.build(ctx)`.
local StoreShell = {}

local DOOR_W, DOOR_H = 9, 11
local SERVICE_W, SERVICE_H = 8, 11

-- Wall run along one axis with rectangular openings. Segments above openings become headers.
local function wallRun(kit, parent, axis, fixedLo, fixedHi, from, to, y0, height, openings, color, material, windows)
	table.sort(openings, function(a, b) return a.center < b.center end)
	local function piece(a, b, yLo, yHi, name, pieceColor, pieceMaterial, collide, opts)
		if b - a < 0.05 or yHi - yLo < 0.05 then return end
		if axis == "x" then
			return kit.span(parent, name, a, b, y0 + yLo, y0 + yHi, fixedLo, fixedHi, pieceColor or color, pieceMaterial or material, collide ~= false, opts)
		end
		return kit.span(parent, name, fixedLo, fixedHi, y0 + yLo, y0 + yHi, a, b, pieceColor or color, pieceMaterial or material, collide ~= false, opts)
	end
	local function solid(a, b)
		if not windows then piece(a, b, 0, height, "Wall") return end
		-- Shopfront: knee wall, display glass, sign band. Glass blocks movement and tagging but not sight.
		local va, vb = math.max(a, windows.from), math.min(b, windows.to)
		if vb - va < 6 then piece(a, b, 0, height, "Wall") return end
		piece(a, va, 0, height, "Wall")
		piece(vb, b, 0, height, "Wall")
		piece(va, vb, 0, 3.5, "KneeWall", windows.knee, nil)
		piece(va, vb, 3.5, 12, "ShopGlass", kit.P.glass, Enum.Material.Glass, true, {transparency = 0.5, shadow = false})
		piece(va, vb, 12, height, "SignBand", color)
		local mullions = math.max(1, math.floor((vb - va) / 10))
		for i = 0, mullions do
			local at = va + (vb - va) * i / mullions
			piece(at - 0.3, at + 0.3, 3.5, 12, "Mullion", windows.accent, Enum.Material.Metal, false)
		end
	end
	local cursor = from
	for _, o in ipairs(openings) do
		local a, b = o.center - o.width / 2, o.center + o.width / 2
		solid(cursor, a)
		piece(a, b, o.height, height, "Header", color)
		cursor = b
	end
	solid(cursor, to)
end

local function alongCoordinate(edge, point)
	if edge == "zMin" or edge == "zMax" then return point.X end
	return point.Z
end

function StoreShell.build(kit, Layout, slot, floor, def, storesFolder, peers)
	local P = kit.P
	local y0 = Layout.FloorY[floor]
	local H = Layout.StoreHeight
	local T = Layout.WallThickness
	local model = Instance.new("Model")
	model.Name = "Store_" .. (def.name:gsub("[^%w]", ""))
	model.Parent = storesFolder
	model:SetAttribute("StoreName", def.name)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("SlotId", slot.id)
	model:SetAttribute("Kind", def.kind or "Store")

	-- Art direction: each shop gets its own bold colors, awning and icon (see Style.lua).
	local theme = kit.style and kit.style.themeFor(def.name)
	local trim = theme and theme.trim or def.accent
	if theme then
		def.wall, def.carpet, def.floorMaterial, def.light = theme.wall, theme.floor, theme.mat, theme.light
	end

	local frontEdge = ({N = "zMin", S = "zMax", E = "xMin", W = "xMax"})[slot.side]
	local backEdge = ({zMin = "zMax", zMax = "zMin", xMin = "xMax", xMax = "xMin"})[frontEdge]
	local openings = {zMin = {}, zMax = {}, xMin = {}, xMax = {}}

	local frame = kit.frame(model, slot.front, slot.yaw, y0)
	local ctx = {kit = kit, P = P, f = frame, parent = model, W = slot.width, D = slot.depth, floor = floor,
		name = def.name, slot = slot, y0 = y0, H = H, accent = def.accent}
	function ctx.sub(lx, lz, yawDeg, parentOverride)
		return kit.frame(parentOverride or model, frame.pos(lx, 0, lz), slot.yaw + math.rad(yawDeg or 0), y0)
	end

	-- Entrance (front wall).
	local entranceWorld = frame.pos(slot.entranceX, 0, 0)
	table.insert(openings[frontEdge], {center = alongCoordinate(frontEdge, entranceWorld), width = def.entranceWidth or slot.entranceWidth, height = Layout.EntranceHeight})
	-- Service doors in the back wall (local x offsets), leading to the back-of-house corridor.
	for _, lx in ipairs(def.serviceDoors or {-slot.width / 4}) do
		local world = frame.pos(lx, 0, slot.depth)
		table.insert(openings[backEdge], {center = alongCoordinate(backEdge, world), width = SERVICE_W, height = SERVICE_H})
	end
	-- Doors to every neighbouring store on this floor, so routes loop through interiors.
	local sealed = {}
	for _, edge in ipairs(def.sealed or {}) do sealed[edge] = true end
	for _, other in ipairs(Layout.Slots) do
		if other ~= slot then
			local function door(edge, lo, hi)
				if sealed[edge] or hi - lo < 14 then return end
				local peer = peers and peers[other.id]
				if def.wideDoor and peer and peer.wideDoor then
					table.insert(openings[edge], {center = (lo + hi) / 2, width = hi - lo - 10, height = 15})
				else
					table.insert(openings[edge], {center = (lo + hi) / 2, width = DOOR_W, height = DOOR_H})
				end
			end
			local zLo, zHi = math.max(slot.z0, other.z0), math.min(slot.z1, other.z1)
			local xLo, xHi = math.max(slot.x0, other.x0), math.min(slot.x1, other.x1)
			if slot.x1 == other.x0 and zHi > zLo then door("xMax", zLo, zHi)
			elseif slot.x0 == other.x1 and zHi > zLo then door("xMin", zLo, zHi)
			elseif slot.z1 == other.z0 and xHi > xLo then door("zMax", xLo, xHi)
			elseif slot.z0 == other.z1 and xHi > xLo then door("zMin", xLo, xHi) end
		end
	end
	-- Door registry for clearance tests and navigation checks (world-space centre at floor level).
	for edge, list in pairs(openings) do
		for _, o in ipairs(list) do
			local center
			if edge == "zMin" then center = Vector3.new(o.center, y0, slot.z0 + T / 2)
			elseif edge == "zMax" then center = Vector3.new(o.center, y0, slot.z1 - T / 2)
			elseif edge == "xMin" then center = Vector3.new(slot.x0 + T / 2, y0, o.center)
			else center = Vector3.new(slot.x1 - T / 2, y0, o.center) end
			table.insert(kit.doors, {store = def.name, edge = edge, center = center, width = o.width, height = o.height, floor = floor})
		end
	end
	local wallColor = def.wall or P.cream
	local wallMaterial = Enum.Material.SmoothPlastic
	-- Visible shopfront range (the part of the front wall that faces the public corridor).
	local windows
	do
		local from, to
		if slot.side == "N" or slot.side == "S" then from, to = math.max(slot.x0, -Layout.Ring.x), math.min(slot.x1, Layout.Ring.x)
		else from, to = slot.z0, slot.z1 end
		windows = {from = from, to = to, knee = def.accent, accent = def.accent}
	end
	local function run(edge)
		local isFront = edge == frontEdge
		if edge == "zMin" then wallRun(kit, model, "x", slot.z0, slot.z0 + T, slot.x0, slot.x1, y0, H, openings[edge], wallColor, wallMaterial, isFront and windows)
		elseif edge == "zMax" then wallRun(kit, model, "x", slot.z1 - T, slot.z1, slot.x0, slot.x1, y0, H, openings[edge], wallColor, wallMaterial, isFront and windows)
		elseif edge == "xMin" then wallRun(kit, model, "z", slot.x0, slot.x0 + T, slot.z0, slot.z1, y0, H, openings[edge], wallColor, wallMaterial, isFront and windows)
		else wallRun(kit, model, "z", slot.x1 - T, slot.x1, slot.z0, slot.z1, y0, H, openings[edge], wallColor, wallMaterial, isFront and windows) end
	end
	for _, edge in ipairs({"zMin", "zMax", "xMin", "xMax"}) do run(edge) end

	-- Floor: coloured carpet inlay with a guiding stripe from the entrance.
	local W, D = slot.width, slot.depth
	frame.b("Carpet", 0, 0.03, D / 2, W - 2 * T - 0.4, 0.05, D - 2 * T - 0.4, def.carpet or P.blush, def.floorMaterial or Enum.Material.Fabric, false)
	frame.b("EntranceStripe", slot.entranceX, 0.09, D * 0.25, 5, 0.05, D * 0.5, def.accent, Enum.Material.SmoothPlastic, false)
	frame.b("Threshold", slot.entranceX, 0.1, 0.5, (def.entranceWidth or slot.entranceWidth) - 1, 0.05, 1.2, trim, Enum.Material.SmoothPlastic, false)

	-- Door frames and the big sign. The sign plate faces the corridor (local -Z).
	local ew = def.entranceWidth or slot.entranceWidth
	for _, s in ipairs({-1, 1}) do
		frame.b("DoorPost", slot.entranceX + s * (ew / 2 + 0.4), 0, -0.4, 1.2, Layout.EntranceHeight, 1.6, trim, Enum.Material.SmoothPlastic, false)
	end
	frame.b("DoorLintel", slot.entranceX, Layout.EntranceHeight, -0.4, ew + 2.4, 1.0, 1.6, trim, Enum.Material.SmoothPlastic, false)
	local signWidth = math.min(36, ew + 12)
	frame.sign(def.name, slot.entranceX, 15, -0.3, signWidth, 5, P.white, def.accent, false, {material = Enum.Material.SmoothPlastic, stroke = P.ink})
	frame.b("SignTrimTop", slot.entranceX, 20.2, -0.3, signWidth, 0.4, 0.4, trim, Enum.Material.SmoothPlastic, false)
	frame.b("SignTrimBottom", slot.entranceX, 14.7, -0.3, signWidth, 0.4, 0.4, trim, Enum.Material.SmoothPlastic, false)
	if def.tagline then
		frame.sign(def.tagline, slot.entranceX, 12.4, -0.3, signWidth * 0.7, 1.9, def.accent, P.white, false, {pixels = 24})
	end

	-- Ceiling: two warm lights, each under a colored pendant shade (no glowing panels).
	local lampTint = def.light or P.white
	for _, lx in ipairs({-W / 4, W / 4}) do
		frame.b("PendantStem", lx, H - 4.2, D * 0.5, 0.2, 2.8, 0.2, P.dark, Enum.Material.Metal, false)
		frame.ball("PendantShade", lx, H - 5.8, D * 0.5, 3.2, 2.2, 3.2, trim, Enum.Material.SmoothPlastic, false)
		frame.lamp(lx, H - 1.5, D * 0.5, lampTint, 0.8, 38)
	end

	-- Interior trim: baseboard, cornice and one painted band around the three inside walls.
	local inner = T + 0.15
	for _, spec in ipairs({
		{"Back", 0, D - inner, W - 2 * T, 0.3, true},
		{"West", -W / 2 + inner, D / 2, 0.3, D - 2 * T, false},
		{"East", W / 2 - inner, D / 2, 0.3, D - 2 * T, false},
	}) do
		local lenX = spec[6] and (W - 2 * T) or 0.3
		local lenZ = spec[6] and 0.3 or (D - 2 * T)
		frame.b("Baseboard" .. spec[1], spec[2], 0, spec[3], lenX, 0.9, lenZ, trim, Enum.Material.SmoothPlastic, false)
		frame.b("Cornice" .. spec[1], spec[2], H - 1.2, spec[3], lenX, 1.0, lenZ, trim, Enum.Material.SmoothPlastic, false)
		frame.b("Band" .. spec[1], spec[2], 7.2, spec[3], lenX, 1.3, lenZ, def.accent, Enum.Material.SmoothPlastic, false)
	end

	-- Storefront dressing: a striped awning over the display windows and a projecting blade sign with the
	-- shop's icon, readable from along the corridor.
	local awning = math.min(W - 6, ew + 14)
	local stripeA, stripeB = def.accent, P.white
	if theme then stripeA, stripeB = theme.awning[1], theme.awning[2] end
	frame.t("AwningBase", slot.entranceX, 12.4, -1.7, awning, 0.35, 3.6, -18, 0, 0, stripeA, Enum.Material.Fabric, false)
	local stripe = 5
	for i = 0, math.floor(awning / stripe) - 1 do
		if i % 2 == 1 then
			frame.t("AwningStripe", slot.entranceX - awning / 2 + stripe * (i + 0.5), 12.45, -1.7, stripe, 0.4, 3.62, -18, 0, 0, stripeB, Enum.Material.Fabric, false)
		end
	end
	local bladeX = slot.entranceX - awning / 2 - 3.4
	if bladeX < -W / 2 + 4 then bladeX = slot.entranceX + awning / 2 + 3.4 end
	frame.b("BladeArm", bladeX, 18.6, -1.6, 0.35, 0.35, 3.2, P.dark, Enum.Material.Metal, false)
	for _, face in ipairs({{-1, 90}, {1, -90}}) do
		local cf = frame.cf(bladeX + face[1] * 0.3, 15.4, -3.4, 0, face[2], 0)
		kit.sign(model, theme and theme.icon or "⭐", cf, 5.2, 5.2, P.white, def.accent, {pixels = 40, distance = 160, noStroke = true})
	end

	if def.build then def.build(ctx) end
	return ctx
end

return StoreShell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">StoresA</string>
              <string name="Source"><![CDATA[-- Ground-floor anchor stores on the north and south strips (100 x 50 each).
local StoresA = {}

function StoresA.defs(P, Fixtures)
	local Fx = Fixtures
	local list = {}

	-- N1 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "N1", floor = 1, name = "FASHION HOUSE", tagline = "NEW SEASON / RUNWAY READY", kind = "Clothing",
		accent = P.pink, wall = P.blush, carpet = P.lilac, light = P.pink, serviceDoors = {22},
		build = function(ctx)
			local f = ctx.f
			local pinks, blues = {P.pink, P.coral, P.sun, P.sky, P.violet, P.mint}, {P.white, P.peach}
			-- Window mannequins in coordinated outfits.
			for i, x in ipairs({-44, -36, -28, -4, 4, 12}) do
				Fx.mannequin(ctx, x, 3.5, pinks[(i % #pinks) + 1], pinks[((i + 2) % #pinks) + 1])
			end
			-- Clothing racks: soft cover in two wings, with a clear aisle from the entrance.
			for ix, x in ipairs({-40, -26, 8, 19}) do
				for iz, z in ipairs({14, 22, 30}) do
					Fx.rack(ctx, x, z, 9, false, pinks[((ix + iz) % #pinks) + 1], pinks[((ix + iz + 3) % #pinks) + 1])
				end
			end
			-- Raised runway with a lit backdrop: a stage to vault onto and sprint along.
			f.b("RunwayStage", -6, 0, 24, 8, 3.2, 22, P.white, Enum.Material.Marble, true, {cover = "Low", vault = true})
			f.b("RunwayGlowL", -10.1, 0.2, 24, 0.25, 0.25, 22, P.pink, Enum.Material.Neon, false)
			f.b("RunwayGlowR", -1.9, 0.2, 24, 0.25, 0.25, 22, P.pink, Enum.Material.Neon, false)
			f.b("RunwayBackdrop", -6, 0, 36.5, 14, 12, 0.6, P.pink, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.b("RunwayBackdropGlow", -6, 9.4, 36.1, 12, 0.3, 0.3, P.white, Enum.Material.Neon, false)
			-- Fitting rooms along the back wall: five curtain booths, each a real hiding spot.
			for i = 1, 5 do
				Fx.hideCell(ctx, {id = "fashion_fit_" .. i, kind = "Fitting Room", lx = -44 + (i - 1) * 6.4, lz = 45.5, yaw = 0,
					wall = P.white, accent = P.pink, door = i % 2 == 0 and P.coral or P.violet, carpet = P.lilac,
					interior = function(g, w, d)
						g.b("Mirror", 0, 2, d / 2 - 0.55, 3.6, 5.6, 0.15, P.sky, Enum.Material.Glass, false, {transparency = 0.3})
						g.b("Bench", 0, 0, d / 2 - 1.2, 3.6, 1.4, 1.2, P.pink, Enum.Material.Fabric, false)
					end})
			end
			Fx.counter(ctx, 6, 8, 10, 2.6, P.pink, P.white, P.pink)
			Fx.shelfWall(ctx, 47.2, 12, 14, true, pinks)
			Fx.plant(ctx, 47, 40, 1)
			Fx.hangBanner(ctx, -20, 20, 8, 7, P.pink)
			Fx.hangBanner(ctx, 12, 28, 8, 7, P.sun)
			Fx.sofa(ctx, 28, 44, 180, P.violet)
			Fx.sofa(ctx, 40, 44, 180, P.coral)
		end})

	-- N2 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "N2", floor = 1, name = "VOLT ELECTRONICS", tagline = "THE FUTURE, ON SALE", kind = "Electronics",
		accent = P.sky, wall = P.white, carpet = Color3.fromRGB(58, 104, 214), floorMaterial = Enum.Material.SmoothPlastic, light = P.sky, serviceDoors = {-30, 30},
		build = function(ctx)
			local f = ctx.f
			local neons = {P.sky, P.mint, P.violet, P.pink, P.sun}
			-- TV wall across the back: nine glowing screens.
			for i = 1, 9 do Fx.tv(ctx, -40 + (i - 1) * 10, 8, 48.4, 8.2, 5, neons[(i % #neons) + 1], true) end
			-- Gaming island and display tables, leaving the centre aisle open.
			Fx.table(ctx, -22, 14, 12, 3.2, 3.2, P.dark, neons)
			Fx.table(ctx, 22, 14, 12, 3.2, 3.2, P.dark, neons)
			Fx.table(ctx, -22, 24, 12, 3.2, 3.2, P.dark, neons)
			Fx.table(ctx, 22, 24, 12, 3.2, 3.2, P.dark, neons)
			-- Phone and headphone gondolas, tall full cover.
			for _, z in ipairs({12, 22, 32}) do Fx.gondola(ctx, -38, z, 8, false, P.white, neons, 7) end
			-- Appliance wall on the right: fridges and washers (full cover) with coloured doors.
			for i, z in ipairs({8, 14, 38, 44}) do
				f.b("Appliance", 43, 0, z, 6, 7, 5.6, P.white, Enum.Material.SmoothPlastic, true, {cover = "Full"})
				f.b("ApplianceDoor", 40, 1.2, z, 0.2, 4.4, 4.4, neons[(i % #neons) + 1], Enum.Material.SmoothPlastic, false)
				f.can("ApplianceDial", 40.1, 5.8, z, 0.8, 0.2, P.dark, Enum.Material.Metal, false)
			end
			-- Mega screen tower: a landmark you can see from the corridor.
			for i = 0, 2 do Fx.tv(ctx, -14, 1 + i * 5.6, 10, 8, 5, neons[(i % #neons) + 1], false) end
			f.b("TowerSpine", -14, 0, 10.3, 1, 17, 0.8, P.dark, Enum.Material.Metal, true, {cover = "Full"})
			Fx.counter(ctx, 34, 5, 10, 2.6, P.dark, P.white, P.sky)
			-- VR demo booths: enclosed cells to duck into.
			for i = 1, 2 do
				Fx.hideCell(ctx, {id = "volt_vr_" .. i, kind = "VR Booth", lx = 6 + (i - 1) * 7, lz = 45.5, yaw = 0, wall = P.dark,
					accent = P.sky, door = P.sky, doorMaterial = Enum.Material.SmoothPlastic, carpet = P.dark,
					interior = function(g, w, d) g.b("VRStand", 0, 0, d / 2 - 1.2, 1.2, 4.5, 1.2, P.sky, Enum.Material.Neon, false) end})
			end
			Fx.plant(ctx, 46, 44, 1.1)
		end})

	-- N3 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "N3", floor = 1, name = "SNEAKER PALACE", tagline = "KICKS FOR EVERY CHASE", kind = "Sneakers",
		accent = P.orange, wall = P.white, carpet = Color3.fromRGB(255, 190, 110), floorMaterial = Enum.Material.SmoothPlastic, light = P.orange, serviceDoors = {44},
		build = function(ctx)
			local f = ctx.f
			local hues = {P.orange, P.red, P.sun, P.sky, P.lime, P.violet}
			-- Shoe wall along the back: glowing boxes of kicks.
			Fx.gondola(ctx, 2, 47.2, 60, false, P.white, hues, 9)
			-- Stepped display pyramid: a parkour staircase of sneakers.
			f.b("PyramidTier1", 16, 0, 27, 26, 1.6, 16, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			f.b("PyramidTier2", 16, 1.6, 27, 18, 1.6, 10, P.orange, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			f.b("PyramidTier3", 16, 3.2, 27, 10, 1.6, 5, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			for i = 1, 4 do f.b("DisplayShoe", 8.5 + i * 3.4, 4.8, 27, 2.4, 1.1, 1, hues[i], Enum.Material.SmoothPlastic, false) end
			-- Giant sneaker landmark.
			local gx, gz = -22, 30
			f.b("GiantSole", gx, 0, gz, 8, 1.6, 20, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			f.b("GiantUpper", gx, 1.6, gz + 2, 7, 4.2, 13, P.orange, Enum.Material.SmoothPlastic, true, {cover = "Low"})
			f.wedge("GiantToe", gx, 1.6, gz - 6.5, 7, 2.6, 6, 0, P.orange, Enum.Material.SmoothPlastic, true)
			f.b("GiantCollar", gx, 5.8, gz + 6, 6.6, 1.6, 5, P.red, Enum.Material.SmoothPlastic, false)
			f.b("GiantTongue", gx, 5.2, gz - 0.6, 4.8, 2.4, 0.8, P.white, Enum.Material.SmoothPlastic, false)
			for i = 1, 4 do f.b("GiantLace", gx, 5.9 - i * 0.15, gz - 3.5 + i * 1.7, 5.2, 0.35, 0.5, P.white, Enum.Material.SmoothPlastic, false) end
			f.t("GiantSwoosh", gx - 3.55, 2.4, gz + 1, 0.25, 1.2, 8, 0, 0, 12, P.white, Enum.Material.Neon, false)
			-- Benches (low cover), a hoop and checkout.
			for _, z in ipairs({12, 20}) do Fx.table(ctx, -40, z, 3, 9, 2.2, P.dark, hues) end
			Fx.counter(ctx, -8, 7, 11, 2.6, P.orange, P.white, P.orange)
			f.b("HoopBoard", 47.6, 9, 38, 0.4, 5, 7, P.white, Enum.Material.SmoothPlastic, false)
			f.b("HoopRim", 46.4, 9.5, 38, 2.4, 0.3, 2.4, P.orange, Enum.Material.Metal, false)
			-- Stock rooms behind the shoe wall: two enclosed cells.
			for i = 1, 2 do
				Fx.hideCell(ctx, {id = "sneaker_stock_" .. i, kind = "Stock Room", lx = -44 + (i - 1) * 9, lz = 44.5, yaw = 0, w = 8, d = 8, wall = P.dark,
					accent = P.orange, door = P.orange, carpet = P.dark,
					interior = function(g, w, d)
						g.b("Boxes", -1.5, 0, d / 2 - 1.6, 2.2, 2.4, 1.8, P.orange, Enum.Material.SmoothPlastic, false)
						g.b("Boxes", 1.4, 0, d / 2 - 1.6, 2.2, 3.6, 1.8, P.white, Enum.Material.SmoothPlastic, false)
					end})
			end
			Fx.hangBanner(ctx, 0, 20, 8, 7, P.orange)
				-- A giant shoe box: orange lid, white base.
				Fx.hideCell(ctx, {id = "sneaker_box", kind = "Giant Shoe Box", lx = 36, lz = 44, yaw = 0, w = 7, d = 6, h = 6,
					wall = P.white, accent = P.orange, door = P.orange, carpet = P.orange, doorGap = 0.4,
					decor = function(g, w, d, h) g.b("BoxLabel", 0, h - 2.6, -d / 2 - 0.2, 3.4, 1.1, 0.2, P.white, Enum.Material.SmoothPlastic, false) end})
		end})

	-- S1 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "S1", floor = 1, name = "MEGA DEPARTMENT", tagline = "EVERYTHING UNDER ONE ROOF", kind = "Department",
		accent = P.teal, wall = P.white, carpet = P.cream, floorMaterial = Enum.Material.Marble, light = P.teal, serviceDoors = {-24, 24},
		build = function(ctx)
			local f = ctx.f
			local mix = {P.teal, P.coral, P.sun, P.sky, P.violet, P.mint}
			-- Maze of tall gondolas: three rows with generous aisles.
			for ix, x in ipairs({-36, -14, 8}) do
				for iz, z in ipairs({13, 25, 37}) do
					Fx.gondola(ctx, x, z, 14, false, P.white, mix, 7)
				end
			end
			-- Perfume island: round counters with glowing bottles.
			f.can("PerfumeCounter", 36, 0, 22, 9, 3.6, P.white, Enum.Material.Marble, true, {cover = "Low", vault = true})
			f.can("PerfumeTop", 36, 3.6, 22, 9.4, 0.3, P.teal, Enum.Material.SmoothPlastic, false)
			for i = 1, 6 do
				local a = i / 6 * math.pi * 2
				f.b("Bottle", 36 + math.cos(a) * 3, 3.9, 22 + math.sin(a) * 3, 0.9, 1.6, 0.9, mix[i], Enum.Material.Glass, false)
			end
			f.can("PerfumeColumn", 36, 3.9, 22, 1.6, 6, P.teal, Enum.Material.Neon, false)
			-- Clothing wing with three fitting rooms.
			for i = 1, 3 do
				Fx.hideCell(ctx, {id = "dept_fit_" .. i, kind = "Fitting Room", lx = 30 + (i - 1) * 6.4, lz = 45.5, yaw = 0, wall = P.white,
					accent = P.teal, door = P.teal, carpet = P.lilac,
					interior = function(g, w, d) g.b("Mirror", 0, 2, d / 2 - 0.55, 3.6, 5.6, 0.15, P.sky, Enum.Material.Glass, false, {transparency = 0.3}) end})
			end
			for i = 1, 3 do Fx.rack(ctx, 40, 12 + i * 6, 8, true, mix[i], mix[i + 2]) end
			Fx.counter(ctx, -10, 5, 10, 2.6, P.teal, P.white, P.teal)
			Fx.counter(ctx, 36, 5, 10, 2.6, P.teal, P.white, P.teal)
			Fx.hangBanner(ctx, -20, 20, 8, 7, P.teal)
			Fx.plant(ctx, -46, 6, 1.1)
		end})

	-- S2 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "S2", floor = 1, name = "QUICK MART", tagline = "SNACKS / DRINKS / FAST", kind = "Convenience",
		accent = P.lime, wall = P.white, carpet = P.white, floorMaterial = Enum.Material.Marble, light = P.lime, serviceDoors = {-34, 34},
		build = function(ctx)
			local f = ctx.f
			local snack = {P.red, P.sun, P.sky, P.lime, P.orange, P.pink}
			-- Parallel aisles of tall shelving (full cover) running front to back.
			for i, x in ipairs({-42, -30, -18, 18, 30, 42}) do
				Fx.gondola(ctx, x, 27, 30, true, P.white, snack, 7)
			end
			-- Cold wall along the back with glowing glass doors.
			for i = 1, 9 do
				f.b("FridgeDoor", -40 + (i - 1) * 10, 0, 48.2, 9, 8, 1.2, P.dark, Enum.Material.Metal, true, {cover = "Full"})
				f.b("FridgeGlass", -40 + (i - 1) * 10, 1, 47.5, 7.6, 6, 0.2, P.sky, Enum.Material.Neon, false, {transparency = 0.2})
			end
			-- Checkout, roller grill, drinks bin and a magazine stand near the front.
			Fx.counter(ctx, -10, 6, 12, 2.8, P.lime, P.white, P.lime)
			Fx.table(ctx, 8, 7, 4, 3, 3.4, P.red, snack)
			f.b("MagazineRack", 12, 0, 9, 4, 6, 1, P.steel, Enum.Material.Metal, true, {cover = "Soft"})
			for i = 1, 4 do f.b("Magazine", 12, 1 + i * 1.1, 8.4, 3.2, 0.9, 0.2, snack[i], Enum.Material.SmoothPlastic, false) end
			-- Walk-in freezer: a cold-room cell at the back, behind the right-hand aisles.
			Fx.hideCell(ctx, {id = "mart_freezer", kind = "Walk-in Freezer", lx = 0, lz = 43.5, yaw = 0, w = 10, d = 10, wall = P.white,
				accent = P.sky, door = P.sky, doorMaterial = Enum.Material.Glass, carpet = P.sky,
				interior = function(g, w, d)
					for i = 1, 3 do g.b("FreezerShelf", -3.5 + (i - 1) * 3.5, 0, d / 2 - 1.2, 3, 5, 1.4, P.white, Enum.Material.SmoothPlastic, false) end
				end})
			-- A stock closet on the left, mirroring the freezer so both back aisles have somewhere to duck.
			Fx.hideCell(ctx, {id = "mart_stock", kind = "Stock Closet", lx = -14, lz = 44.5, yaw = 0, w = 7, d = 8, wall = P.sun,
				accent = P.red, door = P.red, carpet = P.cream})
			f.can("SodaCanLandmark", 0, 0, 18, 4, 10, P.red, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.can("SodaCanTop", 0, 10, 18, 3.6, 0.4, P.steel, Enum.Material.Metal, false)
			f.can("SodaCanBand", 0, 4.5, 18, 4.1, 1.8, P.white, Enum.Material.SmoothPlastic, false)
		end})

	-- S3 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "S3", floor = 1, name = "TOY KINGDOM", tagline = "PLAY / BUILD / SQUEAL", kind = "Toys",
		accent = P.sun, wall = P.blush, carpet = P.sky, light = P.sun, serviceDoors = {-20},
		build = function(ctx)
			local f = ctx.f
			local toy = {P.red, P.sun, P.sky, P.lime, P.pink, P.violet, P.orange}
			-- Giant alphabet-block pyramid: climbable, colourful, great for loops.
			local base = {{-30, 20}, {-22, 20}, {-14, 20}, {-26, 20}, {-18, 20}}
			for i, p in ipairs({{-34, 22}, {-26, 22}, {-18, 22}}) do
				f.b("GiantBlock", p[1], 0, p[2], 6, 6, 6, toy[i], Enum.Material.SmoothPlastic, true, {cover = "Full"})
				f.b("BlockLetter", p[1], 6.02, p[2], 3, 0.1, 3, P.white, Enum.Material.SmoothPlastic, false)
			end
			f.b("GiantBlock", -30, 6, 22, 6, 6, 6, toy[4], Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.b("GiantBlock", -22, 6, 22, 6, 6, 6, toy[5], Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.b("GiantBlock", -26, 12, 22, 6, 6, 6, toy[6], Enum.Material.SmoothPlastic, true, {cover = "Full"})
			-- Giant teddy bear: a friendly landmark built from spheres.
			local bx, bz = 28, 32
			f.ball("BearBody", bx, 0, bz, 9, 10, 8, P.peach, Enum.Material.Fabric, true, {cover = "Full"})
			f.ball("BearHead", bx, 9, bz - 0.5, 7, 6.5, 6.5, P.peach, Enum.Material.Fabric, false)
			for _, s in ipairs({-1, 1}) do
				f.ball("BearEar", bx + s * 3.2, 14.4, bz - 0.5, 2.4, 2.4, 2, P.peach, Enum.Material.Fabric, false)
				f.ball("BearArm", bx + s * 5.4, 3, bz - 1, 3, 6, 3, P.peach, Enum.Material.Fabric, false)
				f.ball("BearEye", bx + s * 1.6, 11, bz - 3.6, 0.8, 0.9, 0.5, P.black, Enum.Material.SmoothPlastic, false)
			end
			f.ball("BearSnout", bx, 9.6, bz - 3.6, 3, 2.4, 2, P.cream, Enum.Material.Fabric, false)
			f.ball("BearNose", bx, 10.2, bz - 4.5, 1, 0.8, 0.6, P.black, Enum.Material.SmoothPlastic, false)
			f.b("BearBow", bx, 7.2, bz - 3.8, 4, 1.2, 0.6, P.red, Enum.Material.Fabric, false)
			-- Toy shelves, a play table and a train track loop.
			Fx.gondola(ctx, -2, 32, 30, false, P.white, toy, 8)
			Fx.gondola(ctx, -8, 14, 14, false, P.white, toy, 6)
			Fx.table(ctx, 10, 14, 10, 3.5, 2.6, P.sky, toy)
			Fx.table(ctx, -40, 8, 3, 12, 2.6, P.sun, toy)
			f.b("TrainTrack", 12, 0.08, 26, 14, 0.06, 1, P.dark, Enum.Material.SmoothPlastic, false)
			f.b("TrainEngine", 8, 0.1, 26, 3, 1.8, 1.6, P.red, Enum.Material.SmoothPlastic, false)
			f.b("TrainCar", 12, 0.1, 26, 3, 1.4, 1.6, P.sun, Enum.Material.SmoothPlastic, false)
			Fx.counter(ctx, -10, 6, 10, 2.6, P.sun, P.white, P.sun)
			-- Play tents: small enclosed cells in the back corners.
			for i = 1, 3 do
				Fx.hideCell(ctx, {id = "toy_tent_" .. i, kind = "Play Tent", lx = 12 + (i - 1) * 7, lz = 46, yaw = 0, w = 6, d = 5, h = 8,
					wall = toy[i + 3], accent = P.sun, door = toy[i], carpet = P.sun,
					interior = function(g, w, d) g.ball("TentPillow", 0, 0, d / 2 - 1, 2.4, 1.4, 1.6, P.white, Enum.Material.Fabric, false) end})
			end
			Fx.hangBanner(ctx, 20, 18, 10, 6, P.sun)
				-- A toy chest big enough to crawl into, with a gold clasp.
				Fx.hideCell(ctx, {id = "toy_chest", kind = "Toy Chest", lx = -42, lz = 44, yaw = 0, w = 6, d = 5, h = 5.8,
					wall = P.red, accent = P.sun, door = P.darkwood, doorMaterial = Enum.Material.Wood, carpet = P.sun, doorGap = 0.4,
					decor = function(g, w, d, h) g.b("ChestClasp", 0, 2.2, -d / 2 - 0.2, 0.9, 1.0, 0.2, P.gold, Enum.Material.Metal, false) end})
		end})

	return list
end

return StoresA
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">StoresB</string>
              <string name="Source"><![CDATA[-- Ground-floor stores on the east and west strips (60 wide x 65 deep, entrance centred).
local StoresB = {}

function StoresB.defs(P, Fx)
	local list = {}

	-- E1 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "E1", floor = 1, name = "SPARKLE & CO", tagline = "DIAMONDS / WATCHES / GOLD", kind = "Jewelry",
		accent = P.violet, wall = P.lilac, carpet = Color3.fromRGB(122, 70, 170), light = P.gold, serviceDoors = {-6},
		build = function(ctx)
			local f = ctx.f
			local gems = {P.sky, P.pink, P.mint, P.sun, P.red}
			-- Glass display cases: solid so you can't walk through them, but low and vaultable.
			for _, z in ipairs({14, 24, 34}) do
				for _, x in ipairs({-17, 17}) do
					f.b("CaseBase", x, 0, z, 10, 2.6, 3, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
					f.b("CaseGlass", x, 2.6, z, 10, 1.4, 3, P.glass, Enum.Material.Glass, true, {transparency = 0.45, shadow = false, vault = true})
					for i = 1, 4 do f.b("Gem", x - 3.6 + (i - 1) * 2.4, 2.7, z, 0.9, 0.9, 0.9, gems[((i + z) % #gems) + 1], Enum.Material.Neon, false) end
				end
			end
			-- Giant diamond on a lit plinth: the store's landmark, visible from the atrium.
			f.can("DiamondPlinth", 0, 0, 52, 9, 2.2, P.white, Enum.Material.Marble, true, {cover = "Low", vault = true})
			f.t("DiamondCore", 0, 2.4, 52, 5, 5, 5, 0, 45, 45, P.sky, Enum.Material.Neon, false, {transparency = 0.25})
			f.wedge("DiamondTopA", 0, 7.2, 52, 5, 2.4, 3.5, 0, P.white, Enum.Material.Glass, false, {transparency = 0.2})
			f.wedge("DiamondTopB", 0, 7.2, 52, 5, 2.4, 3.5, 180, P.white, Enum.Material.Glass, false, {transparency = 0.2})
			f.can("DiamondGlow", 0, 2.25, 52, 8, 0.2, P.sky, Enum.Material.Neon, false)
			-- Chandelier ring.
			f.can("ChandelierRing", 0, 17, 30, 10, 0.5, P.gold, Enum.Material.Metal, false)
			for i = 1, 8 do
				local a = i / 8 * math.pi * 2
				f.ball("ChandelierBulb", math.cos(a) * 4.8, 16, 30 + math.sin(a) * 4.8, 0.9, 1.2, 0.9, P.white, Enum.Material.Neon, false)
			end
			f.b("ChandelierChain", 0, 17.5, 30, 0.2, 4.5, 0.2, P.gold, Enum.Material.Metal, false)
			Fx.sofa(ctx, -22, 46, 180, P.violet)
			Fx.sofa(ctx, 22, 46, 180, P.violet)
			Fx.counter(ctx, 22, 6, 10, 2.6, P.dark, P.gold, P.gold)
			-- Vault and private viewing room: enclosed cells.
			Fx.hideCell(ctx, {id = "sparkle_vault", kind = "Vault", lx = -24, lz = 58, yaw = 0, w = 8, d = 8, wall = P.steel, accent = P.gold,
				door = P.steel, doorMaterial = Enum.Material.Metal, carpet = P.dark,
				interior = function(g, w, d) g.b("SafeBoxes", 0, 0, d / 2 - 1.2, 5, 4, 1.4, P.gold, Enum.Material.Metal, false) end})
			Fx.hideCell(ctx, {id = "sparkle_viewing", kind = "Viewing Room", lx = 24, lz = 58, yaw = 0, w = 8, d = 8, wall = P.violet, accent = P.gold,
				door = P.violet, carpet = P.lilac})
		end})

	-- E2 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "E2", floor = 1, name = "SPORTS ZONE", tagline = "TRAIN / PLAY / WIN", kind = "Sports",
		accent = P.lime, wall = P.white, carpet = Color3.fromRGB(70, 160, 100), light = P.lime, serviceDoors = {18},
		build = function(ctx)
			local f = ctx.f
			local jerseys = {P.red, P.sky, P.sun, P.lime, P.orange}
			-- Half court inlay with a hoop: a clear playground in the middle.
			f.b("CourtInlay", 0, 0.1, 26, 26, 0.04, 28, P.orange, Enum.Material.SmoothPlastic, false)
			f.b("CourtLineA", 0, 0.14, 26, 26, 0.03, 0.4, P.white, Enum.Material.SmoothPlastic, false)
			f.can("CourtCircle", 0, 0.14, 26, 8, 0.03, P.white, Enum.Material.SmoothPlastic, false)
			f.can("CourtCircleInner", 0, 0.16, 26, 7.4, 0.03, P.orange, Enum.Material.SmoothPlastic, false)
			f.b("HoopPole", 0, 0, 42, 0.8, 11, 0.8, P.steel, Enum.Material.Metal, true, {cover = "Soft"})
			f.b("HoopBackboard", 0, 8, 41.4, 6, 4, 0.4, P.white, Enum.Material.SmoothPlastic, false)
			f.can("HoopRim", 0, 8.4, 40, 2.4, 0.25, P.orange, Enum.Material.Metal, false)
			-- Treadmills line the right wall.
			for i, z in ipairs({12, 20, 28, 36}) do
				f.b("TreadmillBase", 22, 0, z, 3, 1.2, 6, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
				f.b("TreadmillBelt", 22, 1.2, z, 2.4, 0.1, 5.2, P.black, Enum.Material.SmoothPlastic, false)
				f.b("TreadmillPost", 22, 1.2, z + 2.6, 0.5, 3.8, 0.5, P.steel, Enum.Material.Metal, false)
				f.b("TreadmillConsole", 22, 4.6, z + 2.6, 2.2, 0.9, 0.6, P.lime, Enum.Material.Neon, false)
			end
			-- Dumbbell and jersey gondolas on the left; barbell racks (soft cover) near the back.
			Fx.gondola(ctx, -26, 18, 14, true, P.white, jerseys, 7)
			Fx.rack(ctx, -14, 12, 9, false, P.red, P.sky)
			Fx.rack(ctx, -14, 20, 9, false, P.sun, P.lime)
			for i = 1, 3 do
				f.b("BarbellRack", -6 + (i - 1) * 8, 0, 56, 6, 3, 0.8, P.dark, Enum.Material.Metal, true, {cover = "Low", vault = true})
				f.b("BarbellBar", -6 + (i - 1) * 8, 3.2, 55.6, 7, 0.3, 0.3, P.steel, Enum.Material.Metal, false)
				for _, s in ipairs({-1, 1}) do f.can("Plate", -6 + (i - 1) * 8 + s * 3.2, 2.4, 55.6, 2.4, 0.5, P.red, Enum.Material.SmoothPlastic, false) end
			end
			-- Climbing wall: a tall coloured panel studded with holds.
			f.b("ClimbingWall", 18, 0, 59, 18, 14, 1.4, P.sky, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			for i = 1, 16 do f.b("Hold", 10 + (i % 8) * 2.2, 1.5 + math.floor(i / 8) * 4 + (i % 3), 58.2, 1, 0.8, 0.6, jerseys[(i % #jerseys) + 1], Enum.Material.SmoothPlastic, false) end
			Fx.counter(ctx, 22, 6, 10, 2.6, P.lime, P.white, P.lime)
			-- Locker room: four enclosed lockers.
			for i = 1, 4 do
				Fx.hideCell(ctx, {id = "sports_locker_" .. i, kind = "Locker", lx = -27 + (i - 1) * 4.2, lz = 60.5, yaw = 0, w = 3.8, d = 4, h = 8,
					wall = P.sky, accent = P.lime, door = P.sky, doorMaterial = Enum.Material.Metal, carpet = P.dark, doorGap = 0.6})
			end
		end})

	-- E3 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "E3", floor = 1, name = "GLOW BEAUTY BAR", tagline = "SHINE / SPARKLE / REPEAT", kind = "Beauty",
		accent = P.coral, wall = P.blush, carpet = Color3.fromRGB(255, 205, 214), light = P.pink, serviceDoors = {18},
		build = function(ctx)
			local f = ctx.f
			local tints = {P.coral, P.pink, P.red, P.violet, P.peach}
			-- Vanity stations with bulb-lined mirrors along the left wall.
			for i, z in ipairs({9, 20, 45, 56}) do
				Fx.counter(ctx, -25, z, 2.8, 8, P.white, P.blush, P.pink)
				f.b("VanityMirror", -28, 3.8, z, 0.3, 6, 7, P.sky, Enum.Material.Glass, false, {transparency = 0.25})
				for k = 1, 4 do f.ball("MirrorBulb", -27.7, 4.4 + (k - 1) * 1.6, z - 3.4, 0.5, 0.5, 0.5, P.sun, Enum.Material.Neon, false) end
			end
			-- Nail bar with stools.
			Fx.counter(ctx, 12, 24, 3, 18, P.pink, P.white, P.pink)
			for i = 1, 5 do f.can("Stool", 16, 0, 16 + (i - 1) * 4, 1.8, 2.2, P.coral, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true}) end
			-- Perfume tower (full cover) and a giant lipstick landmark.
			f.can("PerfumeTower", 0, 0, 36, 5, 10, P.white, Enum.Material.Marble, true, {cover = "Full"})
			for i = 1, 6 do
				local a = i / 6 * math.pi * 2
				f.b("Bottle", math.cos(a) * 2.8, 2 + (i % 3) * 2.4, 36 + math.sin(a) * 2.8, 0.9, 1.6, 0.9, tints[(i % #tints) + 1], Enum.Material.Glass, false)
			end
			f.can("LipstickBase", 20, 0, 48, 4.4, 5, P.gold, Enum.Material.Metal, true, {cover = "Full"})
			f.can("LipstickBody", 20, 5, 48, 3.6, 5, P.red, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.wedge("LipstickTip", 20, 10, 48, 3.6, 2.4, 3.6, 0, P.red, Enum.Material.SmoothPlastic, false)
			Fx.rack(ctx, 6, 12, 8, false, P.pink, P.white)
			Fx.counter(ctx, 22, 6, 10, 2.6, P.coral, P.white, P.coral)
			-- Makeover pods and a photo booth: enclosed cells in the back.
			Fx.hideCell(ctx, {id = "beauty_pod_1", kind = "Makeover Pod", lx = -8, lz = 60, yaw = 0, wall = P.white, accent = P.coral, door = P.pink, carpet = P.blush,
				interior = function(g, w, d) g.b("PodChair", 0, 0, d / 2 - 1.6, 2.4, 2.2, 2.4, P.coral, Enum.Material.Fabric, false) end})
			Fx.hideCell(ctx, {id = "beauty_pod_2", kind = "Makeover Pod", lx = 0, lz = 60, yaw = 0, wall = P.white, accent = P.coral, door = P.violet, carpet = P.blush})
			Fx.hideCell(ctx, {id = "beauty_photo", kind = "Photo Booth", lx = 8, lz = 60, yaw = 0, wall = P.coral, accent = P.sun, door = P.sun, carpet = P.sun})
		end})

	-- W1 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "W1", floor = 1, name = "BOOKWORM BOOKS", tagline = "STORIES YOU CAN HIDE IN", kind = "Books",
		accent = P.wood, wall = P.cream, carpet = Color3.fromRGB(176, 110, 90), light = P.orange, serviceDoors = {0},
		build = function(ctx)
			local f = ctx.f
			local covers = {P.red, P.sky, P.sun, P.lime, P.violet, P.coral, P.teal}
			-- Bookcase maze: tall shelves in staggered rows with 5-stud aisles.
			for i, x in ipairs({-20, -10, 10, 20}) do Fx.bookcase(ctx, x, 30, 34, true, P.darkwood, covers) end
			Fx.bookcase(ctx, -4, 52, 14, false, P.darkwood, covers)
			Fx.bookcase(ctx, 4, 12, 12, false, P.darkwood, covers)
			Fx.bookcase(ctx, -17, 62, 22, false, P.darkwood, covers)
			-- Reading nook: sofas, a low table and a rug.
			f.b("Rug", -22, 0.08, 10, 12, 0.05, 9, P.red, Enum.Material.Fabric, false)
			Fx.sofa(ctx, -22, 15, 180, P.teal)
			Fx.table(ctx, -22, 9, 5, 3, 2.2, P.darkwood, covers)
			-- Giant open book landmark.
			f.b("BookCoverBase", 22, 0, 8, 10, 0.8, 7, P.red, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			f.wedge("BookPageL", 17.4, 0.8, 8, 4.6, 2.2, 6.4, 90, P.white, Enum.Material.SmoothPlastic, false)
			f.wedge("BookPageR", 26.6, 0.8, 8, 4.6, 2.2, 6.4, -90, P.white, Enum.Material.SmoothPlastic, false)
			Fx.counter(ctx, 22, 6, 10, 2.6, P.darkwood, P.wood, P.orange)
			-- Library ladder (decor) and a secret reading room behind a bookcase door.
			f.b("LadderRail", -28.5, 0, 45, 0.4, 9, 0.4, P.wood, Enum.Material.Wood, false)
			f.b("LadderRail", -27, 0, 45, 0.4, 9, 0.4, P.wood, Enum.Material.Wood, false)
			Fx.hideCell(ctx, {id = "books_secret", kind = "Secret Reading Room", lx = 22, lz = 58, yaw = 0, w = 8, d = 8, wall = P.darkwood, accent = P.orange,
				door = P.darkwood, doorMaterial = Enum.Material.Wood, carpet = P.red,
				interior = function(g, w, d) g.b("Armchair", 0, 0, d / 2 - 1.6, 3, 2.4, 2.6, P.coral, Enum.Material.Fabric, false) end})
			Fx.hideCell(ctx, {id = "books_nook", kind = "Reading Booth", lx = 12, lz = 58, yaw = 0, w = 6, d = 6, wall = P.darkwood, accent = P.orange,
				door = P.orange, carpet = P.red})
		end})

	-- W2 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "W2", floor = 1, name = "COZY NEST HOME", tagline = "MAKE ROOM FOR FUN", kind = "Furniture",
		accent = P.mint, wall = P.cream, carpet = P.wood, floorMaterial = Enum.Material.WoodPlanks, light = P.sun, serviceDoors = {18},
		build = function(ctx)
			local f = ctx.f
			local soft = {P.mint, P.sky, P.coral, P.sun, P.violet}
			-- Living room: rug, sofas, coffee table and a TV unit.
			f.b("LivingRug", -20, 0.08, 14, 14, 0.05, 10, P.sky, Enum.Material.Fabric, false)
			Fx.sofa(ctx, -20, 20, 180, P.coral)
			Fx.sofa(ctx, -26, 12, 90, P.mint)
			Fx.table(ctx, -20, 12, 5, 3, 1.8, P.darkwood, soft)
			f.b("TVUnit", -24, 0, 4, 8, 2, 1.6, P.darkwood, Enum.Material.Wood, true, {cover = "Low", vault = true})
			Fx.tv(ctx, -24, 2.8, 4.2, 6, 3.4, P.sky, false)
			-- Bedroom: bed, headboard, bedside tables.
			f.b("BedFrame", 14, 0, 26, 9, 1.8, 11, P.darkwood, Enum.Material.Wood, true, {cover = "Low", vault = true})
			f.b("Mattress", 14, 1.8, 25, 8.4, 1.2, 10, P.white, Enum.Material.Fabric, false)
			f.b("Duvet", 14, 3, 27, 8.6, 0.5, 6, P.mint, Enum.Material.Fabric, false)
			f.b("Headboard", 14, 1.8, 31.6, 9, 4.4, 0.8, P.darkwood, Enum.Material.Wood, true, {cover = "Low"})
			for _, s in ipairs({-1, 1}) do f.b("Bedside", 14 + s * 6, 0, 30.4, 2.2, 2.6, 2.2, P.darkwood, Enum.Material.Wood, true, {cover = "Low", vault = true}) end
			-- Kitchen island and dining set along the back.
			f.b("IslandBody", 0, 0, 46, 14, 3.6, 4, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			f.b("IslandTop", 0, 3.6, 46, 14.4, 0.3, 4.4, P.darkwood, Enum.Material.Wood, true, {vault = true})
			for i = 1, 4 do f.can("BarStool", -5 + (i - 1) * 3.4, 0, 42.4, 1.6, 2.8, P.mint, Enum.Material.SmoothPlastic, false) end
			f.b("DiningTable", 18, 0, 46, 8, 2.8, 5, P.wood, Enum.Material.Wood, true, {cover = "Low", vault = true})
			-- Giant floor lamp landmark.
			f.b("LampPole", 24, 0, 16, 0.5, 11, 0.5, P.steel, Enum.Material.Metal, false)
			f.can("LampShade", 24, 8, 16, 4, 4, P.sun, Enum.Material.Neon, false, {transparency = 0.2})
			f.can("LampBase", 24, 0, 16, 2.4, 0.5, P.dark, Enum.Material.Metal, false)
			Fx.counter(ctx, 22, 6, 10, 2.6, P.mint, P.white, P.mint)
			Fx.plant(ctx, -26, 48, 1.2)
			-- Wardrobes you can step into: enclosed cells.
			for i = 1, 3 do
				Fx.hideCell(ctx, {id = "nest_wardrobe_" .. i, kind = "Wardrobe", lx = -22 + (i - 1) * 5.6, lz = 61, yaw = 0, w = 5, d = 4.2, h = 9.5,
					wall = P.darkwood, accent = P.mint, door = P.wood, doorMaterial = Enum.Material.Wood, carpet = P.darkwood, doorGap = 0.5})
			end
		end})

	-- W3 ------------------------------------------------------------------------------------
	table.insert(list, {slot = "W3", floor = 1, name = "NOIR & GOLD", tagline = "LUXURY BOUTIQUE", kind = "Luxury",
		accent = P.gold, wall = Color3.fromRGB(240, 230, 214), carpet = Color3.fromRGB(116, 52, 120), floorMaterial = Enum.Material.Marble, light = P.gold, serviceDoors = {0},
		build = function(ctx)
			local f = ctx.f
			-- Round pedestals with glass domes and handbags.
			for i, p in ipairs({{-16, 14}, {16, 14}, {-16, 28}, {16, 28}, {-16, 42}, {16, 42}}) do
				f.can("Pedestal", p[1], 0, p[2], 6, 2.6, P.white, Enum.Material.Marble, true, {cover = "Low", vault = true})
				f.b("Handbag", p[1], 2.7, p[2], 2.6, 1.8, 1.2, i % 2 == 0 and P.red or P.black, Enum.Material.Fabric, false)
				f.b("BagStrap", p[1], 4.4, p[2], 1.4, 0.3, 0.3, P.gold, Enum.Material.Metal, false)
				f.can("Dome", p[1], 2.6, p[2], 5.4, 3.6, P.glass, Enum.Material.Glass, false, {transparency = 0.7, shadow = false})
			end
			-- Mannequins in gowns along the walls.
			for i, z in ipairs({10, 20, 30, 40, 50}) do
				Fx.mannequin(ctx, -27.5, z, P.black, P.gold)
				Fx.mannequin(ctx, 27.5, z, P.gold, P.black)
			end
			-- Grand chandelier and velvet ropes leading to the sofa lounge.
			f.can("ChandelierRing", 0, 16, 34, 14, 0.6, P.gold, Enum.Material.Metal, false)
			for i = 1, 12 do
				local a = i / 12 * math.pi * 2
				f.ball("ChandelierBulb", math.cos(a) * 6.8, 14.8, 34 + math.sin(a) * 6.8, 1, 1.4, 1, P.white, Enum.Material.Neon, false)
			end
			f.b("ChandelierChain", 0, 16.5, 34, 0.3, 5.5, 0.3, P.gold, Enum.Material.Metal, false)
			Fx.sofa(ctx, 0, 52, 180, P.red)
			Fx.counter(ctx, 22, 6, 12, 2.6, P.black, P.gold, P.gold)
			-- Private fitting suites: roomy enclosed cells.
			for i = 1, 2 do
				Fx.hideCell(ctx, {id = "noir_suite_" .. i, kind = "Private Suite", lx = -20 + (i - 1) * 40, lz = 59, yaw = 0, w = 8, d = 8, h = 10,
					wall = P.black, accent = P.gold, door = P.red, carpet = P.red,
					interior = function(g, w, d) g.b("SuiteMirror", 0, 2, d / 2 - 0.55, 5, 6, 0.15, P.sky, Enum.Material.Glass, false, {transparency = 0.3}) end})
			end
		end})

	return list
end

return StoresB
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Style</string>
              <string name="Source"><![CDATA[-- Per-store art direction for "Sunburst Mall". Each theme sets bold wall and floor colors, an awning pair and a
-- big icon, so every shop has its own recognizable identity from the corridor. Themes only change appearance:
-- no collision, layout or hiding spot reads from here.
local C = Color3.fromRGB
local Style = {}

local M = Enum.Material

-- Built from the kit palette so the module has no sibling requires (MallBuilder passes `kit.P`).
function Style.new(P)
local style = {}
-- wall: interior/shopfront wall. floor: carpet/inlay color. mat: floor material. trim: door frame, cornice and
-- baseboard color. awning: two stripe colors. icon: emoji on the blade sign. light: warm point-light tint.
style.themes = {
	["FASHION HOUSE"]     = {wall = C(255, 172, 204), floor = C(214, 90, 140), mat = M.Fabric, trim = P.pink, awning = {P.pink, P.white}, icon = "👗", light = C(255, 214, 230)},
	["VOLT ELECTRONICS"]  = {wall = C(40, 62, 130), floor = C(30, 38, 84), mat = M.SmoothPlastic, trim = P.sky, awning = {P.sky, P.navy}, icon = "🎮", light = C(200, 225, 255)},
	["SNEAKER PALACE"]    = {wall = C(255, 214, 96), floor = C(222, 156, 88), mat = M.WoodPlanks, trim = P.orange, awning = {P.orange, P.white}, icon = "👟", light = C(255, 236, 190)},
	["MEGA DEPARTMENT"]   = {wall = C(40, 170, 170), floor = P.sand, mat = M.Slate, trim = P.teal, awning = {P.teal, P.white}, icon = "🛍️", light = C(220, 250, 245)},
	["QUICK MART"]        = {wall = C(110, 200, 80), floor = P.butter, mat = M.SmoothPlastic, trim = P.lime, awning = {P.lime, P.white}, icon = "🛒", light = C(245, 255, 220)},
	["TOY KINGDOM"]       = {wall = C(90, 170, 255), floor = C(255, 214, 80), mat = M.Fabric, trim = P.sun, awning = {P.red, P.sun}, icon = "🧸", light = C(255, 245, 210)},
	["SPARKLE & CO"]      = {wall = C(112, 80, 196), floor = C(84, 50, 140), mat = M.Fabric, trim = P.gold, awning = {P.violet, P.gold}, icon = "💎", light = C(255, 235, 200)},
	["SPORTS ZONE"]       = {wall = C(70, 180, 110), floor = C(44, 130, 86), mat = M.SmoothPlastic, trim = P.orange, awning = {P.lime, P.white}, icon = "⚽", light = C(235, 255, 225)},
	["GLOW BEAUTY BAR"]   = {wall = C(255, 150, 172), floor = C(255, 214, 224), mat = M.SmoothPlastic, trim = P.coral, awning = {P.coral, P.white}, icon = "💄", light = C(255, 226, 234)},
	["BOOKWORM BOOKS"]    = {wall = C(188, 120, 80), floor = C(150, 84, 64), mat = M.Fabric, trim = P.cream, awning = {P.red, P.cream}, icon = "📚", light = C(255, 226, 180)},
	["COZY NEST HOME"]    = {wall = C(150, 222, 190), floor = C(206, 150, 96), mat = M.WoodPlanks, trim = P.mint, awning = {P.mint, P.white}, icon = "🛋️", light = C(255, 240, 210)},
	["NOIR & GOLD"]       = {wall = C(70, 62, 84), floor = C(106, 48, 112), mat = M.Marble, trim = P.gold, awning = {P.black, P.gold}, icon = "👜", light = C(255, 228, 180)},
	["GAME ZONE ARCADE"]  = {wall = C(56, 40, 110), floor = C(30, 26, 60), mat = M.SmoothPlastic, trim = P.pink, awning = {P.violet, P.pink}, icon = "🕹️", light = C(235, 215, 255)},
	["STARLIGHT CINEMA"]  = {wall = C(120, 40, 62), floor = C(160, 40, 70), mat = M.Fabric, trim = P.gold, awning = {P.red, P.gold}, icon = "🎬", light = C(255, 220, 190)},
	["JUNGLE JUMP KIDS"]  = {wall = C(110, 215, 120), floor = C(255, 214, 70), mat = M.Fabric, trim = P.sun, awning = {P.lime, P.sun}, icon = "🐵", light = C(250, 255, 215)},
	["FOOD COURT"]        = {wall = C(255, 196, 120), floor = P.terracotta, mat = M.Slate, trim = P.orange, awning = {P.red, P.white}, icon = "🍔", light = C(255, 236, 200)},
	["RESTROOMS"]         = {wall = C(96, 190, 245), floor = P.white, mat = M.SmoothPlastic, trim = P.sky, awning = {P.sky, P.white}, icon = "🚻", light = C(230, 245, 255)},
	["PET PALACE"]        = {wall = C(255, 200, 150), floor = C(180, 220, 150), mat = M.Fabric, trim = P.orange, awning = {P.orange, P.cream}, icon = "🐾", light = C(255, 240, 215)},
	["SNAP STUDIO"]       = {wall = C(240, 190, 245), floor = P.lilac, mat = M.SmoothPlastic, trim = P.pink, awning = {P.pink, P.lilac}, icon = "📸", light = C(255, 230, 250)},
	["BEAT BOX MUSIC"]    = {wall = C(100, 66, 156), floor = C(54, 36, 90), mat = M.Fabric, trim = P.coral, awning = {P.coral, P.violet}, icon = "🎸", light = C(255, 220, 230)},
	["FIT ZONE GYM"]      = {wall = C(60, 110, 180), floor = C(44, 50, 70), mat = M.SmoothPlastic, trim = P.sky, awning = {P.sky, P.white}, icon = "🏋️", light = C(225, 238, 255)},
}

-- Food stalls and restrooms share a theme through the first word(s) of their name.
function style.themeFor(name)
	local exact = style.themes[name]
	if exact then return exact end
	if string.sub(name, 1, 10) == "FOOD COURT" then return style.themes["FOOD COURT"] end
	if string.sub(name, 1, 9) == "RESTROOMS" then return style.themes["RESTROOMS"] end
	return nil
end

-- Brand colors shared by the exterior and hub.
style.Brand = {primary = P.coral, secondary = P.sun, accent = P.teal, ink = P.ink, cream = P.cream}
return style
end

return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Zones</string>
              <string name="Source"><![CDATA[-- Second-floor attractions: arcade, cinema, kids zone, food court, pets, photo studio, music,
-- gym and restrooms. They use the same slots as the ground-floor stores.
local Zones = {}

local function cabinet(ctx, lx, lz, yawDeg, body, screen, marquee)
	local g = ctx.sub(lx, lz, yawDeg)
	local P = ctx.P
	g.b("CabinetBody", 0, 0, 0, 3.4, 6.2, 2.8, body, Enum.Material.SmoothPlastic, true, {cover = "Full"})
	g.b("CabinetScreen", 0, 2.8, -1.45, 2.6, 2, 0.15, screen, Enum.Material.Neon, false)
	g.b("CabinetDeck", 0, 1.8, -1.6, 3, 0.5, 1, P.dark, Enum.Material.SmoothPlastic, false)
	g.b("CabinetMarquee", 0, 5.3, -1.45, 3.2, 0.8, 0.15, marquee, Enum.Material.Neon, false)
end

local function seatRow(ctx, lx, lz, len, y0, color)
	local f, P = ctx.f, ctx.P
	f.b("SeatBase", lx, y0, lz, len, 1.2, 2, color, Enum.Material.Fabric, true, {cover = "Low", vault = true})
	f.b("SeatBack", lx, y0 + 1.2, lz + 0.8, len, 1.6, 0.5, color, Enum.Material.Fabric, false)
	for i = 1, math.floor(len / 6) do f.b("Armrest", lx - len / 2 + i * 6, y0 + 1.2, lz, 0.4, 0.8, 1.6, P.dark, Enum.Material.SmoothPlastic, false) end
end

local function foodStall(ctx, lx, name, color, prop)
	local f, P = ctx.f, ctx.P
	local depth = ctx.D
	f.b("StallCounter", lx, 0, depth - 8, 14, 3.6, 3, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
	f.b("StallTop", lx, 3.6, depth - 8, 14.3, 0.3, 3.3, color, Enum.Material.SmoothPlastic, false)
	local kitchen = f.b("StallKitchen", lx, 0, depth - 3.5, 14, 11, 2, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Full"})
	ctx.kit.emitter(kitchen, "steam")
	f.b("StallMenu", lx, 6.5, depth - 4.6, 11, 4.2, 0.3, P.white, Enum.Material.SmoothPlastic, false)
	f.sign(name, lx, 12.2, depth - 5.2, 13, 3.4, P.white, color, true, {pixels = 26})
	for i = 1, 4 do f.b("MenuLine", lx, 7.4 + (i - 1) * 0.9, depth - 4.8, 8 - (i % 2) * 2, 0.3, 0.15, color, Enum.Material.SmoothPlastic, false) end
	f.b("StallCanopy", lx, 10.8, depth - 8, 14.6, 0.5, 4.2, color, Enum.Material.Fabric, false)
	for i = 0, 6 do f.b("CanopyStripe", lx - 6.5 + i * 2.17, 10.85, depth - 8, 1.08, 0.52, 4.3, P.white, Enum.Material.Fabric, false) end
	if prop then prop(f, lx, depth - 8) end
end

local function diningIsland(ctx, lx, lz, color)
	local f, P = ctx.f, ctx.P
	f.can("DiningTable", lx, 0, lz, 4.6, 2.8, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
	f.can("DiningTop", lx, 2.8, lz, 5, 0.25, color, Enum.Material.SmoothPlastic, false)
	for i = 0, 1 do
		local a = i * math.pi + math.pi / 4
		f.can("Stool", lx + math.cos(a) * 3.4, 0, lz + math.sin(a) * 3.4, 1.6, 1.8, color, Enum.Material.SmoothPlastic, false)
	end
end

function Zones.defs(P, Fx)
	local list = {}

	-- N1 L2: ARCADE --------------------------------------------------------------------------
	table.insert(list, {slot = "N1", floor = 2, name = "GAME ZONE ARCADE", tagline = "INSERT COIN / CHASE HIGH SCORE", kind = "Arcade",
		accent = P.violet, wall = P.dark, carpet = P.black, floorMaterial = Enum.Material.SmoothPlastic, light = P.violet, serviceDoors = {22},
		build = function(ctx)
			local f = ctx.f
			local glow = {P.pink, P.sky, P.mint, P.sun, P.violet, P.coral}
			-- Back-to-back cabinet pairs form long full-cover walls with open aisles between.
			for r, z in ipairs({16, 30}) do
				for i = 1, 8 do
					local x = -44 + (i - 1) * 4
					cabinet(ctx, x, z, 0, P.dark, glow[(i + r) % #glow + 1], glow[(i + r + 2) % #glow + 1])
					cabinet(ctx, x, z + 3, 180, P.dark, glow[(i + r + 1) % #glow + 1], glow[(i + r + 3) % #glow + 1])
				end
			end
			for i = 1, 5 do cabinet(ctx, -44 + (i - 1) * 4, 46, 0, P.violet, glow[i], glow[(i + 1) % #glow + 1]) end
			-- Neon floor strips and a dance platform.
			for _, z in ipairs({8, 24, 40}) do f.b("FloorNeon", 0, 0.12, z, 90, 0.05, 0.5, glow[(z % 5) + 1], Enum.Material.Neon, false) end
			f.b("DancePlatform", 24, 0, 28, 14, 1, 14, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			for i = 0, 3 do for j = 0, 3 do f.b("DanceTile", 24 - 5.25 + i * 3.5, 1.02, 28 - 5.25 + j * 3.5, 3.2, 0.06, 3.2, glow[((i + j) % #glow) + 1], Enum.Material.Neon, false) end end
			-- Air hockey tables (low) and a giant claw machine landmark.
			for i, z in ipairs({12, 20}) do
				f.b("AirHockey", 40, 0, z, 6, 2.8, 9, P.sky, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
				f.b("AirHockeyGlow", 40, 2.85, z, 5, 0.1, 8, P.white, Enum.Material.Neon, false)
			end
			f.b("ClawBody", 40, 0, 40, 10, 5, 10, P.pink, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.b("ClawGlass", 40, 5, 40, 9, 7, 9, P.glass, Enum.Material.Glass, true, {transparency = 0.6, shadow = false, cover = "Full"})
			f.b("ClawArm", 40, 8.4, 40, 0.5, 3.4, 0.5, P.steel, Enum.Material.Metal, false)
			for i = 1, 6 do f.ball("ClawPrize", 37.5 + (i % 3) * 2.4, 5.1, 37.5 + math.floor(i / 3) * 3, 1.8, 1.8, 1.8, glow[i], Enum.Material.SmoothPlastic, false) end
			f.b("ClawTopLight", 40, 12, 40, 10, 0.5, 10, P.violet, Enum.Material.Neon, false)
			Fx.counter(ctx, -8, 6, 12, 2.6, P.violet, P.white, P.pink)
			-- Photo booths and the prize room.
			for i = 1, 2 do
				Fx.hideCell(ctx, {id = "arcade_booth_" .. i, kind = "Photo Booth", lx = 8 + (i - 1) * 7, lz = 46, yaw = 0, w = 6, d = 6, wall = P.violet, accent = P.sun,
					door = P.sun, carpet = P.black})
			end
			Fx.hideCell(ctx, {id = "arcade_prize", kind = "Prize Room", lx = -4, lz = 44.5, yaw = 0, w = 8, d = 8, wall = P.pink, accent = P.sun, door = P.pink, carpet = P.violet,
				interior = function(g, w, d) g.b("PrizeShelf", 0, 0, d / 2 - 1.2, 6, 5, 1.4, P.white, Enum.Material.SmoothPlastic, false) end})
		end})

	-- N2 L2: CINEMA --------------------------------------------------------------------------
	table.insert(list, {slot = "N2", floor = 2, name = "STARLIGHT CINEMA", tagline = "NOW SHOWING: THE GREAT CHASE", kind = "Cinema",
		accent = P.red, wall = Color3.fromRGB(70, 40, 70), carpet = Color3.fromRGB(150, 40, 70), light = P.sun, serviceDoors = {-34, 34},
		build = function(ctx)
			local f = ctx.f
			-- Lobby: ticket counters, long concession bar, popcorn landmark and poster wall.
			Fx.counter(ctx, -26, 7, 14, 2.6, P.red, P.gold, P.sun)
			Fx.counter(ctx, 26, 7, 14, 2.6, P.red, P.gold, P.sun)
			f.b("ConcessionBar", 0, 0, 16, 26, 3.6, 3, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			f.b("ConcessionTop", 0, 3.6, 16, 26.4, 0.3, 3.4, P.gold, Enum.Material.Metal, false)
			f.b("ConcessionMenu", 0, 7, 17.8, 20, 3, 0.3, P.white, Enum.Material.Neon, false)
			f.can("PopcornBucket", 0, 0, 24, 5, 6, P.white, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			for i = 0, 4 do f.b("BucketStripe", math.cos(i * 1.2566) * 2.2, 0, 24 + math.sin(i * 1.2566) * 2.2, 0.8, 6, 0.8, P.red, Enum.Material.SmoothPlastic, false) end
			for i = 1, 7 do f.ball("Popcorn", math.cos(i) * 1.6, 6 + (i % 3) * 0.6, 24 + math.sin(i) * 1.6, 1.8, 1.6, 1.8, P.cream, Enum.Material.SmoothPlastic, false) end
			for i = 1, 6 do f.b("Poster", -42 + (i - 1) * 17, 5, 1.8, 7, 9, 0.2, ({P.red, P.sky, P.sun, P.violet, P.coral, P.teal})[i], Enum.Material.Neon, false) end
			-- Theatre hall: stepped seating facing a glowing screen at the back-left.
			f.b("ScreenWall", 0, 0, 48.6, 70, 18, 0.6, P.white, Enum.Material.Neon, false)
			f.b("ScreenFrame", 0, 0, 48.3, 72, 19, 0.5, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			for i = 1, 4 do
				local y0 = (i - 1) * 1.2
				seatRow(ctx, -18, 28 + (i - 1) * 3, 28, y0, P.red)
				seatRow(ctx, 18, 28 + (i - 1) * 3, 28, y0, P.red)
			end
			f.b("TheatreRiser", -18, 0, 36, 30, 1.2, 12, P.dark, Enum.Material.Fabric, true)
			f.b("TheatreRiser", 18, 0, 36, 30, 1.2, 12, P.dark, Enum.Material.Fabric, true)
			Fx.hideCell(ctx, {id = "cinema_booth", kind = "Projection Booth", lx = 0, lz = 42.5, yaw = 0, w = 8, d = 8, wall = P.dark, accent = P.sun, door = P.red, carpet = P.dark,
				interior = function(g, w, d) g.b("Projector", 0, 0, d / 2 - 1.2, 2.4, 2.8, 1.6, P.steel, Enum.Material.Metal, false) end})
			Fx.hideCell(ctx, {id = "cinema_usher", kind = "Usher Closet", lx = 42, lz = 14, yaw = 0, w = 5, d = 5, wall = P.red, accent = P.sun, door = P.dark, carpet = P.dark})
			Fx.hideCell(ctx, {id = "cinema_usher_2", kind = "Usher Closet", lx = -42, lz = 14, yaw = 0, w = 5, d = 5, wall = P.red, accent = P.sun, door = P.dark, carpet = P.dark})
		end})

	-- N3 L2: KIDS ZONE -----------------------------------------------------------------------
	table.insert(list, {slot = "N3", floor = 2, name = "JUNGLE JUMP KIDS", tagline = "BOUNCE / SLIDE / GIGGLE", kind = "Play",
		accent = P.lime, wall = P.mint, carpet = P.sun, light = P.lime, serviceDoors = {40},
		build = function(ctx)
			local f = ctx.f
			local pop = {P.red, P.sun, P.sky, P.pink, P.lime, P.violet}
			-- Ball pit: a sunken-looking inlay filled with coloured balls (no collision).
			f.b("BallPitFloor", 22, 0.1, 22, 28, 0.06, 20, P.sky, Enum.Material.SmoothPlastic, false)
			for i = 1, 40 do
				local a = i * 2.399
				f.ball("PitBall", 22 + math.cos(a) * (i % 9) * 1.4, 0.2, 22 + math.sin(a) * (i % 7) * 1.35, 1.6, 1.6, 1.6, pop[(i % #pop) + 1], Enum.Material.SmoothPlastic, false)
			end
			-- Slide tower with stairs and a wedge slide.
			f.b("TowerBase", -30, 0, 14, 8, 8, 8, P.lime, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			for i = 1, 5 do f.b("TowerStep", -30, 0, 22 + i * 1.6, 8, i * 1.4, 1.6, pop[i], Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true}) end
			f.wedge("SlideWedge", -22, 0, 14, 4, 8, 14, 90, P.red, Enum.Material.SmoothPlastic, true)
			-- Foam blocks and mushroom seats: soft low cover.
			for i = 1, 6 do f.b("FoamBlock", -10 + (i % 3) * 6, 0, 30 + math.floor(i / 3) * 6, 4, 2.4 + (i % 2), 4, pop[i], Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true}) end
			for i = 1, 4 do
				f.can("MushroomStem", 38, 0, 38 - (i - 1) * 6, 1.4, 2, P.white, Enum.Material.SmoothPlastic, false)
				f.can("MushroomCap", 38, 2, 38 - (i - 1) * 6, 4, 1.2, pop[i], Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			end
			-- Giant jungle gym frame.
			for _, x in ipairs({-8, 8}) do for _, z in ipairs({40, 52}) do f.b("GymPost", x, 0, z - 2, 0.6, 10, 0.6, P.orange, Enum.Material.Metal, false) end end
			f.b("GymBar", 0, 9.4, 38, 16.6, 0.6, 0.6, P.orange, Enum.Material.Metal, false)
			f.b("GymBar", 0, 6, 38, 16.6, 0.6, 0.6, P.orange, Enum.Material.Metal, false)
			Fx.counter(ctx, 4, 6, 10, 2.6, P.lime, P.white, P.lime)
			for i = 1, 2 do
				Fx.hideCell(ctx, {id = "kids_tunnel_" .. i, kind = "Play Tunnel", lx = 8 + (i - 1) * 8, lz = 47, yaw = 0, w = 6, d = 6, h = 6, wall = pop[i + 2], accent = P.sun, door = pop[i], carpet = P.sun})
			end
			Fx.hideCell(ctx, {id = "kids_house", kind = "Play House", lx = -40, lz = 46, yaw = 0, w = 7, d = 7, h = 9, wall = P.pink, accent = P.sun, door = P.sun, carpet = P.peach})
		end})

	-- S1/S2/S3 L2: FOOD COURT ----------------------------------------------------------------
	local stalls = {
		S1 = {{-34, "BURGER BARN", P.red}, {0, "PIZZA PLANET", P.orange}, {34, "NOODLE MOON", P.coral}},
		S2 = {{-34, "TACO TOWN", P.lime}, {0, "SUSHI SPIN", P.sky}, {34, "ICE CREAM LAB", P.pink}},
		S3 = {{-34, "BUBBLE TEA", P.violet}, {0, "FRY STATION", P.sun}, {34, "DONUT DEN", P.peach}},
	}
	for _, id in ipairs({"S1", "S2", "S3"}) do
		table.insert(list, {slot = id, floor = 2, name = id == "S2" and "FOOD COURT" or "FOOD COURT " .. (id == "S1" and "WEST" or "EAST"), tagline = id == "S2" and "EAT / REGROUP / RUN" or nil,
			kind = "Food", accent = P.orange, wall = P.cream, carpet = P.cream, floorMaterial = Enum.Material.Marble, light = P.orange, wideDoor = true, serviceDoors = {-17, 17},
			build = function(ctx)
				local f = ctx.f
				local cols = {P.red, P.sun, P.sky, P.lime, P.pink, P.violet}
				for i, s in ipairs(stalls[id]) do
					local prop
					if s[2] == "BURGER BARN" then
						prop = function(g, x, z)
							g.can("BurgerBun", x - 7.5, 12.6, z, 3.4, 1.2, P.orange, Enum.Material.SmoothPlastic, false)
							g.can("BurgerPatty", x - 7.5, 11.8, z, 3.6, 0.8, P.darkwood, Enum.Material.SmoothPlastic, false)
							g.can("BurgerLettuce", x - 7.5, 11.2, z, 3.8, 0.5, P.lime, Enum.Material.SmoothPlastic, false)
						end
					elseif s[2] == "ICE CREAM LAB" then
						prop = function(g, x, z)
							g.wedge("ConeWedge", x - 7.5, 11, z, 1.8, 3, 1.8, 0, P.peach, Enum.Material.SmoothPlastic, false)
							g.ball("Scoop", x - 7.5, 13.6, z, 2.6, 2.4, 2.6, P.pink, Enum.Material.SmoothPlastic, false)
						end
					elseif s[2] == "DONUT DEN" then
						prop = function(g, x, z)
							g.can("DonutBase", x - 7.5, 11.6, z, 3.4, 1, P.peach, Enum.Material.SmoothPlastic, false)
							g.can("DonutIcing", x - 7.5, 12.5, z, 3.4, 0.4, P.pink, Enum.Material.SmoothPlastic, false)
						end
					end
					foodStall(ctx, s[1], s[2], s[3], prop)
				end
				-- Dining islands across the hall, leaving three open lanes.
				for i, x in ipairs({-42, -26, -10, 10, 26, 42}) do
					for j, z in ipairs({12, 24}) do
						if not (id == "S2" and math.abs(x) < 12 and z == 12) then diningIsland(ctx, x, z, cols[((i + j) % #cols) + 1]) end
					end
				end
				-- A staff room and a walk-in cooler behind the stalls, in every food court.
				Fx.hideCell(ctx, {id = "food_staff_" .. id, kind = "Staff Room", lx = 45.5, lz = 43.5, yaw = 0, w = 7, d = 7, wall = P.white, accent = P.orange, door = P.orange, carpet = P.cream,
					interior = function(g, w, d) g.b("StaffLocker", 0, 0, d / 2 - 1, 5, 6, 1, P.steel, Enum.Material.Metal, false) end})
				if id == "S3" then
					Fx.hideCell(ctx, {id = "food_cooler_" .. id, kind = "Walk-in Cooler", lx = -45.5, lz = 43.5, yaw = 0, w = 7, d = 7, wall = P.sky, accent = P.sky, door = P.sky, doorMaterial = Enum.Material.Glass, carpet = P.sky})
				else
					Fx.hideCell(ctx, {id = "food_pantry_" .. id, kind = "Mascot Closet", lx = -26, lz = 36, yaw = 0, w = 5, d = 5, wall = P.sun, accent = P.orange, door = P.sky, carpet = P.cream})
				end
			end})
	end

	-- E1 L2: RESTROOMS -----------------------------------------------------------------------
	local function restroom(slot, name)
		return {slot = slot, floor = 2, name = name, tagline = "FRESHEN UP", kind = "Restroom", accent = P.sky, wall = P.sky, carpet = P.white, floorMaterial = Enum.Material.Marble,
			light = P.sky, serviceDoors = {24},
			build = function(ctx)
				local f = ctx.f
				-- Sink counters with mirrors on the left; stalls on the right and back.
				for i, z in ipairs({9, 16, 23}) do
					Fx.counter(ctx, -24, z, 3, 6, P.white, P.sky, P.sky)
					f.b("SinkMirror", -28.5, 4, z, 0.3, 5.6, 6, P.sky, Enum.Material.Glass, false, {transparency = 0.3})
				end
				for i = 1, 5 do
					Fx.hideCell(ctx, {id = slot:lower() .. "_stall_" .. i, kind = "Restroom Stall", lx = -18 + (i - 1) * 7.6, lz = 60.5, yaw = 0, w = 6.4, d = 4.4, h = 8.5,
						wall = P.white, accent = P.sky, door = P.sky, doorMaterial = Enum.Material.SmoothPlastic, carpet = P.white, doorGap = 1.4,
						interior = function(g, w, d)
							g.b("Toilet", 0, 0, d / 2 - 1.1, 1.8, 2.2, 1.6, P.white, Enum.Material.SmoothPlastic, false)
							g.b("TankBack", 0, 2.2, d / 2 - 0.8, 1.8, 1.4, 0.6, P.white, Enum.Material.SmoothPlastic, false)
						end})
				end
				for i = 1, 3 do
					Fx.hideCell(ctx, {id = slot:lower() .. "_stall_r_" .. i, kind = "Restroom Stall", lx = 6 + (i - 1) * 7.6, lz = 44.5, yaw = 0, w = 6.4, d = 4.4, h = 8.5,
						wall = P.white, accent = P.sky, door = P.coral, doorMaterial = Enum.Material.SmoothPlastic, carpet = P.white, doorGap = 1.4})
				end
				Fx.sofa(ctx, 20, 12, 180, P.sky)
				Fx.plant(ctx, 26, 18, 1.1)
				f.b("HandDryer", 12, 3, 1.8, 2, 1.6, 0.8, P.steel, Enum.Material.Metal, false)
			end}
	end
	table.insert(list, restroom("E1", "RESTROOMS EAST"))
	table.insert(list, restroom("W3", "RESTROOMS WEST"))

	-- E2 L2: PET PALACE ----------------------------------------------------------------------
	table.insert(list, {slot = "E2", floor = 2, name = "PET PALACE", tagline = "FRIENDS WITH FUR AND FINS", kind = "Pets",
		accent = P.orange, wall = P.peach, carpet = Color3.fromRGB(190, 220, 160), light = P.orange, serviceDoors = {18},
		build = function(ctx)
			local f = ctx.f
			local fur = {P.orange, P.cream, P.darkwood, P.grey, P.sun}
			-- Giant aquarium: a solid glass tank with swimming blobs and rocks.
			f.b("TankBase", 0, 0, 34, 18, 3, 8, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Full"})
			f.b("TankGlass", 0, 3, 34, 18, 7, 8, P.sky, Enum.Material.Glass, true, {transparency = 0.55, shadow = false, cover = "Full"})
			f.b("TankLid", 0, 10, 34, 18.4, 0.5, 8.4, P.dark, Enum.Material.SmoothPlastic, false)
			for i = 1, 8 do f.ball("Fish", -7 + (i % 4) * 4.6, 4.5 + (i % 3) * 1.7, 33 + (i % 2) * 2, 1.6, 0.8, 0.5, ({P.orange, P.sun, P.pink, P.mint})[(i % 4) + 1], Enum.Material.SmoothPlastic, false) end
			for i = 1, 4 do f.ball("TankRock", -6 + i * 3, 3.2, 34, 2.2, 1.4, 2, P.grey, Enum.Material.Slate, false) end
			-- Pet cages: low units with cuddly residents.
			for i, z in ipairs({10, 18, 26}) do
				f.b("CageUnit", -25, 0, z, 4, 3.4, 6, P.white, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
				f.b("CageGlass", -25, 3.4, z, 4, 1.6, 6, P.glass, Enum.Material.Glass, false, {transparency = 0.6})
				f.ball("Pet", -25, 3.4, z, 2, 1.4, 2, fur[(i % #fur) + 1], Enum.Material.Fabric, false)
			end
			-- Cat tree: stepped platforms to climb.
			f.can("CatPole", 20, 0, 12, 1.4, 9, P.wood, Enum.Material.Wood, true, {cover = "Soft"})
			for i = 1, 3 do f.b("CatShelf", 20, i * 2.6, 12, 5, 0.6, 5, P.mint, Enum.Material.Fabric, i == 1, {cover = "Low", vault = true}) end
			Fx.gondola(ctx, 24, 40, 16, false, P.white, fur, 7)
			Fx.rack(ctx, 12, 22, 8, false, P.coral, P.sun)
			Fx.counter(ctx, 22, 6, 10, 2.6, P.orange, P.white, P.orange)
			-- A dog house with a pitched red roof.
			Fx.hideCell(ctx, {id = "pet_doghouse", kind = "Dog House", lx = -34, lz = 48, yaw = 0, w = 6, d = 6, h = 6.5, wall = P.wood, accent = P.red, door = P.darkwood,
				doorMaterial = Enum.Material.Wood, carpet = P.sun, doorGap = 0.4,
				decor = function(g, w, d, h) g.b("DogRoof", 0, h, 0, w + 1.2, 0.8, d + 1.2, P.red, Enum.Material.SmoothPlastic, false) end})
			for i = 1, 3 do Fx.hideCell(ctx, {id = "pet_carrier_" .. i, kind = "Pet Carrier", lx = -18 + (i - 1) * 6, lz = 60, yaw = 0, w = 5, d = 4.5, h = 7, wall = P.orange, accent = P.sun, door = P.sun, carpet = P.peach, doorMaterial = Enum.Material.Metal}) end
		end})

	-- E3 L2: PHOTO STUDIO --------------------------------------------------------------------
	table.insert(list, {slot = "E3", floor = 2, name = "SNAP STUDIO", tagline = "SAY CHEESE / THEN RUN", kind = "Photo",
		accent = P.pink, wall = P.white, carpet = P.lilac, light = P.pink, serviceDoors = {-12},
		build = function(ctx)
			local f = ctx.f
			local sets = {P.pink, P.sky, P.sun, P.mint, P.violet}
			-- Backdrop panels: tall full-cover sets to weave between.
			for i = 1, 4 do
				local x = -21 + (i - 1) * 14
				f.b("Backdrop", x, 0, 20 + (i % 2) * 10, 12, 11, 0.8, sets[i], Enum.Material.SmoothPlastic, true, {cover = "Full"})
				f.b("BackdropFoot", x, 0, 20.9 + (i % 2) * 10, 12, 0.6, 2.4, P.dark, Enum.Material.SmoothPlastic, false)
			end
			-- Giant frame, flower wall and neon sign.
			f.b("FrameTop", 0, 11, 50, 18, 1, 1, P.gold, Enum.Material.Metal, false)
			f.b("FrameL", -8.5, 1, 50, 1, 10, 1, P.gold, Enum.Material.Metal, false)
			f.b("FrameR", 8.5, 1, 50, 1, 10, 1, P.gold, Enum.Material.Metal, false)
			f.b("FrameBottom", 0, 0, 50, 18, 1, 1, P.gold, Enum.Material.Metal, false)
			for i = 1, 10 do f.ball("Flower", -26 + (i % 5) * 3, 1.5 + math.floor(i / 5) * 3, 62.4, 2.4, 2.4, 1, sets[(i % #sets) + 1], Enum.Material.SmoothPlastic, false) end
			f.sign("SMILE", 0, 7, 62.8, 12, 4, P.white, P.pink, true, {material = Enum.Material.Neon})
			-- Ring-light stands (soft cover) and props.
			for i = 1, 4 do
				f.b("LightStand", -22 + (i - 1) * 14, 0, 40, 0.3, 6.6, 0.3, P.dark, Enum.Material.Metal, false)
				f.can("RingLight", -22 + (i - 1) * 14, 6.2, 40, 2.6, 0.4, P.white, Enum.Material.Neon, false)
			end
			Fx.sofa(ctx, -20, 8, 180, P.pink)
			Fx.sofa(ctx, 20, 8, 180, P.violet)
			Fx.counter(ctx, 22, 5, 10, 2.6, P.pink, P.white, P.pink)
			for i = 1, 3 do Fx.hideCell(ctx, {id = "snap_booth_" .. i, kind = "Selfie Booth", lx = 6 + (i - 1) * 7.4, lz = 60, yaw = 0, wall = sets[i], accent = P.sun, door = P.white, carpet = P.white}) end
		end})

	-- W1 L2: MUSIC ---------------------------------------------------------------------------
	table.insert(list, {slot = "W1", floor = 2, name = "BEAT BOX MUSIC", tagline = "VINYL / GUITARS / DROPS", kind = "Music",
		accent = P.coral, wall = Color3.fromRGB(80, 60, 110), carpet = Color3.fromRGB(60, 40, 90), light = P.coral, serviceDoors = {18},
		build = function(ctx)
			local f = ctx.f
			local discs = {P.coral, P.sun, P.sky, P.mint, P.violet}
			-- Record bins: low crates full of sleeves.
			for i, z in ipairs({12, 20, 28}) do
				for _, x in ipairs({-16, 16}) do
					f.b("RecordBin", x, 0, z, 12, 2.8, 3, P.darkwood, Enum.Material.Wood, true, {cover = "Low", vault = true})
					for k = 1, 6 do f.b("Sleeve", x - 5 + (k - 1) * 2, 2.8, z, 1.6, 2, 0.3, discs[(k + i) % #discs + 1], Enum.Material.SmoothPlastic, false) end
				end
			end
			-- Stage with drum kit and speaker stacks.
			f.b("Stage", 0, 0, 52, 22, 2, 12, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			for _, x in ipairs({-8, 8}) do
				f.b("Speaker", x, 2, 54, 4, 8, 3, P.black, Enum.Material.SmoothPlastic, true, {cover = "Full"})
				f.can("Woofer", x, 3, 52.4, 2.6, 0.4, P.steel, Enum.Material.Metal, false)
			end
			f.can("BassDrum", 0, 2, 52, 4, 3, P.red, Enum.Material.SmoothPlastic, false)
			for i = 1, 3 do f.can("Cymbal", -4 + i * 3, 5.5, 53, 2.6, 0.2, P.gold, Enum.Material.Metal, false) end
			-- Guitar wall: a row of colourful guitars on the left.
			for i = 1, 6 do
				local z = 10 + (i - 1) * 6
				f.ball("GuitarBody", -28, 5, z, 0.8, 3.4, 2.6, discs[(i % #discs) + 1], Enum.Material.Wood, false)
				f.b("GuitarNeck", -28, 6.8, z, 0.4, 4, 0.5, P.darkwood, Enum.Material.Wood, false)
			end
			-- Giant headphone landmark.
			f.can("HeadphoneBand", 20, 0, 40, 6, 0.8, P.coral, Enum.Material.SmoothPlastic, false)
			for _, s in ipairs({-1, 1}) do f.can("Earcup", 20 + s * 3, 0, 40, 2.4, 6, P.dark, Enum.Material.SmoothPlastic, true, {cover = "Full"}) end
			Fx.counter(ctx, 22, 6, 10, 2.6, P.coral, P.white, P.coral)
			Fx.hideCell(ctx, {id = "beat_dj", kind = "DJ Booth", lx = -22, lz = 58, yaw = 0, w = 8, d = 7, wall = P.dark, accent = P.coral, door = P.coral, carpet = P.dark,
				interior = function(g, w, d) g.b("Decks", 0, 0, d / 2 - 1.2, 5, 3, 1.6, P.steel, Enum.Material.Metal, false) end})
			Fx.hideCell(ctx, {id = "beat_booth", kind = "Listening Booth", lx = 24, lz = 58, yaw = 0, w = 6, d = 6, wall = P.violet, accent = P.coral, door = P.coral, carpet = P.dark})
		end})

	-- W2 L2: GYM -----------------------------------------------------------------------------
	table.insert(list, {slot = "W2", floor = 2, name = "FIT ZONE GYM", tagline = "PUSH / PULL / SPRINT", kind = "Gym",
		accent = P.sky, wall = P.white, carpet = P.dark, floorMaterial = Enum.Material.SmoothPlastic, light = P.sky, serviceDoors = {-14},
		build = function(ctx)
			local f = ctx.f
			local mat = {P.sky, P.coral, P.lime, P.sun}
			-- Machines in rows: low cover with colourful pads.
			for i, z in ipairs({12, 22, 32}) do
				for k, x in ipairs({-18, -6, 6, 18}) do
					f.b("Machine", x, 0, z, 4, 4.4, 5, P.dark, Enum.Material.Metal, true, {cover = "Low", vault = true})
					f.b("MachinePad", x, 1.6, z + 1.8, 3, 2.4, 0.6, mat[(i + k) % #mat + 1], Enum.Material.SmoothPlastic, false)
					f.b("MachineStack", x, 4.4, z - 1.6, 1.6, 2.6, 1.2, P.steel, Enum.Material.Metal, false)
				end
			end
			-- Boxing ring: roped platform in the back.
			f.b("RingPlatform", 0, 0, 52, 18, 1.4, 18, P.sky, Enum.Material.SmoothPlastic, true, {cover = "Low", vault = true})
			for _, x in ipairs({-8.4, 8.4}) do for _, z in ipairs({43.6, 60.4}) do f.b("RingPost", x, 1.4, z, 0.6, 4, 0.6, P.red, Enum.Material.Metal, false) end end
			for _, y in ipairs({2.6, 3.6, 4.6}) do
				f.b("RingRope", 0, y, 43.6, 17, 0.2, 0.2, P.red, Enum.Material.SmoothPlastic, false)
				f.b("RingRope", 0, y, 60.4, 17, 0.2, 0.2, P.red, Enum.Material.SmoothPlastic, false)
			end
			-- Heavy bags and a plate wall.
			for i = 1, 3 do
				f.b("BagChain", -24 + (i - 1) * 6, 11, 40, 0.2, 7, 0.2, P.steel, Enum.Material.Metal, false)
				f.can("HeavyBag", -24 + (i - 1) * 6, 3.4, 40, 2.4, 5.6, P.red, Enum.Material.Fabric, true, {cover = "Soft"})
			end
			Fx.counter(ctx, 22, 6, 10, 2.6, P.sky, P.white, P.sky)
			for i = 1, 3 do Fx.hideCell(ctx, {id = "gym_locker_" .. i, kind = "Locker", lx = 12 + (i - 1) * 4.4, lz = 61, yaw = 0, w = 3.8, d = 4, h = 8, wall = P.sky, accent = P.lime, door = P.dark, doorMaterial = Enum.Material.Metal, carpet = P.dark, doorGap = 0.6}) end
		end})

	return list
end

return Zones
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">MallBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- CATCH MALL: a two-floor mall around a huge open atrium. Modules live in World/Mall and are
-- built in a fixed order so every floor, wall and prop agrees on the same layout numbers.
local Lighting = game:GetService("Lighting")

local MallBuilder = {}
local built
local MAP_VERSION = 2

local function load(name)
	if script then return require(script.Parent.Mall[name]) end
	return require("./Mall/" .. name)
end

-- Lighting: a warm, sunny afternoon that stays mid-tone. The previous preset stacked bright ambient, positive
-- exposure and a long haze over hundreds of studs of near-white floor, which washed everything out. Here ambient
-- is moderate so colors keep their saturation, the sun gives readable shadows, and bloom only catches real glow.
-- Lighting.Technology is not scriptable; tools/bake-place.luau sets it (ShadowMap) in the saved place.
local function applyLighting()
	Lighting.ClockTime = 15.4
	Lighting.GeographicLatitude = 28
	Lighting.Brightness = 2.1
	Lighting.Ambient = Color3.fromRGB(118, 116, 134)
	Lighting.OutdoorAmbient = Color3.fromRGB(132, 138, 160)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 236, 205)
	Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
	Lighting.ExposureCompensation = -0.05
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.25
	for _, name in ipairs({"CatchAtmosphere", "CatchBloom", "CatchColor", "CatchSunRays", "CatchSky"}) do
		local old = Lighting:FindFirstChild(name)
		if old then old:Destroy() end
	end
	local sky = Instance.new("Sky")
	sky.Name = "CatchSky"
	sky.StarCount = 0
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 14
	sky.Parent = Lighting
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "CatchAtmosphere"
	atmosphere.Density = 0.1
	atmosphere.Offset = 0.05
	atmosphere.Color = Color3.fromRGB(190, 215, 250)
	atmosphere.Decay = Color3.fromRGB(255, 200, 150)
	atmosphere.Glare = 0
	atmosphere.Haze = 0.1
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CatchBloom"
	bloom.Intensity = 0.12
	bloom.Size = 18
	bloom.Threshold = 1.9
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "CatchColor"
	color.Contrast = 0.06
	color.Saturation = 0.14
	color.TintColor = Color3.fromRGB(255, 250, 244)
	color.Parent = Lighting
end

local function readBaked(model)
	local world = {Model = model, LobbySpawn = model:GetAttribute("LobbySpawn"), RunnerSpawns = {}, HunterSpawns = {}, Podiums = {},
		Bounds = {min = model:GetAttribute("BoundsMin"), max = model:GetAttribute("BoundsMax")}}
	for _, kind in ipairs({"Runner", "Hunter", "Podium"}) do
		local target = kind == "Podium" and world.Podiums or world[kind .. "Spawns"]
		for i = 1, model:GetAttribute(kind .. "Count") or 0 do
			table.insert(target, model:GetAttribute(kind .. "Spawn" .. i))
		end
	end
	return world
end

function MallBuilder.Build(options)
	if built and built.Model.Parent then return built end
	local existing = workspace:FindFirstChild("CatchMall")
	if existing and existing:GetAttribute("CatchMapVersion") == MAP_VERSION then
		built = readBaked(existing)
		applyLighting()
		return built
	elseif existing then existing:Destroy() end

	local Layout, Kit = load("Layout"), load("Kit")
	local model = Instance.new("Model")
	model.Name = "CatchMall"
	model:SetAttribute("MapName", "CATCH MALL")
	local kit = Kit.new(model)
	kit.style = load("Style").new(kit.P)
	local Fixtures, StoreShell = load("Fixtures"), load("StoreShell")
	local shell = load("Shell").build(kit, Layout)
	load("Atrium").build(kit, Layout)
	load("Service").build(kit, Layout, Fixtures)
	local storesFolder = kit.group("Stores")
	local defs = {}
	for _, moduleName in ipairs({"StoresA", "StoresB", "Zones"}) do
		for _, def in ipairs(load(moduleName).defs(kit.P, Fixtures)) do table.insert(defs, def) end
	end
	-- Local (x, z) positions inside each store for a coin and a runner spawn. Tests verify both are clear.
	local storeCoin = {
		N1_1 = {34, 38}, N2_1 = {0, 40}, N3_1 = {-8, 38}, S1_1 = {30, 38}, S2_1 = {0, 30}, S3_1 = {-20, 12},
		E1_1 = {0, 40}, E2_1 = {-10, 46}, E3_1 = {10, 42}, W1_1 = {0, 40}, W2_1 = {0, 34}, W3_1 = {0, 22},
		N1_2 = {0, 38}, N2_2 = {0, 32}, N3_2 = {-20, 42}, S1_2 = {0, 36}, S2_2 = {0, 36}, S3_2 = {0, 36},
		E2_2 = {0, 12}, E3_2 = {0, 40}, W1_2 = {0, 36}, W2_2 = {12, 40},
	}
	local storeSpawn = {
		N1_1 = {24, 34}, N3_1 = {-8, 44}, S1_1 = {30, 34}, S3_1 = {-20, 18}, W2_1 = {0, 40}, E2_1 = {10, 50},
		S2_2 = {0, 30}, N1_2 = {10, 38}, N3_2 = {-20, 46}, W2_2 = {16, 50}, E2_2 = {10, 46},
	}
	local spawnOrder = {"N1_1", "N3_1", "S1_1", "S3_1", "W2_1", "E2_1", "S2_2", "N1_2", "N3_2", "W2_2", "E2_2"}
	local spawnPoints = {}
	local function facing(position)
		return CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
	end
	local peersByFloor = {{}, {}}
	for _, def in ipairs(defs) do peersByFloor[def.floor][def.slot] = def end
	for _, def in ipairs(defs) do
		local slot = Layout.SlotById[def.slot]
		local ctx = StoreShell.build(kit, Layout, slot, def.floor, def, storesFolder, peersByFloor[def.floor])
		local key = def.slot .. "_" .. def.floor
		local y = Layout.FloorY[def.floor]
		if storeCoin[key] then table.insert(kit.coins, ctx.f.pos(storeCoin[key][1], 3.2, storeCoin[key][2])) end
		if storeSpawn[key] then spawnPoints[key] = facing(ctx.f.pos(storeSpawn[key][1], 3.4, storeSpawn[key][2])) end
	end
	-- Public-space coins: risky open ground and elevated routes.
	for _, p in ipairs({{22, 0}, {-22, 0}, {0, 22}, {0, -22}, {16, 16}, {-16, -16}, {40, 52}, {-40, 52}, {40, -52}, {-40, -52},
		{70, 0}, {-70, 0}, {0, 76}, {0, -76}}) do
		table.insert(kit.coins, Vector3.new(p[1], 3.2, p[2]))
	end
	for _, p in ipairs({{0, 0}, {30, 0}, {-30, 0}, {0, 30}, {0, -30}, {78, 82}, {-78, 82}, {78, -82}, {-78, -82}, {0, 76}, {0, -76}}) do
		table.insert(kit.coins, Vector3.new(p[1], Layout.FloorY[2] + 3.2, p[2]))
	end
	for _, p in ipairs({{156, 146}, {-156, 146}, {156, -146}, {-156, -146}}) do
		table.insert(kit.coins, Vector3.new(p[1], 3.2, p[2]))
		table.insert(kit.coins, Vector3.new(p[1], Layout.FloorY[2] + 3.2, p[2]))
	end
	local coinFolder = kit.group("MallCoins")
	for i, position in ipairs(kit.coins) do
		local coin = kit.part(coinFolder, "MallCoin", Vector3.new(0.5, 2.8, 2.8), position, kit.P.gold, Enum.Material.Neon, false, {shape = "Cylinder", shadow = false})
		coin:SetAttribute("CoinId", i)
		local rim = kit.part(coin, "CoinInner", Vector3.new(0.6, 1.8, 1.8), position, Color3.fromRGB(255, 244, 170), Enum.Material.Neon, false, {shape = "Cylinder", shadow = false})
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = coin, rim
		weld.Parent = rim
	end
	model:SetAttribute("CoinCount", #kit.coins)

	local exterior = load("Exterior").build(kit, Layout, load("Decor"))
	local runnerSpawns = {}
	for _, key in ipairs(spawnOrder) do table.insert(runnerSpawns, spawnPoints[key]) end
	table.insert(runnerSpawns, facing(Vector3.new(0, Layout.FloorY[2] + 3.4, 76)))
	local hunterSpawns = {facing(Vector3.new(-24, 3.4, 0)), facing(Vector3.new(24, 3.4, 0))}
	local result = {kit = kit, shell = shell, defs = defs}

	applyLighting()
	model:SetAttribute("StaticPartCount", kit.count)
	model.Parent = workspace
	built = {Model = model, LobbySpawn = exterior.LobbySpawn, RunnerSpawns = runnerSpawns, HunterSpawns = hunterSpawns,
		Podiums = exterior.Podiums, Bounds = Layout.Bounds, Build = result}
	model:SetAttribute("CatchMapVersion", MAP_VERSION)
	model:SetAttribute("LobbySpawn", built.LobbySpawn)
	model:SetAttribute("BoundsMin", built.Bounds.min)
	model:SetAttribute("BoundsMax", built.Bounds.max)
	model:SetAttribute("HideSpotCount", #kit.hideSpots)
	model:SetAttribute("StoreCount", #defs)
	model:SetAttribute("LightCount", kit.lights)
	model:SetAttribute("DetailCount", kit.detail)
	model:SetAttribute("EmitterCount", kit.emitters)
	for _, kind in ipairs({"Runner", "Hunter", "Podium"}) do
		local values = kind == "Podium" and built.Podiums or built[kind .. "Spawns"]
		model:SetAttribute(kind .. "Count", #values)
		for i, transform in ipairs(values) do model:SetAttribute(kind .. "Spawn" .. i, transform) end
	end
	return built
end

return MallBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- NEON HEIGHTS: a deliberately composed six-rooftop chase circuit.
-- All route endpoints are walking-surface coordinates. No asset downloads required.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local MapBuilder = {}
local built
local MAP_VERSION = 4
local P = {
	ink = Color3.fromRGB(38, 52, 82),
	navy = Color3.fromRGB(62, 96, 148),
	steel = Color3.fromRGB(108, 138, 168),
	concrete = Color3.fromRGB(176, 188, 194),
	cream = Color3.fromRGB(240, 222, 186),
	white = Color3.fromRGB(240, 246, 242),
	teal = Color3.fromRGB(44, 192, 196),
	cyan = Color3.fromRGB(77, 239, 229),
	coral = Color3.fromRGB(255, 120, 112),
	pink = Color3.fromRGB(250, 113, 174),
	gold = Color3.fromRGB(255, 198, 100),
	purple = Color3.fromRGB(150, 124, 224),
	green = Color3.fromRGB(70, 190, 130),
	leaf = Color3.fromRGB(128, 214, 120),
	soil = Color3.fromRGB(57, 59, 61),
	road = Color3.fromRGB(80, 90, 110),
	glass = Color3.fromRGB(84, 168, 204),
}

local function applyLighting()
	-- Warm, bright late afternoon: readable routes first, neon as an accent.
	Lighting.ClockTime = 15.2
	Lighting.Brightness = 3.2
	Lighting.Ambient = Color3.fromRGB(138, 148, 172)
	Lighting.OutdoorAmbient = Color3.fromRGB(176, 184, 204)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 236, 200)
	Lighting.ExposureCompensation = 0.2
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3
	Lighting.EnvironmentDiffuseScale = 0.7
	Lighting.EnvironmentSpecularScale = 0.6
	for _, name in ipairs({ "CatchAtmosphere", "CatchBloom", "CatchColor", "CatchSunRays" }) do
		local old = Lighting:FindFirstChild(name)
		if old then old:Destroy() end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "CatchAtmosphere"
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(190, 220, 255)
	atmosphere.Decay = Color3.fromRGB(255, 190, 150)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 0.8
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CatchBloom"
	bloom.Intensity = 0.2
	bloom.Size = 24
	bloom.Threshold = 1.5
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "CatchColor"
	color.Contrast = 0.08
	color.Saturation = 0.22
	color.TintColor = Color3.fromRGB(255, 248, 238)
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "CatchSunRays"
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

local function activateObstacles(model)
	if model:GetAttribute("CatchRuntimeStarted") then return end
	model:SetAttribute("CatchRuntimeStarted", true)
	local tweens = {}
	for _, gate in ipairs(model:GetDescendants()) do
		if gate:IsA("BasePart") and gate:GetAttribute("DynamicObstacle") then
			local closed = gate:GetAttribute("GateClosedCFrame") or gate.CFrame
			gate.CFrame = closed
			local tween = TweenService:Create(gate, TweenInfo.new(gate:GetAttribute("GateCycle") or 3,
				Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 1.5),
				{CFrame = closed + Vector3.new(0, 5, 0)})
			table.insert(tweens, tween)
			tween:Play()
		end
	end
	model.Destroying:Connect(function()
		for _, tween in ipairs(tweens) do tween:Cancel() end
	end)
end

local function readBaked(model)
	local world = {Model=model, LobbySpawn=model:GetAttribute("LobbySpawn"), RunnerSpawns={}, HunterSpawns={}, Podiums={},
		Bounds={min=model:GetAttribute("BoundsMin"),max=model:GetAttribute("BoundsMax")}}
	for _, kind in ipairs({"Runner", "Hunter", "Podium"}) do
		local target = kind == "Podium" and world.Podiums or world[kind.."Spawns"]
		for i=1, model:GetAttribute(kind.."Count") or 0 do
			table.insert(target, model:GetAttribute(kind.."Spawn"..i))
		end
	end
	return world
end

function MapBuilder.Build(options)
	if built and built.Model.Parent then return built end
	local static = options and options.Static == true
	local existing = workspace:FindFirstChild("NeonHeights")
	if existing and existing:GetAttribute("CatchMapVersion") == MAP_VERSION then
		built = readBaked(existing)
		applyLighting()
		if not static then activateObstacles(existing) end
		return built
	elseif existing then existing:Destroy() end
	local model = Instance.new("Model")
	model.Name = "NeonHeights"
	model:SetAttribute("MapName", "NEON HEIGHTS")
	model:SetAttribute("ArtDirection", "Sunset district / painted masonry / mint transit / rooftop gardens")
	local partCount = 0
	local gates = {}
	local function group(name)
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = model
		return folder
	end
	local terrain = group("StreetsAndPlaza")
	local district = group("Architecture")
	local routes = group("ParkourRoutes")
	local props = group("StreetLife")
	local skyline = group("DistantSkyline")
	local lobby = group("SocialDeck")
	local function part(parent, name, size, cf, color, material, collide)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = typeof(cf) == "Vector3" and CFrame.new(cf) or cf
		p.Color = color or P.concrete
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = collide ~= false
		p.CanTouch = false
		p.CanQuery = p.CanCollide
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CastShadow = material ~= Enum.Material.Neon
		p.Parent = parent
		partCount += 1
		return p
	end
	local function box(parent, name, x, y, z, sx, sy, sz, color, material, collide)
		return part(parent, name, Vector3.new(sx, sy, sz), Vector3.new(x, y, z), color, material, collide)
	end
	-- Art-only additions are mounted on solid facades or above head height. This explicit
	-- flag lets geometry checks enforce that visual polish never changes chase collision.
	local function art(parent, name, size, cf, color, material)
		local p = part(parent, name, size, cf, color, material, false)
		p:SetAttribute("VisualPolish", true)
		return p
	end
	local function beamFrame(a, b)
		local direction = b-a
		assert(direction.Magnitude > 0.001, "Beam endpoints must differ")
		-- A vertical beam is parallel to lookAt's default up axis, producing an
		-- undefined rotation in data-only builders. Supply a perpendicular axis.
		local up = math.abs(direction.Unit.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
		return CFrame.lookAt((a+b)/2, b, up)
	end
	local function artBeam(parent, name, a, b, width, color, material)
		return art(parent, name, Vector3.new(width, width, (b-a).Magnitude), beamFrame(a,b), color, material)
	end
	local function disc(parent, name, cf, diameter, thickness, color, material)
		local p = art(parent, name, Vector3.new(thickness, diameter, diameter), cf * CFrame.Angles(0, math.pi/2, 0), color, material)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	local function beam(parent, name, a, b, width, color, material, collide)
		local delta = b - a
		return part(parent, name, Vector3.new(width, width, delta.Magnitude), beamFrame(a,b), color, material, collide)
	end
	local function cylinder(parent, name, center, diameter, height, color, material, collide)
		local p = part(parent, name, Vector3.new(height, diameter, diameter), CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), color, material, collide)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	local function sphere(parent, name, center, size, color)
		local p = part(parent, name, size, center, color, Enum.Material.SmoothPlastic, false)
		p.Shape = Enum.PartType.Ball
		return p
	end
	local function sign(parent, text, center, width, height, accent, rotation)
		local cf = CFrame.new(center) * CFrame.Angles(0, rotation or 0, 0)
		local backing = part(parent, "Sign_" .. text, Vector3.new(width, height, 0.35), cf, P.ink, nil, false)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 34
		gui.LightInfluence = 0
		gui.MaxDistance = 210
		gui.Parent = backing
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.94, 0.82)
		label.Position = UDim2.fromScale(0.03, 0.09)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = accent or P.white
		label.TextScaled = true
		label.FontFace = Font.fromEnum(Enum.Font.GothamBold)
		label.Parent = gui
		for _, side in ipairs({ -1, 1 }) do
			part(parent, "SignEdge", Vector3.new(width, 0.14, 0.16), cf * CFrame.new(0, side * height / 2, -0.22), accent, Enum.Material.Neon, false)
		end
		return backing
	end
	local function light(parent, center, color, brightness, range)
		local bulb = box(parent, "Lamp", center.X, center.Y, center.Z, 1.3, 0.25, 1.3, color, Enum.Material.Neon, false)
		local point = Instance.new("PointLight")
		point.Color = color
		point.Brightness = brightness or 0.6
		point.Range = range or 16
		point.Shadows = false
		point.Parent = bulb
	end
	local function route(name, a, b, width, color, rails, trimStart, trimEnd)
		-- These broad, continuous surfaces stay below the default humanoid slope limit.
		local cf = CFrame.lookAt((a + b) / 2, b)
		local length = (b - a).Magnitude
		-- Sloped decks overlap their landings slightly. Level decks stop at the exact
		-- roof edge: overlapping two opaque top faces at the same height z-fights.
		-- Trimming removes only floor already supplied by a roof, never a route gap.
		local direction = (b - a).Unit
		local deckA = a + direction * (trimStart or -0.2)
		local deckB = b - direction * (trimEnd or -0.2)
		local deckFrame = CFrame.lookAt((deckA + deckB) / 2, deckB)
		local deck = part(routes, name, Vector3.new(width, 0.7, (deckB - deckA).Magnitude), deckFrame * CFrame.new(0, -0.35, 0), P.steel, Enum.Material.Metal)
		deck:SetAttribute("TraversalRoute", true)
		for _, side in ipairs({ -1, 1 }) do
			part(routes, name .. "_Edge", Vector3.new(0.18, 0.08, length), cf * CFrame.new(side * (width / 2 - 0.25), 0.07, 0), color or P.cyan, Enum.Material.Neon, false)
			if rails then
				part(routes, "Handrail", Vector3.new(0.18, 0.18, length), cf * CFrame.new(side * (width / 2 - 0.25), 2.8, 0), P.white, Enum.Material.Metal, false)
				for _, along in ipairs({ -length * 0.45, 0, length * 0.45 }) do
					part(routes, "RailPost", Vector3.new(0.2, 2.8, 0.2), cf * CFrame.new(side * (width / 2 - 0.25), 1.4, along), P.steel, Enum.Material.Metal, false)
				end
			end
		end
		return deck
	end
	local function stair(name, origin, width, rise, run, direction)
		local steps = math.ceil(rise / 0.8)
		local cf = CFrame.new(origin) * CFrame.Angles(0, direction or 0, 0)
		for i = 1, steps do
			local h = rise * i / steps
			part(routes, name, Vector3.new(width, h, run / steps + 0.05), cf * CFrame.new(0, h / 2, -run * (i - 0.5) / steps), P.concrete, Enum.Material.Concrete)
		end
	end
	local function ladder(x, z, roof, rotation)
		local cf = CFrame.new(x, roof / 2 + 0.25, z) * CFrame.Angles(0, rotation or 0, 0)
		local climb = Instance.new("TrussPart")
		climb.Name = "ServiceLadder"
		climb.Size = Vector3.new(2, roof + 2.5, 2)
		climb.CFrame = cf
		climb.Color = P.gold
		climb.Material = Enum.Material.Metal
		climb.Anchored = true
		climb.CanTouch = false
		climb.Parent = routes
		partCount += 1
	end
	local function planter(parent, x, y, z, length, orientation, flowers)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, orientation or 0, 0)
		part(parent, "Planter", Vector3.new(length, 1.5, 3), cf * CFrame.new(0, 0.75, 0), P.cream, Enum.Material.Concrete)
		part(parent, "PlantingSoil", Vector3.new(length - 0.5, 0.15, 2.5), cf * CFrame.new(0, 1.55, 0), P.soil, nil, false)
		for i = 1, math.max(2, math.floor(length / 2.6)) do
			local offset = -length / 2 + i * length / (math.floor(length / 2.6) + 1)
			local pos = (cf * CFrame.new(offset, 2.1, 0)).Position
			sphere(parent, "ClippedShrub", pos, Vector3.new(2.6, 2.2, 2.3), i % 2 == 0 and P.green or P.leaf)
			if flowers then sphere(parent, "Blossom", pos + Vector3.new(0.3, 0.9, 0), Vector3.new(0.6, 0.55, 0.6), i % 2 == 0 and P.pink or P.gold) end
		end
	end
	local function tree(parent, x, y, z, scale)
		scale = scale or 1
		cylinder(parent, "TreeWell", Vector3.new(x, y + 0.25, z), 7 * scale, 0.5, P.cream, Enum.Material.Concrete)
		cylinder(parent, "TreeTrunk", Vector3.new(x, y + 4 * scale, z), 0.85 * scale, 8 * scale, P.soil, Enum.Material.Wood)
		sphere(parent, "TreeCrown", Vector3.new(x, y + 9 * scale, z), Vector3.new(8, 7, 8) * scale, P.green)
		sphere(parent, "TreeCrownLight", Vector3.new(x - 1.8 * scale, y + 10.5 * scale, z - 0.8 * scale), Vector3.new(6, 5, 6) * scale, P.leaf)
	end
	local function bench(parent, x, y, z, rotation)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rotation or 0, 0)
		for _, offset in ipairs({ -2.7, 2.7 }) do
			part(parent, "BenchLeg", Vector3.new(0.5, 1.4, 2.5), cf * CFrame.new(offset, 0.7, 0), P.navy, Enum.Material.Metal)
		end
		for i = 1, 3 do
			part(parent, "BenchSlat", Vector3.new(7, 0.3, 0.6), cf * CFrame.new(0, 1.5, -1.1 + i * 0.7), P.cream, Enum.Material.Wood)
		end
		part(parent, "BenchBack", Vector3.new(7, 1.6, 0.3), cf * CFrame.new(0, 2.65, 1.1), P.cream, Enum.Material.Wood)
	end
	local function acUnit(x, y, z, rotation)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rotation or 0, 0)
		part(props, "ClimateUnit", Vector3.new(6, 2.8, 4), cf * CFrame.new(0, 1.4, 0), P.concrete, Enum.Material.Metal)
		part(props, "VentPanel", Vector3.new(5.2, 2, 0.12), cf * CFrame.new(0, 1.5, -2.07), P.ink, Enum.Material.Metal, false)
		for i = 1, 5 do
			part(props, "VentLouvre", Vector3.new(5, 0.12, 0.16), cf * CFrame.new(0, 0.5 + i * 0.32, -2.2), P.steel, Enum.Material.Metal, false)
		end
		cylinder(props, "FanRim", (cf * CFrame.new(0, 2.85, 0)).Position, 2.6, 0.2, P.ink, Enum.Material.Metal, false)
		for _, angle in ipairs({ 0, math.pi / 2 }) do
			part(props, "FanBlade", Vector3.new(2.3, 0.08, 0.5), cf * CFrame.new(0, 3, 0) * CFrame.Angles(0, angle, 0), P.steel, Enum.Material.Metal, false)
		end
	end
	local function pipe(a, b, color)
		beam(props, "ServicePipe", a, b, 0.65, color or P.coral, Enum.Material.Metal, false)
	end
	local function canopy(parent, x, y, z, width, depth, color, rotation)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rotation or 0, 0)
		part(parent, "Canopy", Vector3.new(width, 0.4, depth), cf * CFrame.Angles(math.rad(-8), 0, 0), color, Enum.Material.Fabric, false)
		part(parent, "CanopyValance", Vector3.new(width, 0.9, 0.2), cf * CFrame.new(0, -0.6, -depth / 2), color, Enum.Material.Fabric, false)
		local sections = math.floor(width / 3)
		for i = 1, sections, 2 do
			part(parent, "CanopyStripe", Vector3.new(width / sections, 0.04, depth), cf * CFrame.Angles(math.rad(-8), 0, 0) * CFrame.new(-width / 2 + (i - 0.5) * width / sections, 0.24, 0), P.cream, Enum.Material.Fabric, false)
		end
	end
	local function building(name, x, z, w, d, h, color, accent)
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = district
		box(folder, "Foundation", x, 0.7, z, w + 1.4, 1.4, d + 1.4, P.navy, Enum.Material.Concrete)
		box(folder, "Facade", x, h / 2 - 0.2, z, w, h - 0.4, d, color, Enum.Material.Concrete)
		box(folder, "GroundFloorBand", x, 4.2, z, w + 0.4, 6.4, d + 0.4, P.ink, Enum.Material.Brick)
		box(folder, "StringCourse", x, 7.6, z, w + 0.8, 0.6, d + 0.8, P.cream, Enum.Material.Concrete)
		-- The roof finishes at h. Its support cap ends at the roof's underside,
		-- avoiding the previous cream/navy coplanar faces across the entire roof.
		box(folder, "RoofCornice", x, h - 0.75, z, w + 1.6, 0.9, d + 1.6, P.cream, Enum.Material.Concrete)
		box(folder, "WalkingRoof", x, h - 0.15, z, w, 0.3, d, P.navy, Enum.Material.Concrete)
		for _, side in ipairs({ -1, 1 }) do
			-- Layered corner pilasters and restrained neon cornices give every block depth.
			for _, endSide in ipairs({ -1, 1 }) do
				box(folder, "Pilaster", x + side * (w / 2 - 1.2), h / 2, z + endSide * (d / 2 + 0.25), 2.4, h - 1.2, 0.9, color, Enum.Material.Concrete)
			end
			box(folder, "CorniceLight", x, h - 1.35, z + side * (d / 2 + 0.85), w - 5, 0.13, 0.12, accent, Enum.Material.Neon, false)
			local columns = math.floor((w - 8) / 10)
			for i = 1, columns do
				local wx = x - w / 2 + 5 + (i - 0.5) * (w - 10) / columns
				box(folder, "ShopGlass", wx, 4.3, z + side * (d / 2 + 0.25), 6.2, 4.6, 0.2, P.glass, Enum.Material.Glass, false)
				box(folder, "WarmDisplay", wx, 5.9, z + side * (d / 2 + 0.4), 5.2, 0.14, 0.12, i % 3 == 0 and accent or P.gold, Enum.Material.Neon, false)
				if h > 15 then
					box(folder, "UpperWindow", wx, h - 5.3, z + side * (d / 2 + 0.2), 4.6, 5.4, 0.22, P.glass, Enum.Material.Glass, false)
					box(folder, "WindowSill", wx, h - 8.1, z + side * (d / 2 + 0.5), 5, 0.35, 0.8, P.cream, nil, false)
					box(folder, "WindowMullion", wx, h - 5.3, z + side * (d / 2 + 0.35), 0.2, 5.4, 0.14, P.cream, nil, false)
				end
			end
			for i = 1, math.floor(d / 12) do
				local wz = z - d / 2 + 5 + (i - 0.5) * (d - 10) / math.floor(d / 12)
				box(folder, "SideWindow", x + side * (w / 2 + 0.2), h > 15 and h - 5.3 or 4.4, wz, 0.2, 4.6, 5.6, P.glass, Enum.Material.Glass, false)
				box(folder, "SideWindowGlow", x + side * (w / 2 + 0.32), h > 15 and h - 3.3 or 6.4, wz, 0.15, 0.13, 5, accent, Enum.Material.Neon, false)
			end
		end
		-- Corner parapets leave the middle of every edge open for bridges and ladders.
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				box(folder, "CornerParapet", x + sx * (w / 2 - 7), h + 0.9, z + sz * (d / 2 - 0.25), 13, 1.8, 0.65, color, Enum.Material.Concrete)
				box(folder, "CornerParapet", x + sx * (w / 2 - 0.25), h + 0.9, z + sz * (d / 2 - 7), 0.65, 1.8, 13, color, Enum.Material.Concrete)
			end
		end
		return folder
	end

	-- The arena is a raised city island. Streets form a cross plus a complete outer loop.
	-- Keep the road at zero, with its supporting island ending below the asphalt.
	box(terrain, "CityIsland", 0, -3.15, 0, 310, 5.7, 280, P.navy, Enum.Material.Concrete)
	box(terrain, "Asphalt", 0, -0.15, 0, 302, 0.3, 272, P.road, Enum.Material.Asphalt)
