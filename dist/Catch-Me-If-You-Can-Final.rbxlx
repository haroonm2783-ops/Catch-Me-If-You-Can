	end
	for _, x in ipairs({ -151, 151 }) do
		box(terrain, "IslandWall", x, 2.2, 0, 2, 4.4, 276, P.navy, Enum.Material.Concrete)
		box(terrain, "IslandLight", x, 4.45, 0, 0.22, 0.12, 276, P.cyan, Enum.Material.Neon, false)
